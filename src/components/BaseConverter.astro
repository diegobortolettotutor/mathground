---
/**
 * BaseConverter.astro — Conversioni tra basi numeriche arbitrarie (2..64),
 * nativo, responsive, bilingue (it/en).
 *
 * Dipendenze:  npm install katex
 *
 * Uso in una pagina .mdx di Starlight:
 *   import BaseConverter from '@components/BaseConverter.astro';
 *   <BaseConverter />
 *
 * ── Alfabeto ────────────────────────────────────────────────────────────
 *   Cifre 0-9 (valori 0..9), lettere A-Z (10..35), lettere a-z (36..61).
 *   Case-sensitive. Le basi 63 e 64 non hanno abbastanza simboli: usano la
 *   notazione a parentesi (v)(v)(v), dove ogni gruppo e' il valore decimale
 *   della cifra. In input e' ammessa una forma "ibrida": simboli nudi e
 *   gruppi (n) mescolati liberamente (es. in base 32 "(10)A17(17)" == "AA17H").
 *   Regola di lettura non ambigua: fuori dalle parentesi ogni singolo
 *   carattere e' una cifra; (n) racchiude un valore decimale a piu' cifre.
 *
 * ── Metodo (in ordine di priorita') ─────────────────────────────────────
 *   1) arrivo = 10        -> espansione posizionale diretta
 *   2) partenza = 10      -> divisioni successive dirette
 *   3) 2 <-> 16           -> scorciatoia a 4 bit  +  anche il metodo generale
 *   4) entrambe non 10    -> ponte esplicito m -> 10 -> n (posizionale, poi
 *                            divisioni successive), i due processi accodati
 *   Il ponte decimale intermedio e' sempre in cifre 0-9; simboli/parentesi
 *   compaiono solo agli estremi (partenza e arrivo).
 *
 * ── Limiti ──────────────────────────────────────────────────────────────
 *   Interi non negativi. Numero massimo di cifre/gruppi in input: 12 per
 *   basi 2..20, 8 per basi 21..64. Aritmetica in BigInt (esatta a qualsiasi
 *   dimensione, coerente col resto del progetto).
 */

import 'katex/dist/katex.min.css';

const lang = (Astro.currentLocale ?? 'it').toLowerCase().startsWith('en') ? 'en' : 'it';

const UI = {
  it: {
    step1: 'Step 1 — SCEGLI LE BASI',
    fromLabel: 'Base di partenza',
    toLabel: 'Base di arrivo',
    swapTitle: 'Scambia le basi',
    step2: 'Step 2 — INSERISCI IL NUMERO',
    numLabel: 'Numero',
    inputHelp1: 'Puoi inserire il numero usando cifre e lettere (maiuscole e minuscole hanno valori diversi).',
    inputHelp2: 'Puoi anche usare le parentesi: ogni gruppo come (12) rappresenta una cifra col suo valore decimale; le due forme si possono mescolare.',
    btnReset: 'AZZERA VALORI',
    btnRandom: 'VALORE CASUALE',
    btnQuick: 'RISULTATO SINTETICO',
    btnStep: 'SVOLGIMENTO PASSO-PASSO',
  },
  en: {
    step1: 'Step 1 — CHOOSE THE BASES',
    fromLabel: 'Source base',
    toLabel: 'Target base',
    swapTitle: 'Swap bases',
    step2: 'Step 2 — ENTER THE NUMBER',
    numLabel: 'Number',
    inputHelp1: 'You can enter the number using digits and letters (upper- and lower-case have different values).',
    inputHelp2: 'You can also use parentheses: each group like (12) represents one digit by its decimal value; the two forms can be mixed.',
    btnReset: 'RESET VALUE',
    btnRandom: 'RANDOM VALUE',
    btnQuick: 'QUICK RESULT',
    btnStep: 'STEP-BY-STEP SOLUTION',
  },
}[lang];
---

<div class="bc-root" data-lang={lang}>
  <!-- Step 1: scelta delle basi -->
  <section class="bc-panel">
    <h3 class="bc-steplabel">{UI.step1}</h3>
    <div class="bc-basesrow">
      <div class="bc-baseblock">
        <label for="bcFrom" class="bc-convlabel">{UI.fromLabel}</label>
        <select id="bcFrom" class="bc-select"></select>
      </div>
      <button id="bcSwap" type="button" class="bc-arrow-sep" data-tooltip={UI.swapTitle} aria-label={UI.swapTitle}>
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="17 1 21 5 17 9"></polyline>
          <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
          <polyline points="7 23 3 19 7 15"></polyline>
          <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
        </svg>
      </button>
      <div class="bc-baseblock">
        <label for="bcTo" class="bc-convlabel">{UI.toLabel}</label>
        <select id="bcTo" class="bc-select"></select>
      </div>
    </div>
  </section>

  <!-- Step 2: inserimento del numero -->
  <section class="bc-panel">
    <h3 class="bc-steplabel">{UI.step2}</h3>
    <div class="bc-numrow">
      <label for="bcNum" class="bc-numlabel">{UI.numLabel}</label>
      <div class="bc-numblock">
        <input id="bcNum" class="bc-numinput" type="text" inputmode="text" autocomplete="off" spellcheck="false" value="" />
        <div id="bcSymHint" class="bc-symhint"></div>
      </div>
    </div>
    <div class="bc-help">
      <p>{UI.inputHelp1}</p>
      <p>{UI.inputHelp2}</p>
    </div>
    <div id="bcStatus" class="bc-status" role="alert" aria-live="polite"></div>
  </section>

  <!-- Azioni -->
  <div class="bc-actions">
    <button id="bcBtnReset" class="bc-btn bc-btn-ghost" type="button">{UI.btnReset}</button>
    <button id="bcBtnRandom" class="bc-btn bc-btn-ghost" type="button">{UI.btnRandom}</button>
    <button id="bcBtnQuick" class="bc-btn bc-btn-ghost" type="button">{UI.btnQuick}</button>
  </div>
  <div class="bc-secondary">
    <button id="bcBtnStep" class="bc-btn bc-btn-ghost bc-btn-wide" type="button">{UI.btnStep}</button>
  </div>

  <!-- Output -->
  <section id="bcQuick" class="bc-result" hidden></section>
  <section id="bcFull" class="bc-result" hidden></section>
</div>
<style is:global>
  .bc-root {
    --bc-radius: 12px;
    --bc-surface: var(--sl-color-gray-6, #1a1a1a);
    --bc-border: var(--sl-color-gray-5, #383838);
    --bc-accent: var(--sl-color-accent, #4f7cff);
    --bc-red: #d11111;
    --bc-green: #1f9d55;
    --bc-accent-hi: var(--sl-color-accent-high, #b8c8ff);
    --bc-faint: var(--sl-color-gray-3, #888);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--sl-color-text, inherit);
    width: 100%;
    min-width: 330px;
    margin: 1.5rem 0;
    text-align: center;
  }
  .bc-root *,
  .bc-root *::before,
  .bc-root *::after { box-sizing: border-box; }

  /* reset difensivo: Starlight inietta margin-top sugli elementi "fratelli"
     dentro il contenuto markdown (regola tipo "* + *"): senza azzerarlo, il
     primo elemento del DOM in board/tabella/gruppi resta piu' in alto di
     tutti gli altri, che invece vengono spinti in basso. Stesso identico fix
     gia' usato nei bottoni di GramSchmidt/GaussJordan/DivisionePolinomiale,
     qui esteso a ogni contenitore che costruiamo dinamicamente via JS. */
  .bc-root[data-lang] .bc-basesrow,
  .bc-root[data-lang] .bc-baseblock,
  .bc-root[data-lang] .bc-arrow-sep,
  .bc-root[data-lang] .bc-convlabel,
  .bc-root[data-lang] .bc-select,
  .bc-root[data-lang] .bc-numrow,
  .bc-root[data-lang] .bc-numblock,
  .bc-root[data-lang] .bc-numlabel,
  .bc-root[data-lang] .bc-numinput,
  .bc-root[data-lang] .bc-symhint,
  .bc-root[data-lang] .bc-help,
  .bc-root[data-lang] .bc-grid,
  .bc-root[data-lang] .bc-cell,
  .bc-root[data-lang] .bc-board-scroller,
  .bc-root[data-lang] .bc-term,
  .bc-root[data-lang] .bc-plus,
  .bc-root[data-lang] .bc-poslabel,
  .bc-root[data-lang] .bc-groups-outer,
  .bc-root[data-lang] .bc-groups-prefix,
  .bc-root[data-lang] .bc-groups-grid,
  .bc-root[data-lang] .bc-group-result,
  .bc-root[data-lang] .bc-group,
  .bc-root[data-lang] .bc-group-bits,
  .bc-root[data-lang] .bc-groups-sep,
  .bc-root[data-lang] .bc-groupswrap,
  .bc-root[data-lang] .bc-booktable,
  .bc-root[data-lang] .bc-booktable th,
  .bc-root[data-lang] .bc-booktable td,
  .bc-root[data-lang] .bc-remainder-box,
  .bc-root[data-lang] .bc-readarrow,
  .bc-root[data-lang] .bc-readarrow-head {
    margin: 0 !important;
  }

  .bc-panel {
    background: var(--bc-surface);
    border: 1px solid var(--bc-border);
    border-radius: var(--bc-radius);
    padding: 1.25rem 1rem;
    margin: 1.25rem 0;
  }
  .bc-steplabel {
    margin: 0 0 1rem;
    font-size: clamp(0.85rem, 2.4vw, 1rem);
    letter-spacing: 0.02em;
    color: var(--sl-color-text-accent, var(--bc-accent-hi));
  }

  /* riga basi: due selettori partenza -> arrivo */
  .bc-basesrow { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: center; gap: 1rem; }
  .bc-baseblock { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; min-width: 9.5rem; }
  .bc-arrow-sep {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6875rem; /* stessa altezza del select: 2*1.5px bordo + 2*0.5rem padding + 1.5rem line-height */
    height: 2.6875rem;
    flex: 0 0 auto;
    color: var(--sl-color-text, inherit);
    align-self: flex-end;
    background-color: var(--bc-surface);
    border: 1.5px solid var(--bc-border);
    border-radius: 6px;
    padding: 0;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease, transform 0.15s ease;
  }
  .bc-arrow-sep svg { display: block; }
  /* focus da tastiera: sempre attivo, su qualsiasi dispositivo (accessibilita') */
  .bc-arrow-sep:focus-visible {
    color: var(--bc-accent);
    border-color: var(--bc-accent);
    background-color: color-mix(in srgb, var(--bc-accent) 14%, var(--bc-surface));
    outline: none;
  }
  .bc-arrow-sep:focus-visible::after { opacity: 1; }
  /* hover: solo sui dispositivi che hanno un vero puntatore (mouse/trackpad).
     Su touch il tocco simula ":hover" ma non lo toglie mai finche' non si
     tocca altrove: il bottone restava "acceso" e il tooltip non spariva
     piu' dopo un tap. Scoping a (hover: hover) evita del tutto il problema. */
  @media (hover: hover) {
    .bc-arrow-sep:hover {
      color: var(--bc-accent);
      border-color: var(--bc-accent);
      background-color: color-mix(in srgb, var(--bc-accent) 14%, var(--bc-surface));
      outline: none;
    }
    .bc-arrow-sep:hover::after { opacity: 1; }
  }
  .bc-arrow-sep:active { transform: scale(0.88); }
  .bc-arrow-sep {
    position: relative;
  }
  .bc-arrow-sep::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    background: var(--bc-surface);
    color: var(--sl-color-text, inherit);
    border: 1px solid var(--bc-border);
    border-radius: 6px;
    padding: 0.3rem 0.6rem;
    font-size: 0.78rem;
    font-family: var(--sl-font, inherit);
    font-weight: 400;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.05s ease;
    z-index: 5;
  }
  .bc-convlabel { font-size: 0.95rem; line-height: 1.4rem; color: var(--sl-color-text-accent, var(--bc-accent-hi)); }
  /* le basi "speciali" (2,10,16) nel menu hanno sfondo piu' scuro per il
     riconoscimento rapido: applicato via classe sull'<option> dallo script */
  .bc-select option.bc-opt-special {
    background-color: var(--sl-color-gray-4, #4a4a4a);
    font-weight: 700;
  }
  .bc-select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background-color: var(--sl-color-bg, #000);
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path d='M1 1l4 4 4-4' stroke='%23888' stroke-width='1.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-repeat: no-repeat;
    background-position: right 0.75rem center;
    background-size: 10px 6px;
    color: var(--sl-color-text, #fff);
    border: 1.5px solid var(--bc-border);
    border-radius: 6px;
    padding: 0.5rem 2rem 0.5rem 0.7rem;
    font: inherit;
    line-height: 1.5rem;
    max-width: 100%;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .bc-symhint {
    font-size: 0.9rem;
    color: var(--bc-faint);
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
  }
  .bc-symhint .bc-symhint-label { font-family: var(--sl-font, inherit); }
  .bc-help { margin-top: 0.5rem; font-size: 0.82rem; color: var(--bc-faint); }
  .bc-help p { margin: 0.25rem 0; }
  .bc-select:hover { border-color: var(--bc-accent); outline: none; }
  .bc-select:focus { border-color: var(--bc-accent); outline: none; }
  .bc-select:focus-visible { outline: none; }

  /* riga numero */
  .bc-numrow { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: center; gap: 0.9rem; }
  .bc-numlabel { padding-top: calc(0.45rem + 1.5px); line-height: 1.5rem; }
  .bc-numblock { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .bc-numinput {
    background: var(--sl-color-bg, #000);
    color: var(--sl-color-text, #fff);
    border: 1.5px solid var(--bc-border);
    border-radius: 6px;
    text-align: center;
    padding: 0.45rem 0.6rem;
    font: inherit;
    line-height: 1.5rem;
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
    letter-spacing: 0.04em;
    width: 12rem;
    max-width: 100%;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .bc-numinput:hover { border-color: var(--bc-accent); background: color-mix(in srgb, var(--bc-accent) 10%, var(--sl-color-bg, #000)); }
  .bc-numinput:focus { border-color: var(--bc-accent); outline: none; }

  .bc-status { margin: 0.6rem 0 0; font-size: 0.95rem; }
  .bc-status.bc-error {
    padding: 0.6rem 0.8rem;
    border-left: 4px solid var(--bc-red);
    background: color-mix(in srgb, var(--bc-red) 8%, transparent);
    border-radius: 4px;
  }

  /* pulsanti */
  .bc-actions {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem; align-items: stretch; margin: 1.25rem auto; max-width: 48rem;
  }
  .bc-actions .bc-btn {
    box-sizing: border-box; width: 100%; margin: 0;
    height: 3.6rem; padding: 0 1rem; line-height: 1.2;
    display: inline-flex; align-items: center; justify-content: center; text-align: center;
  }
  .bc-secondary { margin-top: 1.25rem; }
  .bc-btn {
    font: inherit; font-weight: 600; cursor: pointer;
    border-radius: 999px; padding: 0.7rem 1.4rem; border: 1.5px solid transparent;
    transition: transform 0.1s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .bc-btn:active { transform: scale(0.96); }
  .bc-btn-ghost { background: transparent; color: var(--sl-color-text, inherit); border-color: var(--bc-border); }
  .bc-btn-ghost:hover { border-color: var(--bc-accent); color: var(--bc-accent); }
  .bc-btn-wide { padding: 0.9rem 1.4rem; width: 100%; margin: 0 0 1rem; }

  /* output */
  .bc-result {
    background: var(--bc-surface); border: 1px solid var(--bc-border);
    border-radius: var(--bc-radius); margin-top: 1.5rem; padding: 1.5rem 1rem;
    opacity: 0; transition: opacity 0.3s ease; text-align: left;
  }
  .bc-result.bc-visible { opacity: 1; }
  .bc-result h2 { text-align: center; }
  .bc-result h5 {
    margin: 2.25rem 0 1rem; padding-top: 1rem;
    font-size: 0.95rem; letter-spacing: 0.03em; color: var(--sl-color-text-accent, var(--bc-accent-hi));
  }
  .bc-result h5:first-child { margin-top: 0; padding-top: 0; }
  .bc-text p { margin: 0.7rem 0; }
  .bc-tip {
    background: var(--sl-color-gray-6, rgba(255,255,255,0.04));
    border-left: 4px solid var(--bc-accent);
    border-radius: 6px; padding: 0.9rem 1rem; margin: 1.25rem 0;
  }
  /* stacco tra la scorciatoia a 4 bit e il metodo generale (2<->16):
     margine ampio e simmetrico, cosi' la riga cade esattamente a meta'
     dello spazio verticale creato */
  .bc-divider {
    border: none;
    border-top: 1.5px solid var(--bc-border);
    margin: 3rem 0 !important;
  }
  .bc-katex { overflow-x: auto; overflow-y: hidden; padding: 0.75rem 0.25rem; margin: 1.25rem 0; }
  .bc-katex .katex-display { margin: 0; }

  /* ----- board posizionale (X -> 10) ----- */
  .bc-board-scroller { overflow-x: auto; padding: 0.5rem 0.25rem 0.75rem; margin: 1.25rem 0; }
  .bc-grid {
    display: inline-grid;
    align-items: center;
    justify-content: center;
    column-gap: 0.35rem;
    row-gap: 0.3rem;
    margin: 0 auto;
  }
  .bc-cell { white-space: nowrap; text-align: center; }
  .bc-digit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.6rem;
    height: 1.6rem;
    padding: 0 0.3rem;
    border: 2px solid var(--bc-border);
    border-radius: 4px;
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--bc-red);
  }
  .bc-poslabel {
    font-size: 0.78rem;
    color: var(--bc-faint);
  }
  .bc-poslabel .bc-green { color: var(--bc-green); font-weight: 700; }
  .bc-term { display: flex; align-items: center; justify-content: center; gap: 0.15rem; }
  .bc-plus { align-self: center; padding: 0 0.1rem; opacity: 0.85; }
  .bc-pad-note { color: var(--bc-faint); font-style: italic; }

  /* ----- tabelle in stile "libro": poche righe, zebra, centrate.
     Condivisa da: tabella divisioni successive (10 -> X) e tabella di
     richiamo 2/16/10 (X -> 10, 2 <-> 16). ----- */
  .bc-tablewrap { display: flex; justify-content: center; overflow-x: auto; margin: 3rem 0 !important; padding: 0.25rem; }
  .bc-booktable {
    border-collapse: collapse;
    margin: 0 auto;
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
    font-size: 0.92rem;
  }
  .bc-booktable th, .bc-booktable td {
    border: none;
    padding: 0.22rem 1.1rem;
    text-align: center;
    white-space: nowrap;
  }
  .bc-booktable thead tr {
    border-top: 1.5px solid var(--sl-color-text, currentColor);
    border-bottom: 1.5px solid var(--sl-color-text, currentColor);
  }
  .bc-booktable th {
    font-family: var(--sl-font, inherit);
    font-weight: 700;
    color: var(--sl-color-text-accent, var(--bc-accent-hi));
    padding-top: 0.4rem;
    padding-bottom: 0.4rem;
  }
  .bc-booktable tbody tr:last-child {
    border-bottom: 1.5px solid var(--sl-color-text, currentColor);
  }
  .bc-booktable tbody tr:nth-child(even) {
    background: color-mix(in srgb, var(--sl-color-gray-5, #888) 32%, transparent);
  }
  .bc-divtable td.bc-remainder {
    color: var(--sl-color-text, #111);
    font-weight: 700;
  }
  .bc-remainder-box {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 1.5rem; height: 1.5rem; padding: 0 0.25rem;
    border: 2px solid var(--sl-color-text, #111);
    border-radius: 4px;
  }
  .bc-red-strong { color: var(--bc-red); }
  /* freccia rossa verticale (in una cella con rowspan su tutta la tabella)
     che indica il verso di lettura dei resti, dal basso verso l'alto.
     - L'altezza dell'asta NON puo' essere una percentuale: dentro una cella
       con rowspan il browser non la considera un'altezza "specificata" e
       collassa a 0. Viene quindi impostata in px via JS (fitReadArrows) una
       volta che la tabella e' visibile e la sua altezza reale e' misurabile,
       leggermente piu' corta della cella per lasciare un margine sopra e
       sotto (il centraggio verticale lo fa da solo "vertical-align:middle").
     - Lo sfondo zebrato della tabella non attraversa questa cella (e' un
       unico elemento con rowspan, non una riga per riga): viene ricreato via
       JS con un repeating-linear-gradient a bande alte quanto le righe vere,
       cosi' risulta continuo con le colonne accanto. */
  .bc-divtable td.bc-readarrow-cell {
    border: none;
    padding: 0 0.6rem;
    vertical-align: middle;
    position: relative;
  }
  .bc-readarrow {
    position: relative;
    width: 3px;
    margin: 0 auto;
    background: var(--bc-red);
  }
  .bc-readarrow-head {
    position: absolute;
    top: -4px; /* vertice del chevron: i due tratti scendono e si agganciano sull'asta */
    left: 50%;
    width: 0;
    height: 0;
  }
  .bc-readarrow-head::before,
  .bc-readarrow-head::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 3px;
    height: 10px;
    background: var(--bc-red);
    border-radius: 1.5px;
    transform-origin: top center;
  }
  .bc-readarrow-head::before { transform: translateX(-50%) rotate(-24deg); }
  .bc-readarrow-head::after { transform: translateX(-50%) rotate(24deg); }

  /* ----- gruppi a 4 bit (2 <-> 16) -----
     Griglia (stesso pattern della board posizionale): colonne dispari = un
     gruppo (riga 1) + il suo risultato (riga 2, stessa colonna -> sempre
     centrato sotto, qualunque sia la larghezza del contenuto); colonne pari
     = separatore verticale "|" che attraversa entrambe le righe. */
  .bc-groupswrap { overflow-x: auto; margin: 1.25rem 0; padding: 0.25rem; }
  .bc-groups-outer {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin: 0 auto;
  }
  .bc-groups-prefix { display: inline-flex; align-items: center; padding-top: calc(0.4rem + 1.5px); }
  .bc-groups-grid {
    display: inline-grid;
    column-gap: 0.6rem;
    row-gap: 0.4rem;
    justify-items: center;
    align-items: center;
    margin: 0 auto;
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
    font-size: 1.1rem; font-weight: 700;
  }
  .bc-group {
    display: inline-flex; flex-direction: column; align-items: center; gap: 0.3rem;
    padding: 0.4rem 0.6rem;
    border: 1.5px solid var(--bc-border);
    border-radius: 6px;
  }
  .bc-group-bits span.bc-padbit { opacity: 0.4; }
  .bc-group-arrow { opacity: 0.7; font-family: var(--sl-font, inherit); font-weight: 400; }
  .bc-group-digit { color: var(--bc-red); font-size: 1.2rem; }
  .bc-groups-sep { align-self: stretch; display: flex; align-items: center; opacity: 0.5; font-weight: 400; }
  .bc-group-result {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0.2rem 0.6rem;
    color: var(--bc-red);
  }

  @media (max-width: 600px) {
    .bc-root { font-size: 0.95rem; }
    .bc-actions { grid-template-columns: 1fr; }
    .bc-actions .bc-btn, .bc-btn-wide { width: 100%; }
    .bc-result { padding: 1rem 0.5rem; }
    .bc-numinput { width: 100%; }
    .bc-numrow { flex-direction: column; align-items: stretch; }
    .bc-numlabel { padding-top: 0; }
    .bc-numblock { align-items: stretch; }
    .bc-basesrow { flex-direction: column; align-items: stretch; }
    .bc-baseblock { align-items: stretch; }
    .bc-arrow-sep { align-self: center; }
    .bc-arrow-sep svg { transform: rotate(90deg); }
    .bc-arrow-sep:active { transform: scale(0.88); }
    .bc-select { width: 100%; }
  }
</style>
<script>
  import katex from 'katex';
  import renderMathInElement from 'katex/contrib/auto-render';

  const root = document.querySelector('.bc-root');
  if (root) initBaseConverter(root);

  function initBaseConverter(root) {
    const LANG = (root.dataset.lang || document.documentElement.lang || 'it')
      .toLowerCase().startsWith('en') ? 'en' : 'it';

    const RED = '#d11111';
    const GREEN = '#1f9d55';
    const SPECIAL_BASES = [2, 10, 16];
    const MIN_BASE = 2, MAX_BASE = 64;
    const maxDigitsFor = (base) => (base <= 20 ? 12 : 8);

    // ── alfabeto esteso ──────────────────────────────────────────────
    const ALPHA = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
    const valueOfSymbol = (ch) => ALPHA.indexOf(ch);
    const symbolOfValue = (v) => (v < ALPHA.length ? ALPHA[v] : null);

    // NOTA: la decisione simbolo-vs-parentesi dipende dal VALORE della
    // cifra (0..61 hanno un simbolo in ALPHA, 62 e 63 no), non dalla base:
    // anche in base 63/64 la maggior parte delle cifre usa lettere/numeri
    // normalmente, le parentesi servono solo per i due valori senza simbolo.
    function renderDigit(v) {
      return v < ALPHA.length ? symbolOfValue(v) : `(${v})`;
    }
    // array di valori-cifra (dal piu' significativo) di un BigInt in una base
    function digitsOf(valueBig, base) {
      const b = BigInt(base);
      if (valueBig === 0n) return [0];
      const out = [];
      let q = valueBig;
      while (q > 0n) { out.push(Number(q % b)); q = q / b; }
      return out.reverse();
    }
    // stringa completa di un BigInt in una base (con simboli o parentesi)
    function renderNumber(valueBig, base) {
      return digitsOf(valueBig, base).map((v) => renderDigit(v, base)).join('');
    }
    // valore BigInt a partire da array di valori-cifra
    function digitsToValue(digits, base) {
      const b = BigInt(base);
      let acc = 0n;
      for (const d of digits) acc = acc * b + BigInt(d);
      return acc;
    }
    // simboli leciti per una base (per il suggerimento sotto l'input).
    // Ritorna { symbols, extraValues }: extraValues elenca i soli valori
    // (62, 63) che in questa base esistono ma non hanno un simbolo, quindi
    // vanno scritti tra parentesi — vuoto per le basi fino a 62.
    function allowedSymbolsHint(base) {
      const maxVal = base - 1;
      const symCap = Math.min(maxVal, ALPHA.length - 1); // 61 al massimo
      const parts = [];
      if (symCap <= 9) {
        parts.push(`0-${symCap}`);
      } else {
        parts.push('0-9');
        const upTo = Math.min(35, symCap);
        parts.push(`A-${symbolOfValue(upTo)}`);
        if (symCap >= 36) parts.push(`a-${symbolOfValue(symCap)}`);
      }
      const extraValues = [];
      for (let v = ALPHA.length; v <= maxVal; v++) extraValues.push(v);
      return { symbols: parts.join(', '), extraValues };
    }

    // ── parsing ibrido: simboli nudi + gruppi (n) mescolati ──────────
    function parseHybrid(raw, base) {
      const s = String(raw).trim().replace(/\s+/g, '');
      if (!s) return { error: 'empty' };
      const digits = [];
      let i = 0;
      while (i < s.length) {
        const ch = s[i];
        if (ch === '(') {
          const close = s.indexOf(')', i);
          if (close === -1) return { error: 'malformed' };
          const inner = s.slice(i + 1, close);
          if (!/^[0-9]+$/.test(inner)) return { error: 'malformed' };
          const v = parseInt(inner, 10);
          if (v >= base) return { error: 'digit_too_big', detail: v };
          digits.push(v);
          i = close + 1;
        } else if (ch === ')') {
          return { error: 'malformed' };
        } else {
          const v = valueOfSymbol(ch);
          if (v === -1) return { error: 'bad_symbol', detail: ch };
          if (v >= base) return { error: 'digit_too_big', detail: v };
          digits.push(v);
          i++;
        }
      }
      if (digits.length > maxDigitsFor(base)) return { error: 'too_long', detail: maxDigitsFor(base) };
      return { ok: true, digits };
    }

    // ============================================================= i18n
    const D = {
      it: {
        titleQuick: 'Risultato sintetico',
        titleStep: 'Svolgimento passo-passo',
        posLabel: 'posizione',
        symHintLabel: 'Simboli ammessi:',
        symHintExtra: 'più, tra parentesi, i valori senza simbolo:',
        errEmpty: 'Inserisci un numero.',
        errBadSymbol: (ch) => `Il simbolo "${ch}" non è una cifra valida.`,
        errDigitTooBig: (base) => `Ogni cifra deve essere minore della base (${base}).`,
        errMalformed: 'Parentesi non valide: usa la forma (numero), es. (12).',
        errTooLong: (max) => `Numero troppo lungo: al massimo ${max} cifre per questa base.`,

        // schema A: m -> 10 (espansione posizionale)
        aIntro: (numTex, base) =>
          `<p>Il numero \\( ${numTex} \\) è scritto in base \\( ${base} \\): ogni cifra vale tanto quanto la cifra stessa moltiplicata per la potenza della base corrispondente alla sua posizione, contando da destra a partire da \\( 0 \\).</p>`,
        aBoardIntro: (base) => `<p>Scomponiamo ogni cifra nel proprio termine posizionale (in rosso) moltiplicato per la base (\\( ${base} \\)) elevata alla posizione (in verde):</p>`,
        aSumIntro: '<p>Sommando tutti i termini si ottiene il valore in base \\( 10 \\):</p>',
        aFinal: (numTex, base, result) => `<p>Quindi \\( ${numTex} = ${result}_{10} \\).</p>`,

        // schema B: 10 -> n (divisioni successive)
        bIntro: (value, base) =>
          `<p>Dividiamo ripetutamente \\( ${value} \\) per la base di arrivo \\( ${base} \\), annotando ogni volta quoziente e resto, finché il quoziente non diventa \\( 0 \\):</p>`,
        bTableHead: { div: 'Dividendo', quo: 'Quoziente', rem: 'Resto' },
        bReadIntro: '<p>Il numero nella nuova base si legge prendendo i resti <b class="bc-red-strong">dal basso verso l\'alto</b>:</p>',
        bFinal: (value, base, resultTex) => `<p>Quindi \\( ${value}_{10} = ${resultTex}_{${base}} \\).</p>`,

        // richiamo tabella (solo 2<->16)
        hexRefIntro: '<p>Richiamiamo la corrispondenza tra le cifre esadecimali (da \\( 0 \\) a \\( \\text{F} \\)) e i numeri binari e decimali da \\( 0 \\) a \\( 15 \\):</p>',
        hexRefHead: { bin: 'Base 2', hex: 'Base 16', dec: 'Base 10' },

        // schema C: 2 <-> 16 (scorciatoia 4 bit)
        cIntro: '<p>Poiché \\( 16 = 2^{4} \\), la conversione tra base \\( 2 \\) e base \\( 16 \\) si può fare anche direttamente, senza passare per la base \\( 10 \\): basta raggruppare le cifre binarie a blocchi di \\( 4 \\) bit (da destra verso sinistra); ogni blocco corrisponde esattamente a una cifra esadecimale, e viceversa.</p>',
        cPadNote: (padLen) =>
          `<p>Il numero binario non ha un numero di cifre multiplo di \\( 4 \\): aggiungiamo \\( ${padLen} \\) ${padLen === 1 ? 'zero iniziale' : 'zeri iniziali'} per completare il primo blocco, senza cambiare il valore del numero.</p>`,
        cGroupsIntroBin: '<p>Raggruppiamo le cifre in blocchi di \\( 4 \\) bit e convertiamo ciascun blocco nella cifra esadecimale corrispondente:</p>',
        cGroupsIntroHex: '<p>Espandiamo ogni cifra esadecimale nel proprio blocco di \\( 4 \\) bit:</p>',
        cInfatti: '<p>Infatti, dalla tabella di conversione si ottiene subito che:</p>',
        cFinalBinToHex: (numTex, resultTex) => `<p>Concatenando le cifre esadecimali ottenute (nell'ordine dei blocchi) si ottiene \\( ${numTex} = ${resultTex}_{16} \\).</p>`,
        cFinalHexToBin: (numTex, fullTex, trimmedTex) =>
          `<p>Concatenando i blocchi di \\( 4 \\) bit si ottiene \\( ${fullTex} \\); gli eventuali zeri iniziali dell'intero numero (quelli esterni partendo da sinistra) si possono togliere senza cambiarne il valore, quindi \\( ${numTex} = ${trimmedTex}_{2} \\).</p>`,
        cAltroMetodo: '<p>In alternativa, si può usare il metodo generale passando per la base \\( 10 \\):</p>',

        // ponte m -> 10 -> n
        bridgeIntro: (fromBase, toBase) =>
          `<p>Le basi di partenza e di arrivo sono entrambe diverse da \\( 10 \\): conviene allora passare per la base \\( 10 \\) come ponte, cioè convertire prima da base \\( ${fromBase} \\) a base \\( 10 \\), e poi da base \\( 10 \\) a base \\( ${toBase} \\).</p>`,
        bridgeStep1: (fromBase) => `<p><b>Primo passo:</b> da base \\( ${fromBase} \\) a base \\( 10 \\) (espansione posizionale).</p>`,
        bridgeStep2: (toBase) => `<p><b>Secondo passo:</b> da base \\( 10 \\) a base \\( ${toBase} \\) (divisioni successive).</p>`,
        bridgeFinal: (numTex, fromBase, midValue, resultTex, toBase) =>
          `<p>Mettendo insieme i due passaggi: \\( ${numTex} = ${midValue}_{10} = ${resultTex}_{${toBase}} \\).</p>`,

        // risultato sintetico (per tutti gli schemi)
        finalQuick: (numTex, fromBase, resultTex, toBase) => `<p>Risultato: \\( ${numTex} = ${resultTex}_{${toBase}} \\)</p>`,
      },
      en: {
        titleQuick: 'Quick result',
        titleStep: 'Step-by-step solution',
        posLabel: 'position',
        symHintLabel: 'Allowed symbols:',
        symHintExtra: 'plus, in parentheses, the values with no symbol:',
        errEmpty: 'Enter a number.',
        errBadSymbol: (ch) => `The symbol "${ch}" is not a valid digit.`,
        errDigitTooBig: (base) => `Each digit must be smaller than the base (${base}).`,
        errMalformed: 'Invalid parentheses: use the form (number), e.g. (12).',
        errTooLong: (max) => `Number too long: at most ${max} digits for this base.`,

        aIntro: (numTex, base) =>
          `<p>The number \\( ${numTex} \\) is written in base \\( ${base} \\): each digit is worth as much as the digit itself multiplied by the power of the base corresponding to its position, counting from the right starting at \\( 0 \\).</p>`,
        aBoardIntro: (base) => `<p>We break down each digit into its positional term (in red) multiplied by the base (\\( ${base} \\)) raised to the position (in green):</p>`,
        aSumIntro: '<p>Adding all the terms gives the value in base \\( 10 \\):</p>',
        aFinal: (numTex, base, result) => `<p>So \\( ${numTex} = ${result}_{10} \\).</p>`,

        bIntro: (value, base) =>
          `<p>We repeatedly divide \\( ${value} \\) by the target base \\( ${base} \\), writing down the quotient and remainder each time, until the quotient becomes \\( 0 \\):</p>`,
        bTableHead: { div: 'Dividend', quo: 'Quotient', rem: 'Remainder' },
        bReadIntro: '<p>The number in the new base is read by taking the remainders <b class="bc-red-strong">from bottom to top</b>:</p>',
        bFinal: (value, base, resultTex) => `<p>So \\( ${value}_{10} = ${resultTex}_{${base}} \\).</p>`,

        hexRefIntro: '<p>Recall the correspondence between hexadecimal digits (from \\( 0 \\) to \\( \\text{F} \\)) and the binary and decimal numbers from \\( 0 \\) to \\( 15 \\):</p>',
        hexRefHead: { bin: 'Base 2', hex: 'Base 16', dec: 'Base 10' },

        cIntro: '<p>Since \\( 16 = 2^{4} \\), converting between base \\( 2 \\) and base \\( 16 \\) can also be done directly, without going through base \\( 10 \\): simply group the binary digits into blocks of \\( 4 \\) bits (from right to left); each block corresponds exactly to one hexadecimal digit, and vice versa.</p>',
        cPadNote: (padLen) =>
          `<p>The binary number does not have a number of digits that is a multiple of \\( 4 \\): we add \\( ${padLen} \\) leading zero${padLen === 1 ? '' : 's'} to complete the first block, without changing the value of the number.</p>`,
        cGroupsIntroBin: '<p>We group the digits into blocks of \\( 4 \\) bits and convert each block into the corresponding hexadecimal digit:</p>',
        cGroupsIntroHex: '<p>We expand each hexadecimal digit into its own block of \\( 4 \\) bits:</p>',
        cInfatti: '<p>Indeed, from the conversion table we immediately get that:</p>',
        cFinalBinToHex: (numTex, resultTex) => `<p>Concatenating the hexadecimal digits obtained (in block order) gives \\( ${numTex} = ${resultTex}_{16} \\).</p>`,
        cFinalHexToBin: (numTex, fullTex, trimmedTex) =>
          `<p>Concatenating the \\( 4 \\)-bit blocks gives \\( ${fullTex} \\); any leading zeros of the whole number (the outer ones, counting from the left) can be dropped without changing its value, so \\( ${numTex} = ${trimmedTex}_{2} \\).</p>`,
        cAltroMetodo: '<p>Alternatively, you can use the general method going through base \\( 10 \\):</p>',

        bridgeIntro: (fromBase, toBase) =>
          `<p>The source and target bases are both different from \\( 10 \\): it is then convenient to go through base \\( 10 \\) as a bridge, i.e. first convert from base \\( ${fromBase} \\) to base \\( 10 \\), and then from base \\( 10 \\) to base \\( ${toBase} \\).</p>`,
        bridgeStep1: (fromBase) => `<p><b>First step:</b> from base \\( ${fromBase} \\) to base \\( 10 \\) (positional expansion).</p>`,
        bridgeStep2: (toBase) => `<p><b>Second step:</b> from base \\( 10 \\) to base \\( ${toBase} \\) (successive division).</p>`,
        bridgeFinal: (numTex, fromBase, midValue, resultTex, toBase) =>
          `<p>Putting the two steps together: \\( ${numTex} = ${midValue}_{10} = ${resultTex}_{${toBase}} \\).</p>`,

        finalQuick: (numTex, fromBase, resultTex, toBase) => `<p>Result: \\( ${numTex} = ${resultTex}_{${toBase}} \\)</p>`,
      },
    }[LANG];
    const L = D;

    // ── riferimenti DOM ──────────────────────────────────────────────
    const fromSel = root.querySelector('#bcFrom');
    const toSel = root.querySelector('#bcTo');
    const numInput = root.querySelector('#bcNum');
    const symHint = root.querySelector('#bcSymHint');
    const statusEl = root.querySelector('#bcStatus');
    const quickEl = root.querySelector('#bcQuick');
    const fullEl = root.querySelector('#bcFull');

    // ── helper rendering ─────────────────────────────────────────────
    const KOPTS_DISPLAY = { throwOnError: false, displayMode: true };
    const KOPTS_INLINE = { throwOnError: false, displayMode: false };
    const RMOPTS = {
      throwOnError: false,
      delimiters: [
        { left: '\\(', right: '\\)', display: false },
        { left: '\\[', right: '\\]', display: true },
      ],
    };
    function kx(tex, display) {
      try { return katex.renderToString(tex, display ? KOPTS_DISPLAY : KOPTS_INLINE); }
      catch (e) { return '<span style="color:#e55">[KaTeX error]</span>'; }
    }
    function renderInline(el) { try { renderMathInElement(el, RMOPTS); } catch (e) {} }
    function reveal(el) { el.hidden = false; el.style.display = 'block'; requestAnimationFrame(() => el.classList.add('bc-visible')); }
    function hide(el) { el.classList.remove('bc-visible'); el.style.display = 'none'; el.hidden = true; }
    function tip(msg) { statusEl.textContent = msg; statusEl.className = 'bc-status bc-error'; }
    function unTip() { statusEl.textContent = ''; statusEl.className = 'bc-status'; }
    function emit(target, html, tex) {
      if (html) { const d = document.createElement('div'); d.className = 'bc-text'; d.innerHTML = html; target.appendChild(d); renderInline(d); }
      if (tex) { const w = document.createElement('div'); w.className = 'bc-katex'; w.innerHTML = kx(tex, true); target.appendChild(w); }
    }
    function appendNode(target, node) { target.appendChild(node); }
    function clearResults() { quickEl.innerHTML = ''; fullEl.innerHTML = ''; hide(quickEl); hide(fullEl); }

    // numero come testo LaTeX con pedice base. Per basi con parentesi il
    // contenuto e' gia' "(..)(..)" e va reso in \text; per le altre idem.
    const numTexOf = (digitsStr, base) => `\\text{${digitsStr}}_{${base}}`;
    // rappresentazione di un array di valori-cifra come stringa nella base
    const digitsStr = (digits, base) => digits.map((v) => renderDigit(v, base)).join('');
    // versione "sicura" per \text{} (le parentesi tonde vanno bene in \text)

    // ── popolamento dei due menu a tendina (2..64) ───────────────────
    function populateBaseSelect(sel, selected) {
      sel.innerHTML = '';
      for (let b = MIN_BASE; b <= MAX_BASE; b++) {
        const opt = document.createElement('option');
        opt.value = String(b);
        opt.textContent = String(b);
        if (SPECIAL_BASES.includes(b)) opt.className = 'bc-opt-special';
        if (b === selected) opt.selected = true;
        sel.appendChild(opt);
      }
    }
    const currentFromBase = () => parseInt(fromSel.value, 10);
    const currentToBase = () => parseInt(toSel.value, 10);

    // ── suggerimento simboli leciti ──────────────────────────────────
    const AND = LANG === 'it' ? 'e' : 'and';
    function joinWithAnd(list) {
      if (list.length <= 1) return list.join('');
      return `${list.slice(0, -1).join(', ')} ${AND} ${list[list.length - 1]}`;
    }
    function updateSymHint() {
      const base = currentFromBase();
      const { symbols, extraValues } = allowedSymbolsHint(base);
      let html = `<span class="bc-symhint-label">${L.symHintLabel}</span> ${symbols}`;
      if (extraValues.length) {
        const parensList = joinWithAnd(extraValues.map((v) => `(${v})`));
        html += ` <span class="bc-symhint-label">${L.symHintExtra}</span> ${parensList}`;
      }
      symHint.innerHTML = html;
    }

    // ============================================================= costruttori visuali

    // board dell'espansione posizionale (usata per m -> 10).
    // digits: array di valori-cifra; base: base di partenza.
    function buildPositionalBoard(digits, base) {
      const n = digits.length;
      const scroller = document.createElement('div');
      scroller.className = 'bc-board-scroller';
      const grid = document.createElement('div');
      grid.className = 'bc-grid';
      const nCols = 2 * n - 1;
      grid.style.gridTemplateColumns = `repeat(${nCols}, auto)`;
      digits.forEach((d, idx) => {
        const power = n - 1 - idx;
        const col = 2 * idx + 1;
        const sym = renderDigit(d, base);

        const digitCell = document.createElement('div');
        digitCell.className = 'bc-cell bc-digit';
        digitCell.style.gridColumn = String(col);
        digitCell.style.gridRow = '1';
        digitCell.textContent = sym;
        grid.appendChild(digitCell);

        const posLabel = document.createElement('div');
        posLabel.className = 'bc-cell bc-poslabel';
        posLabel.style.gridColumn = String(col);
        posLabel.style.gridRow = '2';
        posLabel.innerHTML = `${L.posLabel || 'pos.'} <span class="bc-green">${power}</span>`;
        grid.appendChild(posLabel);

        const termCell = document.createElement('div');
        termCell.className = 'bc-cell bc-term';
        termCell.style.gridColumn = String(col);
        termCell.style.gridRow = '3';
        termCell.innerHTML = kx(`\\textcolor{${RED}}{\\text{${sym}}}\\cdot ${base}^{\\textcolor{${GREEN}}{${power}}}`, false);
        grid.appendChild(termCell);

        if (idx < n - 1) {
          const plus = document.createElement('div');
          plus.className = 'bc-cell bc-plus';
          plus.style.gridColumn = String(col + 1);
          plus.style.gridRow = '3';
          plus.innerHTML = kx('+', false);
          grid.appendChild(plus);
        }
      });
      scroller.appendChild(grid);
      return scroller;
    }

    // tabella divisioni successive con freccia rossa di lettura (10 -> n)
    function buildDivisionTable(rows, toBase) {
      const wrap = document.createElement('div');
      wrap.className = 'bc-tablewrap';
      const table = document.createElement('table');
      table.className = 'bc-booktable bc-divtable';
      const thead = document.createElement('thead');
      thead.innerHTML = `<tr><th>${L.bTableHead.div}</th><th></th><th>${L.bTableHead.quo}</th><th>${L.bTableHead.rem}</th><th></th></tr>`;
      table.appendChild(thead);
      const tbody = document.createElement('tbody');
      rows.forEach((r, idx) => {
        const tr = document.createElement('tr');
        const tdDiv = document.createElement('td'); tdDiv.textContent = String(r.dividend);
        const tdOp = document.createElement('td'); tdOp.innerHTML = kx(`\\div ${toBase} \\;=\\;`, false);
        const tdQuo = document.createElement('td'); tdQuo.textContent = String(r.quotient);
        const tdRem = document.createElement('td'); tdRem.className = 'bc-remainder';
        const box = document.createElement('span'); box.className = 'bc-remainder-box'; box.textContent = renderDigit(r.remainder, toBase);
        tdRem.appendChild(box);
        tr.appendChild(tdDiv); tr.appendChild(tdOp); tr.appendChild(tdQuo); tr.appendChild(tdRem);
        if (idx === 0) {
          const tdArrow = document.createElement('td');
          tdArrow.className = 'bc-readarrow-cell';
          tdArrow.rowSpan = rows.length;
          const arrow = document.createElement('div');
          arrow.className = 'bc-readarrow';
          const head = document.createElement('div');
          head.className = 'bc-readarrow-head';
          arrow.appendChild(head);
          tdArrow.appendChild(arrow);
          tr.appendChild(tdArrow);
        }
        tbody.appendChild(tr);
      });
      table.appendChild(tbody);
      wrap.appendChild(table);
      return wrap;
    }

    // tabella di richiamo 0..15 in base 2/16/10 (solo per 2<->16)
    function buildHexRefTable() {
      const wrap = document.createElement('div');
      wrap.className = 'bc-tablewrap';
      const table = document.createElement('table');
      table.className = 'bc-booktable bc-hexreftable';
      const thead = document.createElement('thead');
      thead.innerHTML = `<tr><th>${L.hexRefHead.bin}</th><th>${L.hexRefHead.hex}</th><th>${L.hexRefHead.dec}</th></tr>`;
      table.appendChild(thead);
      const tbody = document.createElement('tbody');
      for (let v = 0; v < 16; v++) {
        const tr = document.createElement('tr');
        const b = v.toString(2).padStart(4, '0');
        const h = symbolOfValue(v);
        tr.innerHTML = `<td>${b}</td><td>${h}</td><td>${v}</td>`;
        tbody.appendChild(tr);
      }
      table.appendChild(tbody);
      wrap.appendChild(table);
      return wrap;
    }

    // gruppi a 4 bit con risultati allineati sotto (2 <-> 16)
    function buildGroups(groups, kind, padLen, results, prefixTex) {
      const wrap = document.createElement('div');
      wrap.className = 'bc-groupswrap';
      const outer = document.createElement('div');
      outer.className = 'bc-groups-outer';
      if (prefixTex) {
        const prefix = document.createElement('span');
        prefix.className = 'bc-groups-prefix';
        prefix.innerHTML = kx(prefixTex, false);
        outer.appendChild(prefix);
      }
      const n = groups.length;
      const grid = document.createElement('div');
      grid.className = 'bc-groups-grid';
      grid.style.gridTemplateColumns = `repeat(${2 * n - 1}, auto)`;
      groups.forEach((g, idx) => {
        const col = 2 * idx + 1;
        const box = document.createElement('div');
        box.className = 'bc-group';
        box.style.gridColumn = String(col);
        box.style.gridRow = '1';
        const bitsEl = document.createElement('div');
        bitsEl.className = 'bc-group-bits';
        if (kind === 'bin' && idx === 0 && padLen > 0) {
          for (let i = 0; i < g.length; i++) {
            const span = document.createElement('span');
            span.textContent = g[i];
            if (i < padLen) span.className = 'bc-padbit';
            bitsEl.appendChild(span);
          }
        } else {
          bitsEl.textContent = g;
        }
        box.appendChild(bitsEl);
        grid.appendChild(box);
        if (idx < n - 1) {
          const sep = document.createElement('span');
          sep.className = 'bc-groups-sep';
          sep.style.gridColumn = String(col + 1);
          sep.style.gridRow = '1';
          sep.textContent = '|';
          grid.appendChild(sep);
        }
      });
      if (results && results.length) {
        results.forEach((res, idx) => {
          const col = 2 * idx + 1;
          const box = document.createElement('div');
          box.className = 'bc-group-result';
          box.style.gridColumn = String(col);
          box.style.gridRow = '2';
          box.textContent = res;
          grid.appendChild(box);
        });
      }
      outer.appendChild(grid);
      wrap.appendChild(outer);
      return wrap;
    }

    // ============================================================= schemi logici
    // Ogni schema costruisce lo svolgimento nel target DOM. Ricevono un
    // oggetto "job" con: fromBase, toBase, digits (valori-cifra input),
    // valueBig (BigInt del numero), inTex (numero di partenza in \text).

    // --- espansione posizionale: costruisce la board + la somma, ritorna nulla ---
    function renderPositional(target, digits, fromBase, valueBig) {
      const n = digits.length;
      const termsTex = digits.map((d, idx) => `${renderDigit(d, fromBase)}\\cdot ${fromBase}^{${n - 1 - idx}}`).join(' + ');
      // valori: d * base^power con BigInt per la potenza (esatta a qualsiasi dimensione)
      const valuesTex2 = digits.map((d, idx) => {
        const power = n - 1 - idx;
        const p = (BigInt(fromBase) ** BigInt(power)).toString();
        return `${d}\\cdot ${p}`;
      }).join(' + ');
      // moltiplicazioni gia' svolte (anche quelle per 0, scritte esplicitamente come 0)
      const productsTex = digits.map((d, idx) => {
        const power = n - 1 - idx;
        const product = (BigInt(d) * (BigInt(fromBase) ** BigInt(power))).toString();
        return product;
      }).join(' + ');
      const inTex = numTexOf(digitsStr(digits, fromBase), fromBase);
      emit(target, L.aBoardIntro(fromBase));
      appendNode(target, buildPositionalBoard(digits, fromBase));
      emit(target, L.aSumIntro, `\\begin{aligned} ${inTex} &= ${termsTex} \\\\ & = ${valuesTex2} \\\\ & = ${productsTex} \\\\ & = ${valueBig.toString()}_{10} \\end{aligned}`);
    }

    // --- divisioni successive: costruisce tabella + lettura, ritorna le cifre risultato ---
    function renderDivisions(target, valueBig, toBase) {
      const rows = [];
      let q = valueBig;
      const b = BigInt(toBase);
      if (q === 0n) rows.push({ dividend: '0', quotient: '0', remainder: 0 });
      else {
        while (q > 0n) {
          const r = Number(q % b);
          const nq = q / b;
          rows.push({ dividend: q.toString(), quotient: nq.toString(), remainder: r });
          q = nq;
        }
      }
      const digits = rows.map((r) => r.remainder).reverse();
      const resultTex = `\\text{${digitsStr(digits, toBase)}}`;
      emit(target, L.bIntro(valueBig.toString(), toBase));
      appendNode(target, buildDivisionTable(rows, toBase));
      emit(target, L.bReadIntro, `\\Longrightarrow\\; ${resultTex}_{${toBase}}`);
      return { digits, resultTex };
    }

    // ============================================================= schema A: m -> 10
    function schemeToDecimal(target, quick, job) {
      const { fromBase, digits, valueBig } = job;
      const inTex = numTexOf(digitsStr(digits, fromBase), fromBase);
      if (quick) { emit(target, L.finalQuick(inTex, fromBase, valueBig.toString(), 10)); return; }
      emit(target, L.aIntro(inTex, fromBase));
      renderPositional(target, digits, fromBase, valueBig);
      emit(target, L.aFinal(inTex, fromBase, valueBig.toString()));
    }

    // ============================================================= schema B: 10 -> n
    function schemeFromDecimal(target, quick, job) {
      const { toBase, valueBig } = job;
      const inTex = `${valueBig.toString()}_{10}`;
      if (quick) {
        const digits = digitsOf(valueBig, toBase);
        emit(target, L.finalQuick(inTex, 10, digitsStr(digits, toBase), toBase));
        return;
      }
      const { resultTex } = renderDivisions(target, valueBig, toBase);
      emit(target, L.bFinal(valueBig.toString(), toBase, resultTex));
    }

    // ============================================================= schema C: 2 <-> 16 (scorciatoia)
    function schemeShortcut216(target, quick, job) {
      const { fromBase, toBase, digits, valueBig } = job;
      const inTex = numTexOf(digitsStr(digits, fromBase), fromBase);
      if (quick) {
        const outDigits = digitsOf(valueBig, toBase);
        emit(target, L.finalQuick(inTex, fromBase, digitsStr(outDigits, toBase), toBase));
        return;
      }
      emit(target, L.cIntro);
      emit(target, L.hexRefIntro);
      appendNode(target, buildHexRefTable());

      if (fromBase === 2 && toBase === 16) {
        const bin = digits.join(''); // cifre 0/1
        const padLen = (4 - (bin.length % 4)) % 4;
        const padded = '0'.repeat(padLen) + bin;
        const groups = [];
        for (let i = 0; i < padded.length; i += 4) groups.push(padded.slice(i, i + 4));
        const hexResults = groups.map((g) => symbolOfValue(parseInt(g, 2)));
        if (padLen > 0) emit(target, L.cPadNote(padLen));
        emit(target, L.cGroupsIntroBin);
        appendNode(target, buildGroups(groups, 'bin', padLen, hexResults, `\\text{${padded}} \\;=\\;`));
        emit(target, L.cInfatti);
        groups.forEach((g) => {
          const bits = g.split('');
          const sumTex = bits.map((bb, j) => `${bb}\\cdot 2^{${3 - j}}`).join('+');
          const valuesTex = bits.map((bb, j) => `${bb}\\cdot ${Math.pow(2, 3 - j)}`).join('+');
          const val = parseInt(g, 2);
          emit(target, '', `\\text{${g}} \\;=\\; ${sumTex} \\;=\\; ${valuesTex} \\;=\\; ${val}_{10} \\;=\\; \\textcolor{${RED}}{\\text{${symbolOfValue(val)}}}_{16}`);
        });
        const resultTex = `\\text{${digitsStr(digitsOf(valueBig, 16), 16)}}`;
        emit(target, L.cFinalBinToHex(inTex, resultTex));
      } else {
        // 16 -> 2
        const hexSyms = digits.map((d) => symbolOfValue(d));
        const groups = digits.map((d) => d.toString(2).padStart(4, '0'));
        const full = groups.join('');
        const trimmed = full.replace(/^0+(?=.)/, '');
        emit(target, L.cGroupsIntroHex);
        appendNode(target, buildGroups(hexSyms, 'hex', 0, groups, `\\text{${hexSyms.join('')}} \\;=\\;`));
        emit(target, L.cInfatti);
        digits.forEach((d, idx) => {
          emit(target, '', `\\text{${symbolOfValue(d)}}_{16} \\;=\\; ${d}_{10} \\;=\\; \\textcolor{${RED}}{\\text{${groups[idx]}}}_{2}`);
        });
        emit(target, L.cFinalHexToBin(inTex, `\\text{${full}}`, `\\text{${trimmed}}`));
      }

      // in aggiunta, il metodo generale m -> 10 -> n, con un netto stacco
      // visivo rispetto alla scorciatoia appena mostrata
      const divider = document.createElement('hr');
      divider.className = 'bc-divider';
      appendNode(target, divider);
      emit(target, L.cAltroMetodo);
      renderBridge(target, job, /*withIntro=*/false);
    }

    // ============================================================= schema D: ponte m -> 10 -> n
    function renderBridge(target, job, withIntro) {
      const { fromBase, toBase, digits, valueBig } = job;
      const inTex = numTexOf(digitsStr(digits, fromBase), fromBase);
      if (withIntro) emit(target, L.bridgeIntro(fromBase, toBase));
      emit(target, L.bridgeStep1(fromBase));
      renderPositional(target, digits, fromBase, valueBig);
      emit(target, L.bridgeStep2(toBase));
      const { digits: outDigits, resultTex } = renderDivisions(target, valueBig, toBase);
      emit(target, L.bridgeFinal(inTex, fromBase, valueBig.toString(), resultTex, toBase));
    }

    function schemeBridge(target, quick, job) {
      const { fromBase, toBase, digits, valueBig } = job;
      const inTex = numTexOf(digitsStr(digits, fromBase), fromBase);
      if (quick) {
        const outDigits = digitsOf(valueBig, toBase);
        emit(target, L.finalQuick(inTex, fromBase, digitsStr(outDigits, toBase), toBase));
        return;
      }
      renderBridge(target, job, /*withIntro=*/true);
    }

    // ============================================================= orchestratore
    function classifyScheme(fromBase, toBase) {
      if (fromBase === toBase) return fromBase === 10 ? 'identity' : 'bridge';
      if (toBase === 10) return 'toDecimal';
      if (fromBase === 10) return 'fromDecimal';
      if ((fromBase === 2 && toBase === 16) || (fromBase === 16 && toBase === 2)) return 'shortcut216';
      return 'bridge';
    }

    function errorMessage(err) {
      if (err.error === 'empty') return L.errEmpty;
      if (err.error === 'bad_symbol') return L.errBadSymbol(err.detail);
      if (err.error === 'digit_too_big') return L.errDigitTooBig(currentFromBase());
      if (err.error === 'malformed') return L.errMalformed;
      if (err.error === 'too_long') return L.errTooLong(err.detail);
      return L.errEmpty;
    }

    // ============================================================= orchestratore
    let bcRandomUsed = false;
    function bcTrack(mode, fromBase, toBase) {
      if (window.umami) {
        umami.track('baseconverter-solve', { mode, conversion: `${fromBase}-${toBase}`, randomUsed: bcRandomUsed });
      }
    }
    function elabora(quick) {
      const target = quick ? quickEl : fullEl;
      const other = quick ? fullEl : quickEl;
      quickEl.innerHTML = ''; fullEl.innerHTML = '';

      const fromBase = currentFromBase();
      const toBase = currentToBase();
      const parsed = parseHybrid(numInput.value, fromBase);
      if (parsed.error) { tip(errorMessage(parsed)); return; }
      unTip();

      const valueBig = digitsToValue(parsed.digits, fromBase);
      const job = { fromBase, toBase, digits: parsed.digits, valueBig };

      emit(target, `<h2>${quick ? L.titleQuick : L.titleStep}</h2>`);

      const scheme = classifyScheme(fromBase, toBase);
      if (scheme === 'identity') {
        // stessa base: il numero non cambia
        const inTex = numTexOf(digitsStr(parsed.digits, fromBase), fromBase);
        emit(target, L.finalQuick(inTex, fromBase, digitsStr(parsed.digits, toBase), toBase));
      } else if (scheme === 'toDecimal') {
        schemeToDecimal(target, quick, job);
      } else if (scheme === 'fromDecimal') {
        schemeFromDecimal(target, quick, job);
      } else if (scheme === 'shortcut216') {
        schemeShortcut216(target, quick, job);
      } else {
        schemeBridge(target, quick, job);
      }

      hide(other);
      reveal(target);
      fitReadArrows();
      bcTrack(quick ? 'quick' : 'steps', fromBase, toBase);
    }

    // altezza + zebra della freccia di lettura (invariato dal precedente)
    const READARROW_INSET = 18;
    function fitReadArrows(tries) {
      tries = tries || 0;
      requestAnimationFrame(() => {
        const cells = root.querySelectorAll('.bc-readarrow-cell');
        if (!cells.length) return;
        let pending = false;
        cells.forEach((cell) => {
          const line = cell.querySelector('.bc-readarrow');
          if (!line) return;
          const h = cell.getBoundingClientRect().height;
          if (h <= 0) { pending = true; return; }
          line.style.height = Math.max(0, h - READARROW_INSET) + 'px';
          const rowsCount = parseInt(cell.getAttribute('rowspan'), 10) || 1;
          const rowH = h / rowsCount;
          const table = cell.closest('table');
          const evenRow = table ? table.querySelector('tbody tr:nth-child(2)') : null;
          const tint = evenRow ? getComputedStyle(evenRow).backgroundColor : 'transparent';
          cell.style.backgroundImage =
            `repeating-linear-gradient(to bottom, transparent 0px, transparent ${rowH}px, ${tint} ${rowH}px, ${tint} ${2 * rowH}px)`;
        });
        if (pending && tries < 12) fitReadArrows(tries + 1);
      });
    }

    // ── valore casuale (dipende dalla coppia di basi) ────────────────
    function randomInRange(min, max) { return min + Math.floor(Math.random() * (max - min + 1)); }
    // quante cifre generare per il caso "generico" (nessun range dedicato):
    // basi piccole (<=8) hanno cifre "povere" di informazione, quindi ne
    // servono di piu' per un esempio sostanzioso; basi grandi (>8) ne
    // bastano meno per arrivare comunque a un valore consistente.
    // quante cifre generare per il caso "generico": base 2 ha un caso dedicato
    // (7-11 cifre, altrimenti i numeri risulterebbero troppo corti per un
    // esempio interessante); le altre basi piccole (<=8) ne usano 6-8, quelle
    // grandi (>8) ne bastano 4-6.
    function randomDigitCount(base) {
      if (base === 2) return randomInRange(7, 11);
      return base > 8 ? randomInRange(4, 6) : randomInRange(6, 8);
    }
    // numero casuale con ESATTAMENTE digitCount cifre nella base data (prima
    // cifra non nulla, cosi' la lunghezza e' quella dichiarata e non meno)
    function randomValueWithDigits(base, digitCount) {
      const digits = [randomInRange(1, base - 1)];
      for (let i = 1; i < digitCount; i++) digits.push(randomInRange(0, base - 1));
      return digitsToValue(digits, base);
    }
    function randomForConversion(fromBase, toBase) {
      const value = randomValueWithDigits(fromBase, randomDigitCount(fromBase));
      return renderNumber(value, fromBase);
    }

    // ── interazioni ──────────────────────────────────────────────────
    function onBasesChanged() { updateSymHint(); clearResults(); unTip(); bcRandomUsed = false; }
    fromSel.addEventListener('change', onBasesChanged);
    toSel.addEventListener('change', onBasesChanged);
    root.querySelector('#bcSwap').addEventListener('click', () => {
      const a = fromSel.value, b = toSel.value;
      fromSel.value = b;
      toSel.value = a;
      onBasesChanged();
    });
    numInput.addEventListener('input', () => { clearResults(); unTip(); bcRandomUsed = false; });
    root.querySelector('#bcBtnReset').addEventListener('click', () => { numInput.value = ''; clearResults(); unTip(); bcRandomUsed = false; });
    root.querySelector('#bcBtnRandom').addEventListener('click', () => {
      numInput.value = randomForConversion(currentFromBase(), currentToBase());
      clearResults(); unTip();
      bcRandomUsed = true;
    });
    root.querySelector('#bcBtnQuick').addEventListener('click', () => elabora(true));
    root.querySelector('#bcBtnStep').addEventListener('click', () => elabora(false));
    window.addEventListener('resize', () => fitReadArrows());

    // ── avvio ────────────────────────────────────────────────────────
    populateBaseSelect(fromSel, 2);
    populateBaseSelect(toSel, 10);
    updateSymHint();
    numInput.value = '';
    renderInline(root);
  }
</script>