  // ----- bootstrap di ogni istanza del componente ---------------------------
  document.querySelectorAll<HTMLElement>(".dp-root").forEach(initInstance);

  function initInstance(root: HTMLElement) {
    const lang = (root.dataset.locale === "en" ? "en" : "it") as Lang;
    const t = (key: string, vars: Record<string, string> = {}) =>
      (I18N[lang][key] ?? key).replace(/\{(\w+)\}/g, (_, k) => vars[k] ?? "");

    // testi statici
    root.querySelectorAll<HTMLElement>("[data-i18n]").forEach(el => {
      el.textContent = t(el.dataset.i18n!);
    });

    const numRow = root.querySelector<HTMLElement>(".dp-num")!;
    const denRow = root.querySelector<HTMLElement>(".dp-den")!;
    const degSel = root.querySelector<HTMLSelectElement>(".dp-degree")!;
    const monicCb = root.querySelector<HTMLInputElement>(".dp-monic-cb")!;
    const msgBox = root.querySelector<HTMLElement>(".dp-message")!;
    const outBox = root.querySelector<HTMLElement>(".dp-output")!;

    const kx = (tex: string, display = false) =>
      katex.renderToString(tex, { throwOnError: false, displayMode: display });

    // costruisce le caselle per una riga (num/den) di grado n
    function buildRow(container: HTMLElement, which: "num" | "den", n: number) {
      container.innerHTML = "";
      for (let pw = n; pw >= 0; pw--) {
        const inp = document.createElement("input");
        inp.type = "text";
        inp.className = "dp-coef";
        inp.value = "0";
        inp.dataset.which = which;
        inp.dataset.pw = String(pw);
        inp.setAttribute("inputmode", "text");
        inp.setAttribute("autocomplete", "off");
        inp.spellcheck = false;
        container.appendChild(inp);

        // per l'ultimo termine (pw=0) non c'e' "x^n" ne' "+" da mostrare: niente
        // span di coda, altrimenti resterebbe uno spazio sottile invisibile che
        // allarga la riga in modo asimmetrico (solo a destra).
        if (pw > 0) {
          const tail = document.createElement("span");
          tail.className = "dp-mono";
          const xp = pw === 1 ? "x" : `x^{${pw}}`;
          tail.innerHTML = kx(`${xp}\\;+`);
          container.appendChild(tail);
        }
      }
    }

    function rebuildInputs() {
      const n = parseInt(degSel.value, 10);
      buildRow(numRow, "num", n);
      buildRow(denRow, "den", n);
      clearOutput();
    }

    function clearOutput() {
      msgBox.textContent = "";
      msgBox.className = "dp-message";
      outBox.innerHTML = "";
    }

    // legge le caselle -> Poly (indice = potenza). Lancia per errori di parsing.
    function readPoly(which: "num" | "den"): Poly {
      const n = parseInt(degSel.value, 10);
      const arr: Poly = new Array(n + 1).fill(PolyA.zero);
      root.querySelectorAll<HTMLInputElement>(`.dp-coef[data-which="${which}"]`).forEach(inp => {
        inp.classList.remove("dp-invalid");
        const pw = parseInt(inp.dataset.pw!, 10);
        try {
          arr[pw] = parseCoeff(inp.value);
        } catch (e) {
          inp.classList.add("dp-invalid");
          const posKey = which === "num" ? "posNum" : "posDen";
          throw new ParseError(t("parseErr", {
            pos: t(posKey, { k: String(pw) }),
            val: inp.value.trim(),
          }));
        }
      });
      return arr;
    }

    function showMessage(text: string, kind: "error" | "info") {
      msgBox.textContent = text;
      msgBox.className = "dp-message dp-" + kind;
    }

    // valida e calcola; ritorna DivResult o null (mostrando il messaggio)
    function compute(): DivResult | null {
      clearOutput();
      let num: Poly, den: Poly;
      try {
        num = readPoly("num");
        den = readPoly("den");
      } catch (e) {
        showMessage((e as Error).message, "error");
        return null;
      }
      const degN = polyDeg(num), degD = polyDeg(den);

      if (degD < 0) { showMessage(t("DENOM_ZERO"), "error"); return null; }
      // coeff direttore del denominatore deve essere numerico
      if (!den[degD].isNumeric()) {
        root.querySelectorAll<HTMLInputElement>(`.dp-coef[data-which="den"]`).forEach(inp => {
          if (parseInt(inp.dataset.pw!, 10) === degD) inp.classList.add("dp-invalid");
        });
        showMessage(t("DENOM_LEAD_SYMBOLIC"), "error"); return null;
      }
      if (degN < 0) { showMessage(t("NUM_ZERO"), "info"); return null; }
      if (degN < degD) { showMessage(t("DEG_LOW"), "error"); return null; }

      const res = divide(num, den, monicCb.checked);
      if (!res.ok) { showMessage(t(res.error ?? "DENOM_ZERO"), "error"); return null; }
      return res;
    }

    // riempie un template di caption sostituendo {x} con KaTeX inline
    function fillCaption(key: string, vars: Record<string, string>): string {
      const tmpl = I18N[lang][key] ?? key;
      return tmpl.replace(/\{(\w+)\}/g, (_, k) =>
        vars[k] !== undefined ? `<span class="dp-inline">${kx(vars[k])}</span>` : "");
    }

    // ----- rendering di un frame (schema a croce) ---------------------------
    // ----- rendering di un frame (schema a croce) ---------------------------
    // Griglia UNICA (non due zone separate): garantisce che numeratore/righe di
    // sviluppo e divisore/quoziente condividano le stesse colonne/righe, cosi'
    // la linea verticale e quella orizzontale risultano continue e si
    // incrociano davvero, come una croce.
    //   riga 1        = numeratore (sinistra) | divisore (destra)
    //   riga 2         = linea orizzontale, copre TUTTA la larghezza
    //   righe 3, 4, ...= sviluppo del calcolo (sinistra) | quoziente (destra,
    //                     ancorato in alto, cresce verso il basso)
    //   colonna vline  = linea verticale, copre TUTTA l'altezza
    function renderBoard(frame: Frame): HTMLElement {
      const board = document.createElement("div");
      board.className = "dp-board";

      const scroller = document.createElement("div");
      scroller.className = "dp-scroller";

      const grid = document.createElement("div");
      grid.className = "dp-grid";
      const vlineCol = frame.topDeg + 3;
      const rightCol = frame.topDeg + 4;
      grid.style.gridTemplateColumns = `auto repeat(${frame.topDeg + 1}, max-content) 1.5rem max-content`;

      // Righe della griglia DICHIARATE ESPLICITAMENTE (riga 1 = numeratore,
      // riga 2 = linea orizzontale, righe 3+ = sviluppo). Senza questa
      // dichiarazione "-1" punterebbe sempre alla riga 1 (la griglia esplicita
      // sarebbe vuota), che e' esattamente il bug che ha causato la verticale
      // troncata e la sovrapposizione divisore/quoziente. Per togliere ogni
      // ambiguita' calcoliamo anche il numero di riga finale alla lettera,
      // invece di usare "-1".
      const totalRows = Math.max(frame.rows.length + 1, 3);
      const lastLine = totalRows + 1; // N righe = N+1 linee di griglia
      grid.style.gridTemplateRows = `repeat(${totalRows}, auto)`;

      frame.rows.forEach((row, idx) => {
        const gridRow = idx === 0 ? 1 : idx + 2; // riga 1 = numeratore, righe 3+ = sviluppo
        const gut = document.createElement("div");
        gut.className = "dp-gutter";
        gut.style.gridRow = String(gridRow);
        gut.style.gridColumn = "1";
        if (row.minus) {
          const m = document.createElement("span");
          m.className = "dp-marker dp-minus" + (row.markerCls === "hl" ? " hl" : "");
          m.textContent = "−";
          gut.appendChild(m);
        }
        if (row.arrow) {
          const a = document.createElement("span");
          a.className = "dp-marker dp-arrow" + (row.markerCls === "hl" ? " hl" : "");
          a.textContent = "↓";
          gut.appendChild(a);
        }
        grid.appendChild(gut);

        for (let pw = frame.topDeg; pw >= 0; pw--) {
          const cell = row.cells[pw];
          if (!cell) continue;
          const c = document.createElement("div");
          c.className = "dp-cell" + (cell.cls ? " " + cell.cls : "");
          c.style.gridRow = String(gridRow);
          c.style.gridColumn = String(frame.topDeg - pw + 2);
          c.innerHTML = kx(cell.tex);
          grid.appendChild(c);
        }
      });

      // linea verticale: dalla riga 1 fino all'ultima riga vera (lastLine),
      // mai "-1": cosi' attraversa l'intera altezza per costruzione.
      const vl = document.createElement("div");
      vl.className = "dp-vline";
      vl.style.gridColumn = String(vlineCol);
      vl.style.gridRow = `1 / ${lastLine}`;
      grid.appendChild(vl);

      // divisore: riga 1, colonna di destra
      const dv = document.createElement("div");
      dv.className = "dp-divisor" + (frame.divisorHl ? " hl" : "");
      dv.style.gridRow = "1";
      dv.style.gridColumn = String(rightCol);
      dv.innerHTML = kx(frame.divisorTex);
      grid.appendChild(dv);

      // linea orizzontale: continua, copre tutta la larghezza della tabella;
      // separa numeratore+divisore (riga 1) dal resto del calcolo sotto.
      if (frame.showRule) {
        const hl = document.createElement("div");
        hl.className = "dp-hline";
        hl.style.gridRow = "2";
        grid.appendChild(hl);
      }

      // quoziente: colonna di destra, dalla riga 3 fino a lastLine (mai
      // sovrapposto al divisore, che e' fermo in riga 1), ancorato in alto
      const q = document.createElement("div");
      q.className = "dp-quotient";
      q.style.gridColumn = String(rightCol);
      q.style.gridRow = `3 / ${lastLine}`;
      q.innerHTML = kx(frame.quotientTex);
      grid.appendChild(q);

      scroller.appendChild(grid);
      board.appendChild(scroller);
      return board;
    }

    function renderDegenerate(res: DivResult, host: HTMLElement) {
      if (!res.degenerateNote) return;
      const note = document.createElement("p");
      note.className = "dp-degenerate";
      note.innerHTML = fillCaption("degenerate", { aval: res.degenerateNote.toLatex() });
      host.appendChild(note);
    }

    // schema a croce SCHEMATICO (etichette letterali, nessun calcolo vero):
    // accompagna la spiegazione testuale mostrando dove va ciascun pezzo.
    // Stessa architettura visiva della tabella reale (vline/hline a croce),
    // ma con contenuto fisso: Numeratore | Denominatore, poi sotto
    // (calcoli)/.../Resto a sinistra, Quoziente a destra.
    function renderMockup(host: HTMLElement) {
      const board = document.createElement("div");
      board.className = "dp-board";
      const scroller = document.createElement("div");
      scroller.className = "dp-scroller";
      const grid = document.createElement("div");
      grid.className = "dp-grid dp-mockup-grid";
      grid.style.gridTemplateColumns = "max-content 1.5rem max-content";
      grid.style.gridTemplateRows = "max-content max-content max-content";

      const num = document.createElement("div");
      num.style.gridRow = "1"; num.style.gridColumn = "1";
      num.textContent = t("mockupNumerator");
      grid.appendChild(num);

      const den = document.createElement("div");
      den.className = "dp-divisor";
      den.style.gridRow = "1"; den.style.gridColumn = "3";
      den.textContent = t("mockupDenominator");
      grid.appendChild(den);

      const vl = document.createElement("div");
      vl.className = "dp-vline";
      vl.style.gridColumn = "2";
      vl.style.gridRow = "1 / 4";
      grid.appendChild(vl);

      const hl = document.createElement("div");
      hl.className = "dp-hline";
      hl.style.gridRow = "2";
      grid.appendChild(hl);

      const calc = document.createElement("div");
      calc.style.gridRow = "3"; calc.style.gridColumn = "1";
      calc.className = "dp-mockup-calc";
      calc.innerHTML = `${t("mockupCalc")}<br>⋮<br>${t("mockupRest")}`;
      grid.appendChild(calc);

      const quo = document.createElement("div");
      quo.className = "dp-quotient";
      quo.style.gridRow = "3"; quo.style.gridColumn = "3";
      quo.textContent = t("mockupQuotient");
      grid.appendChild(quo);

      scroller.appendChild(grid);
      board.appendChild(scroller);
      host.appendChild(board);
    }

    // blocco introduttivo (solo passo-passo): riga 1 SOLO numerica (fratto
    // inserito, con k raccolto numericamente se monico), riga 2 SOLO formale
    // (passaggi con simboli astratti, primati se monico), poi l'annuncio di
    // quali polinomi si usano davvero nella divisione (N(x) e D(x), oppure
    // N(x) e D'(x) se e' stato richiesto il monico).
    function renderIntro(res: DivResult, host: HTMLElement) {
      const block = document.createElement("div");
      block.className = "dp-step-block dp-intro-block";

      const setup = document.createElement("p");
      setup.className = "dp-caption";
      setup.textContent = t("introSetup");
      block.appendChild(setup);

      const eqNumeric = document.createElement("div");
      eqNumeric.className = "dp-intro-eq";
      eqNumeric.innerHTML = kx(introNumericLineTex(res), true);
      block.appendChild(eqNumeric);

      const eqFormal = document.createElement("div");
      eqFormal.className = "dp-intro-eq";
      eqFormal.innerHTML = kx(introFormalLineTex(res), true);
      block.appendChild(eqFormal);

      // ordine: numeratore/denominatore -> dove vanno quoziente e conti ->
      // schema illustrativo -> definizione di termine direttore -> annuncio
      // (quali polinomi si usano davvero), che chiude il blocco introduttivo
      const pNumDenom = document.createElement("p");
      pNumDenom.className = "dp-caption";
      pNumDenom.innerHTML = t("introExplainNumDenom");
      block.appendChild(pNumDenom);

      const pQuotientCalc = document.createElement("p");
      pQuotientCalc.className = "dp-caption";
      pQuotientCalc.innerHTML = t("introExplainQuotientCalc");
      block.appendChild(pQuotientCalc);

      renderMockup(block);

      const pLeadTerm = document.createElement("p");
      pLeadTerm.className = "dp-caption";
      pLeadTerm.innerHTML = t("introExplainLeadTerm");
      block.appendChild(pLeadTerm);

      const algoBox = document.createElement("div");
      algoBox.className = "dp-algo-box";

      const pAlgoIntro = document.createElement("p");
      pAlgoIntro.className = "dp-caption";
      pAlgoIntro.innerHTML = t("introAlgoStepsIntro");
      algoBox.appendChild(pAlgoIntro);

      const algoList = document.createElement("ul");
      algoList.className = "dp-algo-steps";
      for (const key of ["introAlgoStep1", "introAlgoStep2", "introAlgoStep3", "introAlgoStep4"]) {
        const li = document.createElement("li");
        li.innerHTML = t(key);
        algoList.appendChild(li);
      }
      algoBox.appendChild(algoList);
      block.appendChild(algoBox);

      const pImproper = document.createElement("p");
      pImproper.className = "dp-caption";
      pImproper.innerHTML = t("introImproperCheck");
      block.appendChild(pImproper);

      const announce = document.createElement("p");
      announce.className = "dp-caption";
      announce.textContent = t(res.monic ? "introAnnounceMonic" : "introAnnouncePlain");
      block.appendChild(announce);

      host.appendChild(block);
    }

    function renderResultLine(res: DivResult, host: HTMLElement) {
      const wrap = document.createElement("div");
      wrap.className = "dp-result";
      const head = document.createElement("div");
      head.className = "dp-result-head";
      head.textContent = t("resultTitle");
      // riga 1: richiamo della formula generale (simboli astratti)
      const bodyGeneric = document.createElement("div");
      bodyGeneric.className = "dp-result-body dp-result-generic";
      bodyGeneric.innerHTML = kx(genericFormulaTex(res), true);
      // connettivo testuale, come in uno svolgimento di un libro di testo
      const ossia = document.createElement("div");
      ossia.className = "dp-result-ossia";
      ossia.textContent = t("resultOssia");
      // riga 2: controparte numerica della stessa uguaglianza
      const bodyNumeric = document.createElement("div");
      bodyNumeric.className = "dp-result-body dp-result-numeric";
      bodyNumeric.innerHTML = kx(`${initialFractionTex(res)} = ${resultTex(res)}`, true);
      wrap.append(head, bodyGeneric, ossia, bodyNumeric);
      host.appendChild(wrap);
    }

    function maybeAnalyzeButton(res: DivResult, host: HTMLElement) {
      const ana = analyzeParam(res);
      if (!ana.hasParam) return;
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "dp-btn dp-analyze";
      btn.textContent = t("analyze");
      const panel = document.createElement("div");
      panel.className = "dp-ana-panel";
      btn.addEventListener("click", () => {
        if (panel.dataset.done) { panel.classList.toggle("open"); return; }
        renderAnalysis(res, panel);
        panel.dataset.done = "1";
        panel.classList.add("open");
        if ((window as any).umami) {
          (window as any).umami.track('divpoly-analyze', {
            degree: parseInt(degSel.value, 10),
            randomUsed: dpRandomUsed,
          });
        }
      });
      host.append(btn, panel);
    }

    function renderAnalysis(res: DivResult, host: HTMLElement) {
      const ana = analyzeParam(res);
      const title = document.createElement("div");
      title.className = "dp-ana-title";
      title.textContent = t("anaTitle");
      host.appendChild(title);

      const remP = document.createElement("p");
      remP.innerHTML = fillCaption("anaRemainder", { R: polyTex(res.remainder) });
      host.appendChild(remP);

      const main = document.createElement("p");
      if (ana.vanishNote === "ALWAYS") main.textContent = t("anaAlways");
      else if (ana.vanishNote === "NONE") main.textContent = t("anaNone");
      else if (ana.vanishes && ana.vanishes.length) {
        const vals = ana.vanishes.map(f => f.toLatex()).join(", ");
        main.innerHTML = fillCaption("anaSome", { vals });
      } else main.textContent = t("anaNone");
      host.appendChild(main);

      ana.degreeDrops.forEach(d => {
        const p = document.createElement("p");
        p.innerHTML = fillCaption("anaDrop", { v: d.aValue.toLatex(), newDeg: String(d.newDeg) });
        host.appendChild(p);
      });
    }

    // ----- helper tracking -----------------------------------------------
    let dpRandomUsed = false;
    function dpParamsUsed(): boolean {
      let found = false;
      root.querySelectorAll<HTMLInputElement>(".dp-coef").forEach(i => {
        if (/[a-zA-Z]/.test(i.value)) found = true;
      });
      return found;
    }
    function dpTrack(mode) {
      if ((window as any).umami) {
        (window as any).umami.track('divpoly-solve', {
          mode,
          degree: parseInt(degSel.value, 10),
          randomUsed: dpRandomUsed,
          paramsUsed: dpParamsUsed(),
        });
      }
    }

    // ----- risultato veloce -------------------------------------------------
    function doQuick() {
      const res = compute();
      if (!res) return;
      renderDegenerate(res, outBox);
      const frame = buildQuickBoard(res);
      outBox.appendChild(renderBoard(frame));
      renderResultLine(res, outBox);
      maybeAnalyzeButton(res, outBox);
      dpTrack('quick');
    }

    // ----- soluzione passo-passo (impilata, stampabile) ---------------------
    // Tutti i frame vengono renderizzati uno sotto l'altro: l'utente scorre
    // la pagina e puo' stampare l'intera soluzione.
    function doSteps() {
      const res = compute();
      if (!res) return;
      renderDegenerate(res, outBox);
      const frames = buildFrames(res);

      const stack = document.createElement("div");
      stack.className = "dp-stack";

      renderIntro(res, stack);

      frames.forEach((f) => {
        const block = document.createElement("div");
        block.className = "dp-step-block";
        const caption = document.createElement("p");
        caption.className = "dp-caption";
        caption.innerHTML = fillCaption(f.captionKey, f.vars);
        block.appendChild(caption);
        block.appendChild(renderBoard(f));
        stack.appendChild(block);
      });

      outBox.appendChild(stack);
      renderResultLine(res, outBox);
      maybeAnalyzeButton(res, outBox);
      dpTrack('steps');
    }

    // ----- reset & random ---------------------------------------------------
    function doReset() {
      root.querySelectorAll<HTMLInputElement>(".dp-coef").forEach(i => {
        i.value = "0"; i.classList.remove("dp-invalid");
      });
      clearOutput();
      dpRandomUsed = false;
    }

    const randInt = (lo: number, hi: number) =>
      lo + Math.floor(Math.random() * (hi - lo + 1));
    const randNonZero = (lo: number, hi: number) => {
      let v = 0; while (v === 0) v = randInt(lo, hi); return v;
    };

    function doRandom() {
      const n = parseInt(degSel.value, 10);
      const k = randInt(1, 3);
      const degDen = Math.max(1, n - k);
      const setVal = (which: "num" | "den", pw: number, v: number) => {
        const inp = root.querySelector<HTMLInputElement>(
          `.dp-coef[data-which="${which}"][data-pw="${pw}"]`);
        if (inp) { inp.value = String(v); inp.classList.remove("dp-invalid"); }
      };
      for (let pw = 0; pw <= n; pw++) {
        // numeratore: direttore (grado n) non nullo, gli altri 0..9 con segno
        setVal("num", pw, pw === n ? randNonZero(-9, 9) : randInt(-9, 9));
        // denominatore: direttore in [1,9], sotto -9..9, sopra 0
        if (pw === degDen) setVal("den", pw, randInt(1, 9));
        else if (pw < degDen) setVal("den", pw, randInt(-9, 9));
        else setVal("den", pw, 0);
      }
      clearOutput();
      dpRandomUsed = true;
    }

    // ----- wiring -----------------------------------------------------------
    degSel.addEventListener("change", rebuildInputs);
    root.querySelector(".dp-reset")!.addEventListener("click", doReset);
    root.querySelector(".dp-random")!.addEventListener("click", doRandom);
    root.querySelector(".dp-quick")!.addEventListener("click", doQuick);
    root.querySelector(".dp-step-btn")!.addEventListener("click", doSteps);
    monicCb.addEventListener("change", clearOutput);

    rebuildInputs();
  }
</script>

