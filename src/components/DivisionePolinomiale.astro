---
// ============================================================================
//  DivisionePolinomiale.astro
//  Divisore di polinomi (fratto improprio) con:
//   - coefficienti razionali esatti (BigInt) e parametro lineare "a"
//   - selettore di grado (4..10), selettore "rendi monico"
//   - risultato veloce, soluzione passo-passo a frame, analisi del parametro
//  Dipendenze logiche: ./engine.ts e ./view.ts (stessa cartella).
//  KaTeX e' importato nello <script> lato client.
// ============================================================================
const locale = Astro.currentLocale ?? "it";
const lang = locale.startsWith("en") ? "en" : "it";
---

<div class="dp-root" data-locale={lang}>
  <section class="dp-panel">
    <div class="dp-controls">
      <label class="dp-ctrl">
        <span class="dp-ctrl-label" data-i18n="degLabel"></span>
        <select class="dp-degree">
          <option value="4" selected>4</option>
          <option value="5">5</option>
          <option value="6">6</option>
          <option value="7">7</option>
          <option value="8">8</option>
          <option value="9">9</option>
          <option value="10">10</option>
        </select>
      </label>
      <label class="dp-ctrl dp-monic">
        <input type="checkbox" class="dp-monic-cb" />
        <span class="dp-ctrl-label" data-i18n="monicLabel"></span>
      </label>
    </div>
  </section>

  <section class="dp-panel">
    <div class="dp-fraction">
      <div class="dp-fraction-inner">
        <div class="dp-row dp-num" aria-label="numeratore"></div>
        <div class="dp-bar"></div>
        <div class="dp-row dp-den" aria-label="denominatore"></div>
      </div>
    </div>

    <p class="dp-hint" data-i18n="inputHint"></p>
    <div class="dp-message" role="status"></div>
  </section>

  <div class="dp-buttons">
    <button type="button" class="dp-btn dp-reset" data-i18n="reset"></button>
    <button type="button" class="dp-btn dp-random" data-i18n="random"></button>
    <button type="button" class="dp-btn dp-quick" data-i18n="quick"></button>
  </div>
  <button type="button" class="dp-btn dp-step-btn" data-i18n="stepByStep"></button>

  <div class="dp-output"></div>
</div>

<script>
  // KaTeX: serve solo l'API JS per il rendering dinamico a runtime.
  // Il CSS e' gia' caricato globalmente dal sito (rehype-katex), non si importa qui.
  import katex from "katex";

  // ==========================================================================
  // MOTORE MATEMATICO (ex engine.ts) — razionali esatti, polinomio nel
  // parametro "a", parser, algoritmo di divisione, analisi del parametro.
  // ==========================================================================
// ============================================================================
//  Motore per la divisione polinomiale con parametro "a"
//  Self-contained: Frac (razionali BigInt) + PolyA (polinomio in "a") +
//  parser + algoritmo di divisione con trace passo-passo + analisi del resto.
//
//  NOTA DI PROGETTO (importante):
//  L'input dei coefficienti e' al piu' LINEARE in "a" (come deciso).
//  Internamente pero' i coefficienti sono polinomi in "a" di grado QUALSIASI:
//  questo perche' moltiplicare un termine simbolico del quoziente per un
//  coefficiente simbolico del divisore puo' generare gradi in "a" > 1.
//  Cosi' l'algoritmo resta SEMPRE esatto, anche con "a" al denominatore.
// ============================================================================

// ----------------------------------------------------------------------------
//  Frac: razionale esatto su BigInt, sempre ridotto, denominatore > 0
// ----------------------------------------------------------------------------
function bgcd(a: bigint, b: bigint): bigint {
  a = a < 0n ? -a : a;
  b = b < 0n ? -b : b;
  while (b) { [a, b] = [b, a % b]; }
  return a;
}

class Frac {
  readonly n: bigint;
  readonly d: bigint;
  constructor(n: bigint, d: bigint = 1n) {
    if (d === 0n) throw new Error("Denominatore nullo in Frac");
    if (d < 0n) { n = -n; d = -d; }
    const g = bgcd(n, d) || 1n;
    this.n = n / g;
    this.d = d / g;
  }
  static zero = new Frac(0n);
  static one = new Frac(1n);
  static fromInt(k: number | bigint) { return new Frac(BigInt(k)); }

  isZero() { return this.n === 0n; }
  sign(): number { return this.n > 0n ? 1 : this.n < 0n ? -1 : 0; }
  neg() { return new Frac(-this.n, this.d); }
  add(o: Frac) { return new Frac(this.n * o.d + o.n * this.d, this.d * o.d); }
  sub(o: Frac) { return new Frac(this.n * o.d - o.n * this.d, this.d * o.d); }
  mul(o: Frac) { return new Frac(this.n * o.n, this.d * o.d); }
  div(o: Frac) {
    if (o.isZero()) throw new Error("Divisione per zero in Frac");
    return new Frac(this.n * o.d, this.d * o.n);
  }
  equals(o: Frac) { return this.n === o.n && this.d === o.d; }

  // LaTeX: intero o \frac{}{}; il segno e' incluso (utile per assorbimento)
  toLatex(): string {
    if (this.d === 1n) return this.n.toString();
    const s = this.n < 0n ? "-" : "";
    const an = this.n < 0n ? -this.n : this.n;
    return `${s}\\frac{${an}}{${this.d}}`;
  }
}

// ----------------------------------------------------------------------------
//  PolyA: polinomio nel parametro "a".  c[i] = coefficiente di a^i
// ----------------------------------------------------------------------------
class PolyA {
  readonly c: Frac[]; // lunghezza >= 1, trimmed (ultimo != 0 salvo il caso zero)
  constructor(coeffs: Frac[]) {
    let arr = coeffs.length ? coeffs.slice() : [Frac.zero];
    while (arr.length > 1 && arr[arr.length - 1].isZero()) arr.pop();
    this.c = arr;
  }
  static zero = new PolyA([Frac.zero]);
  static fromFrac(f: Frac) { return new PolyA([f]); }
  static constInt(k: number) { return new PolyA([Frac.fromInt(k)]); }

  isZero() { return this.c.length === 1 && this.c[0].isZero(); }
  // true se non contiene "a" (grado 0 in a)
  isNumeric() { return this.c.length === 1; }
  asFrac(): Frac { if (!this.isNumeric()) throw new Error("PolyA non numerico"); return this.c[0]; }
  degA() { return this.c.length - 1; }

  neg() { return new PolyA(this.c.map(x => x.neg())); }
  add(o: PolyA) {
    const n = Math.max(this.c.length, o.c.length);
    const r: Frac[] = [];
    for (let i = 0; i < n; i++) r.push((this.c[i] ?? Frac.zero).add(o.c[i] ?? Frac.zero));
    return new PolyA(r);
  }
  sub(o: PolyA) {
    const n = Math.max(this.c.length, o.c.length);
    const r: Frac[] = [];
    for (let i = 0; i < n; i++) r.push((this.c[i] ?? Frac.zero).sub(o.c[i] ?? Frac.zero));
    return new PolyA(r);
  }
  mul(o: PolyA) {
    const r: Frac[] = new Array(this.c.length + o.c.length - 1).fill(Frac.zero);
    for (let i = 0; i < this.c.length; i++)
      for (let j = 0; j < o.c.length; j++)
        r[i + j] = r[i + j].add(this.c[i].mul(o.c[j]));
    return new PolyA(r);
  }
  // divisione per uno scalare numerico (Frac): sempre lecita
  divFrac(f: Frac) { return new PolyA(this.c.map(x => x.div(f))); }

  equals(o: PolyA) {
    if (this.c.length !== o.c.length) return false;
    return this.c.every((x, i) => x.equals(o.c[i]));
  }

  // LaTeX del coefficiente. wrapParen: se true e il termine e' "ambiguo"
  // (simbolico o somma) lo racchiude tra parentesi.
  toLatex(wrapParen = false): string {
    if (this.isZero()) return "0";
    const parts: { s: string; neg: boolean }[] = [];
    // termine di grado piu' alto in "a" per primo, poi giu' fino alla costante
    for (let i = this.c.length - 1; i >= 0; i--) {
      const f = this.c[i];
      if (f.isZero()) continue;
      const neg = f.sign() < 0;
      const abs = neg ? f.neg() : f;
      let body: string;
      const aPow = i === 0 ? "" : i === 1 ? "a" : `a^{${i}}`;
      if (i === 0) {
        body = abs.toLatex();
      } else if (abs.equals(Frac.one)) {
        body = aPow;
      } else {
        body = `${abs.toLatex()}${aPow}`;
      }
      parts.push({ s: body, neg });
    }
    let out = "";
    parts.forEach((p, idx) => {
      if (idx === 0) out += (p.neg ? "-" : "") + p.s;
      else out += (p.neg ? " - " : " + ") + p.s;
    });
    const ambiguous = parts.length > 1 || this.degA() > 0;
    if (wrapParen && ambiguous) return `\\left(${out}\\right)`;
    return out;
  }
}

// ----------------------------------------------------------------------------
//  Parser: testo -> PolyA (input limitato a grado <= 1 in "a")
//  Accetta: interi, frazioni "p/q", "a", "-a", "2a", "a/3", "3a-2", "2-a/2"...
//  Grammatica semplice: somma/differenza di termini; ogni termine e'
//  [coeff][a] dove coeff e' un razionale opzionale e "a" e' opzionale.
// ----------------------------------------------------------------------------
class ParseError extends Error {}

function parseCoeff(raw: string): PolyA {
  const src = raw.trim();
  if (src === "" ) return PolyA.zero;
  let i = 0;
  const s = src.replace(/\s+/g, "");
  let result = PolyA.zero;
  let sign = 1;

  const readNumber = (): Frac | null => {
    const start = i;
    while (i < s.length && /[0-9]/.test(s[i])) i++;
    let den: bigint | null = null;
    let numStr = s.slice(start, i);
    if (i < s.length && s[i] === "/") {
      i++;
      const ds = i;
      while (i < s.length && /[0-9]/.test(s[i])) i++;
      if (i === ds) throw new ParseError(`Denominatore mancante in "${raw}"`);
      den = BigInt(s.slice(ds, i));
      if (numStr === "") throw new ParseError(`Numeratore mancante in "${raw}"`);
    }
    if (numStr === "" && den === null) return null;
    return new Frac(BigInt(numStr || "1"), den ?? 1n);
  };

  // leading sign
  if (s[i] === "+" || s[i] === "-") { sign = s[i] === "-" ? -1 : 1; i++; }

  let first = true;
  while (i < s.length) {
    if (!first) {
      if (s[i] === "+") { sign = 1; i++; }
      else if (s[i] === "-") { sign = -1; i++; }
      else throw new ParseError(`Atteso + o - in "${raw}"`);
    }
    first = false;

    let coeff = readNumber(); // puo' essere null se termine "a" puro
    let hasA = false;
    if (i < s.length && s[i] === "a") {
      hasA = true; i++;
      // possibile "/q" dopo la a, es. a/3
      if (i < s.length && s[i] === "/") {
        i++;
        const ds = i;
        while (i < s.length && /[0-9]/.test(s[i])) i++;
        if (i === ds) throw new ParseError(`Denominatore mancante dopo a/ in "${raw}"`);
        const q = new Frac(1n, BigInt(s.slice(ds, i)));
        coeff = (coeff ?? Frac.one).mul(q);
      }
    }
    if (coeff === null && !hasA) throw new ParseError(`Termine vuoto in "${raw}"`);
    const c = coeff ?? Frac.one;
    const signed = sign === -1 ? c.neg() : c;
    const term = hasA ? new PolyA([Frac.zero, signed]) : new PolyA([signed]);
    result = result.add(term);

    if (i < s.length && s[i] !== "+" && s[i] !== "-")
      throw new ParseError(`Carattere non valido "${s[i]}" in "${raw}"`);
  }
  if (result.degA() > 1) throw new ParseError(`Solo grado 1 in "a" ammesso in input: "${raw}"`);
  return result;
}

// ----------------------------------------------------------------------------
//  Polinomio in x: array di PolyA, indice = grado di x (ascendente).
// ----------------------------------------------------------------------------
type Poly = PolyA[]; // p[i] = coeff di x^i

function polyDeg(p: Poly): number {
  for (let i = p.length - 1; i >= 0; i--) if (!p[i].isZero()) return i;
  return -1; // polinomio nullo
}
function polyIsZero(p: Poly): boolean { return polyDeg(p) === -1; }

// ----------------------------------------------------------------------------
//  Trace della divisione: dati neutri, la colorazione la fa il componente.
// ----------------------------------------------------------------------------
interface ProductRow {
  // prodotto (termine quoziente) x (divisore), per ogni grado di x
  coeffs: Poly;       // gia' allineato sull'asse delle potenze di x
  shiftDeg: number;   // grado di x del termine quoziente che lo genera
}
interface DivStep {
  qTermDeg: number;          // grado di x del termine di quoziente calcolato
  qTerm: PolyA;              // coefficiente del termine di quoziente
  leadRemDeg: number;        // grado direttore del resto corrente a inizio passo
  remBefore: Poly;           // resto prima della sottrazione
  product: Poly;             // riga prodotto (term quoziente x divisore)
  remAfter: Poly;            // resto dopo la sottrazione
  cancelDeg: number;         // grado di x in cui si ottiene lo zero (cancellazione)
}
interface DivResult {
  ok: boolean;
  error?: string;          // messaggio se non eseguibile
  degenerateNote?: PolyA;  // se coeff direttore numeratore e' simbolico: valore di a che lo annulla
  numerator: Poly;         // numeratore come inserito (per richiamare il fratto iniziale per esteso)
  quotient: Poly;
  remainder: Poly;
  steps: DivStep[];
  // monico
  monic: boolean;
  k?: Frac;                // coeff direttore del divisore originale (se monico)
  divisorUsed: Poly;       // divisore effettivamente usato (monico o no)
  divisorOriginal: Poly;
}

// risolve coeff direttore del numeratore simbolico -> valore di a che lo annulla
function rootOfLinear(p: PolyA): PolyA | null {
  // p = c0 + c1 a ; annulla per a = -c0/c1  (se c1 != 0)
  if (p.degA() === 1 && !p.c[1].isZero()) {
    return PolyA.fromFrac(p.c[0].neg().div(p.c[1]));
  }
  return null;
}

function divide(
  numerator: Poly,
  denominator: Poly,
  makeMonic: boolean,
): DivResult {
  const degN = polyDeg(numerator);
  const degDorig = polyDeg(denominator);

  const base: DivResult = {
    ok: false, numerator, quotient: [], remainder: [], steps: [],
    monic: false, divisorUsed: denominator, divisorOriginal: denominator,
  };

  if (degDorig < 0) return { ...base, error: "DENOM_ZERO" };
  if (degN < 0)    return { ...base, error: "NUM_ZERO" };
  if (degN < degDorig) return { ...base, error: "DEG_LOW" };

  // coeff direttore del denominatore: deve essere numerico (vincolo gia' validato a monte)
  const kPoly = denominator[degDorig];
  if (!kPoly.isNumeric())
    return { ...base, error: "DENOM_LEAD_SYMBOLIC" };
  const k = kPoly.asFrac();

  // nota sul caso degenere: coeff direttore del numeratore simbolico
  const degenerateNote = rootOfLinear(numerator[degN]) ?? undefined;

  // costruzione divisore usato (monico opzionale)
  let divisor = denominator.map(x => x); // copia
  let monic = false;
  if (makeMonic && !k.equals(Frac.one)) {
    divisor = denominator.map(x => x.divFrac(k));
    monic = true;
  }
  const degD = polyDeg(divisor);
  const leadD = divisor[degD]; // PolyA numerico

  // algoritmo
  let rem: Poly = numerator.map(x => x);
  const quotient: PolyA[] = new Array(degN - degD + 1).fill(PolyA.zero);
  const steps: DivStep[] = [];

  let curDeg = polyDeg(rem);
  while (curDeg >= degD) {
    const qDeg = curDeg - degD;
    const qTerm = rem[curDeg].divFrac(leadD.asFrac()); // leadD numerico
    quotient[qDeg] = qTerm;

    // riga prodotto: qTerm * divisor, shiftata di qDeg
    const product: Poly = new Array(curDeg + 1).fill(PolyA.zero);
    for (let i = 0; i <= degD; i++) product[i + qDeg] = divisor[i].mul(qTerm);

    const remBefore = rem.map(x => x);
    const remAfter: Poly = new Array(rem.length).fill(PolyA.zero);
    for (let i = 0; i < rem.length; i++)
      remAfter[i] = (rem[i] ?? PolyA.zero).sub(product[i] ?? PolyA.zero);

    steps.push({
      qTermDeg: qDeg, qTerm, leadRemDeg: curDeg,
      remBefore, product, remAfter, cancelDeg: curDeg,
    });

    rem = remAfter;
    const newDeg = polyDeg(rem);
    if (newDeg >= curDeg) break; // salvaguardia anti-loop (non dovrebbe accadere)
    curDeg = newDeg;
  }

  return {
    ok: true,
    degenerateNote,
    numerator,
    quotient,
    remainder: rem,
    steps,
    monic,
    k: monic ? k : undefined,
    divisorUsed: divisor,
    divisorOriginal: denominator,
  };
}

// ----------------------------------------------------------------------------
//  Analisi del parametro: per quali "a" il resto si annulla / abbassa grado.
//  remainder e' Poly (coeff PolyA in "a"). Resto nullo  <=>  ogni coeff = 0
//  come polinomio in "a"  =>  intersezione delle radici.
// ----------------------------------------------------------------------------
interface ParamAnalysis {
  hasParam: boolean;
  vanishes: Frac[] | null; // valori di a per cui R(x) == 0 ; null = nessuno / indeterminato
  vanishNote: string;      // chiave messaggio
  degreeDrops: { aValue: Frac; newDeg: number }[]; // a che abbassano il grado del resto
}

// radici razionali di un PolyA (grado 0,1,2 gestiti; oltre: best effort vuoto)
function rationalRoots(p: PolyA): { roots: Frac[]; all: boolean } {
  if (p.isZero()) return { roots: [], all: true }; // sempre zero
  const deg = p.degA();
  if (deg === 0) return { roots: [], all: false }; // costante non nulla: mai zero
  if (deg === 1) return { roots: [p.c[0].neg().div(p.c[1])], all: false };
  if (deg === 2) {
    const a = p.c[2], b = p.c[1], c = p.c[0];
    const disc = b.mul(b).sub(Frac.fromInt(4).mul(a).mul(c));
    if (disc.sign() < 0) return { roots: [], all: false };
    // sqrt razionale?
    const isqrt = (x: bigint) => { let r = 0n; while (r * r <= x) r++; return r - 1n; };
    const sn = isqrt(disc.n < 0n ? -disc.n : disc.n);
    const sd = isqrt(disc.d);
    if (sn * sn === disc.n && sd * sd === disc.d) {
      const sq = new Frac(sn, sd);
      const r1 = b.neg().add(sq).div(Frac.fromInt(2).mul(a));
      const r2 = b.neg().sub(sq).div(Frac.fromInt(2).mul(a));
      return { roots: r1.equals(r2) ? [r1] : [r1, r2], all: false };
    }
    return { roots: [], all: false }; // radici irrazionali: non elencate
  }
  return { roots: [], all: false };
}

function fracIn(list: Frac[], f: Frac) { return list.some(x => x.equals(f)); }

function analyzeParam(result: DivResult): ParamAnalysis {
  const R = result.remainder;
  const hasParam = R.some(p => !p.isNumeric());
  const out: ParamAnalysis = { hasParam, vanishes: null, vanishNote: "", degreeDrops: [] };
  if (!hasParam) { out.vanishNote = "NO_PARAM"; return out; }

  // resto nullo: ogni coeff (PolyA) = 0 contemporaneamente
  let candidate: Frac[] | null = null; // null = non ancora vincolato
  let impossible = false;
  let always = true;
  for (const coeff of R) {
    const { roots, all } = rationalRoots(coeff);
    if (all) continue;          // questo coeff e' identicamente 0: nessun vincolo
    always = false;
    if (roots.length === 0) { impossible = true; break; } // costante non nulla o radici non razionali
    if (candidate === null) candidate = roots;
    else candidate = candidate.filter(r => fracIn(roots, r)); // intersezione
  }
  if (impossible || (candidate !== null && candidate.length === 0)) {
    out.vanishes = []; out.vanishNote = "NONE";
  } else if (always) {
    out.vanishes = null; out.vanishNote = "ALWAYS"; // resto gia' identicamente nullo
  } else {
    out.vanishes = candidate ?? [];
    out.vanishNote = "SOME";
  }

  // abbassamento di grado: per quali a il coeff direttore del resto si annulla
  const dR = polyDeg(R);
  if (dR >= 0) {
    const lead = R[dR];
    const { roots, all } = rationalRoots(lead);
    if (!all) {
      for (const r of roots) {
        // valuta il nuovo grado sostituendo a = r
        const newDeg = polyDeg(R.map(p => evalA(p, r)));
        out.degreeDrops.push({ aValue: r, newDeg });
      }
    }
  }
  return out;
}

// valuta un PolyA in a = v -> PolyA numerico
function evalA(p: PolyA, v: Frac): PolyA {
  let acc = Frac.zero, pw = Frac.one;
  for (let i = 0; i < p.c.length; i++) { acc = acc.add(p.c[i].mul(pw)); pw = pw.mul(v); }
  return PolyA.fromFrac(acc);
}

  // ==========================================================================
  // LOGICA DI PRESENTAZIONE (ex view.ts) — LaTeX di output e frame narrazione.
  // ==========================================================================
// ============================================================================
//  view.ts — logica di presentazione PURA (niente DOM, niente KaTeX runtime).
//  Produce stringhe LaTeX e il modello dei "frame" per la narrazione.
// ============================================================================

// --- LaTeX di un monomio  coeff · x^power  (per le CELLE della tabella) -------
// Mostra sempre il coefficiente esplicito (anche 0 e 1) col punto di moltipl.
function monomialTex(coeff: PolyA, power: number): string {
  const c = coeff.toLatex(true); // simbolico -> tra parentesi
  if (power === 0) return c;
  const xp = power === 1 ? "x" : `x^{${power}}`;
  return `${c} ${xp}`;
}

// --- LaTeX di un polinomio inline (quoziente, resto, divisore, risultato) -----
// Termini nulli OMESSI. Segno assorbito nell'operatore per termini numerici;
// termini simbolici racchiusi tra parentesi con operatore "+".
function polyTex(p: Poly): string {
  const deg = polyDeg(p);
  if (deg < 0) return "0";
  let out = "";
  let first = true;
  for (let pw = deg; pw >= 0; pw--) {
    const coeff = p[pw];
    if (coeff.isZero()) continue;
    const xp = pw === 0 ? "" : pw === 1 ? "x" : `x^{${pw}}`;
    const dot = pw === 0 ? "" : " ";

    if (coeff.isNumeric()) {
      const f = coeff.asFrac();
      const neg = f.sign() < 0;
      const abs = neg ? f.neg() : f;
      const body = pw !== 0 && abs.equals(Frac.one) ? `${xp}` : `${abs.toLatex()}${dot}${xp}`;
      out += first ? (neg ? "-" : "") + body : (neg ? " - " : " + ") + body;
    } else {
      // simbolico: parentesi, operatore "+" fisso
      const body = `${coeff.toLatex(true)}${dot}${xp}`;
      out += first ? body : " + " + body;
    }
    first = false;
  }
  return out || "0";
}

// risultato completo:  Q(x) + R(x)/D(x)  (con eventuale fattore 1/k se monico)
function resultTex(r: DivResult): string {
  const q = polyTex(r.quotient);
  const remDeg = polyDeg(r.remainder);
  let core: string;
  if (remDeg < 0) {
    core = q; // divisione esatta
  } else {
    const frac = `\\dfrac{${polyTex(r.remainder)}}{${polyTex(r.divisorUsed)}}`;
    core = `${q} + ${frac}`;
  }
  if (r.monic && r.k) {
    return `\\dfrac{1}{${r.k.toLatex()}} \\left[\\, ${core} \\,\\right]`;
  }
  return core;
}

// fratto iniziale per esteso: N(x)/D(x) con i polinomi effettivamente
// inseriti. Quando e' stato richiesto il denominatore monico, il
// denominatore e' mostrato "raccolto" — k volte la sua forma monica —
// cosi' si vede da dove nasce il fattore 1/k che compare nel risultato.
function initialFractionTex(r: DivResult): string {
  const num = polyTex(r.numerator);
  if (r.monic && r.k) {
    return `\\dfrac{1}{${r.k.toLatex()}} \\dfrac{${num}}{${polyTex(r.divisorUsed)}}`;
  }
  return `\\dfrac{${num}}{${polyTex(r.divisorOriginal)}}`;
}

// riga 1 dell'introduzione — SOLO numerica: il fratto cosi' come inserito e,
// se e' stato richiesto il monico, dopo l'uguale la sua versione con k
// raccolto numericamente a denominatore (nessun simbolo astratto qui).
function introNumericLineTex(r: DivResult): string {
  const entered = `\\dfrac{${polyTex(r.numerator)}}{${polyTex(r.divisorOriginal)}}`;
  if (r.monic && r.k) {
    return `${entered} = ${initialFractionTex(r)}`;
  }
  return entered;
}

// riga 2 dell'introduzione — SOLO formale: i passaggi con simboli astratti
// (nessun numero, tranne il valore di k). Nel caso monico usa simboli
// primati D'(x)/Q'(x)/R'(x), per distinguere esplicitamente gli oggetti
// della divisione "vera" — quella per il divisore reso monico — da quelli
// del divisore originale.
//
// FONTE UNICA: questa stessa funzione alimenta anche la riga formale del
// "Risultato" finale (vedi genericFormulaTex, sotto): cosi' inizio e fine
// coincidono SEMPRE nella forma simbolica, per costruzione — non possono
// piu' divergere.
function introFormalLineTex(r: DivResult): string {
  const remDeg = polyDeg(r.remainder);
  if (r.monic && r.k) {
    const kTex = r.k.toLatex();
    const core = remDeg < 0 ? "Q'(x)" : "Q'(x) + \\dfrac{R'(x)}{D'(x)}";
    return `\\dfrac{N(x)}{D(x)} = \\dfrac{1}{${kTex}} \\dfrac{N(x)}{D'(x)} = `
      + `\\dfrac{1}{${kTex}} \\left[\\, ${core} \\,\\right]`;
  }
  const core = remDeg < 0 ? "Q(x)" : "Q(x) + \\dfrac{R(x)}{D(x)}";
  return `\\dfrac{N(x)}{D(x)} = ${core}`;
}

// richiamo della formula generale per il "Risultato" finale: stessa identica
// forma simbolica della riga formale dell'introduzione (vedi sopra).
function genericFormulaTex(r: DivResult): string {
  return introFormalLineTex(r);
}

// ============================================================================
//  Modello dei frame per la narrazione passo-passo
// ============================================================================
interface Cell { tex: string; cls: string; }      // cls: "" | "hl" | "strike" | "zero"
interface Row {
  minus: boolean; arrow: boolean;       // marcatori rossi nel gutter sinistro
  markerCls: string;                    // "" | "hl"
  cells: (Cell | null)[];               // indicizzate per potenza 0..topDeg
}
interface Frame {
  captionKey: string;
  vars: Record<string, string>;
  topDeg: number;
  rows: Row[];
  divisorTex: string;
  divisorHl: boolean;
  quotientTex: string;     // puo' contenere \textcolor per il termine nuovo
  showRule: boolean;
}

const RED = "#d11111";
function colorTex(tex: string) { return `\\textcolor{${RED}}{${tex}}`; }

function emptyRow(topDeg: number): Row {
  return { minus: false, arrow: false, markerCls: "", cells: new Array(topDeg + 1).fill(null) };
}

// riga numeratore: TUTTI i termini espliciti dal grado effettivo a 0.
// I monomi a coefficiente nullo sono in grigio tenue e restano SEMPRE visibili
// (servono a tenere allineate le colonne). monomialTex produce il monomio
// completo "0 x^k", non il solo "0".
function numeratorRow(num: Poly, topDeg: number, hlLead: boolean): Row {
  const row = emptyRow(topDeg);
  for (let pw = 0; pw <= topDeg; pw++) {
    const coeff = num[pw] ?? PolyA.zero;
    let cls = "";
    if (hlLead && pw === topDeg) cls = "hl";
    else if (coeff.isZero()) cls = "zero-faint";
    row.cells[pw] = { tex: monomialTex(coeff, pw), cls };
  }
  return row;
}

// riga prodotto: dallo span [cancelDeg .. cancelDeg-degD].
// I termini del prodotto a coefficiente nullo sono in grigio tenue (come i
// monomi nulli del numeratore); spariranno dopo che si e' fatta la differenza.
// Con fillZerosBelow anche le posizioni SOTTO lo span (sempre nulle per
// costruzione) sono esplicitate come monomi completi grigi "0 x^k".
function productRow(step: DivStep, topDeg: number, degD: number, opts: {strikeLead?: boolean; minusArrow?: boolean; markerHl?: boolean; fillZerosBelow?: boolean}): Row {
  const row = emptyRow(topDeg);
  const top = step.cancelDeg;
  for (let pw = top; pw >= top - degD; pw--) {
    if (pw < 0) break;
    let cls = "";
    if (step.product[pw].isZero()) cls = "zero-faint";
    if (opts.strikeLead && pw === top) cls = "strike";
    row.cells[pw] = { tex: monomialTex(step.product[pw], pw), cls };
  }
  if (opts.minusArrow) { row.minus = true; row.arrow = true; row.markerCls = opts.markerHl ? "hl" : ""; }
  if (opts.fillZerosBelow) {
    for (let pw = top - degD - 1; pw >= 0; pw--) {
      row.cells[pw] = { tex: monomialTex(PolyA.zero, pw), cls: "zero-faint" };
    }
  }
  return row;
}

// riga resto dopo sottrazione: da cancelDeg a 0.
// - in cancelDeg: lo zero di cancellazione, monomio ROSSO "0 x^k" (solo se zeroRed)
// - tra il nuovo termine direttore e cancelDeg (ESCLUSI): "zona vuota", sempre
//   zero per costruzione (il grado e' sceso di piu' di 1). Stessa vita dello
//   zero rosso: visibile (in grigio) SOLO nel frame che introduce la
//   differenza, eliminata subito dopo — MAI con la vita lunga dei grigi
//   interni (non e' un coefficiente del nuovo resto, e' un effetto collaterale
//   della cancellazione, "a sinistra" del nuovo termine direttore).
// - dal nuovo termine direttore in giu': i termini veri del resto; quelli a
//   coefficiente nullo sono monomi grigi tenui PERSISTENTI, da eliminare al
//   termine della differenza successiva (o prima della consegna, se e' il
//   resto finale): con dropFaintZeros=true le posizioni nulle restano vuote.
// - CASO SPECIALE — resto identicamente nullo (divisione esatta, l'ultimo
//   passo): senza correzione, la versione consolidata (zeroRed=false)
//   ricadrebbe TUTTA in "zona vuota" e la riga sparirebbe del tutto (nessuna
//   cella). Forziamo invece uno zero NEUTRO (nessun colore) in colonna delle
//   unita', cosi' resta un riferimento sia per il confronto dei gradi nel
//   passo successivo, sia per la consegna finale (dove restera' semplicemente
//   nero, non essendo mai colorato qui).
function remainderRow(step: DivStep, topDeg: number, opts: {zeroRed?: boolean; hlLead?: boolean; dropFaintZeros?: boolean}): Row {
  const row = emptyRow(topDeg);
  const top = step.cancelDeg;
  const newLeadDeg = polyDeg(step.remAfter);
  for (let pw = top; pw >= 0; pw--) {
    if (pw === top) {
      // zero di cancellazione: monomio rosso, mostrato solo nel frame che lo introduce
      if (opts.zeroRed) row.cells[pw] = { tex: monomialTex(PolyA.zero, pw), cls: "zero" };
    } else if (pw > newLeadDeg) {
      // zona vuota: stessa vita dello zero rosso, mai persistente
      if (opts.zeroRed) row.cells[pw] = { tex: monomialTex(PolyA.zero, pw), cls: "zero-faint" };
    } else {
      const val = step.remAfter[pw] ?? PolyA.zero;
      if (val.isZero()) {
        // monomio nullo interno (sotto il nuovo direttore): grigio persistente,
        // salvo che vada eliminato (dropFaintZeros)
        if (!opts.dropFaintZeros) row.cells[pw] = { tex: monomialTex(val, pw), cls: "zero-faint" };
      } else {
        const cls = opts.hlLead && pw === newLeadDeg ? "hl" : "";
        row.cells[pw] = { tex: monomialTex(val, pw), cls };
      }
    }
  }
  if (newLeadDeg < 0 && !opts.zeroRed) {
    row.cells[0] = { tex: monomialTex(PolyA.zero, 0), cls: "" };
  }
  return row;
}

// termine del quoziente colorato in rosso (con operatore corretto)
function colorWrapTerm(coeff: PolyA, pw: number, first: boolean): string {
  const xp = pw === 0 ? "" : pw === 1 ? "x" : `x^{${pw}}`;
  const dot = pw === 0 ? "" : " ";
  let inner: string;
  let op = "";
  if (coeff.isNumeric()) {
    const f = coeff.asFrac(); const neg = f.sign() < 0; const abs = neg ? f.neg() : f;
    inner = pw !== 0 && abs.equals(Frac.one) ? xp : `${abs.toLatex()}${dot}${xp}`;
    op = first ? (neg ? "-" : "") : (neg ? " - " : " + ");
  } else {
    inner = `${coeff.toLatex(true)}${dot}${xp}`;
    op = first ? "" : " + ";
  }
  return colorTex(op + inner);
}

// quoziente "pulito" (senza colore) coi termini introdotti dai primi (count)
// PASSI dell'algoritmo. Usa il grado REALE di ciascun passo (r.steps[i].qTermDeg),
// MAI "qDegMax - i": i gradi del quoziente non sono necessariamente consecutivi
// (un passo puo' saltare piu' di un grado se il resto scende di piu' di 1 — la
// stessa "zona vuota" che si vede nella riga del resto). Se non c'e' ancora
// nessun termine (count=0) resta VUOTO, non "0": stessa convenzione gia' usata
// per le posizioni sotto il numeratore.
function quotientClean(r: DivResult, count: number): string {
  if (count === 0) return "";
  const sub: Poly = new Array(r.quotient.length).fill(PolyA.zero);
  for (let i = 0; i < count; i++) {
    const pw = r.steps[i].qTermDeg;
    sub[pw] = r.quotient[pw];
  }
  return polyTex(sub);
}

// quoziente coi termini dei primi (count) passi, l'ultimo (passo count-1) in
// rosso. Stessa correzione: grado reale di ciascun passo, non "qDegMax - i".
function quotientWithRed(r: DivResult, count: number): string {
  let out = ""; let first = true;
  for (let i = 0; i < count; i++) {
    const pw = r.steps[i].qTermDeg;
    const coeff = r.quotient[pw];
    const isLast = i === count - 1;
    out += isLast ? colorWrapTerm(coeff, pw, first) : plainTerm(coeff, pw, first);
    first = false;
  }
  return out || "\\;";
}
function plainTerm(coeff: PolyA, pw: number, first: boolean): string {
  const xp = pw === 0 ? "" : pw === 1 ? "x" : `x^{${pw}}`;
  const dot = pw === 0 ? "" : " ";
  if (coeff.isNumeric()) {
    const f = coeff.asFrac(); const neg = f.sign() < 0; const abs = neg ? f.neg() : f;
    const inner = pw !== 0 && abs.equals(Frac.one) ? xp : `${abs.toLatex()}${dot}${xp}`;
    return (first ? (neg ? "-" : "") : (neg ? " - " : " + ")) + inner;
  }
  return (first ? "" : " + ") + `${coeff.toLatex(true)}${dot}${xp}`;
}

// LaTeX del divisore con SOLO il termine direttore in rosso (per il passo
// "divido i due direttori": qui non deve essere rosso TUTTO il divisore,
// solo il termine che entra davvero nel calcolo).
function divisorTexLeadRed(p: Poly): string {
  const deg = polyDeg(p);
  if (deg < 0) return "0";
  let out = ""; let first = true;
  for (let pw = deg; pw >= 0; pw--) {
    const coeff = p[pw];
    if (coeff.isZero()) continue;
    out += (pw === deg) ? colorWrapTerm(coeff, pw, first) : plainTerm(coeff, pw, first);
    first = false;
  }
  return out || "0";
}

// ----------------------------------------------------------------------------
//  buildFrames: genera l'intera sequenza dei frame della narrazione.
//  Ogni ciclo del quoziente produce 4 frame (3 sotto-passi + confronto gradi).
// ----------------------------------------------------------------------------
function buildFrames(r: DivResult): Frame[] {
  const frames: Frame[] = [];
  const numerator = r.steps.length ? r.steps[0].remBefore : [];
  const topDeg = polyDeg(numerator);
  const divisor = r.divisorUsed;
  const degD = polyDeg(divisor);
  const divTex = polyTex(divisor);

  // righe "consolidate" accumulate man mano. La riga del resto di ciascun
  // ciclo conserva i suoi monomi nulli grigi per tutto il ciclo SUCCESSIVO
  // (F1-F2-F3-F4), perche' resta il riferimento su cui si esegue quella
  // differenza: vengono eliminati solo al "compimento" di quella differenza,
  // cioe' nella consolidazione subito dopo F3 del ciclo successivo (o prima
  // della consegna finale, se non c'e' un ciclo successivo). Teniamo quindi
  // un riferimento all'ultima riga-resto consolidata per "ripulirla"
  // (sostituirla con la versione senza grigi) al momento giusto.
  const settled: Row[] = [numeratorRow(numerator, topDeg, false)];
  let lastRemainderInfo: { index: number; step: DivStep } | null = null;

  // ripulisce la riga-resto del ciclo precedente dai monomi nulli grigi
  function dropPreviousRemainderFaints() {
    if (!lastRemainderInfo) return;
    settled[lastRemainderInfo.index] =
      remainderRow(lastRemainderInfo.step, topDeg, { zeroRed: false, dropFaintZeros: true });
    lastRemainderInfo = null;
  }

  r.steps.forEach((step, idx) => {
    // F1: si divide il direttore del resto per quello del divisore e si
    // scrive SUBITO il nuovo termine del quoziente, in nero (quotientClean
    // con idx+1 include gia' il termine appena trovato, senza colore).
    {
      const rows = settled.map(cloneRow);
      const last = rows[rows.length - 1];
      last.cells[step.leadRemDeg] && (last.cells[step.leadRemDeg]!.cls = "hl");
      frames.push({
        captionKey: "f1_divide", vars: {
          lead: monomialTex(step.remBefore[step.leadRemDeg], step.leadRemDeg),
          dlead: monomialTex(divisor[degD], degD),
          q: monomialTex(step.qTerm, step.qTermDeg),
        },
        topDeg, rows, divisorTex: divisorTexLeadRed(divisor), divisorHl: false,
        quotientTex: quotientClean(r, idx + 1), showRule: true,
      });
    }

    // F2: si moltiplica il quoziente per il divisore e si scrivono i prodotti
    // sotto il resto corrente (riga prodotto mostrata qui). Il termine nuovo
    // del quoziente e il divisore sono in rosso; i monomi nulli del prodotto
    // sono grigi.
    {
      const rows = settled.map(cloneRow);
      rows.push(productRow(step, topDeg, degD, { fillZerosBelow: true }));
      frames.push({
        captionKey: "f2_multiply", vars: { q: monomialTex(step.qTerm, step.qTermDeg) },
        topDeg, rows, divisorTex: divTex, divisorHl: true,
        quotientTex: quotientWithRed(r, idx + 1), showRule: true,
      });
    }

    // F3: sottrazione colonna per colonna — minus+freccia rossi, direttori
    // barrati, zero rosso. Quoziente di nuovo in nero.
    {
      const rows = settled.map(cloneRow);
      const above = rows[rows.length - 1];
      if (above.cells[step.cancelDeg]) above.cells[step.cancelDeg]!.cls = "strike";
      rows.push(productRow(step, topDeg, degD, { strikeLead: true, minusArrow: true, markerHl: true, fillZerosBelow: true }));
      rows.push(remainderRow(step, topDeg, { zeroRed: true }));
      frames.push({
        captionKey: "f3_subtract", vars: {},
        topDeg, rows, divisorTex: divTex, divisorHl: false,
        quotientTex: quotientClean(r, idx + 1), showRule: true,
      });
    }

    // Consolidamento. A questo punto la differenza del ciclo corrente e'
    // "compiuta" (F3 e' terminato): e' il momento giusto per eliminare i
    // monomi nulli grigi della riga-resto del ciclo PRECEDENTE, che fino a
    // qui sono rimasti visibili (servivano nei passaggi F1-F3 appena fatti).
    dropPreviousRemainderFaints();

    // La riga PRODOTTO, dopo la differenza, perde anch'essa i suoi monomi
    // nulli grigi (niente fillZerosBelow, niente grigi nello span): restano
    // solo i termini effettivi. La riga RESTO appena calcolata conserva i
    // grigi (verranno tolti dal ciclo successivo, o prima della consegna
    // se e' l'ultima).
    const prodSettled = productRow(step, topDeg, degD, {});
    // il prodotto consolidato NON mostra i termini nulli (i grigi spariscono
    // dopo la differenza): le relative celle tornano vuote.
    prodSettled.cells = prodSettled.cells.map(c => (c && c.cls === "zero-faint") ? null : c);
    settled.push(prodSettled);

    const remRow = remainderRow(step, topDeg, { zeroRed: false });
    settled.push(remRow);
    lastRemainderInfo = { index: settled.length - 1, step };

    // F5: confronto gradi — direttore nuovo resto in rosso, confrontato col
    // SOLO direttore del divisore (non tutto il divisore: e' un confronto di
    // gradi, stessa natura di F1, non una moltiplicazione per l'intero divisore)
    {
      const rows = settled.map(cloneRow);
      const last = rows[rows.length - 1];
      const newDeg = polyDeg(step.remAfter);
      if (newDeg >= 0 && last.cells[newDeg]) {
        last.cells[newDeg]!.cls = "hl";
      } else if (newDeg < 0 && last.cells[0]) {
        // resto identicamente nullo: lo zero forzato (gia' presente in colonna
        // delle unita' grazie a remainderRow) fa da "direttore" per il confronto
        last.cells[0]!.cls = "hl";
      }
      const continues = newDeg >= degD && idx < r.steps.length - 1;
      frames.push({
        captionKey: continues ? "f5_continue" : "f5_stop", vars: {
          rdeg: String(Math.max(newDeg, 0)), ddeg: String(degD),
        },
        topDeg, rows, divisorTex: divisorTexLeadRed(divisor), divisorHl: false,
        quotientTex: quotientClean(r, idx + 1), showRule: true,
      });
    }
  });

  // Prima della consegna: il resto finale perde i suoi monomi nulli grigi.
  dropPreviousRemainderFaints();

  // Frame finale: tabella completa, ma senza alcuna evidenziazione rossa — il
  // risultato vero e proprio viene gia' mostrato, enfatizzato, subito dopo
  // (riga "Risultato"): ripeterlo in rosso qui sarebbe ridondante. Se la
  // divisione e' risultata esatta (resto nullo), lo segnaliamo esplicitamente
  // nella didascalia.
  {
    const rows = settled.map(cloneRow);
    const isExact = polyDeg(r.remainder) < 0;
    frames.push({
      captionKey: isExact ? "f_final_exact" : "f_final", vars: {},
      topDeg, rows, divisorTex: divTex, divisorHl: false,
      quotientTex: quotientClean(r, r.steps.length), showRule: true,
    });
  }
  return frames;
}

function cloneRow(row: Row): Row {
  return { minus: row.minus, arrow: row.arrow, markerCls: row.markerCls,
    cells: row.cells.map(c => c ? { tex: c.tex, cls: c.cls } : null) };
}

// board "veloce": un solo frame consolidato con Q e R in rosso (per risultato veloce)
function buildQuickBoard(r: DivResult): Frame {
  const all = buildFrames(r);
  return all[all.length - 1];
}
















