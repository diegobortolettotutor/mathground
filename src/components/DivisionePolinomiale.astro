  /* zeri di completamento (posizioni vuote sotto lo span del prodotto):
     un dettaglio discreto, non un risultato del calcolo come lo zero rosso. */
  .dp-cell.zero-faint { color: var(--dp-faint); font-weight: 400; opacity: 0.75; }
  .dp-cell.strike { position: relative; }
