    // heightPx: altezza reale che la parentesi deve coprire (l'altezza della griglia).
    // widthPx: spessore della parentesi, legato al font-size (non all'altezza), come
    // fa KaTeX stesso (0.875em fisso) — così resta sottile anche su matrici molto alte.
    function gjParenSvg(side, heightPx, widthPx) {
      const k = widthPx / PAREN_VBW; // px per unità viewBox
      let viewBoxHeight = Math.round(heightPx / k);
      let midHeight = viewBoxHeight - PAREN_CAP_HEIGHT;
      if (midHeight < 0) midHeight = 0; // griglia più bassa del minimo: parentesi minima
      viewBoxHeight = PAREN_CAP_HEIGHT + midHeight;
      const renderedHeight = viewBoxHeight * k;
      const d = side === 'l' ? gjLparenPath(midHeight) : gjRparenPath(midHeight);
      const w = widthPx.toFixed(2), h = renderedHeight.toFixed(2);
      // WebKit/iOS: quando un <svg> è figlio di un contenitore flex (qui .gj-paren
      // è inline-flex), Safari ne calcola la larghezza intrinseca a 0px se le
      // dimensioni arrivano SOLO dagli attributi di presentazione, e la parentesi
      // non viene disegnata affatto (problema documentato, es. CSS-Tricks "6 Common
      // SVG Fails"). Rimedio: ribadiamo width/height anche via style inline e
      // fissiamo flex:0 0 auto perché il flexbox non possa comprimerla a zero.
      // L'!important sulle dimensioni inline serve a battere eventuali regole CSS
      // globali del tema (Starlight applica stili al contenuto, p.es. su 'svg'):
      // lo style inline con !important ha precedenza su qualunque foglio di stile.
      // preserveAspectRatio="none" è sicuro qui: l'aspetto del viewBox combacia
      // per costruzione con quello del box (entrambi derivati da k), quindi non
      // introduce alcuna distorsione, ma garantisce il riempimento esatto.
      const style = `display:block !important;flex:0 0 auto;`
        + `width:${w}px !important;height:${h}px !important;`
        + `max-width:none !important;opacity:1 !important;visibility:visible !important`;
      return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${PAREN_VBW} ${viewBoxHeight}" width="${w}" height="${h}" preserveAspectRatio="none" style="${style}" aria-hidden="true"><path d="${d}" fill="currentColor"/></svg>`;
    }

    const parenL = root.querySelector('.gj-paren-l');
    const parenR = root.querySelector('.gj-paren-r');
    function fitBrackets(tries) {
      tries = tries || 0;
      requestAnimationFrame(() => {
        const grid = tdTabea.querySelector('.gj-grid');
        // Se la griglia non è ancora misurabile (KaTeX delle intestazioni ancora in
        // rendering, layout non assestato) la sua altezza può valere 0 al primo
        // frame: in quel caso riproviamo al frame successivo invece di rinunciare
        // in silenzio lasciando le parentesi vuote.
        if (!grid || grid.getBoundingClientRect().height <= 0) {
          if (tries < 12) fitBrackets(tries + 1);
          return;
        }
        const G = grid.getBoundingClientRect().height;
        // Larghezza: stessa convenzione di KaTeX, 0.875em, dove "em" è il
        // font-size ereditato da .gj-paren — così la parentesi resta coerente
        // con le altre parentesi KaTeX della pagina (risultati, label).
        const fontSizePx = parseFloat(getComputedStyle(parenL).fontSize) || 16;
        const widthPx = fontSizePx * 0.875;
        parenL.innerHTML = gjParenSvg('l', G, widthPx);
        parenR.innerHTML = gjParenSvg('r', G, widthPx);
      });
    }

    function lisoform(IDcella) {
      const r = parseInt(IDcella.slice(6, 8));
      const c = parseInt(IDcella.slice(9, 11));
      const limiteCar = 15;
      const elem = root.querySelector('#' + IDcella);
      if (elem.value.length >= limiteCar) {
        elem.value = '0';
        nerdamer.setVar('valsMAT', 'matset(valsMAT,' + r + ',' + c + ',0)');
        tip(L.errTooLong(limiteCar));
      } else if (!vaBen(elem)) {
        elem.value = '0';
        nerdamer.setVar('valsMAT', 'matset(valsMAT,' + r + ',' + c + ',0)');
        tip(L.errForbidden);
      } else {
        try {
          const espressione = nerdamer.simplify(elem.value);
          nerdamer.setVar('valsMAT', 'matset(valsMAT,' + r + ',' + c + ',' + espressione.expand() + ')');
          elem.value = espressione.expand();
          unTip();
        } catch (err) {
          elem.value = '0';
          tip(err.toString());
        }
      }
    }

    function vaBen(elem) {
      const str = elem.value;
      if (str === '') return false;
      let tmp = 0, strMejo = '', verdetto = true;
      for (let i = 0; i < str.length; i++) {
        tmp = str.charCodeAt(i);
        if (((tmp > 39) & (tmp < 58)) | ((tmp > 64) & (tmp < 69)) | ((tmp > 69) & (tmp < 73)) | ((tmp > 73) & (tmp < 91)) | ((tmp > 96) & (tmp < 101)) | ((tmp > 101) & (tmp < 105)) | ((tmp > 105) & (tmp < 123)) | ((tmp == 94) | (tmp == 32))) {
          if (tmp == 44) strMejo += '.';
          else strMejo += String.fromCharCode(tmp);
        } else verdetto = false;
      }
      elem.value = strMejo;
      return verdetto;
    }

    function buildRandMat() {
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const rStr = String(r).padStart(2, '0');
          const cStr = String(c).padStart(2, '0');
          const idInput = 'campoR' + rStr + 'C' + cStr;
          const node = buildRandNum();
          nerdamer.setVar('valsMAT', 'matset(valsMAT,' + r + ',' + c + ',' + node.expand() + ')');
          root.querySelector('#' + idInput).value = node.text('fractions');
        }
      }
    }
    function buildRandNum() {
      const sign = '((-1)^' + (Math.floor(Math.random() * 10) + 1) + ')';
      const temp = sign + Math.floor(Math.random() * 15);
      let randNUM = nerdamer.simplify(temp);
      if ((randNUM >= 10) | (randNUM <= -10)) randNUM = nerdamer(0);
      return randNUM;
    }

    // ---------------------------------------------------- matrice -> LaTeX
    function mat2Tex() {
      strLatex += '\\begin{pmatrix}';
      if (vuiRC.checked) strLatex += '&';
      if (vuiRC.checked) {
        for (let c = 0; c < cols - 1; c++) strLatex += '\\small \\mathscr{C}_{' + (c + 1) + '}&';
        strLatex += '\\small \\mathscr{C}_{' + cols + '}\\\\[9pt]';
      }
      for (let r = 0; r < rows - 1; r++) {
        if (vuiRC.checked) strLatex += '\\small \\mathscr{R}_{' + (r + 1) + '}&';
        for (let c = 0; c < cols - 1; c++) {
          strTemp1 = 'matget(pivsMATcopy,' + r + ',' + c + ')';
          strTemp2 = 'matget(valsMATcopy,' + r + ',' + c + ')';
          strTemp4 = '{\\displaystyle ' + neta(nerdamer(strTemp2).toTeX()) + '}';
          if ((nerdamer(strTemp1).toString() == 1) && vuiPivot.checked) strLatex += '\\boxed{' + strTemp4 + '} &';
          else strLatex += strTemp4 + '&';
        }
        strTemp1 = 'matget(pivsMATcopy,' + r + ',' + (cols - 1) + ')';
        strTemp2 = 'matget(valsMATcopy,' + r + ',' + (cols - 1) + ')';
        strTemp4 = '{\\displaystyle ' + neta(nerdamer(strTemp2).toTeX()) + '}';
        if ((nerdamer(strTemp1).toString() == 1) && vuiPivot.checked) strLatex += '\\boxed{' + strTemp4 + '} \\\\[9pt]';
        else strLatex += strTemp4 + '\\\\[9pt]';
      }
      if (vuiRC.checked) strLatex += '\\small \\mathscr{R}_{' + rows + '}&';
      for (let c = 0; c < cols - 1; c++) {
        strTemp1 = 'matget(pivsMATcopy,' + (rows - 1) + ',' + c + ')';
        strTemp2 = 'matget(valsMATcopy,' + (rows - 1) + ',' + c + ')';
        strTemp4 = '{\\displaystyle ' + neta(nerdamer(strTemp2).toTeX()) + '}';
        if ((nerdamer(strTemp1).toString() == 1) && vuiPivot.checked) strLatex += '\\boxed{' + strTemp4 + '} &';
        else strLatex += strTemp4 + '&';
      }
      strTemp1 = 'matget(pivsMATcopy,' + (rows - 1) + ',' + (cols - 1) + ')';
      strTemp2 = 'matget(valsMATcopy,' + (rows - 1) + ',' + (cols - 1) + ')';
      strTemp4 = '{\\displaystyle ' + neta(nerdamer(strTemp2).toTeX()) + '}';
      if ((nerdamer(strTemp1).toString() == 1) && vuiPivot.checked) strLatex += '\\boxed{' + strTemp4 + '} \\end{pmatrix}';
      else strLatex += strTemp4 + '\\end{pmatrix}';
    }

    function mat2TexPost_KRpre(Ktex, riga) {
      strLatexPost += '\\begin{matrix} ';
      strLatexPost += '\\left(' + neta(Ktex) + '\\right) \\cdot \\mspace{3mu} \\mathscr{R}_{' + (riga + 1) + '_{' + SB + '}} \\quad & = & \\quad ';
      for (let c = 0; c < cols; c++) {
        strTemp4 = neta(nerdamer('matget(valsMATcopy,' + riga + ',' + c + ')').toTeX());
        if (c < cols - 1) strLatexPost += strTemp4 + '\\cdot \\left(' + neta(Ktex) + '\\right)&\\quad ';
        else strLatexPost += '\\mspace{17mu}' + strTemp4 + '\\cdot \\left(' + neta(Ktex) + '\\right)\\quad\\\\';
      }
      strLatexPost += '&&';
      for (let c = 0; c < cols; c++) strLatexPost += (c < cols - 1) ? ' \\mspace{13mu}\\downarrow&' : '\\mspace{13mu}\\downarrow\\\\';
    }
    function mat2TexPost_KRpost(Ktex, riga) {
      strLatexPost += '\\mathscr{R}_{' + (riga + 1) + '_{' + SA + '}} \\; = \\enspace \\left(' + neta(Ktex) + '\\right) \\cdot \\mspace{3mu} \\mathscr{R}_{' + (riga + 1) + '_{' + SB + '}} \\quad & = & \\quad ';
      for (let c = 0; c < cols; c++) {
        strTemp4 = neta(nerdamer('matget(valsMATcopy,' + riga + ',' + c + ')').toTeX());
        if (c < cols - 1) strLatexPost += strTemp4 + '&\\quad ';
        else strLatexPost += strTemp4 + '\\end{matrix}';
      }
    }
    function mat2TexPost_R1KR2pre(Ktex, riga1, riga2) {
      strLatexPost += '\\begin{matrix} ';
      strLatexPost += '\\mathscr{R}_{' + (riga1 + 1) + '_{' + SB + '}} \\quad & = & \\quad ';
      for (let c = 0; c < cols; c++) {
        strTemp4 = neta(nerdamer('matget(valsMATcopy,' + riga1 + ',' + c + ')').toTeX());
        strLatexPost += (c < cols - 1) ? strTemp4 + '&\\quad ' : strTemp4 + '\\\\';
      }
      strLatexPost += '+&&';
      for (let c = 0; c < cols; c++) strLatexPost += (c < cols - 1) ? ' \\mspace{17mu}+&' : '\\mspace{17mu}+\\\\';
      strLatexPost += '\\left(' + neta(Ktex) + '\\right) \\cdot \\mspace{3mu} \\mathscr{R}_{' + (riga2 + 1) + '_{' + SB + '}} \\quad & = & \\quad ';
      for (let c = 0; c < cols; c++) {
        strTemp4 = neta(nerdamer('matget(valsMATcopy,' + riga2 + ',' + c + ')').toTeX());
        if (c < cols - 1) strLatexPost += strTemp4 + '\\cdot\\left(' + neta(Ktex) + '\\right)&\\quad ';
        else strLatexPost += '\\mspace{17mu}' + strTemp4 + '\\cdot\\left(' + neta(Ktex) + '\\right)\\quad\\\\';
      }
      strLatexPost += '\\downarrow&&';
      for (let c = 0; c < cols; c++) strLatexPost += (c < cols - 1) ? ' \\mspace{13mu}\\downarrow&' : '\\mspace{13mu}\\downarrow\\\\';
    }
    function mat2TexPost_R1KR2post(Ktex, riga1, riga2) {
      strLatexPost += '\\mathscr{R}_{' + (riga1 + 1) + '_{' + SA + '}} \\; = \\enspace \\left(\\mathscr{R}_{' + (riga1 + 1) + '_{' + SB + '}} + \\left(' + neta(Ktex) + '\\right) \\cdot \\mspace{3mu} \\mathscr{R}_{' + (riga2 + 1) + '_{' + SB + '}}\\right) \\quad & = & \\quad ';
      for (let c = 0; c < cols; c++) {
        strTemp4 = neta(nerdamer('matget(valsMATcopy,' + riga1 + ',' + c + ')').toTeX());
        if (c < cols - 1) strLatexPost += strTemp4 + '&\\quad ';
        else strLatexPost += strTemp4 + '\\end{matrix}';
      }
    }
    function mat2TexPost_R1R2pre(riga1, riga2) {
      strLatexPost += '\\begin{matrix} ';
      strLatexPost += '\\mathscr{R}_{' + (riga1 + 1) + '_{' + SB + '}} \\quad & = & \\quad ';
      for (let c = 0; c < cols; c++) {
        strTemp4 = neta(nerdamer('matget(valsMATcopy,' + riga1 + ',' + c + ')').toTeX());
        strLatexPost += (c < cols - 1) ? strTemp4 + '&\\quad ' : strTemp4 + '\\\\';
      }
      strLatexPost += '+&&';
      for (let c = 0; c < cols; c++) strLatexPost += (c < cols - 1) ? ' \\mspace{17mu}+&' : '\\mspace{17mu}+\\\\';
      strLatexPost += '\\mathscr{R}_{' + (riga2 + 1) + '_{' + SB + '}} \\quad & = & \\quad ';
      for (let c = 0; c < cols; c++) {
        strTemp4 = neta(nerdamer('matget(valsMATcopy,' + riga2 + ',' + c + ')').toTeX());
        if (c < cols - 1) strLatexPost += strTemp4 + '&\\quad ';
        else strLatexPost += '\\mspace{17mu}' + strTemp4 + '\\quad\\\\';
      }
      strLatexPost += '\\downarrow&&';
      for (let c = 0; c < cols; c++) strLatexPost += (c < cols - 1) ? ' \\mspace{13mu}\\downarrow&' : '\\mspace{13mu}\\downarrow\\\\';
    }
    function mat2TexPost_R1R2post(riga1, riga2) {
      strLatexPost += '\\mathscr{R}_{' + (riga1 + 1) + '_{' + SA + '}} \\; = \\enspace \\left(\\mathscr{R}_{' + (riga1 + 1) + '_{' + SB + '}} + \\mathscr{R}_{' + (riga2 + 1) + '_{' + SB + '}}\\right) \\quad & = & \\quad ';
      for (let c = 0; c < cols; c++) {
        strTemp4 = neta(nerdamer('matget(valsMATcopy,' + riga1 + ',' + c + ')').toTeX());
        if (c < cols - 1) strLatexPost += strTemp4 + '&\\quad ';
        else strLatexPost += strTemp4 + '\\end{matrix}';
      }
    }

    function neta(s) { return s.replace(/\\cdot/g, '\\mspace{2mu}'); }

    // ----------------------------------------------------------- visualizzazione
    function pushView(target) {
      const parag = document.createElement('div');
      parag.className = 'gj-text';
      parag.innerHTML = strHTML.replace(/\\mspace/g, '\\mkern');
      target.appendChild(parag);
      renderInline(parag);
      if (strLatex !== '') {
        const wrap = document.createElement('div');
        wrap.className = 'gj-katex';
        wrap.innerHTML = renderKatexBlock(strLatex);
        target.appendChild(wrap);
        strLatex = '';
        if (strLatexPost !== '') {
          const conti = document.createElement('div');
          conti.className = 'gj-conti';
          conti.innerHTML = renderKatexBlock(strLatexPost);
          target.appendChild(conti);
          strLatexPost = '';
        }
      }
      strHTML = '';
    }
    function showMat() { pushView(robe); }
    function showMatSvelto() { pushView(robeSvelte); strLatexPost = ''; }

    // ------------------------------------------------------------ utilità nerdamer
    function annotaPivot(r, c) { nerdamer.setVar('pivsMATcopy', 'matset(pivsMATcopy,' + r + ',' + c + ',1)'); }
    function matriceNulla() {
      for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++)
        if (!nerdamer('matget(valsMATcopy,' + r + ',' + c + ')').eq(0)) return false;
      return true;
    }
    function subRigaNulla(nRiga, ci, cf) {
      for (let c = ci; c <= cf; c++) if (!nerdamer('matget(valsMATcopy,' + nRiga + ',' + c + ')').eq(0)) return false;
      return true;
    }
    function subColonnaNulla(nCol, ri, rf) {
      for (let r = ri; r <= rf; r++) if (!nerdamer('matget(valsMATcopy,' + r + ',' + nCol + ')').eq(0)) return false;
      return true;
    }
    function elemNullo(r, c) { return nerdamer('matget(valsMATcopy,' + r + ',' + c + ')').eq(0); }
    function elemNormalizzato(r, c) { return nerdamer('matget(valsMATcopy,' + r + ',' + c + ')').eq(1); }
    function elemAntiNormalizzato(r, c) { return nerdamer('matget(valsMATcopy,' + r + ',' + c + ')').eq(-1); }
    function sumRowsByK(riga1, kappa, riga2, colPiv) {
      for (let c = colPiv; c < cols; c++) {
        const a = nerdamer('matget(valsMATcopy,' + riga1 + ',' + c + ')');
        const b = nerdamer('matget(valsMATcopy,' + riga2 + ',' + c + ')');
        const prod = nerdamer.simplify(nerdamer.simplify(kappa).multiply(nerdamer.simplify(b)));
        const res = nerdamer.simplify(prod.add(nerdamer.simplify(a)));
        nerdamer.setVar('valsMATcopy', 'matset(valsMATcopy,' + riga1 + ',' + c + ',' + res + ')');
      }
    }
    function switchRows(riga1, riga2) {
      for (let c = 0; c < cols; c++) {
        const a = nerdamer('matget(valsMATcopy,' + riga1 + ',' + c + ')');
        const b = nerdamer('matget(valsMATcopy,' + riga2 + ',' + c + ')');
        nerdamer.setVar('valsMATcopy', 'matset(valsMATcopy,' + riga1 + ',' + c + ',' + b + ')');
        nerdamer.setVar('valsMATcopy', 'matset(valsMATcopy,' + riga2 + ',' + c + ',' + a + ')');
      }
    }
    function rowMultK(riga, kappa) {
      for (let c = 0; c < cols; c++) {
        const a = nerdamer('matget(valsMATcopy,' + riga + ',' + c + ')');
        if (!a.eq(0)) {
          const res = nerdamer.simplify(a).multiply(nerdamer.simplify(kappa));
          nerdamer.setVar('valsMATcopy', 'matset(valsMATcopy,' + riga + ',' + c + ',' + res + ')');
        }
      }
    }
    function rowNorm(rigaPiv, colPiv) { rowMultK(rigaPiv, creaKappaNorm(rigaPiv, colPiv)); }
    function copiaMat() {
      for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
        nerdamer.setVar('valsMATcopy', 'matset(valsMATcopy,' + r + ',' + c + ',' + nerdamer('matget(valsMAT,' + r + ',' + c + ')') + ')');
        nerdamer.setVar('pivsMATcopy', 'matset(pivsMATcopy,' + r + ',' + c + ',' + nerdamer('matget(pivsMAT,' + r + ',' + c + ')') + ')');
      }
    }
    function creaKappa(riga, rigaPiv, colP) {
      const a = nerdamer('matget(valsMATcopy,' + riga + ',' + colP + ')');
      const b = nerdamer('matget(valsMATcopy,' + rigaPiv + ',' + colP + ')');
      return nerdamer.simplify(a.divide(b).multiply(-1)).text('fractions');
    }
    function creaKappaTex(riga, rigaPiv, colP) {
      const a = nerdamer('matget(valsMATcopy,' + riga + ',' + colP + ')');
      const b = nerdamer('matget(valsMATcopy,' + rigaPiv + ',' + colP + ')');
      return nerdamer.simplify(a.divide(b).multiply(-1)).toTeX();
    }
    function creaKappaNorm(rigaP, colP) {
      const b = nerdamer('matget(valsMATcopy,' + rigaP + ',' + colP + ')');
      return nerdamer.simplify(nerdamer('1').divide(b)).text('fractions');
    }
    function creaKappaNormTex(rigaP, colP) {
      const b = nerdamer('matget(valsMATcopy,' + rigaP + ',' + colP + ')');
      return nerdamer.simplify(nerdamer('1').divide(b)).toTeX();
    }
    function getMatElemTex(r, c) { return nerdamer('matget(valsMATcopy,' + r + ',' + c + ')').toTeX(); }
    function getOppostoMatElemTex(r, c) { return nerdamer('matget(valsMATcopy,' + r + ',' + c + ')').multiply('-1').toTeX(); }

    // ============================================================= Gauss-Jordan
    function elabora() {
      copiaMat();
      strSotto = vuiConti.checked ? L.arrowBA : '';
      strHTML = '<h2>' + (daidai ? L.titleQuick : L.titleStep) + '</h2>';
      strHTML += '<p>' + L.inputIs + '</p>';
      strLatex = 'A =';
      mat2Tex();
      daidai ? showMatSvelto() : showMat();

      if (matriceNulla()) { // ---------------------------------- matrice nulla
        strHTML = L.nullMatrix;
        strLatex = L.aRef + ' \\; = \\; ' + L.aRref + ' \\; = \\;';
        mat2Tex();
        daidai ? showMatSvelto() : showMat();
      }
      else if (rows == 1) { // --------------------------------- una sola riga
        let posPivC;
        for (let c = 0; c < cols; c++) if (!elemNullo(0, c)) { posPivC = c; break; }
        annotaPivot(0, posPivC);
        strHTML = L.srIntro(getMatElemTex(0, posPivC), posPivC);
        strLatex = L.aRef + ' =';
        mat2Tex();
        daidai ? showMatSvelto() : showMat();
        if (!elemNormalizzato(0, posPivC)) {
          strHTML = L.srNorm(creaKappaNormTex(0, posPivC));
          mat2Tex();
          let strTemp;
          if (vuiConti.checked) { strTemp = creaKappaNormTex(0, posPivC); mat2TexPost_KRpre(strTemp, 0); }
          strLatex += '\\xrightarrow[' + strSotto + ']{\\mathscr{R}_{1} \\; = \\; \\left(' + creaKappaNormTex(0, posPivC) + '\\right)  \\cdot  \\mspace{3mu} \\mathscr{R}_{1}}';
          rowNorm(0, posPivC);
          mat2Tex();
          if (vuiConti.checked) mat2TexPost_KRpost(strTemp, 0);
          showMat();
          strHTML = L.srAfterNorm(posPivC);
        } else {
          strHTML = L.srAlready(posPivC);
        }
        strLatex = L.aRref + ' =';
        mat2Tex();
        if (daidai) { strHTML = L.srQuick(posPivC); showMatSvelto(); } else showMat();
      }
      else if (cols == 1) { // -------------------------------- una sola colonna
        strHTML = L.splitIntro + L.gaussHead + L.gaussSub + L.movesIntro;
        strHTML += '<ul>' + L.moveSwap + L.moveMult + L.moveAdd + '</ul>';
        strHTML += L.scOnlySwap + '<ul>' + L.moveSwap + '</ul>' + L.scReason;

        // Trova il primo elemento non nullo partendo dall'alto
        let firstNzRow = 0;
        for (let r = 0; r < rows; r++) { if (!elemNullo(r, 0)) { firstNzRow = r; break; } }

        // Se la prima riga è nulla, scambia con la prima riga non nulla trovata
        let scambioFatto = false;
        if (firstNzRow > 0) {
          strHTML += L.scFirstIsZero;
          mat2Tex();
          strLatex += '\\xrightarrow[' + strSotto + ']{\\mathscr{R}_{' + (firstNzRow + 1) + '} \\; \\rightleftharpoons \\; \\mathscr{R}_{1}}';
          strHTML += L.scSwapDo(firstNzRow, 0);
          switchRows(0, firstNzRow);
          mat2Tex();
          showMat(); // resetta strHTML e strLatex
          scambioFatto = true;
        }
        // Il pivot è ora sempre in riga 0
        annotaPivot(0, 0);
        // Annunciamo il pivot: "già" se non c'è stato scambio, "ora" dopo lo swap
        if (!scambioFatto) strHTML += L.scPivotHere(getMatElemTex(0, 0));
        else strHTML += L.scPivotNow(getMatElemTex(0, 0));

        // Azzera tutte le righe sotto il pivot con R_i = 0 * R_i
        // (incondizionato: non si verifica se siano già nulle)
        let zerataFatto = false;
        if (rows > 1) {
          const anyNzBelow = (() => { for (let r = 1; r < rows; r++) if (!elemNullo(r, 0)) return true; return false; })();
          if (anyNzBelow) {
            strHTML += L.zeroBelow;
            mat2Tex();
            if (rows === 2) {
              strLatex += '\\xrightarrow[' + strSotto + ']{\\mathscr{R}_{2} \\; = \\; 0 \\cdot \\mathscr{R}_{2}}';
            } else {
              strLatex += '\\xrightarrow[' + strSotto + ']{\\mathscr{R}_{2, \\mspace{3mu} \\ldots \\mspace{3mu} , \\mspace{1mu}' + rows + '} \\; = \\; 0}';
            }
            zerataFatto = true;
          }
          for (let r = 1; r < rows; r++) rowMultK(r, 0);
          if (zerataFatto) { mat2Tex(); showMat(); }
        }

        // Annuncio conclusione Gauss (REF)
        if (scambioFatto || zerataFatto) {
          strHTML += '<p>' + L.scNow;
        } else if (rows === 1) {
          strHTML += '<p>' + L.scAlready2;
        } else {
          // nessuno scambio e nessun azzeramento: primo elem non nullo, resto già zero
          strHTML += L.scNoSwapLower + '<p>' + L.scAlready;
        }
        strHTML += L.scEchelon(getMatElemTex(0, 0), 0);
        strLatex = L.aRef + ' =';
        mat2Tex();
        if (daidai) { strHTML = L.scQuickEch(getMatElemTex(0, 0), 0); showMatSvelto(); } else showMat();

        // ---- PARTE JORDAN (invariata, posPivR = 0 sempre) ----
        const posPivR = 0;
        strHTML = L.jordanHead + L.jordanSub;
        let pivUnitario = false, pivPolePos = false;
        if (!elemNormalizzato(posPivR, 0)) {
          strHTML += L.scNormFirst + L.scNormMult(creaKappaNormTex(posPivR, 0), posPivR);
          mat2Tex();
          let strTemp;
          if (vuiConti.checked) { strTemp = creaKappaNormTex(posPivR, 0); mat2TexPost_KRpre(strTemp, posPivR); }
          strLatex += '\\xrightarrow[' + strSotto + ']{\\mathscr{R}_{' + (posPivR + 1) + '} \\; = \\; \\left(' + creaKappaNormTex(posPivR, 0) + '\\right) \\cdot \\mspace{3mu} \\mathscr{R}_{' + (posPivR + 1) + '}}';
          rowMultK(posPivR, creaKappaNorm(posPivR, 0));
          mat2Tex();
          if (vuiConti.checked) { strTemp = creaKappaNormTex(posPivR, 0); mat2TexPost_KRpost(strTemp, posPivR); }
          showMat();
        } else {
          strHTML += L.scAlreadyUnit;
          pivUnitario = true;
        }
        // posPivR == 0 sempre: non ci sono righe sopra da azzerare
        strHTML += L.scNoRowsAbove;
        pivPolePos = true;
        if (pivUnitario) {
          strHTML += L.scFinAlready;
        } else {
          strHTML += L.scFinMade;
        }
        strLatex = L.aRref + ' =';
        mat2Tex();
        if (daidai) { strHTML = L.scQuickFin(posPivR); showMatSvelto(); } else showMat();
      }
      else { // ---------------------- più di una riga e più di una colonna
        strHTML = L.splitIntro + L.gaussHead + L.gaussSub + L.movesIntro;
        strHTML += '<ul>' + L.moveSwap + L.moveMult + L.moveAdd + '</ul>';
        strHTML += L.gcTip1 + L.gcTipBox + L.gcTip2 + L.gcTip2move;
        let lastRow = rows - 1, lastCol = cols - 1, procRow = 0, procCol = 0, pivRow = 0;
        while ((procCol <= lastCol) & (pivRow <= lastRow)) {
          if (pivRow <= lastRow) {
            strHTML += L.analyzeCol(procCol);
            if (subColonnaNulla(procCol, pivRow, lastRow)) {
              strHTML += (pivRow == 0) ? L.gcNoPivAllNull : L.gcNoPivBelow;
              pivRow--;
            } else if (elemNullo(pivRow, procCol)) {
              for (procRow = pivRow + 1; procRow <= lastRow; procRow++) {
                if (!elemNullo(procRow, procCol)) {
                  strHTML += (pivRow == 0)
                    ? L.gcSwap0(getMatElemTex(procRow, procCol), procRow, pivRow)
                    : L.gcSwapBelow(getMatElemTex(procRow, procCol), procRow, pivRow);
                  mat2Tex();
                  switchRows(pivRow, procRow);
                  strLatex += '\\xrightarrow{\\mathscr{R}_{' + (procRow + 1) + '} \\; \\rightleftharpoons \\; \\mathscr{R}_{' + (pivRow + 1) + '}}';
                  annotaPivot(pivRow, procCol);
                  mat2Tex();
                  showMat();
                  break;
                }
              }
            } else {
              annotaPivot(pivRow, procCol);
              strHTML += (pivRow == 0)
                ? L.gcHere0(getMatElemTex(pivRow, procCol), pivRow)
                : L.gcHereBelow(getMatElemTex(pivRow, procCol), pivRow);
            }
          }
          let almenoUno = 0;
          for (procRow = pivRow + 1; procRow < lastRow + 1; procRow++) {
            if (!elemNullo(procRow, procCol)) {
              almenoUno++;
              if (almenoUno == 1) strHTML += L.zeroBelow;
              mat2Tex();
              const strTemp = creaKappaTex(procRow, pivRow, procCol);
              if (vuiConti.checked) mat2TexPost_R1KR2pre(strTemp, procRow, pivRow);
              strHTML += L.gcZeroElem(getMatElemTex(procRow, procCol), procRow, procCol, pivRow, creaKappaTex(procRow, pivRow, procCol));
              strLatex += '\\xrightarrow[' + strSotto + ']{\\mathscr{R}_{' + (procRow + 1) + '} \\; = \\; \\mathscr{R}_{' + (procRow + 1) + '} \\mspace{2mu} + \\mspace{3mu} \\left(' + creaKappaTex(procRow, pivRow, procCol) + '\\right) \\cdot \\mspace{3mu} \\mathscr{R}_{' + (pivRow + 1) + '}}';
              sumRowsByK(procRow, creaKappa(procRow, pivRow, procCol), pivRow, procCol);
              mat2Tex();
              if (vuiConti.checked) mat2TexPost_R1KR2post(strTemp, procRow, pivRow);
              showMat();
            }
          }
          procCol++; pivRow++;
          if (strHTML != '') { mat2Tex(); showMat(); }
        }
        strLatex = L.aRef + ' =';
        mat2Tex();
        strHTML = L.refResult;
        daidai ? showMatSvelto() : showMat();

        strHTML = L.jordanHead + L.jordanSub + L.jordanFree + L.jordanGoal;
        procCol = cols - 1;
        pivRow = pivRow - 1;
        while (pivRow > -1) {
          if ((pivRow == 0) & (!elemNullo(0, 0))) {
            procCol = 0;
          } else {
            for (let i = procCol - 1; i > -1; i--) {
              if (subRigaNulla(pivRow, 0, i)) { procCol = i + 1; break; }
            }
          }
          strHTML += L.analyzeCol(procCol);
          let strTemp = 1;
          if (!elemNormalizzato(pivRow, procCol)) {
            mat2Tex();
            if (vuiConti.checked) { strTemp = creaKappaNormTex(pivRow, procCol); mat2TexPost_KRpre(strTemp, pivRow); }
            strHTML += L.gcNormPivot(procCol, creaKappaNormTex(pivRow, procCol), pivRow);
            strLatex += '\\xrightarrow[' + strSotto + ']{\\mathscr{R}_{' + (pivRow + 1) + '} \\; = \\; \\left(' + creaKappaNormTex(pivRow, procCol) + '\\right) \\cdot \\mspace{3mu} \\mathscr{R}_{' + (pivRow + 1) + '}}';
            rowNorm(pivRow, procCol);
          }
          mat2Tex();
          if (vuiConti.checked && strTemp != 1) mat2TexPost_KRpost(strTemp, pivRow);
          showMat();
          if (pivRow > 0) {
            for (let procRow2 = pivRow - 1; procRow2 > -1; procRow2--) {
              if (!elemNullo(procRow2, procCol)) {
                mat2Tex();
                if (!elemAntiNormalizzato(procRow2, procCol)) {
                  if (vuiConti.checked) { strTemp = creaKappaTex(procRow2, pivRow, procCol); mat2TexPost_R1KR2pre(strTemp, procRow2, pivRow); strSotto = L.arrowBA; }
                  strHTML = L.gcZeroAboveOpp(getMatElemTex(procRow2, procCol), procRow2, procCol, pivRow, getOppostoMatElemTex(procRow2, procCol));
                  strLatex += '\\xrightarrow[' + strSotto + ']{\\mathscr{R}_{' + (procRow2 + 1) + '} \\; = \\; \\mathscr{R}_{' + (procRow2 + 1) + '} \\mspace{2mu} + \\mspace{3mu} \\left(' + getOppostoMatElemTex(procRow2, procCol) + '\\right) \\cdot \\mspace{3mu} \\mathscr{R}_{' + (pivRow + 1) + '}}';
                  sumRowsByK(procRow2, creaKappa(procRow2, pivRow, procCol), pivRow, procCol);
                  mat2Tex();
                  if (vuiConti.checked) mat2TexPost_R1KR2post(strTemp, procRow2, pivRow);
                } else {
                  if (vuiConti.checked) { strTemp = creaKappaTex(procRow2, pivRow, procCol); mat2TexPost_R1R2pre(procRow2, pivRow); strSotto = L.arrowBA; }
                  strHTML = L.gcZeroAboveSimple(getMatElemTex(procRow2, procCol), procRow2, procCol, pivRow);
                  strLatex += '\\xrightarrow[' + strSotto + ']{\\mathscr{R}_{' + (procRow2 + 1) + '} \\; = \\; \\mathscr{R}_{' + (procRow2 + 1) + '} \\mspace{2mu} + \\mspace{3mu} \\mathscr{R}_{' + (pivRow + 1) + '}}';
                  sumRowsByK(procRow2, creaKappa(procRow2, pivRow, procCol), pivRow, procCol);
                  mat2Tex();
                  if (vuiConti.checked) mat2TexPost_R1R2post(procRow2, pivRow);
                }
                showMat();
              }
            }
          }
          pivRow--; procCol--;
        }
        strLatex = L.aRref + ' =';
        mat2Tex();
        strHTML = L.rrefResult;
        daidai ? showMatSvelto() : showMat();
      }

      const active = daidai ? robeSvelte : robe;
      const other = daidai ? robe : robeSvelte;
      hide(other);
      reveal(active);
    }

    // -------------------------------------------------------------- interazioni
    let gjRandomUsed = false;
    function gjParamsUsed() {
      let found = false;
      tdTabea.querySelectorAll('.gj-matrix-cell').forEach((el) => {
        if (/[a-zA-Z]/.test(el.value)) found = true;
      });
      return found;
    }
    function gjTrack(mode) {
      if (window.umami) {
        umami.track('gaussjordan-solve', { mode, rows, cols, randomUsed: gjRandomUsed, paramsUsed: gjParamsUsed() });
      }
    }
    function clearResults() {
      robe.innerHTML = ''; robeSvelte.innerHTML = '';
      hide(robe); hide(robeSvelte);
    }
    function rimodea() { showTabea(); clearResults(); gjRandomUsed = false; }
    function tikigna() {
      strSotto = vuiConti.checked ? L.arrowBA : '';
      if (robe.innerHTML !== '' || robeSvelte.innerHTML !== '') {
        robe.innerHTML = ''; robeSvelte.innerHTML = '';
        elabora();
      }
    }

    inRows.addEventListener('input', rimodea);
    inCols.addEventListener('input', rimodea);
    vuiPivot.addEventListener('change', tikigna);
    vuiRC.addEventListener('change', tikigna);
    vuiConti.addEventListener('change', tikigna);

    // Si allarga solo la cella in focus; le altre della colonna restano strette e
    // si ANIMANO (allargamento/restringimento) entrando/uscendo dal focus.
    // La larghezza della COLONNA e ancorata dall'intestazione (gj-col-wide, min-width
    // fissa): mentre le celle si animano, la colonna NON si muove. Il focusout e
    // rimandato e annullato dal focusin successivo, cosi cambiando cella nella stessa
    // colonna l'intestazione non si disancora mai (niente accenno di restringimento).
    let blurTimer = null;
    function setFocus(cell) {
      const col = cell ? cell.dataset.col : null;
      tdTabea.querySelectorAll('.gj-matrix-cell').forEach((el) => {
        el.classList.toggle('gj-cell-wide', el === cell);
      });
      tdTabea.querySelectorAll('.gj-colhead[data-col]').forEach((th) => {
        th.classList.toggle('gj-col-wide', col !== null && th.dataset.col === col);
      });
    }
    tdTabea.addEventListener('focusin', (e) => {
      if (e.target.classList && e.target.classList.contains('gj-matrix-cell')) {
        if (blurTimer) { clearTimeout(blurTimer); blurTimer = null; }
        setFocus(e.target);
      }
    });
    tdTabea.addEventListener('focusout', () => {
      // rimando: se subito dopo arriva un focusin nella griglia (cambio cella),
      // il timer viene annullato e la colonna non si restringe nemmeno per un istante.
      if (blurTimer) clearTimeout(blurTimer);
      blurTimer = setTimeout(() => { setFocus(null); blurTimer = null; }, 0);
    });

    root.querySelector('#gjBtnReset').addEventListener('click', () => { showTabea(); clearResults(); unTip(); gjRandomUsed = false; });
    root.querySelector('#gjBtnRandom').addEventListener('click', () => { buildRandMat(); clearResults(); unTip(); gjRandomUsed = true; });
    root.querySelector('#gjBtnQuick').addEventListener('click', () => {
      clearResults(); daidai = true; elabora(); gjTrack('quick');
    });
    root.querySelector('#gjBtnStep').addEventListener('click', () => {
      clearResults(); daidai = false; elabora(); gjTrack('steps');
    });

    // ------------------------------------------------------------- avvio
    showTabea();              // crea e renderizza la griglia delle celle
    renderInline(root);       // renderizza tutto il math statico restante (label, toggle, A=)
    fitBrackets();            // riadatta le parentesi a layout assestato
    window.addEventListener('resize', fitBrackets);
  }
</script>