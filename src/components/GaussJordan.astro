---
/**
 * GaussJordan.astro — Risolutore Gauss-Jordan nativo, responsive, bilingue (it/en).
 *
 * Dipendenze (una sola volta nel progetto):
 *   npm install nerdamer katex
 *
 * Uso in una pagina .mdx di Starlight:
 *   import GaussJordan from '../../../components/GaussJordan.astro';
 *   <GaussJordan />
 *
 * Note:
 *  - Il rendering matematico usa KaTeX (niente MathJax, niente conflitti col sito).
 *  - nerdamer resta il motore simbolico (frazioni esatte, celle con lettere).
 *  - Pensato per UNA istanza per pagina (nerdamer tiene le matrici in variabili globali).
 */

// Il CSS di KaTeX: se il sito lo carica già via rehype-katex puoi togliere questa riga.
import 'katex/dist/katex.min.css';

// Rilevo la lingua come negli altri tuoi componenti bilingui.
const lang = (Astro.currentLocale ?? 'it').toLowerCase().startsWith('en') ? 'en' : 'it';

// Etichette statiche dell'interfaccia (lato server).
const UI = {
  it: {
    title: 'Algoritmo di Gauss-Jordan',
    subtitle: 'Riduzione (semplice/ridotta) di una matrice in forma a scala',
    step1: 'Step 1 — IMPOSTA LE DIMENSIONI DELLA MATRICE',
    rowsLabel: 'Righe \\(\\left(\\mathscr{R}\\right)\\)',
    colsLabel: 'Colonne \\(\\left(\\mathscr{C}\\right)\\)',
    step2: 'Step 2 — IMPOSTA IL CONTENUTO DELLE CELLE',
    btnReset: 'AZZERA VALORI',
    btnRandom: 'VALORI CASUALI',
    btnQuick: 'RISULTATO SINTETICO',
    btnStep: 'SVOLGIMENTO PASSO-PASSO',
    togglePivot: 'Mostra i pivot nello svolgimento',
    toggleRC: 'Mostra \\(\\mathscr{R}_m\\) e \\(\\mathscr{C}_n\\) nello svolgimento',
    toggleConti: 'Mostra i conti sulle righe nello svolgimento',
  },
  en: {
    title: 'Gauss-Jordan Algorithm',
    subtitle: 'Row reduction (echelon / reduced echelon) of a matrix',
    step1: 'Step 1 — SET THE MATRIX DIMENSIONS',
    rowsLabel: 'Rows \\(\\left(\\mathscr{R}\\right)\\)',
    colsLabel: 'Columns \\(\\left(\\mathscr{C}\\right)\\)',
    step2: 'Step 2 — SET THE MATRIX CELL CONTENTS',
    btnReset: 'RESET VALUES',
    btnRandom: 'RANDOM VALUES',
    btnQuick: 'QUICK RESULT',
    btnStep: 'STEP-BY-STEP SOLUTION',
    togglePivot: 'Show pivots in the solution',
    toggleRC: 'Show \\(\\mathscr{R}_m\\) and \\(\\mathscr{C}_n\\) in the solution',
    toggleConti: 'Show row computations in the solution',
  },
}[lang];
---

<div class="gj-root" data-lang={lang}>
  <!-- Step 1: dimensioni -->
  <section class="gj-panel">
    <h3 class="gj-steplabel">{UI.step1}</h3>
    <div class="gj-dims" id="gjDims">
      <label for="gjRows" set:html={UI.rowsLabel}></label>
      <input id="gjRows" type="number" min="1" max="6" value="3" />
      <span class="gj-times">\(\large\times\)</span>
      <input id="gjCols" type="number" min="1" max="12" value="4" />
      <label for="gjCols" set:html={UI.colsLabel}></label>
    </div>
  </section>

  <!-- Step 2: contenuto celle -->
  <section class="gj-panel">
    <h3 class="gj-steplabel">{UI.step2}</h3>
    <div class="gj-matrixwrap" id="gjMatrixWrap">
      <div class="gj-matrix">
        <span id="gjThA" class="gj-a">\(A=\)</span>
        <span class="gj-paren gj-paren-l" aria-hidden="true"></span>
        <div id="gjTd" class="gj-gridhost"></div>
        <span class="gj-paren gj-paren-r" aria-hidden="true"></span>
      </div>
    </div>
    <div id="gjStatus" class="gj-status" role="alert" aria-live="polite"></div>
  </section>

  <!-- Azioni -->
  <div class="gj-actions">
    <button id="gjBtnReset" class="gj-btn gj-btn-ghost" type="button">{UI.btnReset}</button>
    <button id="gjBtnRandom" class="gj-btn gj-btn-ghost" type="button">{UI.btnRandom}</button>
    <button id="gjBtnQuick" class="gj-btn gj-btn-ghost" type="button">{UI.btnQuick}</button>
  </div>

  <div class="gj-secondary">
    <button id="gjBtnStep" class="gj-btn gj-btn-ghost gj-btn-wide" type="button">{UI.btnStep}</button>
    <ul class="gj-toggles">
      <li>
        <label class="gj-switch">
          <input type="checkbox" id="gjPivot" checked />
          <span class="gj-slider"></span>
        </label>
        <span set:html={UI.togglePivot}></span>
      </li>
      <li>
        <label class="gj-switch">
          <input type="checkbox" id="gjRC" checked />
          <span class="gj-slider"></span>
        </label>
        <span set:html={UI.toggleRC}></span>
      </li>
      <li>
        <label class="gj-switch">
          <input type="checkbox" id="gjConti" />
          <span class="gj-slider"></span>
        </label>
        <span set:html={UI.toggleConti}></span>
      </li>
    </ul>
  </div>

  <!-- Output -->
  <section id="gjQuick" class="gj-result" hidden></section>
  <section id="gjFull" class="gj-result" hidden></section>
</div>

<style is:global>
  .gj-root {
    --gj-radius: 12px;
    --gj-surface: var(--sl-color-gray-6, #1a1a1a);
    --gj-border: var(--sl-color-gray-5, #383838);
    --gj-accent: var(--sl-color-accent, #4f7cff);
    --gj-accent-hi: var(--sl-color-accent-high, #b8c8ff);
    --gj-red: #d11111;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--sl-color-text, inherit);
    width: 100%;
    min-width: 330px;
    margin: 1.5rem 0;
    text-align: center;
  }
  .gj-root *,
  .gj-root *::before,
  .gj-root *::after { box-sizing: border-box; }

  .gj-panel {
    background: var(--gj-surface);
    border: 1px solid var(--gj-border);
    border-radius: var(--gj-radius);
    padding: 1.25rem 1rem;
    margin: 1.25rem 0;
  }
  .gj-steplabel {
    margin: 0 0 1rem;
    font-size: clamp(0.85rem, 2.4vw, 1rem);
    letter-spacing: 0.02em;
    color: var(--sl-color-text-accent, var(--gj-accent-hi));
  }

  /* dimensioni */
  .gj-dims { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 1.2rem; }
  .gj-dims label { font-size: 1rem; }
  .gj-dims input,
  .gj-matrix-cell {
    background: var(--sl-color-bg, #000);
    color: var(--sl-color-text, #fff);
    border: 1.5px solid var(--gj-border);
    border-radius: 6px;
    text-align: center;
    padding: 0.35rem;
    font: inherit;
  }
  .gj-dims input { width: 4rem; }
  .gj-dims input:hover {
    border-color: var(--gj-accent);
    background: color-mix(in srgb, var(--gj-accent) 10%, var(--sl-color-bg, #000));
  }
  .gj-dims input:focus,
  .gj-matrix-cell:focus { border-color: var(--gj-accent); outline: none; }
  .gj-dims input { transition: background-color 0.15s ease, border-color 0.15s ease; }
  .gj-times { font-size: 1.3rem; }

  /* matrice di input */
  .gj-matrixwrap { overflow-x: auto; padding: 0.5rem 0.25rem; }
  .gj-matrix { display: inline-flex; align-items: center; justify-content: center; gap: 0.15rem; min-width: 100%; }
  .gj-gridhost { display: inline-block; }

  /* A = e parentesi */
  .gj-a { display: inline-flex; align-items: center; padding-right: 0.3rem; }
  .gj-paren { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; line-height: 0; color: var(--sl-color-text, inherit); }
  .gj-paren svg { display: block; }

  /* azzero gli stili tabella iniettati da Starlight (bordi/righe grigie/zebra) */
  .gj-root .gj-grid {
    display: table !important;
    width: auto !important;
    margin: 0;
    border: 0 !important;
    border-collapse: collapse;
    background: transparent !important;
    box-shadow: none !important;
  }
  .gj-root .gj-grid :is(thead, tbody, tr, th, td) {
    border: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
  }
  .gj-root .gj-grid td { padding: 2px 3px; text-align: center; vertical-align: middle; }
  .gj-root .gj-grid th.gj-colhead {
    padding: 0 0 0.15rem; font-size: 0.75rem; font-weight: 400;
    text-align: center; vertical-align: bottom;
    color: var(--sl-color-text-accent, var(--gj-accent-hi));
    min-width: 3.25rem;
    transition: min-width 0.35s ease-in-out;
  }
  .gj-root .gj-grid th.gj-colhead.gj-col-wide { min-width: 7rem; }
  .gj-root .gj-grid th.gj-rowhead {
    padding: 0 0.4rem; font-size: 0.75rem; font-weight: 400;
    text-align: center; vertical-align: middle;
    color: var(--sl-color-text-accent, var(--gj-accent-hi));
  }

  /* celle: compatte, evidenziate all'hover, allargate per l'intera colonna attiva */
  .gj-matrix-cell {
    width: 3.25rem; padding: 0.18rem 0.3rem; margin: 0;
    transition: width 0.35s ease-in-out, background-color 0.15s ease, border-color 0.15s ease;
  }
  .gj-matrix-cell:hover {
    border-color: var(--gj-accent);
    background: color-mix(in srgb, var(--gj-accent) 10%, var(--sl-color-bg, #000));
  }
  .gj-matrix-cell:focus {
    border-color: var(--gj-accent);
    background: color-mix(in srgb, var(--gj-accent) 16%, var(--sl-color-bg, #000));
  }
  .gj-matrix-cell.gj-cell-wide { width: 7rem; }

  .gj-status { margin: 0.5rem 0; font-size: 0.95rem; }
  .gj-status.gj-error {
    padding: 0.6rem 0.8rem;
    border-left: 4px solid var(--gj-red);
    background: color-mix(in srgb, var(--gj-red) 8%, transparent);
    border-radius: 4px;
  }

  /* pulsanti */
  .gj-actions {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem; align-items: stretch; margin: 1.25rem auto; max-width: 48rem;
  }
  .gj-actions .gj-btn {
    box-sizing: border-box; width: 100%; margin: 0;
    height: 3.6rem; padding: 0 1rem; line-height: 1.2;
    display: inline-flex; align-items: center; justify-content: center; text-align: center;
  }
  .gj-secondary { margin-top: 1.25rem; }
  .gj-btn {
    font: inherit; font-weight: 600; cursor: pointer;
    border-radius: 999px; padding: 0.7rem 1.4rem; border: 1.5px solid transparent;
    transition: transform 0.1s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .gj-btn:active { transform: scale(0.96); }
  .gj-btn-primary, .gj-btn-accent { background: var(--gj-accent); color: var(--sl-color-white, #fff); }
  .gj-btn-primary:hover, .gj-btn-accent:hover { background: var(--sl-color-accent-high, var(--gj-accent)); }
  .gj-btn-ghost { background: transparent; color: var(--sl-color-text, inherit); border-color: var(--gj-border); }
  .gj-btn-ghost:hover { border-color: var(--gj-accent); color: var(--gj-accent); }
  .gj-btn-wide { padding: 0.9rem 1.4rem; width: 100%; margin: 0 0 1rem; }

  /* toggle switch */
  .gj-toggles { list-style: none; margin: 1.5rem auto 0; padding: 0; max-width: 28rem; }
  .gj-toggles li { display: flex; align-items: center; gap: 0.8rem; text-align: left; padding: 0.5rem 0; }
  .gj-switch { position: relative; display: inline-block; width: 46px; height: 26px; flex: 0 0 auto; }
  .gj-switch input { opacity: 0; width: 0; height: 0; }
  .gj-slider {
    position: absolute; inset: 0; cursor: pointer; border-radius: 26px;
    background: transparent; border: 1.5px solid var(--gj-border); transition: 0.3s;
  }
  .gj-slider::before {
    content: ''; position: absolute; height: 18px; width: 18px; left: 2px; top: 50%;
    background: var(--gj-border); border-radius: 50%; transition: 0.3s; transform: translateY(-50%);
  }
  .gj-switch input:checked + .gj-slider { background: transparent; border-color: var(--sl-color-text, #888); }
  .gj-switch input:checked + .gj-slider::before { transform: translate(20px, -50%); background: var(--sl-color-text, #888); }

  /* output */
  .gj-result {
    background: var(--gj-surface); border: 1px solid var(--gj-border);
    border-radius: var(--gj-radius); margin-top: 1.5rem; padding: 1.5rem 1rem;
    opacity: 0; transition: opacity 0.3s ease; text-align: left;
  }
  .gj-result.gj-visible { opacity: 1; }
  .gj-result h2 { text-align: center; }
  .gj-result h3 { margin-top: 2.5rem; color: var(--gj-accent); }
  .gj-result h4 { margin-top: 0.25rem; }
  .gj-result h5 {
    margin: 2.5rem 0 1rem; padding-top: 1rem;
    font-size: 0.95rem; letter-spacing: 0.03em; color: var(--sl-color-text-accent, var(--gj-accent-hi));
  }
  .gj-result ul { margin: 1.25rem 0; padding-left: 1.4rem; }
  .gj-result li { margin: 0.4rem 0; }
  .gj-tip {
    background: var(--sl-color-gray-6, rgba(255,255,255,0.04));
    border-left: 4px solid var(--gj-accent);
    border-radius: 6px; padding: 0.9rem 1rem; margin: 1.5rem 0;
  }
  .gj-katex { overflow-x: auto; overflow-y: hidden; padding: 0.75rem 0.25rem; margin: 1.5rem 0; }
  .gj-katex .katex-display { margin: 0; }
  .gj-conti { overflow-x: auto; padding: 0.5rem 0.25rem; margin: 0.5rem 0 1.5rem; opacity: 0.95; }

  @media (max-width: 600px) {
    .gj-root { font-size: 0.95rem; }
    .gj-actions { grid-template-columns: 1fr; }
    .gj-actions .gj-btn, .gj-btn-wide { width: 100%; }
    .gj-result { padding: 1rem 0.5rem; }

    .gj-dims {
      display: grid;
      grid-template-columns: 4rem auto 4rem;
      column-gap: 1.2rem;
      row-gap: 0.4rem;
      justify-content: center;
      align-items: center;
    }
    .gj-dims input { grid-row: 1; width: 100%; }
    #gjRows { grid-column: 1; }
    .gj-times { grid-row: 1; grid-column: 2; justify-self: center; }
    #gjCols { grid-column: 3; }
    .gj-dims label {
      grid-row: 2;
      width: max-content;
      white-space: nowrap;
    }
    label[for="gjRows"] { grid-column: 1; justify-self: center; }
    label[for="gjCols"] { grid-column: 3; justify-self: center; }
  }
</style>

<script>
  import nerdamer from 'nerdamer';
  import 'nerdamer/Algebra.js';
  import 'nerdamer/Calculus.js';
  import 'nerdamer/Solve.js';
  import 'nerdamer/Extra.js';
  import katex from 'katex';
  import renderMathInElement from 'katex/contrib/auto-render';

  const root = document.querySelector('.gj-root');
  if (root) initGaussJordan(root);

  function initGaussJordan(root) {
    const LANG = (root.dataset.lang || document.documentElement.lang || 'it')
      .toLowerCase().startsWith('en') ? 'en' : 'it';

    // ----------------------------------------------------------------- i18n
    const D = {
      it: {
        before: 'prima', after: 'dopo',
        arrowBA: '\\impliedby prima \\quad \\quad dopo\\implies',
        aRef: 'A_{\\text{REF}}', aRref: 'A_{\\text{RREF}}',
        titleQuick: 'Risultato sintetico', titleStep: 'Svolgimento passo-passo',
        inputIs: 'La matrice immessa è',
        errTooLong: (n) => `Troppo lungo: riprova usando meno di ${n} caratteri.`,
        errForbidden: "Caratteri non ammessi. Usa solo numeri, lettere (tranne 'i' ed 'e') minuscole o maiuscole, un punto o una virgola, le parentesi tonde e gli operatori + - / * ^",
        nullMatrix: '<p>La matrice immessa è nulla, quindi si trova già nella sua forma a scala per righe (REF), che coincide con la sua forma a scala per righe ridotta (RREF). Non vi sono pivot (scalini).</p>',
        refResult: '<p>La matrice nella sua forma a scala per righe (REF) risulta:</p>',
        rrefResult: '<p>La matrice nella sua forma a scala per righe ridotta (RREF) risulta:</p>',
        splitIntro: '<p>Divideremo il processo (l\'algoritmo di Gauss-Jordan) in due parti.<br>Nella prima parte porteremo la matrice in forma a scala per righe (REF) e chiameremo questo processo "Parte Gauss".<br>Nella seconda parte porteremo successivamente la matrice in forma a scala per righe ridotta (RREF) e chiameremo questo processo "Parte Jordan".</p>',
        gaussHead: '<h3>Parte Gauss</h3>',
        gaussSub: '<h4>Portiamo la matrice in forma a scala per righe (REF)</h4>',
        jordanHead: '<h3>Parte Jordan</h3>',
        jordanSub: '<h4>Portiamo la matrice in forma a scala per righe ridotta (RREF)</h4>',
        movesIntro: '<p>L\'obiettivo è annullare la parte inferiore della matrice sfruttando solo <i>mosse di Gauss</i> sulle righe. Le ricordiamo qui di seguito e, fra parentesi, riportiamo come le indicheremo nei passaggi:</p>',
        moveSwap: '<li>scambiare di posto tra loro le righe \\( \\mathscr{R}_{i} \\) ed \\( \\mathscr{R}_{j} \\quad \\left( \\; \\mathscr{R}_{i} \\; \\rightleftharpoons \\; \\mathscr{R}_{j} \\; \\right) \\)</li>',
        moveMult: '<li>moltiplicare una riga \\( \\mathscr{R}_{i} \\) per uno scalare \\( K\\in\\mathbb{R} \\quad \\left( \\; \\mathscr{R}_{i} \\; = \\; K \\mspace{-2mu}\\cdot \\mathscr{R}_{i} \\; \\right) \\)</li>',
        moveAdd: '<li>sommare ad una riga \\( \\mathscr{R}_{i} \\) un\'altra riga \\( \\mathscr{R}_{j} \\quad \\left( \\; \\mathscr{R}_{i} \\; = \\; \\mathscr{R}_{i} + \\mathscr{R}_{j} \\; \\right) \\)</li>',
        gcTip1: '<p>Un suggerimento pratico che in queste soluzioni useremo sempre:</p>',
        gcTipBox: '<p class="gj-tip">Quando si effettua la semplice riduzione a gradini di una matrice (la "Parte Gauss") e si lavora con matrici con più di una riga e più di una colonna, è buona abitudine evitare la mossa che consente di moltiplicare una riga per uno scalare. Adottare sempre questo accorgimento porta benefici con le <i>matrici quadrate</i>, perché nei vari passaggi mantiene inalterato il valore del determinante, risparmiando tempo negli esercizi in cui se ne richiede il calcolo.</p>',
        gcTip2: '<p>Spesso nei conti, al posto di evitare la regola precedente, si preferisce usare la combinazione:</p>',
        gcTip2move: '<ul><li>sommare ad una riga \\( \\mathscr{R}_{i} \\) un\'altra riga \\( \\mathscr{R}_{j} \\) opportunamente moltiplicata per uno scalare \\( K\\in\\mathbb{R} \\quad \\left( \\; \\mathscr{R}_{i} \\; = \\; \\mathscr{R}_{i} + K \\mspace{-2mu}\\cdot \\mathscr{R}_{j} \\; \\right) \\)</li></ul>',
        jordanFree: '<p class="gj-tip">Diversamente dalla parte Gauss, ora siamo liberi di usare qualunque delle tre <i>mosse di Gauss</i>.</p>',
        jordanGoal: '<p>Rendiamo unitari tutti i pivot trovati nella parte Gauss e annulliamo tutte le eventuali celle sopra di essi, iniziando dal pivot nella colonna più a destra.</p>',
        analyzeCol: (c) => `<h5>ANALIZZIAMO LA COLONNA \\( \\mathscr{C}_{${c + 1}} \\)</h5>`,
        zeroBelow: '<p>Annulliamo gli elementi sotto di esso.</p>',
        srIntro: (e, pc) => `<p>Ogni matrice con una sola riga non nulla è già nella sua forma a scala per righe (REF) e l'unico pivot (scalino) è il primo elemento non nullo della riga.<br>In questo caso vale \\(${e}\\) e si trova nell'unica riga \\( \\mathscr{R}_{1} \\) alla colonna \\( \\mathscr{C}_{${pc + 1}} \\).</p>`,
        srNorm: (k) => `<p>Per ottenere la forma a scala per righe ridotta (RREF) basta rendere unitario l'unico pivot, moltiplicando tutta la riga \\( \\mathscr{R}_{1} \\) per il reciproco del suo valore, ossia per \\(${k}\\).</p>`,
        srAfterNorm: (pc) => `<p>La matrice è ora nella sua forma a scala per righe ridotta (RREF) e presenta un pivot unitario nell'unica riga \\( \\mathscr{R}_{1} \\) alla colonna \\( \\mathscr{C}_{${pc + 1}} \\).</p>`,
        srAlready: (pc) => `<p>La matrice è anche già nella sua forma a scala per righe ridotta (RREF) e presenta il pivot unitario nell'unica riga \\( \\mathscr{R}_{1} \\) alla colonna \\( \\mathscr{C}_{${pc + 1}} \\).</p>`,
        srQuick: (pc) => `<p>La matrice, nella sua forma a scala per righe ridotta (RREF), presenta un pivot unitario nell'unica riga \\( \\mathscr{R}_{1} \\) alla colonna \\( \\mathscr{C}_{${pc + 1}} \\).</p>`,
        scOnlySwap: '<p>Avendo un\'unica colonna non nulla, in generale si distinguono due possibilità. La prima è quando l\'elemento nella prima riga è diverso da zero, in tal caso esso sarà direttamente il pivot. La seconda è quando invece l\'elemento nella prima riga risulta nullo, in tal caso l\'unica mossa utile sarebbe:</p>',
        scReason: '<p>Infatti, quando l\'elemento della prima riga è nullo, l\'idea è quella di far salire al suo posto, in testa alla colonna, la prima cella non nulla sotto alla prima. Una volta salita essa sarà l\'unico pivot.</p><p>Successivamente, in entrambi i casi, si devono annullare eventuali termini sottostanti al pivot, formalmente moltiplicando le righe per lo stesso coefficiente: zero (di fatto, semplicemente si impongono a zero tutti i termini sotto al pivot).</p>',
        scSwapDo: (sup, inf) => `<p>Scambio di posto le righe \\( \\mathscr{R}_{${sup + 1}} \\) ed \\( \\mathscr{R}_{${inf + 1}} \\).</p>`,
        scNoSwapLower: '<p>In questo esercizio non serve scambiare alcuna coppia di righe: tutte le celle nulle si trovano già nella sola parte inferiore della colonna.</p>',
        scNoSwapAllNz: '<p>In questo esercizio non serve scambiare alcuna coppia di righe: tutte le celle hanno valore non nullo.</p>',
        scPivotHere: (e) => `<p>La matrice presenta già un pivot di valore \\(${e}\\) nell'unica colonna \\( \\mathscr{C}_{1} \\) alla riga \\( \\mathscr{R}_{1} \\).</p>`,
        scFirstIsZero: '<p>La matrice presenta il primo elemento nullo nell\'unica colonna \\( \\mathscr{C}_{1} \\).</p>',
        scPivotNow: (e) => `<p>La matrice ora presenta un pivot di valore \\(${e}\\) nell'unica colonna \\( \\mathscr{C}_{1} \\) alla riga \\( \\mathscr{R}_{1} \\).</p>`,
