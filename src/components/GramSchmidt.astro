---
/**
 * GramSchmidt.astro — Ortonormalizzazione di Gram-Schmidt, nativa, responsive, bilingue (it/en).
 *
 * Dipendenze:
 *   npm install katex      (nessun nerdamer: aritmetica razionale esatta in puro BigInt)
 *
 * Uso in una pagina .mdx di Starlight:
 *   import GramSchmidt from '../../../components/GramSchmidt.astro';
 *   <GramSchmidt />
 *
 * Metodo: tecnica "umana" delle norme al quadrato. Ogni versore resta nella forma
 *   u_i = (1/||a_i||) * a_i   con a_i a coordinate intere e ||a_i||^2 = a_i . a_i (intero).
 * Nelle proiezioni il versore compare due volte: 1/||a_i|| -> 1/||a_i||^2 (razionale), quindi
 * i radicali spariscono durante l'ortogonalizzazione e ricompaiono solo alla fine.
 *
 * Note:
 *  - Rendering matematico con KaTeX (coerente col resto del sito).
 *  - Aritmetica esatta sui razionali con una piccola classe Frac su BigInt (zero dipendenze).
 *  - Stato tenuto in un modello JS; nessuna variabile globale condivisa.
 */

import 'katex/dist/katex.min.css';

const lang = (Astro.currentLocale ?? 'it').toLowerCase().startsWith('en') ? 'en' : 'it';

const UI = {
  it: {
    title: 'Ortonormalizzazione di Gram-Schmidt',
    subtitle: 'Da \\(k\\) vettori di \\(\\mathbb{R}^n\\) a una base ortonormale',
    step1: 'Step 1 — IMPOSTA QUANTI VETTORI E DI QUALE DIMENSIONE',
    vecLabel: 'Vettori \\(\\left(k\\right)\\)',
    dimLabel: 'Dimensione \\(\\left(n\\right)\\)',
    inR: '\\(\\times\\)',
    step2: 'Step 2 — IMPOSTA LE COORDINATE DEI VETTORI',
    btnReset: 'AZZERA VALORI',
    btnRandom: 'VALORI CASUALI',
    btnQuick: 'RISULTATO SINTETICO',
    btnStep: 'SVOLGIMENTO PASSO-PASSO',
  },
  en: {
    title: 'Gram-Schmidt Orthonormalization',
    subtitle: 'From \\(k\\) vectors of \\(\\mathbb{R}^n\\) to an orthonormal basis',
    step1: 'Step 1 — SET HOW MANY VECTORS AND OF WHICH DIMENSION',
    vecLabel: 'Vectors \\(\\left(k\\right)\\)',
    dimLabel: 'Dimension \\(\\left(n\\right)\\)',
    inR: '\\(\\times\\)',
    step2: 'Step 2 — SET THE VECTOR COORDINATES',
    btnReset: 'RESET VALUES',
    btnRandom: 'RANDOM VALUES',
    btnQuick: 'QUICK RESULT',
    btnStep: 'STEP-BY-STEP SOLUTION',
  },
}[lang];
---

<div class="gs-root" data-lang={lang}>
  <!-- Step 1: dimensioni -->
  <section class="gs-panel">
    <h3 class="gs-steplabel">{UI.step1}</h3>
    <div class="gs-dims" id="gsDims">
      <label for="gsVecs" set:html={UI.vecLabel}></label>
      <input id="gsVecs" type="number" min="1" max="8" value="3" />
      <span class="gs-sep" set:html={UI.inR}></span>
      <input id="gsDim" type="number" min="1" max="8" value="3" />
      <label for="gsDim" set:html={UI.dimLabel}></label>
    </div>
  </section>

  <!-- Step 2: contenuto vettori -->
  <section class="gs-panel">
    <h3 class="gs-steplabel">{UI.step2}</h3>
    <div class="gs-vectorswrap" id="gsVectorsWrap">
      <div class="gs-vectors" id="gsVectors"></div>
    </div>
    <div id="gsStatus" class="gs-status" role="alert" aria-live="polite"></div>
  </section>

  <!-- Azioni -->
  <div class="gs-actions">
    <button id="gsBtnReset" class="gs-btn gs-btn-ghost" type="button">{UI.btnReset}</button>
    <button id="gsBtnRandom" class="gs-btn gs-btn-ghost" type="button">{UI.btnRandom}</button>
    <button id="gsBtnQuick" class="gs-btn gs-btn-ghost" type="button">{UI.btnQuick}</button>
  </div>

  <div class="gs-secondary">
    <button id="gsBtnStep" class="gs-btn gs-btn-ghost gs-btn-wide" type="button">{UI.btnStep}</button>
  </div>

  <!-- Output -->
  <section id="gsQuick" class="gs-result" hidden></section>
  <section id="gsFull" class="gs-result" hidden></section>
</div>

<style is:global>
  .gs-root {
    --gs-radius: 12px;
    --gs-surface: var(--sl-color-gray-6, #1a1a1a);
    --gs-border: var(--sl-color-gray-5, #383838);
    --gs-accent: var(--sl-color-accent, #4f7cff);
    --gs-red: #d11111;
    --gs-accent-hi: var(--sl-color-accent-high, #b8c8ff);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--sl-color-text, inherit);
    width: 100%;
    min-width: 330px;
    margin: 1.5rem 0;
    text-align: center;
  }
  .gs-root *,
  .gs-root *::before,
  .gs-root *::after { box-sizing: border-box; }

  .gs-panel {
    background: var(--gs-surface);
    border: 1px solid var(--gs-border);
    border-radius: var(--gs-radius);
    padding: 1.25rem 1rem;
    margin: 1.25rem 0;
  }
  .gs-steplabel {
    margin: 0 0 1rem;
    font-size: clamp(0.85rem, 2.4vw, 1rem);
    letter-spacing: 0.02em;
    color: var(--sl-color-text-accent, var(--gs-accent-hi));
  }

  /* dimensioni */
  .gs-dims { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 1.2rem; }
  .gs-dims label { font-size: 1rem; }
  .gs-dims input {
    background: var(--sl-color-bg, #000);
    color: var(--sl-color-text, #fff);
    border: 1.5px solid var(--gs-border);
    border-radius: 6px;
    text-align: center;
    padding: 0.35rem;
    font: inherit;
    width: 4rem;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .gs-dims input:hover {
    border-color: var(--gs-accent);
    background: color-mix(in srgb, var(--gs-accent) 10%, var(--sl-color-bg, #000));
  }
  .gs-dims input:focus { border-color: var(--gs-accent); outline: none; }
  .gs-sep { font-size: 1.6rem; opacity: 0.9; line-height: 1; }

  /* zona vettori di input */
  .gs-vectorswrap { overflow-x: auto; padding: 0.5rem 0.25rem; }
  .gs-vectors {
    display: inline-flex; align-items: flex-start; justify-content: center;
    gap: 1.1rem; min-width: 100%; padding: 0.25rem 0; margin: 0;
  }
  /* l'etichetta v_j e' fuori dal flusso (position:absolute), cosi non puo' MAI
     influenzare l'altezza o la posizione del corpo del vettore: tutti i corpi
     restano allineati sulla stessa linea indipendentemente dal rendering KaTeX
     dell'etichetta. .gs-vec riserva lo spazio con padding-top fisso. */
  .gs-vec { position: relative; display: inline-flex; flex-direction: column; align-items: center; padding-top: 1.6rem; }
  /* reset defensivo: alcuni temi applicano margin/padding diversi al primo elemento
     di un blocco di contenuto (es. :first-child del markdown). Azzeriamo qui per
     evitare che v1 riceva margini che gli altri vettori non hanno. */
  /* reset defensivo: alcuni temi applicano margin/padding diversi al primo elemento
     di un blocco di contenuto (es. :first-child del markdown), spesso con !important.
     Per vincere la cascata indipendentemente dall'ordine, alziamo la specificita'
     usando l'attributo [data-lang] (sempre presente su .gs-root). */
  .gs-root[data-lang] .gs-vec,
  .gs-root[data-lang] .gs-vec-label,
  .gs-root[data-lang] .gs-vec-body,
  .gs-root[data-lang] .gs-vec-col,
  .gs-root[data-lang] .gs-cell {
    margin: 0 !important;
  }
  .gs-root[data-lang] .gs-vectorswrap,
  .gs-root[data-lang] .gs-vectors,
  .gs-root[data-lang] .gs-vec {
    margin-top: 0 !important;
  }
  .gs-vec-label {
    position: absolute; top: 0; left: 0; right: 0;
    font-size: 0.85rem; color: var(--sl-color-text-accent, var(--gs-accent-hi));
    height: 1.6rem; line-height: 1.6rem;
    display: flex; align-items: center; justify-content: center;
    white-space: nowrap;
  }
  .gs-vec-label .katex { line-height: normal; }
  .gs-vec-body { display: inline-flex; align-items: center; gap: 0.12rem; }
  .gs-vec-col { display: inline-flex; flex-direction: column; gap: 4px; width: 4.5rem; align-items: center; }
  .gs-paren { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; line-height: 0; color: var(--sl-color-text, inherit); }
  .gs-paren svg { display: block; }

  /* celle: strette, si allargano (animate) al focus SENZA spostare le vicine,
     perche la colonna ha larghezza fissa e l'input cresce al suo interno. */
  .gs-cell {
    background: var(--sl-color-bg, #000);
    color: var(--sl-color-text, #fff);
    border: 1.5px solid var(--gs-border);
    border-radius: 6px;
    text-align: center;
    padding: 0.18rem 0.3rem;
    font: inherit;
    width: 3.4rem;
    transition: width 0.3s ease-in-out, background-color 0.15s ease, border-color 0.15s ease;
  }
  .gs-cell:hover {
    border-color: var(--gs-accent);
    background: color-mix(in srgb, var(--gs-accent) 10%, var(--sl-color-bg, #000));
  }
  .gs-cell:focus {
    border-color: var(--gs-accent); outline: none;
    background: color-mix(in srgb, var(--gs-accent) 16%, var(--sl-color-bg, #000));
    width: 4.5rem;
  }

  .gs-status { margin: 0.5rem 0 0; font-size: 0.95rem; }
  .gs-status.gs-error {
    padding: 0.6rem 0.8rem;
    border-left: 4px solid var(--gs-red);
    background: color-mix(in srgb, var(--gs-red) 8%, transparent);
    border-radius: 4px;
  }

  /* pulsanti */
  .gs-actions {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem; align-items: stretch; margin: 1.25rem auto; max-width: 48rem;
  }
  .gs-actions .gs-btn {
    box-sizing: border-box; width: 100%; margin: 0;
    height: 3.6rem; padding: 0 1rem; line-height: 1.2;
    display: inline-flex; align-items: center; justify-content: center; text-align: center;
  }
  .gs-secondary { margin-top: 1.25rem; }
  .gs-btn {
    font: inherit; font-weight: 600; cursor: pointer;
    border-radius: 999px; padding: 0.7rem 1.4rem; border: 1.5px solid transparent;
    transition: transform 0.1s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .gs-btn:active { transform: scale(0.96); }
  .gs-btn-ghost { background: transparent; color: var(--sl-color-text, inherit); border-color: var(--gs-border); }
  .gs-btn-ghost:hover { border-color: var(--gs-accent); color: var(--gs-accent); }
  .gs-btn-wide { padding: 0.9rem 1.4rem; width: 100%; margin: 0 0 1rem; }

  /* output */
  .gs-result {
    background: var(--gs-surface); border: 1px solid var(--gs-border);
    border-radius: var(--gs-radius); margin-top: 1.5rem; padding: 1.5rem 1rem;
    opacity: 0; transition: opacity 0.3s ease; text-align: left;
  }
  .gs-result.gs-visible { opacity: 1; }
  .gs-result h2 { text-align: center; }
  .gs-result h3 { margin-top: 2.5rem; color: var(--gs-accent); }
  .gs-result h4 { margin-top: 0.25rem; }
  .gs-result h5 {
    margin: 2.5rem 0 1rem; padding-top: 1rem;
    font-size: 0.95rem; letter-spacing: 0.03em; color: var(--sl-color-text-accent, var(--gs-accent-hi));
  }
  .gs-result ul { margin: 1.25rem 0; padding-left: 1.4rem; }
  .gs-result li { margin: 0.4rem 0; }
  .gs-tip {
    background: var(--sl-color-gray-6, rgba(255,255,255,0.04));
    border-left: 4px solid var(--gs-accent);
    border-radius: 6px; padding: 0.9rem 1rem; margin: 1.5rem 0;
  }
  .gs-katex { overflow-x: auto; overflow-y: hidden; padding: 0.75rem 0.25rem; margin: 1.5rem 0; }
  .gs-katex .katex-display { margin: 0; }
  .gs-conti { overflow-x: auto; padding: 0.5rem 0.25rem; margin: 0.5rem 0 1.5rem; opacity: 0.95; }

  @media (max-width: 600px) {
    .gs-root { font-size: 0.95rem; }
    .gs-actions { grid-template-columns: 1fr; }
    .gs-actions .gs-btn, .gs-btn-wide { width: 100%; }
    .gs-result { padding: 1rem 0.5rem; }

    /* Step 1: due righe — input affiancati sopra, etichette allineate sotto */
    .gs-dims {
      display: grid;
      grid-template-columns: 4rem auto 4rem;
      column-gap: 1.2rem;
      row-gap: 0.4rem;
      justify-content: center;
      align-items: center;
    }
    .gs-dims input { grid-row: 1; width: 100%; }
    #gsVecs { grid-column: 1; }
    .gs-sep { grid-row: 1; grid-column: 2; justify-self: center; }
    #gsDim { grid-column: 3; }
    .gs-dims label {
      grid-row: 2;
      width: max-content;
      white-space: nowrap;
    }
    label[for="gsVecs"] { grid-column: 1; justify-self: center; }
    label[for="gsDim"] { grid-column: 3; justify-self: center; }
  }
</style>

<script>
  import katex from 'katex';
  import renderMathInElement from 'katex/contrib/auto-render';

  const root = document.querySelector('.gs-root');
  if (root) initGramSchmidt(root);

  function initGramSchmidt(root) {
    const LANG = (root.dataset.lang || document.documentElement.lang || 'it')
      .toLowerCase().startsWith('en') ? 'en' : 'it';

    // ============================================================= i18n / narrazione
    const D = {
      it: {
        titleQuick: 'Risultato sintetico',
        titleStep: 'Svolgimento passo-passo',
        inputIs: '<p>I vettori immessi sono:</p>',

        // --- spiegazione della tecnica (solo nel passo-passo) ---
        techHead: '<h5>LA TECNICA RISOLUTIVA CHE USEREMO</h5>',
        techBody:
          '<p>Prima di iniziare fissiamo il metodo che useremo in tutto lo svolgimento. È una tecnica "umana", pensata per non scrivere mai numeri decimali e per trascinare i radicali solo dove servono davvero.</p>' +
          '<p>I versori ortonormali non verranno mai normalizzati nelle singole coordinate: ogni versore \\( \\mathbf{u}\\mkern1.5mu_{i} \\) resterà nella forma "fattore di norma per il vettore ortogonale \\( \\mathbf{v}\\mkern-2mu_{i\\perp} \\) a coordinate intere", cioè</p>',
        techFormU: '\\mathbf{u}\\mkern1.5mu_{i} \\; = \\; \\frac{1}{\\lVert \\mathbf{v}\\mkern-2mu_{i\\perp}\\rVert}\\; \\mathbf{v}\\mkern-2mu_{i\\perp}',
        techBody2:
          '<p>dove \\( \\mathbf{v}\\mkern-2mu_{i\\perp} \\) ha coordinate intere e \\( \\lVert \\mathbf{v}\\mkern-2mu_{i\\perp}\\rVert^{2}=\\mathbf{v}\\mkern-2mu_{i\\perp}\\cdot \\mathbf{v}\\mkern-2mu_{i\\perp} \\) è la sua <i>norma al quadrato</i> (un numero intero).</p>' +
          '<p class="gs-tip">Il punto chiave: nella proiezione di un vettore lungo \\( \\mathbf{u}\\mkern1.5mu_{i} \\) il versore compare <b>due volte</b>, quindi il fattore \\( \\tfrac{1}{\\lVert \\mathbf{v}\\mkern-2mu_{i\\perp}\\rVert} \\) compare al quadrato e diventa \\( \\tfrac{1}{\\lVert \\mathbf{v}\\mkern-2mu_{i\\perp}\\rVert^{2}} \\), un numero <b>razionale</b>. Il radicale sparisce da solo. Quello che ci portiamo dietro ai denominatori è sempre la norma al quadrato \\( \\lVert \\mathbf{v}\\mkern-2mu_{i\\perp}\\rVert^{2} \\), che è intera, e tutta l\'ortogonalizzazione si svolge con frazioni esatte.</p>',
        techBody3:
          '<p>La proiezione di \\( \\mathbf{v}\\mkern-2mu_{j} \\) lungo il versore \\( \\mathbf{u}\\mkern1.5mu_{i} \\) (la sua componente <i>parallela</i> a \\( \\mathbf{u}\\mkern1.5mu_{i} \\)) la indichiamo \\( \\mathbf{v}\\mkern-2mu_{j\\mkern1mu\\mathbin{/\\mkern-5mu/}\\mkern1mu\\mathbf{u}\\mkern1.5mu_{i}} \\) e vale:</p>',
        techFormProj:
          '\\mathbf{v}\\mkern-2mu_{j\\mkern1mu\\mathbin{/\\mkern-5mu/}\\mkern1mu\\mathbf{u}\\mkern1.5mu_{i}} \\; = \\; \\bigl(\\mathbf{v}\\mkern-2mu_{j}\\cdot \\mathbf{u}\\mkern1.5mu_{i}\\bigr)\\,\\mathbf{u}\\mkern1.5mu_{i} \\; = \\; \\frac{\\mathbf{v}\\mkern-2mu_{j}\\cdot \\mathbf{v}\\mkern-2mu_{i\\perp}}{\\lVert \\mathbf{v}\\mkern-2mu_{i\\perp}\\rVert^{2}}\\; \\mathbf{v}\\mkern-2mu_{i\\perp}',
        techBody4:
          '<p>La parte di \\( \\mathbf{v}\\mkern-2mu_{j} \\) ortogonale a tutte le direzioni già trovate la indichiamo \\( \\mathbf{v}\\mkern-2mu_{j\\perp} \\):</p>',
        techFormPerp:
          '\\mathbf{v}\\mkern-2mu_{j\\perp} \\; = \\; \\mathbf{v}\\mkern-2mu_{j} \\; - \\; \\sum_{i\\,<\\,j} \\mathbf{v}\\mkern-2mu_{j\\mkern1mu\\mathbin{/\\mkern-5mu/}\\mkern1mu\\mathbf{u}\\mkern1.5mu_{i}} \\qquad\\Longrightarrow\\qquad \\mathbf{u}_{j} \\; = \\; \\frac{\\mathbf{v}\\mkern-2mu_{j\\perp}}{\\lVert \\mathbf{v}\\mkern-2mu_{j\\perp}\\rVert}',
        techBody5:
          '<p>Ogni \\( \\mathbf{v}\\mkern-2mu_{j\\perp} \\) lo scriveremo come \\( \\tfrac{1}{d} \\) per un vettore a coordinate intere, e continueremo a chiamarlo \\( \\mathbf{v}\\mkern-2mu_{j\\perp} \\) riferendoci a quel vettore intero: nel normalizzare, il fattore \\( \\tfrac{1}{d} \\) si semplifica da solo e resta \\( \\mathbf{u}_{j}=\\tfrac{1}{\\lVert \\mathbf{v}\\mkern-2mu_{j\\perp}\\rVert}\\,\\mathbf{v}\\mkern-2mu_{j\\perp} \\).</p>',

        // --- per vettore ---
        analyze: (j) => `<h5>ANALIZZIAMO \\( \\mathbf{v}\\mkern-2mu_{${j}} \\)</h5>`,
        firstIntro: (j) =>
          `<p>Il primo vettore (non nullo) dà direttamente la prima direzione: \\( \\mathbf{v}\\mkern-2mu_{${j}} \\Longrightarrow \\mathbf{v}\\mkern-2mu_{${j}\\perp} \\). Ne calcoliamo la norma al quadrato \\( \\lVert \\mathbf{v}\\mkern-2mu_{${j}\\perp}\\rVert^{2} \\) e otteniamo il versore \\( \\mathbf{u}_{1} \\) dividendo per la norma.</p>`,
        firstZero: (j) =>
          `<p>Il vettore \\( \\mathbf{v}\\mkern-2mu_{${j}} \\) è il vettore nullo: non individua alcuna direzione, quindi lo scartiamo e proseguiamo.</p>`,
        projIntro: (j) =>
          `<p>Calcoliamo le proiezioni di \\( \\mathbf{v}\\mkern-2mu_{${j}} \\) lungo ciascuna direzione ortonormale già trovata.</p>`,
        projStep: (j, ui, srcJ, dotTex, S) =>
          `<p>Proiezione di \\( \\mathbf{v}\\mkern-2mu_{${j}} \\) lungo \\( \\mathbf{u}_{${ui}} \\): il prodotto scalare vale \\( \\mathbf{v}\\mkern-2mu_{${j}}\\cdot \\mathbf{v}\\mkern-2mu_{${srcJ}\\perp} = ${dotTex} \\) e si divide per \\( \\lVert \\mathbf{v}\\mkern-2mu_{${srcJ}\\perp}\\rVert^{2} = ${S} \\).</p>`,
        perpIntro: (j) =>
          `<p>La parte ortogonale è \\( \\mathbf{v}\\mkern-2mu_{${j}} \\) meno tutte le proiezioni trovate. Raccogliamo il denominatore comune così le coordinate restano intere.</p>`,
        dependent: (j) =>
          `<p>Risulta \\( \\mathbf{v}\\mkern-2mu_{${j}\\perp} = \\mathbf{0} \\): il vettore \\( \\mathbf{v}\\mkern-2mu_{${j}} \\) è combinazione lineare dei precedenti, quindi <b>non aggiunge una nuova direzione</b>. Lo scartiamo e proseguiamo.</p>`,
        normalize: (j, vi, S) =>
          `<p>Normalizziamo \\( \\mathbf{v}\\mkern-2mu_{${j}\\perp} \\): il fattore razionale davanti si semplifica con quello della norma e resta il versore \\( \\mathbf{u}_{${vi}} = \\tfrac{1}{\\lVert \\mathbf{v}\\mkern-2mu_{${j}\\perp}\\rVert}\\,\\mathbf{v}\\mkern-2mu_{${j}\\perp} \\) con \\( \\lVert \\mathbf{v}\\mkern-2mu_{${j}\\perp}\\rVert^{2} = ${S} \\).</p>`,
        dropFactorNote:
          '<p class="gs-tip">Il fattore evidenziato e barrato non è stato calcolato "a caso": a noi interessa solo la <i>direzione</i> di \\( \\mathbf{v}\\mkern-2mu_{j\\perp} \\), e qualunque multiplo positivo di un vettore individua la stessa direzione. Quando le coordinate hanno un fattore comune conviene quindi sostituire il vettore con il suo rappresentante a coordinate più semplici, scartando quel fattore: tanto, alla fine, normalizzeremo comunque. Da qui in avanti \\( \\mathbf{v}\\mkern-2mu_{j\\perp} \\) indicherà sempre questo rappresentante semplificato.</p>',

        resultHead: '<h5>BASE ORTONORMALE</h5>',
        resultIntro: (m) =>
          m === 0
            ? '<p>Nessuno dei vettori immessi è indipendente: non si ottiene alcun versore.</p>'
            : `<p>I versori ortonormali ottenuti sono ${m === 1 ? 'l\'unico seguente' : `i seguenti \\( ${m} \\)`}:</p>`,
        quickIntro: (m) =>
          m === 0
            ? '<p>I vettori immessi sono linearmente dipendenti: non si ottiene alcun versore ortonormale.</p>'
            : `<p>La base ortonormale ottenuta con Gram-Schmidt è:</p>`,
        depNote: (list, n) =>
          n === 1
            ? `<p>Il vettore \\( ${list} \\) è risultato combinazione lineare dei precedenti e non ha prodotto un nuovo versore.</p>`
            : `<p>I vettori \\( ${list} \\) sono risultati combinazione lineare dei precedenti e non hanno prodotto un nuovo versore.</p>`,
      },
      en: {
        titleQuick: 'Quick result',
        titleStep: 'Step-by-step solution',
        inputIs: '<p>The entered vectors are:</p>',

        techHead: '<h5>THE SOLUTION TECHNIQUE WE WILL USE</h5>',
        techBody:
          '<p>Before we start, let us fix the method we will use throughout. It is a "human" technique, designed to never write decimal numbers and to carry radicals only where they are truly needed.</p>' +
          '<p>The orthonormal vectors will never be normalized coordinate by coordinate: each versor \\( \\mathbf{u}\\mkern1.5mu_{i} \\) stays in the form "norm factor times the orthogonal vector \\( \\mathbf{v}\\mkern-2mu_{i\\perp} \\) with integer coordinates", that is</p>',
        techFormU: '\\mathbf{u}\\mkern1.5mu_{i} \\; = \\; \\frac{1}{\\lVert \\mathbf{v}\\mkern-2mu_{i\\perp}\\rVert}\\; \\mathbf{v}\\mkern-2mu_{i\\perp}',
        techBody2:
          '<p>where \\( \\mathbf{v}\\mkern-2mu_{i\\perp} \\) has integer coordinates and \\( \\lVert \\mathbf{v}\\mkern-2mu_{i\\perp}\\rVert^{2}=\\mathbf{v}\\mkern-2mu_{i\\perp}\\cdot \\mathbf{v}\\mkern-2mu_{i\\perp} \\) is its <i>squared norm</i> (an integer).</p>' +
          '<p class="gs-tip">The key point: in the projection of a vector along \\( \\mathbf{u}\\mkern1.5mu_{i} \\) the versor appears <b>twice</b>, so the factor \\( \\tfrac{1}{\\lVert \\mathbf{v}\\mkern-2mu_{i\\perp}\\rVert} \\) is squared and becomes \\( \\tfrac{1}{\\lVert \\mathbf{v}\\mkern-2mu_{i\\perp}\\rVert^{2}} \\), a <b>rational</b> number. The radical vanishes on its own. What we carry at the denominators is always the squared norm \\( \\lVert \\mathbf{v}\\mkern-2mu_{i\\perp}\\rVert^{2} \\), which is an integer, and the whole orthogonalization is done with exact fractions.</p>',
        techBody3:
          '<p>The projection of \\( \\mathbf{v}\\mkern-2mu_{j} \\) along the versor \\( \\mathbf{u}\\mkern1.5mu_{i} \\) (its component <i>parallel</i> to \\( \\mathbf{u}\\mkern1.5mu_{i} \\)) is denoted \\( \\mathbf{v}\\mkern-2mu_{j\\mkern1mu\\mathbin{/\\mkern-5mu/}\\mkern1mu\\mathbf{u}\\mkern1.5mu_{i}} \\) and equals:</p>',
        techFormProj:
          '\\mathbf{v}\\mkern-2mu_{j\\mkern1mu\\mathbin{/\\mkern-5mu/}\\mkern1mu\\mathbf{u}\\mkern1.5mu_{i}} \\; = \\; \\bigl(\\mathbf{v}\\mkern-2mu_{j}\\cdot \\mathbf{u}\\mkern1.5mu_{i}\\bigr)\\,\\mathbf{u}\\mkern1.5mu_{i} \\; = \\; \\frac{\\mathbf{v}\\mkern-2mu_{j}\\cdot \\mathbf{v}\\mkern-2mu_{i\\perp}}{\\lVert \\mathbf{v}\\mkern-2mu_{i\\perp}\\rVert^{2}}\\; \\mathbf{v}\\mkern-2mu_{i\\perp}',
        techBody4:
          '<p>The part of \\( \\mathbf{v}\\mkern-2mu_{j} \\) orthogonal to every direction already found is denoted \\( \\mathbf{v}\\mkern-2mu_{j\\perp} \\):</p>',
        techFormPerp:
          '\\mathbf{v}\\mkern-2mu_{j\\perp} \\; = \\; \\mathbf{v}\\mkern-2mu_{j} \\; - \\; \\sum_{i\\,<\\,j} \\mathbf{v}\\mkern-2mu_{j\\mkern1mu\\mathbin{/\\mkern-5mu/}\\mkern1mu\\mathbf{u}\\mkern1.5mu_{i}} \\qquad\\Longrightarrow\\qquad \\mathbf{u}_{j} \\; = \\; \\frac{\\mathbf{v}\\mkern-2mu_{j\\perp}}{\\lVert \\mathbf{v}\\mkern-2mu_{j\\perp}\\rVert}',
        techBody5:
          '<p>We will write each \\( \\mathbf{v}\\mkern-2mu_{j\\perp} \\) as \\( \\tfrac{1}{d} \\) times an integer-coordinate vector, and keep calling it \\( \\mathbf{v}\\mkern-2mu_{j\\perp} \\) referring to that integer vector: upon normalizing, the factor \\( \\tfrac{1}{d} \\) cancels by itself and what remains is \\( \\mathbf{u}_{j}=\\tfrac{1}{\\lVert \\mathbf{v}\\mkern-2mu_{j\\perp}\\rVert}\\,\\mathbf{v}\\mkern-2mu_{j\\perp} \\).</p>',

        analyze: (j) => `<h5>LET'S ANALYZE \\( \\mathbf{v}\\mkern-2mu_{${j}} \\)</h5>`,
        firstIntro: (j) =>
          `<p>The first (non-zero) vector directly gives the first direction: \\( \\mathbf{v}\\mkern-2mu_{${j}} \\Longrightarrow \\mathbf{v}\\mkern-2mu_{${j}\\perp} \\). We compute its squared norm \\( \\lVert \\mathbf{v}\\mkern-2mu_{${j}\\perp}\\rVert^{2} \\) and obtain the versor \\( \\mathbf{u}_{1} \\) by dividing by the norm.</p>`,
        firstZero: (j) =>
          `<p>The vector \\( \\mathbf{v}\\mkern-2mu_{${j}} \\) is the zero vector: it gives no direction, so we discard it and continue.</p>`,
        projIntro: (j) =>
          `<p>We compute the projections of \\( \\mathbf{v}\\mkern-2mu_{${j}} \\) along each orthonormal direction already found.</p>`,
        projStep: (j, ui, srcJ, dotTex, S) =>
          `<p>Projection of \\( \\mathbf{v}\\mkern-2mu_{${j}} \\) along \\( \\mathbf{u}_{${ui}} \\): the dot product is \\( \\mathbf{v}\\mkern-2mu_{${j}}\\cdot \\mathbf{v}\\mkern-2mu_{${srcJ}\\perp} = ${dotTex} \\) and we divide by \\( \\lVert \\mathbf{v}\\mkern-2mu_{${srcJ}\\perp}\\rVert^{2} = ${S} \\).</p>`,
        perpIntro: (j) =>
          `<p>The orthogonal part is \\( \\mathbf{v}\\mkern-2mu_{${j}} \\) minus all the projections found. We collect the common denominator so the coordinates stay integer.</p>`,
        dependent: (j) =>
          `<p>We get \\( \\mathbf{v}\\mkern-2mu_{${j}\\perp} = \\mathbf{0} \\): the vector \\( \\mathbf{v}\\mkern-2mu_{${j}} \\) is a linear combination of the previous ones, so it <b>adds no new direction</b>. We discard it and continue.</p>`,
        normalize: (j, vi, S) =>
          `<p>We normalize \\( \\mathbf{v}\\mkern-2mu_{${j}\\perp} \\): the rational factor in front cancels with the one from the norm, leaving the versor \\( \\mathbf{u}_{${vi}} = \\tfrac{1}{\\lVert \\mathbf{v}\\mkern-2mu_{${j}\\perp}\\rVert}\\,\\mathbf{v}\\mkern-2mu_{${j}\\perp} \\) with \\( \\lVert \\mathbf{v}\\mkern-2mu_{${j}\\perp}\\rVert^{2} = ${S} \\).</p>`,
        dropFactorNote:
          '<p class="gs-tip">The highlighted, crossed-out factor was not pulled out "by chance": we only care about the <i>direction</i> of \\( \\mathbf{v}\\mkern-2mu_{j\\perp} \\), and any positive multiple of a vector points in the same direction. When the coordinates share a common factor, it is convenient to replace the vector with its representative with simpler coordinates, dropping that factor: we will normalize everything anyway in the end. From here on, \\( \\mathbf{v}\\mkern-2mu_{j\\perp} \\) will always denote this simplified representative.</p>',

        resultHead: '<h5>ORTHONORMAL BASIS</h5>',
        resultIntro: (m) =>
          m === 0
            ? '<p>None of the entered vectors is independent: no versor is obtained.</p>'
            : `<p>The orthonormal vectors obtained are ${m === 1 ? 'the single one below' : `the following \\( ${m} \\)`}:</p>`,
        quickIntro: (m) =>
          m === 0
            ? '<p>The entered vectors are linearly dependent: no orthonormal versor is obtained.</p>'
            : `<p>The orthonormal basis obtained with Gram-Schmidt is:</p>`,
        depNote: (list, n) =>
          n === 1
            ? `<p>The vector \\( ${list} \\) turned out to be a linear combination of the previous ones and produced no new versor.</p>`
            : `<p>The vectors \\( ${list} \\) turned out to be linear combinations of the previous ones and produced no new versor.</p>`,
      },
    }[LANG];
    const L = D;
    // ---------------------------------------------------------- riferimenti DOM
    const inVecs = root.querySelector('#gsVecs');
    const inDim = root.querySelector('#gsDim');
    const vectorsEl = root.querySelector('#gsVectors');
    const statusEl = root.querySelector('#gsStatus');
    const quickEl = root.querySelector('#gsQuick');
    const fullEl = root.querySelector('#gsFull');

    let K, N;

    // --------------------------------------------------------- helper rendering
    const KOPTS = { throwOnError: false, displayMode: true };
    const RMOPTS = {
      throwOnError: false,
      delimiters: [
        { left: '\\(', right: '\\)', display: false },
        { left: '\\[', right: '\\]', display: true },
      ],
    };
    function renderKatexBlock(tex) {
      const safe = tex.replace(/\\mspace/g, '\\mkern');
      try { return katex.renderToString(safe, KOPTS); }
      catch (e) { return '<span style="color:#e55">[KaTeX error]</span>'; }
    }
    function renderInline(el) { try { renderMathInElement(el, RMOPTS); } catch (e) {} }
    function reveal(el) {
      el.hidden = false; el.style.display = 'block';
      requestAnimationFrame(() => el.classList.add('gs-visible'));
    }
    function hide(el) { el.classList.remove('gs-visible'); el.style.display = 'none'; el.hidden = true; }
    function tip(msg) { statusEl.textContent = msg; statusEl.className = 'gs-status gs-error'; }
    function unTip() { statusEl.textContent = ''; statusEl.className = 'gs-status'; }

    const ERR = {
      it: {
        long: (n) => `Troppo lungo: usa meno di ${n} caratteri.`,
        bad: 'Caratteri non ammessi. Inserisci solo numeri razionali (interi, frazioni come 3/4, decimali). Niente lettere.',
      },
      en: {
        long: (n) => `Too long: use fewer than ${n} characters.`,
        bad: 'Forbidden characters. Enter only rational numbers (integers, fractions like 3/4, decimals). No letters.',
      },
    }[LANG];

    // ------------------------------------------------------------ griglia input
    function cellId(j, c) { return `gsv${j}c${c}`; }

    function showVectors() {
      K = Math.max(1, Math.min(8, parseInt(inVecs.value) || 1));
      N = Math.max(1, Math.min(8, parseInt(inDim.value) || 1));
      let html = '';
      for (let j = 0; j < K; j++) {
        html += '<div class="gs-vec">';
        html += `<div class="gs-vec-label">\\( \\mathbf{v}\\mkern-2mu_{${j + 1}} \\)</div>`;
        html += '<div class="gs-vec-body">';
        html += '<span class="gs-paren gs-paren-l" aria-hidden="true"></span>';
        html += '<div class="gs-vec-col">';
        for (let c = 0; c < N; c++) {
          html += `<input class="gs-cell" type="text" inputmode="text" id="${cellId(j, c)}" value="0">`;
        }
        html += '</div>';
        html += '<span class="gs-paren gs-paren-r" aria-hidden="true"></span>';
        html += '</div></div>';
      }
      vectorsEl.innerHTML = html;
      vectorsEl.querySelectorAll('input').forEach((inp) => {
        inp.addEventListener('change', () => validateCell(inp));
      });
      renderInline(vectorsEl);
      fitBrackets();
    }

    // ---- Parentesi SVG: path matematico reale di KaTeX (tallDelim) ----
    const PAREN_VBW = 875;
    const PAREN_CAP_HEIGHT = 3600;
    function gjLparenPath(midHeight) {
      return `M863,9c0,-2,-2,-5,-6,-9c0,0,-17,0,-17,0c-12.7,0,-19.3,0.3,-20,1
c-5.3,5.3,-10.3,11,-15,17c-242.7,294.7,-395.3,682,-458,1162c-21.3,163.3,-33.3,349,
-36,557 l0,${midHeight + 84}c0.2,6,0,26,0,60c2,159.3,10,310.7,24,454c53.3,528,210,
949.7,470,1265c4.7,6,9.7,11.7,15,17c0.7,0.7,7,1,19,1c0,0,18,0,18,0c4,-4,6,-7,6,-9
c0,-2.7,-3.3,-8.7,-10,-18c-135.3,-192.7,-235.5,-414.3,-300.5,-665c-65,-250.7,-102.5,
-544.7,-112.5,-882c-2,-104,-3,-167,-3,-189
l0,-${midHeight + 92}c0,-162.7,5.7,-314,17,-454c20.7,-272,63.7,-513,129,-723c65.3,
-210,155.3,-396.3,270,-559c6.7,-9.3,10,-15.3,10,-18z`;
    }
    function gjRparenPath(midHeight) {
      return `M76,0c-16.7,0,-25,3,-25,9c0,2,2,6.3,6,13c21.3,28.7,42.3,60.3,
63,95c96.7,156.7,172.8,332.5,228.5,527.5c55.7,195,92.8,416.5,111.5,664.5
c11.3,139.3,17,290.7,17,454c0,28,1.7,43,3.3,45l0,${midHeight + 9}
c-3,4,-3.3,16.7,-3.3,38c0,162,-5.7,313.7,-17,455c-18.7,248,-55.8,469.3,-111.5,664
c-55.7,194.7,-131.8,370.3,-228.5,527c-20.7,34.7,-41.7,66.3,-63,95c-2,3.3,-4,7,-6,11
c0,7.3,5.7,11,17,11c0,0,11,0,11,0c9.3,0,14.3,-0.3,15,-1c5.3,-5.3,10.3,-11,15,-17
c242.7,-294.7,395.3,-681.7,458,-1161c21.3,-164.7,33.3,-350.7,36,-558
l0,-${midHeight + 144}c-2,-159.3,-10,-310.7,-24,-454c-53.3,-528,-210,-949.7,
-470,-1265c-4.7,-6,-9.7,-11.7,-15,-17c-0.7,-0.7,-6.7,-1,-18,-1z`;
    }
    function gjParenSvg(side, heightPx, widthPx) {
      const k = widthPx / PAREN_VBW;
      let viewBoxHeight = Math.round(heightPx / k);
      let midHeight = viewBoxHeight - PAREN_CAP_HEIGHT;
      if (midHeight < 0) midHeight = 0;
      viewBoxHeight = PAREN_CAP_HEIGHT + midHeight;
      const renderedHeight = viewBoxHeight * k;
      const d = side === 'l' ? gjLparenPath(midHeight) : gjRparenPath(midHeight);
      const w = widthPx.toFixed(2), h = renderedHeight.toFixed(2);
      const style = `display:block !important;flex:0 0 auto;`
        + `width:${w}px !important;height:${h}px !important;`
        + `max-width:none !important;opacity:1 !important;visibility:visible !important`;
      return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${PAREN_VBW} ${viewBoxHeight}" width="${w}" height="${h}" preserveAspectRatio="none" style="${style}" aria-hidden="true"><path d="${d}" fill="currentColor"/></svg>`;
    }

    // parentesi estensibili SVG, dimensionate sull'altezza della colonna di input.
    // Qui ci sono PIU' vettori, ciascuno con le proprie parentesi: misuriamo la prima
    // colonna (tutte hanno la stessa altezza) e applichiamo a tutte.
    function fitBrackets(tries) {
      tries = tries || 0;
      requestAnimationFrame(() => {
        const col = vectorsEl.querySelector('.gs-vec-col');
        if (!col || col.getBoundingClientRect().height <= 0) {
          if (tries < 12) fitBrackets(tries + 1);
          return;
        }
        const H = col.getBoundingClientRect().height;
        const probe = vectorsEl.querySelector('.gs-paren-l');
        if (!probe) return;
        const fontSizePx = parseFloat(getComputedStyle(probe).fontSize) || 16;
        const widthPx = fontSizePx * 0.875;
        const lSvg = gjParenSvg('l', H, widthPx);
        const rSvg = gjParenSvg('r', H, widthPx);
        vectorsEl.querySelectorAll('.gs-paren-l').forEach((el) => { el.innerHTML = lSvg; });
        vectorsEl.querySelectorAll('.gs-paren-r').forEach((el) => { el.innerHTML = rSvg; });
      });
    }

    // ------------------------------------------------------------ validazione cella
    function sanitizeRational(str) {
      // ammessi: cifre, segno + -, una barra di frazione /, punto/virgola decimale, spazi
      let out = '', ok = true;
      for (const ch of str) {
        const code = ch.charCodeAt(0);
        const isDigit = code >= 48 && code <= 57;
        if (isDigit) out += ch;
        else if (ch === ',') out += '.';
        else if (ch === '+' || ch === '-' || ch === '/' || ch === '.' || ch === ' ') out += ch;
        else ok = false;
      }
      return { out: out.replace(/\s+/g, ''), ok };
    }

    function validateCell(inp) {
      const LIM = 16;
      const raw = inp.value;
      if (raw.length >= LIM) { inp.value = '0'; tip(ERR.long(LIM)); return; }
      const { out, ok } = sanitizeRational(raw);
      if (out === '') { inp.value = '0'; unTip(); return; }
      if (!ok || (out.match(/\//g) || []).length > 1) { inp.value = '0'; tip(ERR.bad); return; }
      try {
        const v = Frac.parse(out);          // aritmetica esatta su BigInt
        inp.value = v.toString();           // "p/q" oppure "p"
        unTip();
      } catch (e) { inp.value = '0'; tip(ERR.bad); }
    }

    let gsRandomUsed = false;
    function randInt() { return Math.floor(Math.random() * 11) - 5; } // -5..5
    function fillRandom() {
      for (let j = 0; j < K; j++)
        for (let c = 0; c < N; c++)
          root.querySelector('#' + cellId(j, c)).value = String(randInt());
      unTip();
      gsRandomUsed = true;
    }
    function resetCells() {
      for (let j = 0; j < K; j++)
        for (let c = 0; c < N; c++)
          root.querySelector('#' + cellId(j, c)).value = '0';
      unTip();
      gsRandomUsed = false;
    }
    function gsTrack(mode) {
      if (window.umami) umami.track('gramschmidt-solve', { mode, vectors: K, dim: N, randomUsed: gsRandomUsed });
    }

    // legge il modello corrente dai campi (stringhe razionali esatte)
    function readVectors() {
      const V = [];
      for (let j = 0; j < K; j++) {
        const col = [];
        for (let c = 0; c < N; c++) {
          const el = root.querySelector('#' + cellId(j, c));
          let s = (el && el.value || '0').trim();
          if (s === '' || /[a-zA-Z]/.test(s)) s = '0';
          col.push(s);
        }
        V.push(col);
      }
      return V;
    }
    // ============================================================= motore (BigInt)
    const babs = (x) => (x < 0n ? -x : x);
    function bgcd(a, b) { a = babs(a); b = babs(b); while (b) { [a, b] = [b, a % b]; } return a; }
    function blcm(a, b) { a = babs(a); b = babs(b); if (a === 0n || b === 0n) return 0n; return (a / bgcd(a, b)) * b; }

    class Frac {
      constructor(n, d = 1n) {
        if (d === 0n) throw new Error('den 0');
        if (d < 0n) { n = -n; d = -d; }
        const g = bgcd(n, d) || 1n;
        this.n = n / g; this.d = d / g;
      }
      static parse(str) {
        let s = String(str).trim().replace(/\s+/g, '').replace(/,/g, '.');
        if (s === '' || s === '+' || s === '-') return new Frac(0n);
        if (s.includes('/')) { const p = s.split('/'); return Frac.parseDec(p[0]).div(Frac.parseDec(p[1])); }
        return Frac.parseDec(s);
      }
      static parseDec(str) {
        let s = String(str).trim(), sign = 1n;
        if (s[0] === '+') s = s.slice(1);
        else if (s[0] === '-') { sign = -1n; s = s.slice(1); }
        if (s === '') return new Frac(0n);
        if (s.includes('.')) {
          const parts = s.split('.');
          if (parts.length > 2) throw new Error('bad decimal');
          const ip = parts[0], fp = parts[1] || '';
          if (!/^[0-9]*$/.test(ip) || !/^[0-9]*$/.test(fp)) throw new Error('bad decimal');
          return new Frac(sign * BigInt((ip || '0') + fp), 10n ** BigInt(fp.length));
        }
        if (!/^[0-9]+$/.test(s)) throw new Error('not a number: ' + str);
        return new Frac(sign * BigInt(s), 1n);
      }
      add(o) { return new Frac(this.n * o.d + o.n * this.d, this.d * o.d); }
      sub(o) { return new Frac(this.n * o.d - o.n * this.d, this.d * o.d); }
      mul(o) { return new Frac(this.n * o.n, this.d * o.d); }
      div(o) { return new Frac(this.n * o.d, this.d * o.n); }
      isZero() { return this.n === 0n; }
      isOne() { return this.n === 1n && this.d === 1n; }
      toString() { return this.d === 1n ? `${this.n}` : `${this.n}/${this.d}`; }
    }

    function dotF(u, v) { let acc = new Frac(0n); for (let i = 0; i < u.length; i++) acc = acc.add(u[i].mul(v[i])); return acc; }

    // riduce un vettore di Frac a (scale)*(vettore intero ridotto): { scale:Frac, a:[BigInt], S:BigInt } | {zero}
    function reduceDirection(w) {
      let D = 1n;
      for (const f of w) D = blcm(D, f.d);
      const b = w.map((f) => f.n * (D / f.d));
      let g = 0n;
      for (const x of b) g = bgcd(g, x);
      if (g === 0n) return { zero: true };
      const a = b.map((x) => x / g);
      let S = 0n;
      for (const x of a) S += x * x;
      return { zero: false, a, S, scale: new Frac(g, D) };
    }

    // Gram-Schmidt; vectors: array (k) di array (n) di stringhe razionali. Ritorna { versors, log }.
    function gramSchmidt(vectors) {
      const versors = [];          // { a:[BigInt], S:BigInt, srcJ: indice (1-based) del vettore originale che lo ha generato }
      const log = [];
      vectors.forEach((vRaw, j) => {
        const v = vRaw.map(Frac.parse);
        let w = v.slice();
        const projs = [];
        versors.forEach((u, idx) => {
          const aF = u.a.map((x) => new Frac(x));
          const num = dotF(v, aF);                  // v . a_i
          const t = num.div(new Frac(u.S));         // num / S_i
          const proj = aF.map((af) => af.mul(t));   // t * a_i
          w = w.map((wc, c) => wc.sub(proj[c]));
          projs.push({ ui: idx + 1, srcJ: u.srcJ, a: u.a.slice(), S: u.S, num, t, proj });
        });
        const wRaw = w.slice();
        const red = reduceDirection(w);
        if (red.zero) {
          log.push({ j, kind: projs.length ? 'dependent' : 'zero', v, projs, wRaw });
        } else {
          versors.push({ a: red.a, S: red.S, srcJ: j + 1 });
          const vi = versors.length; // indice del versore (1-based) nell'ordine di accettazione
          log.push({ j, vi, kind: projs.length ? 'new' : 'first', v, projs, wRaw, a: red.a, S: red.S, scale: red.scale });
        }
      });
      return { versors, log };
    }

    // -------------------------------------------------------------- helper LaTeX
    function fracTeX(f) {
      if (f.d === 1n) return `${f.n}`;
      return f.n < 0n ? `-\\frac{${-f.n}}{${f.d}}` : `\\frac{${f.n}}{${f.d}}`;
    }
    function colVecF(arr) { return '\\begin{pmatrix}' + arr.map(fracTeX).join('\\\\[2pt]') + '\\end{pmatrix}'; }
    function colVecI(arr) { return '\\begin{pmatrix}' + arr.map((x) => `${x}`).join('\\\\[2pt]') + '\\end{pmatrix}'; }
    // scalare razionale davanti a un vettore: barrato ed evidenziato (per la nota "rappresentante più semplice")
    function dropFactorTeX(f) {
      if (f.isOne()) return '';
      if (f.n === 1n) return `\\frac{1}{\\textcolor{#e5a050}{\\cancel{${f.d}}}}\\,`;
      return `\\textcolor{#e5a050}{\\cancel{${fracTeX(f)}}}\\,`;
    }
    // prodotto scalare esteso: a_0 v_0 + a_1 v_1 + ... (salta i termini con coordinata 0 del versore)
    function dotSumTeX(vArr, aInts) {
      const terms = [];
      for (let c = 0; c < aInts.length; c++) {
        if (aInts[c] === 0n) continue;
        const vt = fracTeX(vArr[c]);
        const at = `${aInts[c]}`;
        terms.push(`\\left(${vt}\\right)\\!\\cdot\\!\\left(${at}\\right)`);
      }
      return terms.length ? terms.join(' + ') : '0';
    }
    function sqSumTeX(a) { return a.map((x) => (x < 0n ? `(${x})^{2}` : `${x}^{2}`)).join(' + '); }

    // ------------------------------------------------------------ visualizzazione
    function emit(target, html, tex, conti) {
      if (html) { const d = document.createElement('div'); d.className = 'gs-text'; d.innerHTML = html; target.appendChild(d); renderInline(d); }
      if (tex) { const w = document.createElement('div'); w.className = 'gs-katex'; w.innerHTML = renderKatexBlock(tex); target.appendChild(w); }
      if (conti) { const c = document.createElement('div'); c.className = 'gs-conti'; c.innerHTML = renderKatexBlock(conti); target.appendChild(c); }
    }
    function clearResults() { quickEl.innerHTML = ''; fullEl.innerHTML = ''; hide(quickEl); hide(fullEl); }

    // ============================================================= Gram-Schmidt
    function elabora(quick) {
      const target = quick ? quickEl : fullEl;
      const other = quick ? fullEl : quickEl;
      quickEl.innerHTML = ''; fullEl.innerHTML = '';

      const V = readVectors();
      const { versors, log } = gramSchmidt(V);

      emit(target, `<h2>${quick ? L.titleQuick : L.titleStep}</h2>`);

      // vettori immessi
      const inParts = log.map((e) => `\\mathbf{v}\\mkern-2mu_{${e.j + 1}} = ${colVecF(e.v)}`);
      emit(target, L.inputIs, inParts.join('\\quad '));

      if (!quick) {
        // spiegazione della tecnica risolutiva
        emit(target, L.techHead + L.techBody, L.techFormU);
        emit(target, L.techBody2 + L.techBody3, L.techFormProj);
        emit(target, L.techBody4, L.techFormPerp);
        emit(target, L.techBody5);

        // passi per ciascun vettore
        let shownDropNote = false;
        log.forEach((e) => {
          const jD = e.j + 1;
          if (e.kind === 'zero') { emit(target, L.analyze(jD) + L.firstZero(jD)); return; }
          emit(target, L.analyze(jD));

          if (e.kind === 'first') {
            emit(target, L.firstIntro(jD));
            let t = `\\mathbf{v}\\mkern-2mu_{${jD}} = ${colVecF(e.v)}`;
            if (!e.scale.isOne()) {
              t += ` \\;\\Longrightarrow\\; \\mathbf{v}\\mkern-2mu_{${jD}\\perp} = ${dropFactorTeX(e.scale)}${colVecI(e.a)} = ${colVecI(e.a)}`;
            } else {
              t += ` \\;\\Longrightarrow\\; \\mathbf{v}\\mkern-2mu_{${jD}\\perp} = ${colVecI(e.a)}`;
            }
            emit(target, '', t);
            if (!e.scale.isOne() && !shownDropNote) { emit(target, L.dropFactorNote); shownDropNote = true; }
            emit(target, '', `\\lVert \\mathbf{v}\\mkern-2mu_{${jD}\\perp}\\rVert^{2} = \\mathbf{v}\\mkern-2mu_{${jD}\\perp}\\cdot \\mathbf{v}\\mkern-2mu_{${jD}\\perp} = ${sqSumTeX(e.a)} = ${e.S}`);
            emit(target, L.normalize(jD, e.vi, e.S), `\\mathbf{u}_{1} = \\frac{1}{\\sqrt{${e.S}}}\\,${colVecI(e.a)}`);
            return;
          }

          // 'new' o 'dependent': mostra le proiezioni
          emit(target, L.projIntro(jD));
          e.projs.forEach((p) => {
            emit(target,
              L.projStep(jD, p.ui, p.srcJ, fracTeX(p.num), `${p.S}`),
              `\\mathbf{v}\\mkern-2mu_{${jD}\\mkern1mu\\mathbin{/\\mkern-5mu/}\\mkern1mu\\mathbf{u}_{${p.ui}}} \\; = \\; \\frac{\\mathbf{v}\\mkern-2mu_{${jD}}\\cdot \\mathbf{v}\\mkern-2mu_{${p.srcJ}\\perp}}{\\lVert \\mathbf{v}\\mkern-2mu_{${p.srcJ}\\perp}\\rVert^{2}}\\,\\mathbf{v}\\mkern-2mu_{${p.srcJ}\\perp} \\; = \\; \\frac{${fracTeX(p.num)}}{${p.S}}\\,${colVecI(p.a)} \\; = \\; ${colVecF(p.proj)}`);
          });

          // parte ortogonale
          emit(target, L.perpIntro(jD));
          let sym = `\\mathbf{v}\\mkern-2mu_{${jD}\\perp} \\; = \\; \\mathbf{v}\\mkern-2mu_{${jD}}`;
          let vals = colVecF(e.v);
          e.projs.forEach((p) => { sym += ` \\, - \\, \\mathbf{v}\\mkern-2mu_{${jD}\\mkern1mu\\mathbin{/\\mkern-5mu/}\\mkern1mu\\mathbf{u}_{${p.ui}}}`; vals += ` \\, - \\, ${colVecF(p.proj)}`; });
          let perpTex = `${sym} \\; = \\; ${vals} \\; = \\; ${colVecF(e.wRaw)}`;

          if (e.kind === 'dependent') {
            perpTex += ' \\; = \\; \\mathbf{0}';
            emit(target, '', perpTex);
            emit(target, L.dependent(jD));
          } else {
            if (!e.scale.isOne()) {
              perpTex += ` \\;\\Longrightarrow\\; \\mathbf{v}\\mkern-2mu_{${jD}\\perp} = ${dropFactorTeX(e.scale)}${colVecI(e.a)} = ${colVecI(e.a)}`;
            }
            emit(target, '', perpTex);
            if (!e.scale.isOne() && !shownDropNote) { emit(target, L.dropFactorNote); shownDropNote = true; }
            emit(target, '', `\\lVert \\mathbf{v}\\mkern-2mu_{${jD}\\perp}\\rVert^{2} = \\mathbf{v}\\mkern-2mu_{${jD}\\perp}\\cdot \\mathbf{v}\\mkern-2mu_{${jD}\\perp} = ${sqSumTeX(e.a)} = ${e.S}`);
            emit(target, L.normalize(jD, e.vi, e.S),
              `\\mathbf{u}_{${e.vi}} \\; = \\; \\frac{\\mathbf{v}\\mkern-2mu_{${jD}\\perp}}{\\lVert \\mathbf{v}\\mkern-2mu_{${jD}\\perp}\\rVert} \\; = \\; \\frac{1}{\\sqrt{${e.S}}}\\,${colVecI(e.a)}`);
          }
        });
      }

      // risultato finale (sia passo-passo sia sintetico)
      const m = versors.length;
      const deps = log.filter((e) => e.kind === 'dependent' || e.kind === 'zero').map((e) => `\\mathbf{v}\\mkern-2mu_{${e.j + 1}}`);
      if (quick) emit(target, L.quickIntro(m));
      else emit(target, L.resultHead + L.resultIntro(m));
      if (m > 0) {
        const list = versors.map((u, i) => `\\mathbf{u}_{${i + 1}} \\; = \\; \\frac{1}{\\sqrt{${u.S}}}\\,${colVecI(u.a)}`).join('\\qquad ');
        emit(target, '', list);
      }
      if (deps.length && (quick ? m > 0 : true)) emit(target, L.depNote(deps.join(',\\; '), deps.length));

      hide(other);
      reveal(target);
    }

    // -------------------------------------------------------------- interazioni
    function rebuild() { showVectors(); clearResults(); unTip(); }
    inVecs.addEventListener('input', rebuild);
    inDim.addEventListener('input', rebuild);
    root.querySelector('#gsBtnReset').addEventListener('click', () => { resetCells(); clearResults(); unTip(); });
    root.querySelector('#gsBtnRandom').addEventListener('click', () => { fillRandom(); clearResults(); });
    root.querySelector('#gsBtnQuick').addEventListener('click', () => { clearResults(); elabora(true); gsTrack('quick'); });
    root.querySelector('#gsBtnStep').addEventListener('click', () => { clearResults(); elabora(false); gsTrack('steps'); });

    // ------------------------------------------------------------- avvio
    showVectors();
    renderInline(root);
    fitBrackets();
    window.addEventListener('resize', fitBrackets);
  }
</script>