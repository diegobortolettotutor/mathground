---
/*
  GramSchmidtOrtho3D.astro
  --------------------------------------------------------------------------
  ORTOGONALIZZAZIONE di Gram-Schmidt in R^3 (senza normalizzazione).
  Produce tre vettori w1, w2, w3 mutuamente ORTOGONALI, ma NON di lunghezza 1.

  Differenza chiave rispetto all'ortonormalizzazione: le proiezioni usano i
  vettori ortogonali w (non versori), quindi il coefficiente e' (v·w)/(w·w),
  e manca del tutto il passo di normalizzazione.

  Componente nativo: nessuna libreria a runtime, proiezione 3D->2D a mano su
  <canvas>. Vettori trascinabili (in modalita' Modifica), vista orbitabile e
  zoomabile (rotella / pinch). Le formule del procedimento NON sono piu'
  renderizzate qui: vivono nella pagina .mdx che ospita il componente.
--------------------------------------------------------------------------*/

const uid = 'gso3d-' + Math.random().toString(36).slice(2, 9);

// --- lingua: prop esplicita, altrimenti locale della pagina, altrimenti italiano ---
interface Props { lang?: 'it' | 'en'; }
const { lang: langProp } = Astro.props;
const locale = String(langProp ?? Astro.currentLocale ?? 'it');
const lang: 'it' | 'en' = locale.startsWith('en') ? 'en' : 'it';

const STR = {
  it: {
    aria: 'Ortogonalizzazione di Gram-Schmidt in 3D',
    compute: 'Calcola e mantieni',
    pause: 'Pausa',
    resume: 'Riprendi',
    edit: 'Modifica v₁ v₂ v₃',
    reset: 'Reset',
    slow: 'rallentatore',
    hintEdit: 'Trascina le punte di <b>v₁, v₂, v₃</b> · sfondo = ruota · rotella o pinch = zoom',
    hintExplore: 'Ruota: trascina · Zoom: rotella o pinch · «Modifica» per spostare i vettori',
  },
  en: {
    aria: 'Gram-Schmidt orthogonalization in 3D',
    compute: 'Compute & keep',
    pause: 'Pause',
    resume: 'Resume',
    edit: 'Edit v₁ v₂ v₃',
    reset: 'Reset',
    slow: 'slow motion',
    hintEdit: 'Drag the tips of <b>v₁, v₂, v₃</b> · background = rotate · wheel or pinch = zoom',
    hintExplore: 'Rotate: drag · Zoom: wheel or pinch · “Edit” to move the vectors',
  },
}[lang];
---

<figure class="gso3d" data-gso3d data-uid={uid}
  data-hint-edit={STR.hintEdit} data-hint-explore={STR.hintExplore}
  data-pause-label={STR.pause} data-resume-label={STR.resume}>
  <div class="gso3d__stage">
    <canvas class="gso3d__canvas" aria-label={STR.aria}></canvas>
    <div class="gso3d__hint"></div>
  </div>

  <div class="gso3d__coordform" hidden>
    {[0, 1, 2].map(i => (
      <div class="gso3d__coordvec">
        <span class="gso3d__coordlabel">{['v₁', 'v₂', 'v₃'][i]}</span>
        {[0, 1, 2].map(j => (
          <input type="number" step="0.1" class="gso3d__coordinput"
            data-v={i} data-c={j}
            aria-label={`${['v₁', 'v₂', 'v₃'][i]} ${['x', 'y', 'z'][j]}`}
            placeholder={['x', 'y', 'z'][j]} />
        ))}
      </div>
    ))}
  </div>

  <div class="gso3d__controls">
    <button class="gso3d__btn gso3d__mode gso3d__compute is-on" type="button" aria-pressed="true">{STR.compute}</button>
    <button class="gso3d__btn gso3d__mode gso3d__edit" type="button" aria-pressed="false">{STR.edit}</button>
    <button class="gso3d__btn gso3d__reset" type="button">{STR.reset}</button>
    <span class="gso3d__slowcell">
      <label for={uid + '-slow'}>{STR.slow}</label>
      <input type="range" id={uid + '-slow'} class="gso3d__slow" min="0.1" max="1" value="1" step="0.05" />
      <span class="gso3d__slow-val">1.00×</span>
    </span>
  </div>

  <div class="gso3d__check">
    <span class="gso3d__cell">‖w₁‖,‖w₂‖,‖w₃‖ = <b class="gso3d__norms">—</b> <small>(≠ 1)</small></span>
    <span class="gso3d__cell">w₁·w₂, w₁·w₃, w₂·w₃ = <b class="gso3d__dots">—</b></span>
  </div>
  <div class="gso3d__coords">
    <span class="gso3d__cell">v₁, v₂, v₃ = <b class="gso3d__vcoords">—</b></span>
    <span class="gso3d__cell">w₁, w₂, w₃ = <b class="gso3d__wcoords">—</b></span>
  </div>
</figure>

<script>
  // ===================== ALGEBRA VETTORIALE DI BASE =====================
  type V3 = [number, number, number];
  const dot = (a: V3, b: V3) => a[0]*b[0] + a[1]*b[1] + a[2]*b[2];
  const sub = (a: V3, b: V3): V3 => [a[0]-b[0], a[1]-b[1], a[2]-b[2]];
  const add = (a: V3, b: V3): V3 => [a[0]+b[0], a[1]+b[1], a[2]+b[2]];
  const scl = (a: V3, k: number): V3 => [a[0]*k, a[1]*k, a[2]*k];
  const len = (a: V3) => Math.hypot(a[0], a[1], a[2]);
  const cross = (a: V3, b: V3): V3 => [
    a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0],
  ];
  const normv = (a: V3): V3 => { const n = len(a) || 1; return scl(a, 1/n); };

  // ORTOGONALIZZAZIONE (niente normalizzazione): coefficiente (v·w)/(w·w)
  function gramSchmidtOrtho(v1: V3, v2: V3, v3: V3) {
    const w1: V3 = [...v1] as V3;                 // w1 = v1 (resta tale e quale)
    const p2 = scl(w1, dot(v2, w1) / dot(w1, w1)); // proiezione di v2 su w1
    const w2 = sub(v2, p2);
    const p3a = scl(w1, dot(v3, w1) / dot(w1, w1)); // proiezione di v3 su w1
    const p3b = scl(w2, dot(v3, w2) / dot(w2, w2)); // proiezione di v3 su w2
    const w3 = sub(sub(v3, p3a), p3b);             // tolgo ENTRAMBE le proiezioni
    return { w1, w2, w3, p2, p3a, p3b };
  }

  // base ortonormale della telecamera (serve solo per disegnare in prospettiva)
  function camera(az: number, el: number) {
    const ce = Math.cos(el), se = Math.sin(el), ca = Math.cos(az), sa = Math.sin(az);
    const dir: V3 = [ce*ca, ce*sa, se];
    const right = normv(cross([0, 0, 1], dir));
    const up = cross(dir, right);
    return { dir, right, up };
  }

  const easeInOut = (t: number) => t < 0.5 ? 4*t*t*t : 1 - Math.pow(-2*t+2, 3)/2;

  // ============================ UNA ISTANZA ============================
  function initInstance(root: HTMLElement) {
    const canvas = root.querySelector('.gso3d__canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const normsEl = root.querySelector('.gso3d__norms') as HTMLElement;
    const dotsEl  = root.querySelector('.gso3d__dots') as HTMLElement;
    const vCoordsEl = root.querySelector('.gso3d__vcoords') as HTMLElement;
    const wCoordsEl = root.querySelector('.gso3d__wcoords') as HTMLElement;
    const coordForm = root.querySelector('.gso3d__coordform') as HTMLElement;
    const coordInputs: HTMLInputElement[][] = [0, 1, 2].map(i => [0, 1, 2].map(j =>
      root.querySelector(`.gso3d__coordinput[data-v="${i}"][data-c="${j}"]`) as HTMLInputElement));
    const computeBtn = root.querySelector('.gso3d__compute') as HTMLButtonElement;
    const editBtn = root.querySelector('.gso3d__edit') as HTMLButtonElement;
    const resetBtn = root.querySelector('.gso3d__reset') as HTMLButtonElement;
    const hintEl = root.querySelector('.gso3d__hint') as HTMLElement;
    const slowEl = root.querySelector('.gso3d__slow') as HTMLInputElement;
    const slowValEl = root.querySelector('.gso3d__slow-val') as HTMLElement;

    const V0: V3[] = [[2.0, 0.6, 0.4], [0.5, 2.0, 0.3], [0.4, 0.5, 2.0]];
    let v: V3[] = V0.map(a => [...a] as V3);
    let az = 0.7, el = 0.5;
    let zoom = 1;
    let mode: 'explore' | 'edit' = 'explore';   // a riposo: vettori BLOCCATI
    let geom = gramSchmidtOrtho(v[0], v[1], v[2]);

    const COL = {
      v: ['#7aa2f7', '#5fd0a0', '#f0bd6a'],     // input (tinte tenui)
      res: ['#3b82f6', '#10b981', '#f59e0b'],   // risultato w1, w2, w3 (vivi)
      proj: '#eab308',                          // proiezioni
      rightAngle: 'rgba(220,38,38,0.55)',       // segno di angolo retto (rosso tenue)
    };
    let ink = 'rgba(128,128,128,0.9)';
    function refreshThemeColors() { ink = getComputedStyle(canvas).color || 'rgb(128,128,128)'; }

    // ---------- dimensionamento responsivo ----------
    let W = 0, H = 0, baseScale = 80, scale = 80, cx = 0, cy = 0;
    function applyScale() { scale = baseScale * zoom; }
    function resize() {
      const cssW = canvas.clientWidth || 600;
      const cssH = Math.max(320, Math.min(cssW * 0.72, 460));
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.style.height = cssH + 'px';
      canvas.width = Math.round(cssW * dpr);
      canvas.height = Math.round(cssH * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      W = cssW; H = cssH;
      baseScale = Math.min(W, H) / 6.2;
      applyScale();
      cx = W / 2; cy = H / 2;
      draw();
    }

    let cam = camera(az, el);
    const project = (p: V3): [number, number] =>
      [cx + dot(p, cam.right) * scale, cy - dot(p, cam.up) * scale];

    // ---------- primitive di disegno ----------
    // Le etichette (v1, w1, ...) possono cadere nello stesso punto sullo schermo:
    // in questa variante w1 == v1 SEMPRE (nessuna normalizzazione al passo 1), quindi
    // le due frecce hanno la stessa punta e le etichette si sovrapporrebbero. labelPos
    // tiene traccia dei punti gia' occupati in questo fotogramma e sposta in basso
    // (a scalini) qualunque nuova etichetta che cadrebbe troppo vicina a una gia' posta.
    let placedLabels: [number, number][] = [];
    // riflette 'offset' (in pixel schermo) rispetto all'asse individuato, a schermo,
    // dalla proiezione di 'axisVec': usata per mettere l'etichetta w_i speculare a
    // v_i quando le due punte coincidono (base gia' orto-parziale o totale in ingresso:
    // w_i = v_i se v_i e' gia' ortogonale ai w precedenti).
    function mirrorOffsetAcrossAxis(axisVec: V3, offset: [number, number]): [number, number] {
      const A = project([0, 0, 0]);
      const B = project(axisVec);
      let ux = B[0]-A[0], uy = B[1]-A[1];
      const L = Math.hypot(ux, uy) || 1;
      ux /= L; uy /= L;
      const d = offset[0]*ux + offset[1]*uy;   // componente dell'offset lungo l'asse
      return [2*d*ux - offset[0], 2*d*uy - offset[1]];
    }
    function labelPos(bx: number, by: number): [number, number] {
      let x = bx + 8, y = by - 6;
      let guard = 0;
      while (placedLabels.some(([px, py]) => Math.hypot(px - x, py - y) < 15) && guard < 8) {
        y += 16;
        guard++;
      }
      placedLabels.push([x, y]);
      return [x, y];
    }
    function line(a: V3, b: V3, color: string, width: number, alpha = 1, dash: number[] = []) {
      const A = project(a), B = project(b);
      ctx.save();
      ctx.globalAlpha = alpha; ctx.strokeStyle = color; ctx.lineWidth = width;
      ctx.setLineDash(dash);
      ctx.beginPath(); ctx.moveTo(A[0], A[1]); ctx.lineTo(B[0], B[1]); ctx.stroke();
      ctx.restore();
    }
    function arrow(vec: V3, color: string, width: number, alpha = 1, label?: string, from: V3 = [0, 0, 0], labelOffset: [number, number] = [8, -6]) {
      const A = project(from), B = project(vec);
      const dx = B[0]-A[0], dy = B[1]-A[1], L = Math.hypot(dx, dy);
      ctx.save();
      ctx.globalAlpha = alpha; ctx.strokeStyle = color; ctx.fillStyle = color;
      ctx.lineWidth = width; ctx.lineCap = 'round';
      
      // asta: dalla proiezione di 'from' fino alla base della punta
      let shaftEnd: [number, number] = [B[0], B[1]];
      if (L > 6) {
        const ux = dx/L, uy = dy/L, h = 11;
        shaftEnd = [B[0]-ux*h, B[1]-uy*h];
      }
      ctx.beginPath(); ctx.moveTo(A[0], A[1]); ctx.lineTo(shaftEnd[0], shaftEnd[1]); ctx.stroke();
      
      // punta: isoscele, solo se il vettore è abbastanza lungo
      if (L > 6) {
        const ux = dx/L, uy = dy/L, h = 11, w = 6;
        const bx = B[0]-ux*h, by = B[1]-uy*h;
        const px = -uy, py = ux;
        ctx.beginPath();
        ctx.moveTo(B[0], B[1]);
        ctx.lineTo(bx + px*w, by + py*w);
        ctx.lineTo(bx - px*w, by - py*w);
        ctx.closePath(); ctx.fill();
      }
      
      // etichetta
      if (label) {
        ctx.globalAlpha = Math.min(1, alpha + 0.2);
        ctx.font = '600 14px system-ui, sans-serif';
        ctx.fillText(label, B[0] + labelOffset[0], B[1] + labelOffset[1]);
      }
      ctx.restore();
    }
    // segno "a L" di angolo retto nel punto 'corner', fra la direzione 'axisDir'
    // (l'asse su cui si proietta) e 'dropDir' (il tratteggio perpendicolare che
    // scende dalla punta del vettore originale). Disegnato in coordinate SCHERMO
    // (non in unita' 3D): resta leggibile a 8px qualunque sia zoom o angolo di vista.
    function rightAngleMark(corner: V3, axisDir: V3, dropDir: V3, alpha: number) {
      if (alpha <= 0.02) return;
      const C = project(corner);
      const Pa = project(add(corner, scl(axisDir, 0.01)));
      const Pd = project(add(corner, scl(dropDir, 0.01)));
      const ax = Pa[0]-C[0], ay = Pa[1]-C[1], aLen = Math.hypot(ax, ay) || 1;
      const dx = Pd[0]-C[0], dy = Pd[1]-C[1], dLen = Math.hypot(dx, dy) || 1;
      const ux = ax/aLen, uy = ay/aLen, vx = dx/dLen, vy = dy/dLen;
      const S = 8; // dimensione del segno in pixel
      const P1: [number, number] = [C[0]+ux*S, C[1]+uy*S];
      const P2: [number, number] = [P1[0]+vx*S, P1[1]+vy*S];
      const P3: [number, number] = [C[0]+vx*S, C[1]+vy*S];
      ctx.save();
      ctx.globalAlpha = alpha;
      ctx.strokeStyle = COL.rightAngle;
      ctx.lineWidth = 2;
      ctx.lineCap = 'round'; ctx.lineJoin = 'round';
      ctx.beginPath();
      ctx.moveTo(P1[0], P1[1]); ctx.lineTo(P2[0], P2[1]); ctx.lineTo(P3[0], P3[1]);
      ctx.stroke();
      ctx.restore();
    }
    function axes() {
      const ax: [V3, string][] = [[[3,0,0],'x'], [[0,3,0],'y'], [[0,0,3],'z']];
      for (const [a, lab] of ax) {
        line(scl(a, -1) as V3, a, ink, 1, 0.18);
        const P = project(a);
        ctx.save();
        ctx.globalAlpha = 0.35; ctx.fillStyle = ink;
        ctx.font = '12px system-ui, sans-serif';
        ctx.fillText(lab, P[0] + 4, P[1] - 4);
        ctx.restore();
      }
    }

    // ---------- stato della "vista costruzione" ----------
    // r1,r2,r3 = frazione di crescita dei vettori risultato w1,w2,w3
    type View = {
      r1?: number; r2?: number; r3?: number;
      p2?: number; p3a?: number; p3b?: number;
      drop2?: number; drop3a?: number; drop3b?: number;
    };
    let view: View = {};
    function staticView() { view = { r1: 1, r2: 1, r3: 1 }; } // a riposo: i tre w pieni

    function draw() {
      cam = camera(az, el);
      ctx.clearRect(0, 0, W, H);
      placedLabels = [];
      axes();

      // input v_i (sempre visibili: sono le maniglie)
      for (let i = 0; i < 3; i++)
        arrow(v[i], COL.v[i], 2.5, 0.55, ['v₁', 'v₂', 'v₃'][i]);

      // proiezioni (giallo) e tratteggi perpendicolari
      if (view.p2)  arrow(scl(geom.p2, view.p2), COL.proj, 3, 0.95);
      if (view.drop2) { line(geom.p2, v[1], ink, 1.5, 0.5 * view.drop2, [5, 4]); rightAngleMark(geom.p2, normv(geom.w1), normv(sub(v[1], geom.p2)), view.drop2); }
      if (view.p3a) arrow(scl(geom.p3a, view.p3a), COL.proj, 3, 0.95);
      if (view.drop3a) { line(geom.p3a, v[2], ink, 1.5, 0.5 * view.drop3a, [5, 4]); rightAngleMark(geom.p3a, normv(geom.w1), normv(sub(v[2], geom.p3a)), view.drop3a); }
      if (view.p3b) arrow(scl(geom.p3b, view.p3b), COL.proj, 3, 0.95);
      if (view.drop3b) { line(geom.p3b, v[2], ink, 1.5, 0.5 * view.drop3b, [5, 4]); rightAngleMark(geom.p3b, normv(geom.w2), normv(sub(v[2], geom.p3b)), view.drop3b); }

      // risultato: i tre vettori ortogonali w1, w2, w3 (vivi), in crescita
      if (view.r1) arrow(scl(geom.w1, view.r1), COL.res[0], 3.5, 1, view.r1 > 0.9 ? 'w₁' : undefined, [0, 0, 0], mirrorOffsetAcrossAxis(v[0], [8, -6]));
      if (view.r2) arrow(scl(geom.w2, view.r2), COL.res[1], 3.5, 1, view.r2 > 0.9 ? 'w₂' : undefined, [0, 0, 0], mirrorOffsetAcrossAxis(v[1], [8, -6]));
      if (view.r3) arrow(scl(geom.w3, view.r3), COL.res[2], 3.5, 1, view.r3 > 0.9 ? 'w₃' : undefined, [0, 0, 0], mirrorOffsetAcrossAxis(v[2], [8, -6]));

      updateReadout();   // norme/prodotti scalari + coordinate: sempre in sincrono col disegno
    }

    function updateReadout() {
      const { w1, w2, w3 } = geom;
      normsEl.textContent = [w1, w2, w3].map(w => len(w).toFixed(2)).join(', ');
      dotsEl.textContent = [dot(w1, w2), dot(w1, w3), dot(w2, w3)]
        .map(x => (Math.abs(x) < 5e-3 ? '0.00' : x.toFixed(2))).join(', ');

      // coordinate: v (1 decimale, come le caselle di Modifica) sempre visibili;
      // w (2 decimali) si rivelano una per una, in sincrono con l'animazione: 'view.rN'
      // esiste (>0) solo da quando la freccia w_N inizia a crescere (stesso stato del disegno).
      const fmtV = (p: V3) => `(${p.map(x => x.toFixed(1)).join(', ')})`;
      const fmtW = (p: V3) => `(${p.map(x => x.toFixed(2)).join(', ')})`;
      vCoordsEl.textContent = v.map(fmtV).join('  ');
      wCoordsEl.textContent = [
        view.r1 ? fmtW(scl(geom.w1, view.r1)) : '—',
        view.r2 ? fmtW(scl(geom.w2, view.r2)) : '—',
        view.r3 ? fmtW(scl(geom.w3, view.r3)) : '—',
      ].join('  ');
    }

    // ---------- rallentatore: fattore di velocita' dell'animazione ----------
    // 1.00 = velocita' attuale (nessuna modifica); valori piu' bassi = piu' lento.
    // Il fattore viene letto una volta all'avvio di ogni play(), cosi' una
    // riproduzione in corso resta coerente anche se lo slider viene toccato.
    let speed = 1;
    function updateSpeedLabel() {
      slowValEl.textContent = speed.toFixed(2) + '×';
    }
    slowEl.addEventListener('input', () => {
      speed = +slowEl.value;
      updateSpeedLabel();
    });

    // ---------- animazione a fasi ----------
    let animToken = 0;
    let runId = 0;
    const aborted = (my: number) => my !== runId;

    // ---------- pausa: congela l'avanzamento di tween/wait senza perdere lo stato ----------
    // il bottone "Calcola e mantieni" fa ora anche da Pausa/Riprendi (un solo
    // pulsante, 3 stati, come il tasto Avvia di SimulatoreUrti): a riposo avvia,
    // durante l'esecuzione mette in pausa, in pausa riprende.
    let paused = false;
    let running = false;
    const IDLE_LABEL = computeBtn.textContent ?? '';
    const PAUSE_LABEL = root.dataset.pauseLabel ?? '';
    const RESUME_LABEL = root.dataset.resumeLabel ?? '';
    function setPaused(p: boolean) {
      paused = p;
      computeBtn.textContent = paused ? RESUME_LABEL : PAUSE_LABEL;
    }
    function setRunning(r: boolean) {
      running = r;
      paused = false;
      computeBtn.textContent = r ? PAUSE_LABEL : IDLE_LABEL;
    }

    // tween e wait avanzano un "elapsed" solo quando non in pausa: durante la
    // pausa il rAF continua a girare (per restare pronti a riprendere subito)
    // ma il tempo trascorso non si accumula, cosi' l'animazione resta congelata
    // esattamente al fotogramma in cui e' stata messa in pausa.
    function tween(ms: number, cb: (t: number) => void) {
      return new Promise<void>(res => {
        const tok = ++animToken;
        let elapsed = 0, last = performance.now();
        const frame = (now: number) => {
          if (tok !== animToken) { res(); return; }
          if (!paused) elapsed += now - last;
          last = now;
          const t = Math.min(1, elapsed / ms);
          cb(easeInOut(t)); draw();
          if (t < 1) requestAnimationFrame(frame); else res();
        };
        requestAnimationFrame(frame);
      });
    }
    function wait(ms: number) {
      return new Promise<void>(res => {
        const tok = animToken;
        let elapsed = 0, last = performance.now();
        const frame = (now: number) => {
          if (tok !== animToken) { res(); return; }
          if (!paused) elapsed += now - last;
          last = now;
          if (elapsed >= ms) { res(); return; }
          requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      });
    }

    // interrompe del tutto una riproduzione in corso (usata da tip-drag, Modifica, Reset)
    function cancelPlay() {
      animToken++; runId++;
      setRunning(false);
    }

    async function play() {
      const my = ++runId;
      const spd = Math.max(0.05, speed);    // fattore congelato per questa riproduzione
      const t = (ms: number) => ms / spd;   // scala una durata in base al rallentatore
      geom = gramSchmidtOrtho(v[0], v[1], v[2]);
      view = {}; animToken++;
      setRunning(true);
      const stop = () => setRunning(false);

      // PASSO 1: w1 = v1 (nessuna normalizzazione: cresce fino a v1 e basta)
      await tween(t(650), tt => { view.r1 = tt; }); if (aborted(my)) return stop();
      await wait(t(250)); if (aborted(my)) return stop();

      // PASSO 2: proietto v2 su w1, sottraggo -> w2 (NON normalizzo)
      await tween(t(650), tt => { view.p2 = tt; view.drop2 = tt; }); if (aborted(my)) return stop();
      await tween(t(650), tt => {                       // cresce w2, sfumano proiezione/tratteggio
        view.r2 = tt; view.p2 = 1 - tt; view.drop2 = 1 - tt;
      }); if (aborted(my)) return stop();
      view.r2 = 1; view.p2 = view.drop2 = 0;
      await wait(t(250)); if (aborted(my)) return stop();

      // PASSO 3: DUE proiezioni INDIPENDENTI (su w1 e su w2), calcolate ciascuna
      // direttamente sul proprio vettore GIA' ortogonale (coefficiente (v3*w1)/(w1*w1)
      // e (v3*w2)/(w2*w2) presi separatamente): NON e' una proiezione sul piano w1-w2.
      // La freccia della seconda proiezione (p3b) viene disegnata in coda alla prima
      // (dalla punta di p3a, non dall'origine): resta comunque parallela a w2 - e' solo
      // una traslazione per addizione vettoriale - ma cosi' si vede chiaramente che e'
      // un passo lungo w2, non un salto diagonale nel piano. Entrambe le proiezioni (e i
      // relativi tratteggi guida) restano visibili insieme finche' non vengono sottratte
      // da v3 per formare w3.
      await tween(t(650), tt => { view.p3a = tt; view.drop3a = tt; }); if (aborted(my)) return stop();
      await wait(t(180)); if (aborted(my)) return stop();
      await tween(t(650), tt => { view.p3b = tt; view.drop3b = tt; }); if (aborted(my)) return stop();
      await tween(t(700), tt => {                       // cresce w3, sfuma tutto il resto
        view.r3 = tt;
        view.p3a = view.p3b = view.drop3a = view.drop3b = 1 - tt;
      }); if (aborted(my)) return stop();

      staticView(); draw();
      stop();
    }

    // ---------- modalita': explore (bloccato) vs edit ----------
    const HINT = {
      edit: root.dataset.hintEdit ?? '',
      explore: root.dataset.hintExplore ?? '',
    };
    function setMode(m: 'explore' | 'edit') {
      mode = m;
      computeBtn.classList.toggle('is-on', m === 'explore');
      editBtn.classList.toggle('is-on', m === 'edit');
      computeBtn.setAttribute('aria-pressed', String(m === 'explore'));
      editBtn.setAttribute('aria-pressed', String(m === 'edit'));
      hintEl.innerHTML = m === 'edit' ? HINT.edit : HINT.explore;
      coordForm.hidden = m !== 'edit';
      if (m === 'edit') syncCoordInputs();
      canvas.style.cursor = 'default';
    }

    // ---------- caselle coordinate (v1,v2,v3): sincronizzate col trascinamento ----------
    function syncCoordInputs() {
      for (let i = 0; i < 3; i++)
        for (let j = 0; j < 3; j++)
          if (document.activeElement !== coordInputs[i][j])
            coordInputs[i][j].value = v[i][j].toFixed(1);
    }
    function commitCoordInput(i: number, j: number) {
      const el = coordInputs[i][j];
      const val = parseFloat(el.value.replace(',', '.'));
      if (Number.isFinite(val)) {
        v[i][j] = val;
        geom = gramSchmidtOrtho(v[0], v[1], v[2]);
        staticView(); draw();
      }
      el.value = v[i][j].toFixed(1);
    }
    for (let i = 0; i < 3; i++) for (let j = 0; j < 3; j++) {
      const el = coordInputs[i][j];
      el.addEventListener('change', () => commitCoordInput(i, j));
      el.addEventListener('keydown', e => { if (e.key === 'Enter') el.blur(); });
    }

    // ---------- zoom (rotella) ----------
    canvas.addEventListener('wheel', e => {
      e.preventDefault();
      zoom = Math.max(0.4, Math.min(4, zoom * Math.exp(-e.deltaY * 0.0015)));
      applyScale(); draw();
    }, { passive: false });

    // ---------- interazione (mouse + touch + pinch) ----------
    let drag: { kind: 'orbit' } | { kind: 'tip'; i: number } | null = null;
    let last = { x: 0, y: 0 };
    const pts = new Map<number, { x: number; y: number }>();
    let pinch: { dist: number; zoom: number } | null = null;

    function pointerPos(e: PointerEvent) {
      const r = canvas.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    }
    function hitTip(px: number, py: number) {
      for (let i = 0; i < 3; i++) {
        const P = project(v[i]);
        if (Math.hypot(P[0]-px, P[1]-py) < 16) return i;
      }
      return -1;
    }
    const twoDist = () => {
      const [a, b] = [...pts.values()];
      return Math.hypot(a.x-b.x, a.y-b.y);
    };

    canvas.addEventListener('pointerdown', e => {
      // NOTA: qui NON si interrompe piu' l'animazione a priori. La si interrompe
      // solo se l'interazione risulta essere un trascinamento di una punta di
      // vettore (tip-drag, possibile solo in Modifica): orbitare la vista o fare
      // pinch-zoom deve restare possibile SEMPRE, anche a play in corso o in pausa.
      canvas.setPointerCapture(e.pointerId);
      const p = pointerPos(e);
      pts.set(e.pointerId, p);
      if (pts.size === 2) { drag = null; pinch = { dist: twoDist(), zoom }; return; }
      if (mode === 'edit') {
        const i = hitTip(p.x, p.y);
        if (i >= 0) {
          cancelPlay();                 // modificare un vettore invalida l'animazione in corso
          drag = { kind: 'tip', i };
          canvas.style.cursor = 'grabbing';
        } else {
          drag = { kind: 'orbit' };
          canvas.style.cursor = 'move';
        }
      } else {
        drag = { kind: 'orbit' };
        canvas.style.cursor = 'move';
      }
      last = p;
    });

    canvas.addEventListener('pointermove', e => {
      if (pts.has(e.pointerId)) pts.set(e.pointerId, pointerPos(e));
      if (pinch && pts.size >= 2) {
        e.preventDefault();
        zoom = Math.max(0.4, Math.min(4, pinch.zoom * (twoDist() / pinch.dist)));
        applyScale(); draw();
        return;
      }
      if (!drag) {
        if (mode === 'edit') {
          const p = pointerPos(e);
          canvas.style.cursor = hitTip(p.x, p.y) >= 0 ? 'grab' : 'default';
        }
        return;
      }
      e.preventDefault();
      const p = pointerPos(e);
      const dx = p.x - last.x, dy = p.y - last.y;
      last = p;
      if (drag.kind === 'orbit') {
        az -= dx * 0.01;
        el = Math.max(-1.45, Math.min(1.45, el + dy * 0.01));
      } else {
        const world = add(scl(cam.right, dx / scale), scl(cam.up, -dy / scale));
        v[drag.i] = add(v[drag.i], world);
        geom = gramSchmidtOrtho(v[0], v[1], v[2]);   // ricalcolo solo qui
        staticView(); updateReadout(); syncCoordInputs();
      }
      draw();
    });

    const endPointer = (e: PointerEvent) => {
      pts.delete(e.pointerId);
      try { canvas.releasePointerCapture(e.pointerId); } catch {}
      if (pts.size < 2) pinch = null;
      if (pts.size === 0) { drag = null; canvas.style.cursor = 'default'; }
      else { drag = null; last = [...pts.values()][0]; }
    };
    canvas.addEventListener('pointerup', endPointer);
    canvas.addEventListener('pointercancel', endPointer);

    // ---------- pulsanti ----------
    computeBtn.addEventListener('click', () => {
      if (running) { setPaused(!paused); return; }   // toggle pausa/ripresa
      setMode('explore'); play();                     // a riposo: avvia
    });
    editBtn.addEventListener('click', () => {
      cancelPlay();
      setMode('edit'); staticView(); draw();
    });
    resetBtn.addEventListener('click', () => {
      // NOTA: il rallentatore NON viene toccato dal reset (resta come l'ha impostato l'utente)
      cancelPlay();
      v = V0.map(a => [...a] as V3);
      az = 0.7; el = 0.5; zoom = 1; applyScale();
      geom = gramSchmidtOrtho(v[0], v[1], v[2]);
      setMode('explore'); staticView(); updateReadout(); syncCoordInputs(); draw();
    });

    // ---------- avvio ----------
    refreshThemeColors();
    setMode('explore');
    staticView();
    updateReadout();
    syncCoordInputs();
    updateSpeedLabel();
    new ResizeObserver(resize).observe(canvas);
    new MutationObserver(() => { refreshThemeColors(); draw(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'class'] });
    resize();
  }

  document.querySelectorAll<HTMLElement>('[data-gso3d]').forEach(initInstance);
</script>

