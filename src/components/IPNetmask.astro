          : 'IP and mask bits: the green rectangle selects the columns where the mask is 0; below, the host part.'),
      },
    }[LANG];
    const L = D;

    // ── riferimenti DOM ──────────────────────────────────────────────
    const ipInput = root.querySelector('#ipnIp');
    const maskInput = root.querySelector('#ipnMask');
    const statusEl = root.querySelector('#ipnStatus');
    const quickEl = root.querySelector('#ipnQuick');
    const fullEl = root.querySelector('#ipnFull');

    // ── helper rendering (da BaseConverter) ──────────────────────────
    const KOPTS_DISPLAY = { throwOnError: false, displayMode: true };
    const KOPTS_INLINE = { throwOnError: false, displayMode: false };
    const RMOPTS = {
      throwOnError: false,
      delimiters: [
        { left: '\\(', right: '\\)', display: false },
        { left: '\\[', right: '\\]', display: true },
      ],
    };
    function kx(tex, display) {
      try { return katex.renderToString(tex, display ? KOPTS_DISPLAY : KOPTS_INLINE); }
      catch (e) { return '<span style="color:#e55">[KaTeX error]</span>'; }
    }
    function renderInline(el) { try { renderMathInElement(el, RMOPTS); } catch (e) {} }
    function reveal(el) { el.hidden = false; el.style.display = 'block'; requestAnimationFrame(() => el.classList.add('ipn-visible')); }
    function hide(el) { el.classList.remove('ipn-visible'); el.style.display = 'none'; el.hidden = true; }
    function tip(msg) { statusEl.textContent = msg; statusEl.className = 'ipn-status ipn-error'; }
    function unTip() {
      statusEl.textContent = ''; statusEl.className = 'ipn-status';
      ipInput.classList.remove('ipn-invalid'); maskInput.classList.remove('ipn-invalid');
    }
    function emit(target, html, tex) {
      if (html) { const d = document.createElement('div'); d.className = 'ipn-text'; d.innerHTML = html; target.appendChild(d); renderInline(d); }
      if (tex) { const w = document.createElement('div'); w.className = 'ipn-katex'; w.innerHTML = kx(tex, true); target.appendChild(w); }
    }
    function emitTip(target, html) {
      const d = document.createElement('div'); d.className = 'ipn-tip'; d.innerHTML = html; target.appendChild(d); renderInline(d);
    }
    function appendNode(target, node) { target.appendChild(node); }
    function heading(target, text) { const h = document.createElement('h5'); h.textContent = text; target.appendChild(h); }
    function block(target) { const b = document.createElement('div'); b.className = 'ipn-octblock'; target.appendChild(b); return b; }
    function clearResults() { quickEl.innerHTML = ''; fullEl.innerHTML = ''; hide(quickEl); hide(fullEl); }

    // ── bit e ottetti ────────────────────────────────────────────────
    const bitsOf = (oct) => oct.map((v) => v.toString(2).padStart(8, '0')).join('');
    const octetsOf = (bits) => [0, 1, 2, 3].map((k) => parseInt(bits.slice(8 * k, 8 * k + 8), 2));
    const dotted = (oct) => oct.join('.');
    const dottedBits = (bits) => bits.match(/.{8}/g).join('.');

    // ── parsing di un indirizzo in decimale puntato ──────────────────
    function parseDotted(raw) {
      const s = String(raw).trim().replace(/\s+/g, '');
      if (!s) return { error: 'empty' };
      const parts = s.split('.');
      if (parts.length !== 4) return { error: 'parts' };
      const oct = [];
      for (let k = 0; k < 4; k++) {
        const t = parts[k];
        if (t === '') return { error: 'octet_empty', k: k + 1 };
        if (!/^[0-9]{1,3}$/.test(t) || parseInt(t, 10) > 255) return { error: 'octet', k: k + 1, detail: t };
        oct.push(parseInt(t, 10));
      }
      return { ok: true, oct };
    }
    function parseError(field, err) {
      if (err.error === 'empty') return L.errEmpty[field];
      if (err.error === 'parts') return L.errParts[field];
      if (err.error === 'octet_empty') return L.errOctetEmpty[field](err.k);
      return L.errOctet[field](err.k, err.detail);
    }

    // ── analisi: prefisso, rete, parte host ──────────────────────────
    function analyze(ipOct, maskOct) {
      const ipBits = bitsOf(ipOct);
      const maskBits = bitsOf(maskOct);
      const firstZero = maskBits.indexOf('0');
      const p = firstZero === -1 ? 32 : firstZero;
      const again = maskBits.indexOf('1', p);
      if (again !== -1) {
        const k = Math.floor(again / 8);
        return { error: 'mask_shape', k: k + 1, bits: maskBits.slice(8 * k, 8 * k + 8) };
      }
      const h = 32 - p;
      const netBits = ipBits.slice(0, p) + '0'.repeat(h);
      const hostBits = '0'.repeat(p) + ipBits.slice(p);
      return {
        ipOct, maskOct, ipBits, maskBits, p, h, netBits, hostBits,
        netOct: octetsOf(netBits), hostOct: octetsOf(hostBits),
      };
    }

    // ============================================================= costruttori visuali

    // board dell'espansione posizionale (da BaseConverter)
    function buildPositionalBoard(digits, base) {
      const n = digits.length;
      const scroller = document.createElement('div');
      scroller.className = 'ipn-board-scroller';
      const grid = document.createElement('div');
      grid.className = 'ipn-grid';
      const nCols = 2 * n - 1;
      grid.style.gridTemplateColumns = `repeat(${nCols}, auto)`;
      digits.forEach((d, idx) => {
        const power = n - 1 - idx;
        const col = 2 * idx + 1;
        const sym = String(d);

        const digitCell = document.createElement('div');
        digitCell.className = 'ipn-cell ipn-digit';
        digitCell.style.gridColumn = String(col);
        digitCell.style.gridRow = '1';
        digitCell.textContent = sym;
        grid.appendChild(digitCell);

        const posLabel = document.createElement('div');
        posLabel.className = 'ipn-cell ipn-poslabel';
        posLabel.style.gridColumn = String(col);
        posLabel.style.gridRow = '2';
        // etichetta su due righe: con 8 bit la board resta dentro la colonna di testo
        posLabel.innerHTML = `${L.posLabel}<br><span class="ipn-green">${power}</span>`;
        grid.appendChild(posLabel);

        const termCell = document.createElement('div');
        termCell.className = 'ipn-cell ipn-term';
        termCell.style.gridColumn = String(col);
        termCell.style.gridRow = '3';
        termCell.innerHTML = kx(`\\textcolor{${RED}}{\\text{${sym}}}\\cdot ${base}^{\\textcolor{${GREEN}}{${power}}}`, false);
        grid.appendChild(termCell);

        if (idx < n - 1) {
          const plus = document.createElement('div');
          plus.className = 'ipn-cell ipn-plus';
          plus.style.gridColumn = String(col + 1);
          plus.style.gridRow = '3';
          plus.innerHTML = kx('+', false);
          grid.appendChild(plus);
        }
      });
      scroller.appendChild(grid);
      return scroller;
    }

    // tabella divisioni successive con freccia rossa di lettura (da BaseConverter)
    function buildDivisionTable(rows, toBase) {
      const wrap = document.createElement('div');
      wrap.className = 'ipn-tablewrap';
      const table = document.createElement('table');
      table.className = 'ipn-booktable ipn-divtable';
      const thead = document.createElement('thead');
      thead.innerHTML = `<tr><th>${L.bTableHead.div}</th><th></th><th>${L.bTableHead.quo}</th><th>${L.bTableHead.rem}</th><th></th></tr>`;
      table.appendChild(thead);
      const tbody = document.createElement('tbody');
      rows.forEach((r, idx) => {
        const tr = document.createElement('tr');
        const tdDiv = document.createElement('td'); tdDiv.textContent = String(r.dividend);
        const tdOp = document.createElement('td'); tdOp.innerHTML = kx(`\\div ${toBase} \\;=\\;`, false);
        const tdQuo = document.createElement('td'); tdQuo.textContent = String(r.quotient);
        const tdRem = document.createElement('td'); tdRem.className = 'ipn-remainder';
        const box = document.createElement('span'); box.className = 'ipn-remainder-box'; box.textContent = String(r.remainder);
        tdRem.appendChild(box);
        tr.appendChild(tdDiv); tr.appendChild(tdOp); tr.appendChild(tdQuo); tr.appendChild(tdRem);
        if (idx === 0) {
          const tdArrow = document.createElement('td');
          tdArrow.className = 'ipn-readarrow-cell';
          tdArrow.rowSpan = rows.length;
          const arrow = document.createElement('div');
          arrow.className = 'ipn-readarrow';
          const head = document.createElement('div');
          head.className = 'ipn-readarrow-head';
          arrow.appendChild(head);
          tdArrow.appendChild(arrow);
          tr.appendChild(tdArrow);
        }
        tbody.appendChild(tr);
      });
      table.appendChild(tbody);
      wrap.appendChild(table);
      return wrap;
    }

    // tabella generica in stile "libro" (celle in HTML)
    function buildBookTable(head, rows, extraClass) {
      const wrap = document.createElement('div');
      wrap.className = 'ipn-tablewrap';
      const table = document.createElement('table');
      table.className = 'ipn-booktable' + (extraClass ? ' ' + extraClass : '');
      const thead = document.createElement('thead');
      thead.innerHTML = `<tr>${head.map((x) => `<th>${x}</th>`).join('')}</tr>`;
      table.appendChild(thead);
      const tbody = document.createElement('tbody');
      rows.forEach((r) => {
        const tr = document.createElement('tr');
        r.forEach((cell, j) => {
          const td = document.createElement('td');
          if (j === 0) td.className = 'ipn-rowhead';
          td.innerHTML = cell;
          tr.appendChild(td);
        });
        tbody.appendChild(tr);
      });
      table.appendChild(tbody);
      wrap.appendChild(table);
      return wrap;
    }

    // ── figura SVG: IP sopra, maschera sotto, rettangolo di selezione,
    //    riga del risultato con i bit copiati e gli zeri aggiunti ───────
    const FG = { cell: 22, gap: 9, label: 150, pad: 10 };
    const fx = (i) => FG.label + i * FG.cell + Math.floor(i / 8) * FG.gap;
    const FIG_RIGHT = fx(31) + FG.cell;
    const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    function svgText(x, y, txt, cls, anchor) {
      return `<text x="${x}" y="${y}" class="${cls}" text-anchor="${anchor || 'middle'}" dominant-baseline="central">${esc(txt)}</text>`;
    }

    function buildMaskFigure(kind, info) {
      const net = kind === 'net';
      const a = net ? 0 : info.p;          // colonne selezionate: [a, b)
      const b = net ? info.p : 32;
      const res = net ? info.netBits : info.hostBits;
      const color = net ? RED : GREEN;
      const C = FG.cell;
      // niente valori decimali degli ottetti nella figura: al confine fra bit
      // selezionati e bit esclusi un valore riferito all'intero ottetto confonde.
      // Le parentesi (e le etichette) sono staccate di 36 unita' dalla riga
      // del risultato.
      const yIp = 6, yMask = 32, yRes = 92, yBrace = 128, yBraceTxt = 142, H = 154;
      const W = FIG_RIGHT + FG.pad;
      const out = [];
      out.push(`<svg class="ipn-fig" viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(L.figAria(kind))}" xmlns="http://www.w3.org/2000/svg">`);

      // una riga di 32 caselle. Opzioni:
      //  sel: [da, a) colonne selezionate; fuori da qui, nella riga del
      //       risultato, le caselle sono zeri aggiunti (grigi e tratteggiati)
      //  cross: [da, a) colonne selezionate; le altre si barrano con una X grigia
      const row = (y, bits, label, opts) => {
        const o = opts || {};
        out.push(svgText(FG.label - 10, y + C / 2, label, 'ipn-rowlabel', 'end'));
        for (let i = 0; i < 32; i++) {
          const filler = o.sel && !(i >= o.sel[0] && i < o.sel[1]);
          const crossed = o.cross && !(i >= o.cross[0] && i < o.cross[1]);
          out.push(`<rect x="${fx(i)}" y="${y}" width="${C}" height="${C}" class="${filler ? 'ipn-cfill' : 'ipn-c'}"/>`);
          if (o.sel && !filler) {
            out.push(`<rect x="${fx(i)}" y="${y}" width="${C}" height="${C}" fill="${color}" fill-opacity="0.16"/>`);
          }
          out.push(svgText(fx(i) + C / 2, y + C / 2 + 0.5, bits[i], filler ? 'ipn-bitfill' : 'ipn-bit'));
          if (crossed) {
            const x0 = fx(i) + 3, y0 = y + 3, s = C - 6;
            out.push(`<path d="M ${x0} ${y0} L ${x0 + s} ${y0 + s} M ${x0} ${y0 + s} L ${x0 + s} ${y0}" class="ipn-cross"/>`);
          }
        }
      };
      row(yIp, info.ipBits, L.figIp, { cross: [a, b] });
      row(yMask, info.maskBits, L.figMask);
      row(yRes, res, net ? L.figNet : L.figHost, { sel: [a, b] });

      if (b > a) {
        // rettangolo trasparente che raccoglie IP e maschera sulle colonne selezionate
        const x1 = fx(a) - 4, x2 = fx(b - 1) + C + 4;
        out.push(`<rect x="${x1}" y="${yIp - 4}" width="${x2 - x1}" height="${yMask + C + 4 - (yIp - 4)}" rx="5" fill="${color}" fill-opacity="0.16" stroke="${color}" stroke-width="2.2"/>`);
        // stesso contorno, piu' sottile, sui bit copiati nella riga del risultato
        out.push(`<rect x="${x1}" y="${yRes - 4}" width="${x2 - x1}" height="${C + 8}" rx="5" fill="none" stroke="${color}" stroke-width="1.4"/>`);
        // freccia verso il basso: i bit dell'IP scendono nel risultato
        const cx = (x1 + x2) / 2;
        out.push(`<line x1="${cx}" y1="${yMask + C + 9}" x2="${cx}" y2="${yRes - 15}" stroke="${color}" stroke-width="2.2"/>`);
        out.push(`<polygon points="${cx - 6},${yRes - 16} ${cx + 6},${yRes - 16} ${cx},${yRes - 7}" fill="${color}"/>`);
      }

      // parentesi sotto il risultato: bit copiati / zeri aggiunti
      const segs = net
        ? [[0, info.p, L.braceIp(info.p), color], [info.p, 32, L.braceZero(info.h), GRAY]]
        : [[0, info.p, L.braceZero(info.p), GRAY], [info.p, 32, L.braceIp(info.h), color]];
      segs.forEach(([s, e, txt, col]) => {
        if (e <= s) return;
        const bx1 = fx(s) + 2, bx2 = fx(e - 1) + C - 2;
        out.push(`<path d="M ${bx1} ${yBrace - 5} V ${yBrace} H ${bx2} V ${yBrace - 5}" class="ipn-brace" stroke="${col}"/>`);
        // etichetta centrata, ma tenuta dentro la figura se il tratto e' corto
        const w = txt.length * 6.2;
        let x = (bx1 + bx2) / 2, anchor = 'middle';
        if (x - w / 2 < FG.label) { x = bx1; anchor = 'start'; }
        else if (x + w / 2 > FIG_RIGHT) { x = bx2; anchor = 'end'; }
        out.push(svgText(x, yBraceTxt, txt, 'ipn-bracelabel', anchor));
      });

      out.push('</svg>');
      const wrap = document.createElement('div');
      wrap.className = 'ipn-figwrap';
      wrap.innerHTML = out.join('');
      return wrap;
    }

    // ============================================================= passaggi

    // divisioni successive per 2 di un ottetto: tabella + lettura, ritorna le cifre
    function renderDivisions(target, valueBig, toBase) {
      const rows = [];
      let q = valueBig;
      const b = BigInt(toBase);
      if (q === 0n) rows.push({ dividend: '0', quotient: '0', remainder: 0 });
      else {
        while (q > 0n) {
          const r = Number(q % b);
          const nq = q / b;
          rows.push({ dividend: q.toString(), quotient: nq.toString(), remainder: r });
          q = nq;
        }
      }
      const raw = rows.map((r) => r.remainder).reverse().join('');
      appendNode(target, buildDivisionTable(rows, toBase));
      emit(target, L.bRead, `${valueBig.toString()}_{10} \\;\\Longrightarrow\\; \\text{${raw}}_{${toBase}}`);
      return raw;
    }

    // espansione posizionale di un ottetto (board + somma), da BaseConverter
    function renderPositional(target, digits, fromBase, valueBig) {
      const n = digits.length;
      const termsTex = digits.map((d, idx) => `${d}\\cdot ${fromBase}^{${n - 1 - idx}}`).join(' + ');
      const valuesTex2 = digits.map((d, idx) => {
        const p = (BigInt(fromBase) ** BigInt(n - 1 - idx)).toString();
        return `${d}\\cdot ${p}`;
      }).join(' + ');
      const productsTex = digits.map((d, idx) => (BigInt(d) * (BigInt(fromBase) ** BigInt(n - 1 - idx))).toString()).join(' + ');
      const inTex = `\\text{${digits.join('')}}_{${fromBase}}`;
      appendNode(target, buildPositionalBoard(digits, fromBase));
      emit(target, '', `\\begin{aligned} ${inTex} &= ${termsTex} \\\\ & = ${valuesTex2} \\\\ & = ${productsTex} \\\\ & = ${valueBig.toString()}_{10} \\end{aligned}`);
    }

    // ritorno al decimale degli ottetti del risultato
    function renderBack(target, kind, info) {
      const a = kind === 'net' ? 0 : info.p;
      const b = kind === 'net' ? info.p : 32;
      const bits = kind === 'net' ? info.netBits : info.hostBits;
      const oct = kind === 'net' ? info.netOct : info.hostOct;
      emit(target, L.backIntro(kind === 'net' ? L.backNet : L.backHost));
      for (let k = 0; k < 4; k++) {
        const lo = 8 * k, hi = 8 * k + 8;
        const selected = Math.max(0, Math.min(hi, b) - Math.max(lo, a));
        const ob = bits.slice(lo, hi);
        const blk = block(target);
        if (selected === 8) emit(blk, L.octCopied(k + 1, info.ipOct[k]));
        else if (selected === 0) emit(blk, L.octZero(k + 1));
        else {
          emit(blk, L.octExpand(k + 1, ob));
          renderPositional(blk, ob.split('').map(Number), 2, BigInt(oct[k]));
        }
      }
    }

    function resultTex(bits, oct) {
      return `\\begin{aligned} \\text{${L.binWord}:}\\;\\; & \\texttt{${dottedBits(bits)}} \\\\ \\text{${L.decWord}:}\\;\\; & ${dotted(oct)} \\end{aligned}`;
    }

    function buildSummary(info) {
      const mono = (s) => `<code>${s}</code>`;
      const vals = [
        dotted(info.ipOct), dottedBits(info.ipBits), dotted(info.maskOct), dottedBits(info.maskBits),
        '/' + info.p, String(info.p), String(info.h),
        dotted(info.netOct), dottedBits(info.netBits), dotted(info.hostOct), dottedBits(info.hostBits),
      ];
      const rows = L.sumRows.map((label, i) => [label, mono(vals[i])]);
      return buildBookTable(['', ''], rows, 'ipn-sumtable');
    }

    function hostNote(info) {
      if (info.h < 2) return '';
      const hostOfIp = info.ipBits.slice(info.p);
      if (!hostOfIp.includes('1')) return L.noteNet;
      if (!hostOfIp.includes('0')) return L.noteBc;
      return '';
    }

    // ============================================================= svolgimento completo
    function renderFull(target, info) {
      const ipDec = dotted(info.ipOct), maskDec = dotted(info.maskOct);

      // 1. dati
      heading(target, L.s1);
      emit(target, L.s1Text(ipDec, maskDec));

      // 2. decimale -> binario, un ottetto alla volta (senza ripetere i valori gia' visti)
      heading(target, L.s2);
      emit(target, L.s2Intro);
      const seen = new Map();
      const items = [
        ...info.ipOct.map((v, k) => ({ v, label: L.ipOctLabel(k + 1) })),
        ...info.maskOct.map((v, k) => ({ v, label: L.maskOctLabel(k + 1) })),
      ];
      items.forEach(({ v, label }) => {
        const blk = block(target);
        if (seen.has(v)) { emit(blk, L.already(label, v, seen.get(v))); return; }
        emit(blk, L.octHead(label, v));
        if (v === 255) emitTip(blk, L.note255);
        const raw = renderDivisions(blk, BigInt(v), 2);
        const add = 8 - raw.length;
        if (add > 0) {
          emit(blk, L.padNote(raw.length, add),
            `\\text{${raw}}_{2} = \\textcolor{${GRAY}}{\\text{${'0'.repeat(add)}}}\\text{${raw}}_{2}`);
        }
        seen.set(v, raw.padStart(8, '0'));
      });
      const ipB = info.ipBits.match(/.{8}/g), mB = info.maskBits.match(/.{8}/g);
      emit(target, L.recapIntro);
      appendNode(target, buildBookTable(L.recapHead, [
        [L.recapRows[0], ...info.ipOct.map(String)],
        [L.recapRows[1], ...ipB],
        [L.recapRows[2], ...info.maskOct.map(String)],
        [L.recapRows[3], ...mB],
      ]));

      // 3. prefisso
      heading(target, L.s3);
      emit(target, L.s3Text(info.p), L.s3Tex(info.p, info.h));
      emit(target, L.boundary(info.p));

      // 4. indirizzo di rete
      heading(target, L.s4);
      emit(target, info.p > 0 ? L.s4Intro(info.p) : L.s4IntroNone);
      appendNode(target, buildMaskFigure('net', info));
      emit(target, L.s4And);
      renderBack(target, 'net', info);
      emit(target, L.netResult, resultTex(info.netBits, info.netOct));

      // 5. parte host
      heading(target, L.s5);
      emit(target, info.h > 0 ? L.s5Intro(info.h) : L.s5IntroNone);
      appendNode(target, buildMaskFigure('host', info));
      emit(target, L.s5And);
      renderBack(target, 'host', info);
      emit(target, L.hostResult, resultTex(info.hostBits, info.hostOct));

      // 6. riepilogo e controllo
      heading(target, L.s6);
      appendNode(target, buildSummary(info));
      const sums = [0, 1, 2, 3].map((k) => `(${info.netOct[k]} + ${info.hostOct[k]})`).join('.');
      emit(target, L.checkText, `${sums} = ${dotted(info.ipOct)}`);
      const note = hostNote(info);
      if (note) emitTip(target, note);
    }

    // ============================================================= orchestratore
    let ipnRandomUsed = false;
    function ipnTrack(mode, prefix) {
      if (window.umami) {
        umami.track('ipnetmask-solve', { mode, prefix, randomUsed: ipnRandomUsed });
      }
    }
    function elabora(quick) {
      const target = quick ? quickEl : fullEl;
      const other = quick ? fullEl : quickEl;
      quickEl.innerHTML = ''; fullEl.innerHTML = '';
      unTip();

      const ipP = parseDotted(ipInput.value);
      if (ipP.error) { tip(parseError('ip', ipP)); ipInput.classList.add('ipn-invalid'); hide(quickEl); hide(fullEl); return; }
      const mP = parseDotted(maskInput.value);
      if (mP.error) { tip(parseError('mask', mP)); maskInput.classList.add('ipn-invalid'); hide(quickEl); hide(fullEl); return; }
      const info = analyze(ipP.oct, mP.oct);
      if (info.error) {
        tip(L.errMaskShape(dotted(mP.oct), info.k, info.bits));
        maskInput.classList.add('ipn-invalid'); hide(quickEl); hide(fullEl); return;
      }

      emit(target, `<h2>${quick ? L.titleQuick : L.titleStep}</h2>`);
      if (quick) {
        appendNode(target, buildSummary(info));
        const note = hostNote(info);
        if (note) emitTip(target, note);
      } else {
        renderFull(target, info);
      }

      hide(other);
      reveal(target);
      fitReadArrows();
      ipnTrack(quick ? 'quick' : 'steps', info.p);
    }

    // altezza + zebra della freccia di lettura (da BaseConverter)
    const READARROW_INSET = 18;
    function fitReadArrows(tries) {
      tries = tries || 0;
      requestAnimationFrame(() => {
        const cells = root.querySelectorAll('.ipn-readarrow-cell');
        if (!cells.length) return;
        let pending = false;
        cells.forEach((cell) => {
          const line = cell.querySelector('.ipn-readarrow');
          if (!line) return;
          const h = cell.getBoundingClientRect().height;
          if (h <= 0) { pending = true; return; }
          line.style.height = Math.max(0, h - READARROW_INSET) + 'px';
          const rowsCount = parseInt(cell.getAttribute('rowspan'), 10) || 1;
          const rowH = h / rowsCount;
          const table = cell.closest('table');
          const evenRow = table ? table.querySelector('tbody tr:nth-child(2)') : null;
          const tint = evenRow ? getComputedStyle(evenRow).backgroundColor : 'transparent';
          cell.style.backgroundImage =
            `repeating-linear-gradient(to bottom, transparent 0px, transparent ${rowH}px, ${tint} ${rowH}px, ${tint} ${2 * rowH}px)`;
        });
        if (pending && tries < 12) fitReadArrows(tries + 1);
      });
    }

    // ── valore casuale: IP privato, prefisso da /16 a /30, IP che non
    //    coincide con l'indirizzo di rete ne' con il broadcast ──────────
    function randomInRange(min, max) { return min + Math.floor(Math.random() * (max - min + 1)); }
    function randomCase() {
      const p = randomInRange(16, 30);
      const h = 32 - p;
      const kind = randomInRange(0, 2);
      const first = kind === 0 ? [192, 168] : kind === 1 ? [172, randomInRange(16, 31)] : [10, randomInRange(0, 255)];
      const base = bitsOf([...first, randomInRange(0, 255), randomInRange(0, 255)]);
      const host = randomInRange(1, 2 ** h - 2);
      const ipBits = base.slice(0, p) + host.toString(2).padStart(h, '0');
      const maskBits = '1'.repeat(p) + '0'.repeat(h);
      return { ip: dotted(octetsOf(ipBits)), mask: dotted(octetsOf(maskBits)) };
    }

    // ── interazioni ──────────────────────────────────────────────────
    const onEdit = () => { clearResults(); unTip(); ipnRandomUsed = false; };
    ipInput.addEventListener('input', onEdit);
    maskInput.addEventListener('input', onEdit);
    root.querySelector('#ipnBtnReset').addEventListener('click', () => {
      ipInput.value = ''; maskInput.value = ''; onEdit();
    });
    root.querySelector('#ipnBtnRandom').addEventListener('click', () => {
      const c = randomCase();
      ipInput.value = c.ip; maskInput.value = c.mask;
      clearResults(); unTip();
      ipnRandomUsed = true;
    });
    root.querySelector('#ipnBtnQuick').addEventListener('click', () => elabora(true));
    root.querySelector('#ipnBtnStep').addEventListener('click', () => elabora(false));
    window.addEventListener('resize', () => fitReadArrows());

    // ── avvio ────────────────────────────────────────────────────────
    ipInput.value = '';
    maskInput.value = '';
    renderInline(root);
  }
</script>