---
/**
 * IPNetmask.astro — Risolutore IPv4: dato un indirizzo IP e una maschera di
 * sottorete in notazione decimale puntata, ricava prefisso CIDR, indirizzo di
 * rete e parte host, con lo svolgimento completo. Nativo, responsive,
 * bilingue (it/en).
 *
 * Dipendenze:  npm install katex
 *
 * Uso in una pagina .mdx di Starlight:
 *   import IPNetmask from '@components/IPNetmask.astro';
 *   <IPNetmask />
 *
 * ── Svolgimento (come nel Modulo 1-C, Reti) ────────────────────────────
 *   1) dati: IP e maschera, 32 bit divisi in quattro ottetti
 *   2) ogni ottetto da decimale a binario con le divisioni successive per 2
 *      (stessa tabella con freccia di lettura di BaseConverter), con gli
 *      zeri a sinistra fino a 8 bit; i valori gia' convertiti non si ripetono
 *   3) controllo della maschera, prefisso CIDR, bit di rete e bit host
 *   4) indirizzo di rete: figura con IP sopra e maschera sotto, rettangolo
 *      rosso trasparente sulle colonne in cui la maschera vale 1; si copiano
 *      i bit dell'IP dentro il rettangolo e si completa con zeri. Ritorno al
 *      decimale con l'espansione posizionale (stessa board di BaseConverter)
 *   5) parte host: stessa figura con rettangolo verde sulle colonne in cui la
 *      maschera vale 0 (AND bit a bit fra IP e maschera negata)
 *   6) riepilogo, controllo (rete + host = IP ottetto per ottetto) ed
 *      eventuale osservazione se l'IP coincide con rete o broadcast
 *
 * ── Ritorno al decimale ────────────────────────────────────────────────
 *   Un ottetto tutto dentro il rettangolo e' identico all'ottetto dell'IP;
 *   uno tutto fuori contiene solo zeri aggiunti: per entrambi si dice il
 *   valore senza ricalcolarlo. L'ottetto attraversato dal confine (bit
 *   copiati e zeri aggiunti insieme) si converte sempre per esteso.
 *
 * ── Limiti ─────────────────────────────────────────────────────────────
 *   Solo IPv4. La maschera si inserisce in decimale puntato e deve avere gli
 *   1 consecutivi da sinistra (prefissi da /0 a /32).
 */

import 'katex/dist/katex.min.css';

const lang = (Astro.currentLocale ?? 'it').toLowerCase().startsWith('en') ? 'en' : 'it';

const UI = {
  it: {
    step1: 'Step 1 — INSERISCI INDIRIZZO IP E MASCHERA',
    ipLabel: 'Indirizzo IP',
    maskLabel: 'Maschera di sottorete',
    help1: 'Scrivere entrambi i valori in notazione decimale puntata: quattro numeri interi da 0 a 255 separati da punti.',
    help2: 'Nella maschera gli 1 devono essere tutti consecutivi a partire da sinistra, per esempio 255.255.255.192.',
    btnReset: 'AZZERA VALORI',
    btnRandom: 'VALORE CASUALE',
    btnQuick: 'RISULTATO SINTETICO',
    btnStep: 'SVOLGIMENTO PASSO-PASSO',
  },
  en: {
    step1: 'Step 1 — ENTER IP ADDRESS AND MASK',
    ipLabel: 'IP address',
    maskLabel: 'Subnet mask',
    help1: 'Write both values in dotted decimal notation: four integers from 0 to 255 separated by dots.',
    help2: 'In the mask all the 1s must be consecutive starting from the left, for example 255.255.255.192.',
    btnReset: 'RESET VALUES',
    btnRandom: 'RANDOM VALUE',
    btnQuick: 'QUICK RESULT',
    btnStep: 'STEP-BY-STEP SOLUTION',
  },
}[lang];
---

<div class="ipn-root" data-lang={lang}>
  <!-- Step 1: inserimento di IP e maschera -->
  <section class="ipn-panel">
    <h3 class="ipn-steplabel">{UI.step1}</h3>
    <div class="ipn-fields">
      <div class="ipn-field">
        <label for="ipnIp" class="ipn-label">{UI.ipLabel}</label>
        <input id="ipnIp" class="ipn-input" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" placeholder="192.168.1.66" value="" />
      </div>
      <div class="ipn-field">
        <label for="ipnMask" class="ipn-label">{UI.maskLabel}</label>
        <input id="ipnMask" class="ipn-input" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" placeholder="255.255.255.192" value="" />
      </div>
    </div>
    <div class="ipn-help">
      <p>{UI.help1}</p>
      <p>{UI.help2}</p>
    </div>
    <div id="ipnStatus" class="ipn-status" role="alert" aria-live="polite"></div>
  </section>

  <!-- Azioni -->
  <div class="ipn-actions">
    <button id="ipnBtnReset" class="ipn-btn ipn-btn-ghost" type="button">{UI.btnReset}</button>
    <button id="ipnBtnRandom" class="ipn-btn ipn-btn-ghost" type="button">{UI.btnRandom}</button>
    <button id="ipnBtnQuick" class="ipn-btn ipn-btn-ghost" type="button">{UI.btnQuick}</button>
  </div>
  <div class="ipn-secondary">
    <button id="ipnBtnStep" class="ipn-btn ipn-btn-ghost ipn-btn-wide" type="button">{UI.btnStep}</button>
  </div>

  <!-- Output -->
  <section id="ipnQuick" class="ipn-result" hidden></section>
  <section id="ipnFull" class="ipn-result" hidden></section>
</div>
<style is:global>
  .ipn-root {
    --ipn-radius: 12px;
    --ipn-surface: var(--sl-color-gray-6, #1a1a1a);
    --ipn-border: var(--sl-color-gray-5, #383838);
    --ipn-accent: var(--sl-color-accent, #4f7cff);
    --ipn-red: #d11111;
    --ipn-green: #1f9d55;
    --ipn-accent-hi: var(--sl-color-accent-high, #b8c8ff);
    --ipn-faint: var(--sl-color-gray-3, #888);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--sl-color-text, inherit);
    width: 100%;
    min-width: 330px;
    margin: 1.5rem 0;
    text-align: center;
  }
  .ipn-root *,
  .ipn-root *::before,
  .ipn-root *::after { box-sizing: border-box; }

  /* reset difensivo contro il margin-top che Starlight inietta sugli elementi
     "fratelli" dentro il contenuto markdown: stesso fix di BaseConverter,
     esteso a ogni contenitore costruito dinamicamente via JS */
  .ipn-root[data-lang] .ipn-fields,
  .ipn-root[data-lang] .ipn-field,
  .ipn-root[data-lang] .ipn-label,
  .ipn-root[data-lang] .ipn-input,
  .ipn-root[data-lang] .ipn-help,
  .ipn-root[data-lang] .ipn-grid,
  .ipn-root[data-lang] .ipn-cell,
  .ipn-root[data-lang] .ipn-board-scroller,
  .ipn-root[data-lang] .ipn-term,
  .ipn-root[data-lang] .ipn-plus,
  .ipn-root[data-lang] .ipn-poslabel,
  .ipn-root[data-lang] .ipn-booktable,
  .ipn-root[data-lang] .ipn-booktable th,
  .ipn-root[data-lang] .ipn-booktable td,
  .ipn-root[data-lang] .ipn-remainder-box,
  .ipn-root[data-lang] .ipn-readarrow,
  .ipn-root[data-lang] .ipn-readarrow-head,
  .ipn-root[data-lang] .ipn-fig {
    margin: 0 !important;
  }

  .ipn-panel {
    background: var(--ipn-surface);
    border: 1px solid var(--ipn-border);
    border-radius: var(--ipn-radius);
    padding: 1.25rem 1rem;
    margin: 1.25rem 0;
  }
  .ipn-steplabel {
    margin: 0 0 1rem;
    font-size: clamp(0.85rem, 2.4vw, 1rem);
    letter-spacing: 0.02em;
    color: var(--sl-color-text-accent, var(--ipn-accent-hi));
  }

  /* campi IP e maschera */
  .ipn-fields { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: center; gap: 1rem 2rem; }
  .ipn-field { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; }
  .ipn-label { font-size: 0.95rem; line-height: 1.4rem; color: var(--sl-color-text-accent, var(--ipn-accent-hi)); }
  .ipn-input {
    background: var(--sl-color-bg, #000);
    color: var(--sl-color-text, #fff);
    border: 1.5px solid var(--ipn-border);
    border-radius: 6px;
    text-align: center;
    padding: 0.45rem 0.6rem;
    font: inherit;
    line-height: 1.5rem;
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
    letter-spacing: 0.04em;
    width: 13rem;
    max-width: 100%;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .ipn-input:hover { border-color: var(--ipn-accent); background: color-mix(in srgb, var(--ipn-accent) 10%, var(--sl-color-bg, #000)); }
  .ipn-input:focus { border-color: var(--ipn-accent); outline: none; }
  .ipn-input.ipn-invalid { border-color: var(--ipn-red); }
  .ipn-help { margin-top: 0.75rem; font-size: 0.82rem; color: var(--ipn-faint); }
  .ipn-help p { margin: 0.25rem 0; }

  .ipn-status { margin: 0.6rem 0 0; font-size: 0.95rem; }
  .ipn-status.ipn-error {
    padding: 0.6rem 0.8rem;
    border-left: 4px solid var(--ipn-red);
    background: color-mix(in srgb, var(--ipn-red) 8%, transparent);
    border-radius: 4px;
    text-align: left;
  }

  /* pulsanti */
  .ipn-actions {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem; align-items: stretch; margin: 1.25rem auto; max-width: 48rem;
  }
  .ipn-actions .ipn-btn {
    box-sizing: border-box; width: 100%; margin: 0;
    height: 3.6rem; padding: 0 1rem; line-height: 1.2;
    display: inline-flex; align-items: center; justify-content: center; text-align: center;
  }
  /* stessa larghezza massima e stessa centratura della riga dei tre pulsanti */
  .ipn-secondary { max-width: 48rem; margin: 1.25rem auto 0; }
  .ipn-btn {
    font: inherit; font-weight: 600; cursor: pointer;
    border-radius: 999px; padding: 0.7rem 1.4rem; border: 1.5px solid transparent;
    transition: transform 0.1s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .ipn-btn:active { transform: scale(0.96); }
  .ipn-btn-ghost { background: transparent; color: var(--sl-color-text, inherit); border-color: var(--ipn-border); }
  .ipn-btn-ghost:hover { border-color: var(--ipn-accent); color: var(--ipn-accent); }
  .ipn-btn-wide { padding: 0.9rem 1.4rem; width: 100%; margin: 0 0 1rem; }

  /* output */
  .ipn-result {
    background: var(--ipn-surface); border: 1px solid var(--ipn-border);
    border-radius: var(--ipn-radius); margin-top: 1.5rem; padding: 1.5rem 1rem;
    opacity: 0; transition: opacity 0.3s ease; text-align: left;
  }
  .ipn-result.ipn-visible { opacity: 1; }
  .ipn-result h2 { text-align: center; }
  .ipn-result h5 {
    margin: 2.25rem 0 1rem; padding-top: 1rem;
    font-size: 0.95rem; letter-spacing: 0.03em; color: var(--sl-color-text-accent, var(--ipn-accent-hi));
  }
  .ipn-result h5:first-child { margin-top: 0; padding-top: 0; }
  .ipn-text p { margin: 0.7rem 0; }
  .ipn-tip {
    background: var(--sl-color-gray-6, rgba(255,255,255,0.04));
    border-left: 4px solid var(--ipn-accent);
    border-radius: 6px; padding: 0.9rem 1rem; margin: 1.25rem 0;
  }
  .ipn-katex { overflow-x: auto; overflow-y: hidden; padding: 0.75rem 0.25rem; margin: 1.25rem 0; }
  .ipn-katex .katex-display { margin: 0; }
  .ipn-red-strong { color: var(--ipn-red); }
  .ipn-green-strong { color: var(--ipn-green); }

  /* blocco di un singolo ottetto (conversioni) */
  .ipn-octblock {
    border-top: 1px dashed var(--ipn-border);
    margin-top: 1.25rem;
    padding-top: 0.5rem;
  }

  /* ----- figura dei 32 bit con rettangolo di selezione (SVG) -----
     Coordinate del viewBox in px "logici": la figura scala con la colonna
     di testo e, sotto la larghezza minima, scorre in orizzontale. */
  .ipn-figwrap { overflow-x: auto; margin: 1.5rem 0; padding: 0.25rem 0; }
  .ipn-fig { display: block; width: 100%; min-width: 38rem; max-width: 54rem; height: auto; margin: 0 auto !important; }
  .ipn-fig .ipn-c { fill: var(--sl-color-bg, #fff); stroke: var(--sl-color-gray-4, #888); stroke-width: 0.8; }
  .ipn-fig .ipn-cfill { fill: color-mix(in srgb, var(--sl-color-gray-5, #888) 45%, var(--sl-color-bg, #fff)); stroke: var(--sl-color-gray-4, #888); stroke-width: 0.8; stroke-dasharray: 2 2; }
  .ipn-fig text { fill: var(--sl-color-text, #222); font-family: var(--__sl-font-mono, ui-monospace, monospace); }
  .ipn-fig .ipn-bit { font-size: 14px; font-weight: 700; }
  .ipn-fig .ipn-bitfill { font-size: 14px; font-weight: 700; fill: var(--ipn-faint); }
  .ipn-fig .ipn-cross { fill: none; stroke: var(--sl-color-gray-3, #888); stroke-width: 1.4; stroke-linecap: round; }
  .ipn-fig .ipn-rowlabel { font-family: var(--sl-font, sans-serif); font-size: 12.5px; font-weight: 600; }
  .ipn-fig .ipn-bracelabel { font-family: var(--sl-font, sans-serif); font-size: 11.5px; }
  .ipn-fig .ipn-brace { fill: none; stroke-width: 1.3; }

  /* ----- board posizionale (binario -> decimale), da BaseConverter ----- */
  .ipn-board-scroller { overflow-x: auto; padding: 0.5rem 0.25rem 0.75rem; margin: 1.25rem 0; text-align: center; }
  .ipn-grid {
    display: inline-grid;
    align-items: center;
    justify-content: center;
    column-gap: 0.35rem;
    row-gap: 0.3rem;
    margin: 0 auto;
  }
  .ipn-cell { white-space: nowrap; text-align: center; }
  .ipn-digit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.6rem;
    height: 1.6rem;
    padding: 0 0.3rem;
    border: 2px solid var(--ipn-border);
    border-radius: 4px;
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--ipn-red);
  }
  .ipn-poslabel { font-size: 0.78rem; line-height: 1.15; color: var(--ipn-faint); }
  .ipn-poslabel .ipn-green { color: var(--ipn-green); font-weight: 700; }
  .ipn-term { display: flex; align-items: center; justify-content: center; gap: 0.15rem; }
  .ipn-plus { align-self: center; padding: 0 0.1rem; opacity: 0.85; }

  /* ----- tabelle in stile "libro", da BaseConverter ----- */
  .ipn-tablewrap { display: flex; justify-content: center; overflow-x: auto; margin: 1.5rem 0 !important; padding: 0.25rem; }
  .ipn-booktable {
    border-collapse: collapse;
    margin: 0 auto;
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
    font-size: 0.92rem;
  }
  .ipn-booktable th, .ipn-booktable td {
    border: none;
    padding: 0.22rem 1.1rem;
    text-align: center;
    white-space: nowrap;
  }
  .ipn-booktable thead tr {
    border-top: 1.5px solid var(--sl-color-text, currentColor);
    border-bottom: 1.5px solid var(--sl-color-text, currentColor);
  }
  .ipn-booktable th {
    font-family: var(--sl-font, inherit);
    font-weight: 700;
    color: var(--sl-color-text-accent, var(--ipn-accent-hi));
    padding-top: 0.4rem;
    padding-bottom: 0.4rem;
  }
  .ipn-booktable tbody tr:last-child { border-bottom: 1.5px solid var(--sl-color-text, currentColor); }
  .ipn-booktable tbody tr:nth-child(even) {
    background: color-mix(in srgb, var(--sl-color-gray-5, #888) 32%, transparent);
  }
  .ipn-booktable td.ipn-rowhead { font-family: var(--sl-font, system-ui, sans-serif); text-align: left; font-weight: 600; }
  .ipn-sumtable thead { display: none; }
  .ipn-sumtable tbody tr:first-child { border-top: 1.5px solid var(--sl-color-text, currentColor); }
  .ipn-sumtable td { text-align: left; }
  .ipn-divtable td.ipn-remainder { color: var(--sl-color-text, #111); font-weight: 700; }
  .ipn-remainder-box {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 1.5rem; height: 1.5rem; padding: 0 0.25rem;
    border: 2px solid var(--sl-color-text, #111);
    border-radius: 4px;
  }
  /* freccia rossa verticale di lettura dei resti (vedi BaseConverter: altezza
     e zebratura impostate via JS da fitReadArrows) */
  .ipn-divtable td.ipn-readarrow-cell {
    border: none;
    padding: 0 0.6rem;
    vertical-align: middle;
    position: relative;
  }
  .ipn-readarrow { position: relative; width: 3px; margin: 0 auto; background: var(--ipn-red); }
  .ipn-readarrow-head { position: absolute; top: -4px; left: 50%; width: 0; height: 0; }
  .ipn-readarrow-head::before,
  .ipn-readarrow-head::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 3px;
    height: 10px;
    background: var(--ipn-red);
    border-radius: 1.5px;
    transform-origin: top center;
  }
  .ipn-readarrow-head::before { transform: translateX(-50%) rotate(-24deg); }
  .ipn-readarrow-head::after { transform: translateX(-50%) rotate(24deg); }

  @media (max-width: 600px) {
    .ipn-root { font-size: 0.95rem; }
    .ipn-actions { grid-template-columns: 1fr; }
    .ipn-actions .ipn-btn, .ipn-btn-wide { width: 100%; }
    .ipn-result { padding: 1rem 0.5rem; }
    .ipn-fields { flex-direction: column; align-items: stretch; }
    .ipn-field { align-items: stretch; }
    .ipn-input { width: 100%; }
  }
</style>
<script>
  import katex from 'katex';
  import renderMathInElement from 'katex/contrib/auto-render';

  document.querySelectorAll('.ipn-root').forEach((root) => initIPNetmask(root));

  function initIPNetmask(root) {
    const LANG = (root.dataset.lang || document.documentElement.lang || 'it')
      .toLowerCase().startsWith('en') ? 'en' : 'it';

    const RED = '#d11111';
    const GREEN = '#1f9d55';
    const GRAY = '#8a8a8a';

    // ============================================================= i18n
    const D = {
      it: {
        titleQuick: 'Risultato sintetico',
        titleStep: 'Svolgimento passo-passo',
        posLabel: 'posizione',

        errEmpty: { ip: "Inserire l'indirizzo IP.", mask: 'Inserire la maschera di sottorete.' },
        errParts: {
          ip: "L'indirizzo IP deve essere formato da quattro numeri separati da punti, per esempio 192.168.1.66.",
          mask: 'La maschera deve essere formata da quattro numeri separati da punti, per esempio 255.255.255.192.',
        },
        errOctetEmpty: { ip: (k) => `Nell'indirizzo IP l'ottetto ${k} è vuoto.`, mask: (k) => `Nella maschera l'ottetto ${k} è vuoto.` },
        errOctet: {
          ip: (k, t) => `Nell'indirizzo IP l'ottetto ${k} ("${t}") non è valido: ogni ottetto deve essere un numero intero da 0 a 255.`,
          mask: (k, t) => `Nella maschera l'ottetto ${k} ("${t}") non è valido: ogni ottetto deve essere un numero intero da 0 a 255.`,
        },
        errMaskShape: (mask, k, bits) =>
          `La maschera ${mask} non è valida: gli 1 devono essere tutti consecutivi a partire da sinistra, seguiti soltanto da 0, ma dopo il primo 0 compare di nuovo un 1 (ottetto ${k}: ${bits}). Un ottetto della maschera può valere soltanto 0, 128, 192, 224, 240, 248, 252, 254 oppure 255, e dopo il primo ottetto diverso da 255 gli ottetti successivi valgono 0.`,

        // 1. dati
        s1: '1. Dati',
        s1Text: (ip, mask) =>
          `<p>Sono dati l'indirizzo IP \\( ${ip} \\) e la maschera di sottorete \\( ${mask} \\), in notazione decimale puntata. Ciascuno dei due è una sequenza di \\( 32 \\) bit, divisa in quattro <b>ottetti</b>, cioè gruppi di \\( 8 \\) bit: ogni numero fra i punti è il valore decimale di un ottetto, da \\( 0 \\) a \\( 255 \\). Per vedere quali bit dell'IP vengono selezionati dalla maschera occorre scrivere tutti gli ottetti in base \\( 2 \\).</p>`,

        // 2. decimale -> binario
        s2: '2. Conversione degli ottetti da decimale a binario',
        s2Intro:
          `<p>Ogni ottetto si converte con il metodo delle divisioni successive: si divide ripetutamente il valore per \\( 2 \\), annotando quoziente e resto, finché il quoziente non diventa \\( 0 \\). Le cifre binarie sono i resti letti <b class="ipn-red-strong">dal basso verso l'alto</b>. Un ottetto ha sempre esattamente \\( 8 \\) bit: se si ottengono meno di \\( 8 \\) cifre, si aggiungono zeri a sinistra, che non cambiano il valore.</p>`,
        ipOctLabel: (k) => `Ottetto ${k} dell'IP`,
        maskOctLabel: (k) => `Ottetto ${k} della maschera`,
        octHead: (label, v) => `<p><b>${label}</b>: \\( ${v}_{10} \\)</p>`,
        note255:
          '<b>Da ricordare:</b> \\( 255 \\) è il più grande numero intero che si può scrivere con \\( 8 \\) bit, perché si ottiene con tutti gli \\( 8 \\) bit a \\( 1 \\): \\( 128+64+32+16+8+4+2+1 = 255 = 2^{8}-1 \\). Quindi \\( 255 \\) si scrive \\( 11111111 \\) e, viceversa, \\( 8 \\) bit tutti a \\( 1 \\) valgono \\( 255 \\). Per chi non lo ricorda, ecco comunque il calcolo.',
        bTableHead: { div: 'Dividendo', quo: 'Quoziente', rem: 'Resto' },
        bRead: "<p>Resti letti dal basso verso l'alto:</p>",
        padNote: (len, add) =>
          `<p>${len === 1 ? 'Si ottiene una sola cifra' : `Si ottengono \\( ${len} \\) cifre`}: si ${add === 1 ? 'aggiunge uno zero' : `aggiungono \\( ${add} \\) zeri`} a sinistra per completare gli \\( 8 \\) bit dell'ottetto.</p>`,
        already: (label, v, bits) =>
          `<p><b>${label}</b>: \\( ${v}_{10} \\) è già stato convertito sopra, quindi \\( ${v}_{10} = \\text{${bits}}_{2} \\).</p>`,
        recapIntro: '<p>Riassumendo, IP e maschera ottetto per ottetto:</p>',
        recapHead: ['', 'Ottetto 1', 'Ottetto 2', 'Ottetto 3', 'Ottetto 4'],
