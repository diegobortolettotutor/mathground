        noteNet:
          'All the host bits of the IP are 0: the IP coincides with the network address, which identifies the whole subnet and in an ordinary subnet is not assigned to a device.',
        noteBc:
          'All the host bits of the IP are 1: the IP coincides with the broadcast address of the subnet, which does not identify a single device and in an ordinary subnet is not assigned.',

        figIp: 'IP (binary)',
        figMask: 'Mask (binary)',
        figNet: 'Network (binary)',
        figHost: 'Host (binary)',
        braceIp: (n) => (n === 1 ? '1 IP bit' : `${n} IP bits`),
        braceZero: (n) => (n === 1 ? '1 added zero' : `${n} added zeros`),
        figAria: (kind) => (kind === 'net'
