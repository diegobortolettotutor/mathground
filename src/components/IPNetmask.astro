          if (p % 8 === 0) return `<p>The boundary between network part and host part coincides with the boundary between octet ${p / 8} and octet ${p / 8 + 1}.</p>`;
          const k = Math.floor(p / 8) + 1, r = p % 8;
          return `<p>The boundary between network part and host part falls <b>inside</b> octet ${k}, after ${r === 1 ? 'its first bit' : `its first \\( ${r} \\) bits`}: the groups of \\( 8 \\) are used to write the address, they do not set the boundary of the network.</p>`;
