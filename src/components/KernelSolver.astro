  }

  const result = parseSum();
  if (i !== src.length) throw new Error('Token residui in: ' + s);
  return result;
}

// Costruisce la matrice di elementi dal contenuto testuale delle celle.
// Decide il campo: se compare almeno una variabile -> simbolico, altrimenti numerico.
function buildMatrix(cellStrings) {
  const polys = cellStrings.map((row) => row.map(parseCellToPoly));
  const varSet = new Set();
  for (const row of polys) for (const p of row) for (const v of p.vars()) varSet.add(v);
  const vars = [...varSet].sort();
  if (vars.length === 0) {
    const field = numericField;
    const data = polys.map((row) => row.map((p) => {
      const fr = p.asConstant();
      return field.fromFraction(fr);
    }));
    return { matrix: data, field, vars: [] };
  }
  const field = symbolicField(vars);
  const data = polys.map((row) => row.map((p) => new RationalFunction(p)));
  return { matrix: data, field, vars };
}

// --- cases ---
// cases.mjs — Analisi per casi sui PARAMETRI.
//
// Idea. Riducendo con un pivot simbolico p(k) si assume p(k) ≠ 0 (altrimenti si è
// diviso per zero). I valori critici candidati sono perciò gli zeri dei polinomi-pivot.
// Ogni valore in cui il rango cala davvero è necessariamente uno di questi (se quel
// minore non si annulla, il rango è già massimo lì): i candidati sono un SOVRAINSIEME
// di quelli veri. Per ciascun candidato si SOSTITUISCE il valore (la matrice torna
// numerica) e si ricalcola rango/nucleo in modo ESATTO, verificando se il rango cala
// davvero invece di proclamarlo.
//
//  - UN parametro: diramazione completa sui valori critici RAZIONALI; gli eventuali
//    valori non razionali (radici irrazionali dei pivot) sono dichiarati in forma
//    simbolica (condizione = 0) senza chiuderli.
//  - PIÙ parametri: ramo generico esatto + assunzioni dichiarate; sulle condizioni
//    LINEARI a parametro singolo (es. a = 0) si fa UN livello di ricorsione
//    (sostituzione + richiusura del generico nei parametri rimasti), poi stop.






// ---- radici razionali di un polinomio univariato (teorema delle radici razionali) ----
function uniCoeffs(poly, v) {
  const d = poly.degreeIn(v);
  const arr = new Array(d + 1).fill(null).map(() => Fraction.ZERO);
  for (const [k, c] of poly.terms) {
    if (k === '') { arr[0] = arr[0].add(c); continue; }
    const e = parseInt(k.split('^')[1], 10);
    arr[e] = arr[e].add(c);
  }
  return arr;
}
function divisorsBig(nAbs) {
  const out = [];
  for (let i = 1n; i * i <= nAbs; i++) {
    if (nAbs % i === 0n) { out.push(i); if (i !== nAbs / i) out.push(nAbs / i); }
  }
  return out.sort((a, b) => (a < b ? -1 : 1));
}
// Ritorna { roots:[Fraction], residualDeg } — residualDeg>0 segnala radici non razionali.
function rationalRoots(poly, v) {
  let coeffs = uniCoeffs(poly, v); // index = grado, Fraction
  // libera dai denominatori -> coeff interi
  let lcm = 1n;
  const g = (a, b) => { a = a < 0n ? -a : a; b = b < 0n ? -b : b; while (b) { [a, b] = [b, a % b]; } return a; };
  for (const c of coeffs) lcm = lcm / g(lcm, c.den) * c.den;
  let ic = coeffs.map((c) => c.num * (lcm / c.den)); // BigInt[]
  // togli zeri in testa (gradi alti nulli)
  while (ic.length > 1 && ic[ic.length - 1] === 0n) ic.pop();
  const roots = [];
  // radice 0 con molteplicità: finché a0 == 0
  while (ic.length > 1 && ic[0] === 0n) { roots.push(new Fraction(0n, 1n)); ic = ic.slice(1); }
  if (ic.length <= 1) return { roots: dedupeFr(roots), residualDeg: 0 };
  const a0 = ic[0] < 0n ? -ic[0] : ic[0];
  const an = ic[ic.length - 1] < 0n ? -ic[ic.length - 1] : ic[ic.length - 1];
  const ps = divisorsBig(a0), qs = divisorsBig(an);
  const evalInt = (cands, x) => { // valuta polinomio intero in Fraction x
    let acc = Fraction.ZERO;
    let pw = Fraction.ONE;
    for (let i = 0; i < cands.length; i++) { acc = acc.add(new Fraction(cands[i], 1n).mul(pw)); pw = pw.mul(x); }
    return acc;
  };
  const tried = new Set();
  for (const p of ps) for (const q of qs) for (const s of [1n, -1n]) {
    const cand = new Fraction(s * p, q);
    const key = cand.toString();
    if (tried.has(key)) continue; tried.add(key);
    if (evalInt(ic, cand).isZero()) roots.push(cand);
  }
  const uniq = dedupeFr(roots);
  // grado residuo = grado totale - numero di radici razionali distinte trovate
  // (stima onesta: se restano radici non razionali, residualDeg > 0)
  const totalDeg = ic.length - 1 + roots.filter((r) => r.isZero()).length * 0; // gradi già contati
  const residualDeg = Math.max(0, (poly.degreeIn(v)) - uniq.length);
  return { roots: uniq, residualDeg };
}
function dedupeFr(arr) {
  const seen = new Set(); const out = [];
  for (const f of arr) { const k = f.toString(); if (!seen.has(k)) { seen.add(k); out.push(f); } }
  return out;
}

// Approssimazione numerica delle radici REALI di un polinomio univariato.
// Serve SOLO a orientare lo studente quando le radici sono irrazionali: i valori
// esatti restano fuori portata (aritmetica razionale), ma indicare dove si trovano
// e quante sono rende il caso comprensibile invece di un vicolo cieco.
function approxRealRoots(poly, v) {
  let coeffs = uniCoeffs(poly, v);
  let lcm = 1n;
  const g = (a, b) => { a = a < 0n ? -a : a; b = b < 0n ? -b : b; while (b) { [a, b] = [b, a % b]; } return a; };
  for (const c of coeffs) lcm = lcm / g(lcm, c.den) * c.den;
  let ic = coeffs.map((c) => Number(c.num * (lcm / c.den)));
  while (ic.length > 1 && ic[ic.length - 1] === 0) ic.pop();
  const degree = ic.length - 1;
  if (degree < 1) return { roots: [], degree: 0 };
  const f = (x) => { let s = 0; for (let i = ic.length - 1; i >= 0; i--) s = s * x + ic[i]; return s; };
  const an = Math.abs(ic[ic.length - 1]);
  let bound = 1;
  for (let i = 0; i < ic.length - 1; i++) bound = Math.max(bound, Math.abs(ic[i]) / an);
  bound = 1 + bound;
  const step = Math.min(0.01, (2 * bound) / 4000);
  const roots = [];
  let pk = -bound, pv = f(pk);
  for (let x = -bound + step; x <= bound; x += step) {
    const vv = f(x);
    if (pv === 0) roots.push(pk);
    else if (pv * vv < 0) {
      let a = pk, b = x, fa = pv;
      for (let i = 0; i < 100; i++) { const m = (a + b) / 2, fm = f(m); if (fa * fm <= 0) b = m; else { a = m; fa = fm; } }
      roots.push((a + b) / 2);
    }
    pk = x; pv = vv;
  }
  const uniq = [];
  for (const r of roots) if (!uniq.some((u) => Math.abs(u - r) < 1e-6)) uniq.push(r);
  return { roots: uniq, degree };
}

// ---- sostituzione di un parametro nella matrice simbolica ----
function substituteMatrix(symMatrix, param, fr) {
  return symMatrix.map((row) => row.map((rfEl) => rfEl.substitute(param, fr)));
}
// converte una matrice di RationalFunction (eventualmente con variabili residue) nel
// campo giusto: numerico se non restano variabili, altrimenti simbolico ridotto.
function fieldOfSymMatrix(symMatrix) {
  const vars = new Set();
  for (const row of symMatrix) for (const e of row) for (const v of e.vars()) vars.add(v);
  const list = [...vars].sort();
  if (list.length === 0) {
    const field = numericField;
    const matrix = symMatrix.map((row) => row.map((e) => field.fromFraction(e.asFraction())));
    return { matrix, field, vars: [] };
  }
  return { matrix: symMatrix.map((row) => row.map((e) => e.clone())), field: symbolicField(list), vars: list };
}

// ---- chiusura del ramo generico ----
function closeGeneric(matrix, field) {
  const n = matrix.length ? matrix[0].length : 0;
  const { R, pivotCols, rank, assumptions } = rref(matrix, field, { preferConstantPivot: true });
  const { basis, freeCols } = kernelBasis(R, pivotCols, n, field);
  return { n, rank, nullity: n - rank, basis, pivotCols, freeCols, R, assumptions };
}

// ---- analisi completa ----
function analyzeParametric(matrix, field) {
  const n = matrix.length ? matrix[0].length : 0;
  const params = field.vars.slice();
  const generic = closeGeneric(matrix, field);

  const result = {
    parameters: params,
    multiParam: params.length > 1,
    generic: {
      rank: generic.rank,
      nullity: generic.nullity,
      basis: generic.basis,
      assumptions: generic.assumptions.map((a) => a.element),
    },
    branches: [],
    declaredConditions: [], // condizioni dichiarate ma non chiuse (non razionali o cross-parametro)
  };

  if (params.length === 1) {
    const v = params[0];
    // raccogli candidati: radici razionali dei numeratori dei pivot simbolici
    const candSet = new Map(); // key -> Fraction
    for (const a of generic.assumptions) {
      const num = a.element.num; // Polynomial
      const { roots, residualDeg } = rationalRoots(num, v);
      for (const r of roots) candSet.set(r.toString(), r);
      if (residualDeg > 0) {
        const { roots, degree } = approxRealRoots(num, v);
        result.declaredConditions.push({
          kind: 'nonrational',
          poly: num,
          approx: roots.map((r) => (Math.abs(r) < 1e-9 ? '0' : r.toFixed(4))),
          degree,
          realCount: roots.length,
        });
      }
    }
    // per ciascun valore critico: sostituisci e richiudi in modo esatto
    for (const val of candSet.values()) {
      const subNum = substituteMatrix(matrix, v, val);
      const { matrix: numMat, field: numF } = fieldOfSymMatrix(subNum);
      const closed = closeGeneric(numMat, numF);
      result.branches.push({
        condition: { param: v, value: val },
        rank: closed.rank,
        nullity: closed.nullity,
        basis: closed.basis,
        rankDropped: closed.rank < generic.rank,
        subMatrix: numMat,
        R: closed.R,
        pivotCols: closed.pivotCols,
        freeCols: closed.freeCols,
      });
    }
  } else if (params.length > 1) {
    // multivariato: un livello di ricorsione SOLO sulle condizioni lineari a parametro singolo
    for (const a of generic.assumptions) {
      const num = a.element.num; // Polynomial
      const vs = num.vars();
      if (num.totalDegree() === 1 && vs.length === 1) {
        // a*v + b = 0  ->  v = -b/a (costante razionale)
        const v = vs[0];
        const co = uniCoeffs(num, v); // [b, a]
        const b = co[0], aCoef = co[1];
        const val = b.neg().div(aCoef);
        const subNum = substituteMatrix(matrix, v, val);
        const { matrix: subMat, field: subF } = fieldOfSymMatrix(subNum);
        const closed = closeGeneric(subMat, subF);
        result.branches.push({
          condition: { param: v, value: val },
          rank: closed.rank,
          nullity: closed.nullity,
          basis: closed.basis,
          rankDropped: closed.rank < generic.rank,
          subMatrix: subMat,
          R: closed.R,
          pivotCols: closed.pivotCols,
          freeCols: closed.freeCols,
          residualParams: subF.vars || [],
          residualAssumptions: (closed.assumptions || []).map((x) => x.element),
        });
      } else {
        // condizione cross-parametro o non lineare: dichiarata, non chiusa
        result.declaredConditions.push({ kind: 'declared', poly: num });
      }
    }
  }
  return result;
}

