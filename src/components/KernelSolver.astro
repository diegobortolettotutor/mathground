---
/**
 * KernelSolver.astro — Risolutore didattico del NUCLEO di un'applicazione lineare.
 * Bilingue (it/en), aritmetica esatta (razionale su BigInt + funzioni razionali
 * multivariate per i parametri), spiegazione passo-passo in KaTeX.
 *
 * Dipendenze (già nel progetto): npm install katex
 * Uso in una pagina .mdx:
 *   import KernelSolver from '../../../components/KernelSolver.astro';
 *   <KernelSolver />
 *
 * Una sola istanza per pagina (come per GaussJordan.astro).
 */
import 'katex/dist/katex.min.css';

const lang = (Astro.currentLocale ?? 'it').toLowerCase().startsWith('en') ? 'en' : 'it';

const UI = {
  it: {
    title: 'Nucleo di un\u2019applicazione lineare',
    subtitle: 'Risoluzione del sistema omogeneo \\(A \\cdot \\mathbf{x}=\\mathbf{0}\\) con scorciatoie e Gauss-Jordan',
    step1: 'Step 1 \u2014 IMPOSTA LE DIMENSIONI DELLA MATRICE',
    rowsLabel: 'Righe \\((m)\\)',
    colsLabel: 'Colonne \\((n)\\)',
    step2: 'Step 2 \u2014 COMPILA LA MATRICE \\(A\\) (numeri o parametri)',
    homogeneous: 'Cercheremo le soluzioni del sistema OMOGENEO, cio\u00e8 il nucleo: i vettori \\(\\mathbf{x}\\) con \\(A \\cdot \\mathbf{x}=\\mathbf{0}\\).',
    btnReset: 'AZZERA VALORI',
    btnRandom: 'VALORI CASUALI',
    btnQuick: 'RISULTATO SINTETICO',
    btnStep: 'SVOLGIMENTO PASSO-PASSO',
  },
  en: {
    title: 'Kernel of a linear map',
    subtitle: 'Solving the homogeneous system \\(A \\cdot \\mathbf{x}=\\mathbf{0}\\) via shortcuts and Gauss-Jordan',
    step1: 'Step 1 \u2014 SET THE MATRIX DIMENSIONS',
    rowsLabel: 'Rows \\((m)\\)',
    colsLabel: 'Columns \\((n)\\)',
    step2: 'Step 2 \u2014 FILL IN THE MATRIX \\(A\\) (numbers or parameters)',
    homogeneous: 'We look for the solutions of the HOMOGENEOUS system, i.e. the kernel: the vectors \\(\\mathbf{x}\\) with \\(A \\cdot \\mathbf{x}=\\mathbf{0}\\).',
    btnReset: 'RESET VALUES',
    btnRandom: 'RANDOM VALUES',
    btnQuick: 'QUICK RESULT',
    btnStep: 'STEP-BY-STEP SOLUTION',
  },
}[lang];
---

<div class="ks-root" data-lang={lang}>
  <section class="ks-panel">
    <h4 class="ks-steplabel">{UI.step1}</h4>
    <div class="ks-dims" id="ksDims">
      <label for="ksRows" set:html={UI.rowsLabel}></label>
      <input id="ksRows" type="number" min="1" max="8" value="3" />
      <span class="ks-times">\(\large\times\)</span>
      <input id="ksCols" type="number" min="1" max="10" value="4" />
      <label for="ksCols" set:html={UI.colsLabel}></label>
    </div>
  </section>

  <section class="ks-panel">
    <h4 class="ks-steplabel">{UI.step2}</h4>
    <div class="ks-eqwrap" id="ksEqWrap">
      <div class="ks-eq">
        <span class="ks-paren ks-paren-l" aria-hidden="true"></span>
        <div id="ksGrid" class="ks-gridhost"></div>
        <span class="ks-paren ks-paren-r" aria-hidden="true"></span>
        <span id="ksXeq" class="ks-xeq"></span>
      </div>
    </div>
    <p class="ks-homog" set:html={UI.homogeneous}></p>
    <div id="ksStatus" class="ks-status" role="alert" aria-live="polite"></div>
  </section>

  <div class="ks-actions">
    <button id="ksBtnReset" class="ks-btn ks-btn-ghost" type="button">{UI.btnReset}</button>
    <button id="ksBtnRandom" class="ks-btn ks-btn-ghost" type="button">{UI.btnRandom}</button>
    <button id="ksBtnQuick" class="ks-btn ks-btn-ghost" type="button">{UI.btnQuick}</button>
  </div>

  <div class="ks-secondary">
    <button id="ksBtnStep" class="ks-btn ks-btn-ghost ks-btn-wide" type="button">{UI.btnStep}</button>
  </div>

  <section id="ksOut" class="ks-result" hidden></section>
</div>

<style is:global>
  .ks-root {
    --ks-radius: 12px;
    --ks-surface: var(--sl-color-gray-6, #1a1a1a);
    --ks-border: var(--sl-color-gray-5, #383838);
    --ks-accent: var(--sl-color-accent, #4f7cff);
    --ks-red: #d11111;
    --ks-accent-hi: var(--sl-color-accent-high, #b8c8ff);
    font-size: 1rem; line-height: 1.5;
    min-width: 330px;
    color: var(--sl-color-text, inherit);
    width: 100%; margin: 1.5rem 0; text-align: center;
  }
  .ks-root *, .ks-root *::before, .ks-root *::after { box-sizing: border-box; }


  .ks-panel {
    background: var(--ks-surface); border: 1px solid var(--ks-border);
    border-radius: var(--ks-radius); padding: 1.25rem 1rem; margin: 1.25rem 0;
  }
  .ks-steplabel {
    margin: 0 0 1rem; font-size: clamp(0.8rem, 2.4vw, 1rem);
    letter-spacing: 0.02em; color: var(--sl-color-text-accent, var(--ks-accent-hi));
  }

  .ks-dims { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 1.2rem; }
  .ks-dims label { font-size: 1rem; }
  .ks-dims input, .ks-cell {
    background: var(--sl-color-bg, #000); color: var(--sl-color-text, #fff);
    border: 1.5px solid var(--ks-border); border-radius: 6px; text-align: center;
    padding: 0.35rem; font: inherit;
  }
  .ks-dims input { width: 4rem; }
  .ks-dims input:hover, .ks-cell:hover {
    border-color: var(--ks-accent);
    background: color-mix(in srgb, var(--ks-accent) 10%, var(--sl-color-bg, #000));
  }
  .ks-dims input:focus, .ks-cell:focus { border-color: var(--ks-accent); outline: none; }
  .ks-times { font-size: 1.3rem; }

  .ks-eqwrap { overflow-x: auto; padding: 0.5rem 0.25rem; }
  .ks-eq { display: inline-flex; align-items: center; justify-content: center; gap: 0.15rem; min-width: 100%; white-space: nowrap; }
  .ks-gridhost { display: inline-block; }
  .ks-paren { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; line-height: 0; color: var(--sl-color-text, inherit); }
  .ks-paren svg { display: block; }
  .ks-xeq { display: inline-flex; align-items: center; padding-left: 0.5rem; white-space: nowrap; }

  .ks-root .ks-grid {
    display: table !important; width: auto !important; margin: 0; border: 0 !important;
    border-collapse: collapse; background: transparent !important; box-shadow: none !important;
  }
  .ks-root .ks-grid :is(thead, tbody, tr, th, td) {
    border: 0 !important; background: transparent !important; box-shadow: none !important;
  }
  .ks-root .ks-grid td { padding: 2px 3px; text-align: center; vertical-align: middle; }

  .ks-cell {
    width: 3.4rem; padding: 0.18rem 0.3rem; margin: 0;
    transition: width 0.35s ease-in-out, background-color 0.15s ease, border-color 0.15s ease;
  }
  .ks-cell:focus { background: color-mix(in srgb, var(--ks-accent) 16%, var(--sl-color-bg, #000)); }
  .ks-cell.ks-cell-wide { width: 7rem; }

  .ks-homog { margin: 1rem auto 0; max-width: 36rem; opacity: 0.9; font-size: 0.9rem; }

  .ks-status { margin: 0.75rem 0 0; font-size: 0.95rem; }
  .ks-status.ks-error {
    padding: 0.6rem 0.8rem;
    border-left: 4px solid var(--ks-red);
    background: color-mix(in srgb, var(--ks-red) 8%, transparent);
    border-radius: 4px;
  }

  .ks-actions {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem; align-items: stretch; margin: 1.25rem auto; max-width: 48rem;
  }
  .ks-actions .ks-btn { width: 100%; margin: 0; }
  .ks-btn {
    box-sizing: border-box; height: 3.6rem; padding: 0 1rem; line-height: 1.2;
    display: inline-flex; align-items: center; justify-content: center; text-align: center;
    font: inherit; font-weight: 600; cursor: pointer; border-radius: 999px;
    border: 1.5px solid transparent; transition: transform 0.1s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .ks-btn:active { transform: scale(0.96); }
  .ks-btn-accent { background: var(--ks-accent); color: var(--sl-color-white, #fff); }
  .ks-btn-accent:hover { background: var(--sl-color-accent-high, var(--ks-accent)); }
  .ks-btn-ghost { background: transparent; color: var(--sl-color-text, inherit); border-color: var(--ks-border); }
  .ks-btn-ghost:hover { border-color: var(--ks-accent); color: var(--ks-accent); }
  .ks-secondary { margin: 1.25rem auto 0; max-width: 48rem; }
  .ks-btn-wide { width: 100%; margin: 0 0 1rem; }

  .ks-result {
    background: var(--ks-surface); border: 1px solid var(--ks-border);
    border-radius: var(--ks-radius); margin-top: 1.5rem; padding: 1.5rem 1rem;
    opacity: 0; transition: opacity 0.3s ease; text-align: left;
  }
  .ks-result.ks-visible { opacity: 1; }
  .ks-result h2 { text-align: center; }
  .ks-result h3 {
    margin-top: 2.5rem; padding-top: 0.75rem; color: var(--ks-accent);
    border-top: 1px solid var(--ks-border);
  }
  .ks-result p { margin: 0.9rem 0; }
  .ks-katex { overflow-x: auto; overflow-y: hidden; padding: 0.75rem 0.25rem; margin: 1rem 0; }
  .ks-katex .katex-display { margin: 0; }

  @media (max-width: 600px) {
    .ks-root { font-size: 0.95rem; }
    .ks-actions { grid-template-columns: 1fr; }
    .ks-result { padding: 1rem 0.5rem; }

    /* Step 1 (input m e n) su due righe: input affiancati sopra, etichette sotto
       allineate al bordo interno del proprio input. Colonne 1 e 3 = 4rem (= larghezza
       input), così le etichette più larghe sporgono senza spostare l'allineamento. */
    .ks-dims {
      display: grid;
      grid-template-columns: 4rem auto 4rem;
      column-gap: 1.2rem;
      row-gap: 0.4rem;
      justify-content: center;
      align-items: center;
    }
    .ks-dims input { grid-row: 1; width: 100%; }
    #ksRows { grid-column: 1; }
    .ks-times { grid-row: 1; grid-column: 2; justify-self: center; }
    #ksCols { grid-column: 3; }
    .ks-dims label {
      grid-row: 2;
      width: max-content;
      white-space: nowrap;
    }
    label[for="ksRows"] { grid-column: 1; justify-self: center; }
    label[for="ksCols"] { grid-column: 3; justify-self: center; }
  }
</style>

<script>
import katex from 'katex';
import renderMathInElement from 'katex/contrib/auto-render';


// --- fraction ---
// fraction.mjs — Aritmetica razionale ESATTA su BigInt.
// È il "percorso veloce" usato quando la matrice contiene solo numeri.
// Invariante: den > 0, gcd(|num|, den) == 1, lo zero è 0/1.

function gcdBig(a, b) {
  a = a < 0n ? -a : a;
  b = b < 0n ? -b : b;
  while (b) { [a, b] = [b, a % b]; }
  return a;
}

class Fraction {
  constructor(num, den = 1n) {
    num = BigInt(num);
    den = BigInt(den);
    if (den === 0n) throw new Error('Fraction: denominatore nullo');
    if (den < 0n) { num = -num; den = -den; }
    const g = gcdBig(num, den) || 1n;
    this.num = num / g;
    this.den = den / g;
  }

  static get ZERO() { return new Fraction(0n, 1n); }
  static get ONE() { return new Fraction(1n, 1n); }

  // Parsing di una stringa "umana": intero, decimale, o frazione a/b.
  // Ritorna null se la stringa non è un numero razionale puro (es. contiene lettere).
  static tryParse(str) {
    const s = String(str).trim().replace(/\s+/g, '');
    if (s === '') return null;
    // frazione a/b
    let m = s.match(/^([+-]?\d+)\/([+-]?\d+)$/);
    if (m) return new Fraction(BigInt(m[1]), BigInt(m[2]));
    // intero
    m = s.match(/^([+-]?\d+)$/);
    if (m) return new Fraction(BigInt(m[1]), 1n);
    // decimale a.b (anche con segno)
    m = s.match(/^([+-]?)(\d*)\.(\d+)$/);
    if (m) {
      const sign = m[1] === '-' ? -1n : 1n;
      const intp = m[2] === '' ? 0n : BigInt(m[2]);
      const frac = m[3];
      const den = 10n ** BigInt(frac.length);
      const num = intp * den + BigInt(frac);
      return new Fraction(sign * num, den);
    }
    return null;
  }

  clone() { return new Fraction(this.num, this.den); }

  isZero() { return this.num === 0n; }
  isConstant() { return true; }
  isOne() { return this.num === 1n && this.den === 1n; }
  isMinusOne() { return this.num === -1n && this.den === 1n; }
  isInteger() { return this.den === 1n; }

  sign() { return this.num > 0n ? 1 : (this.num < 0n ? -1 : 0); }

  neg() { return new Fraction(-this.num, this.den); }
  inv() {
    if (this.num === 0n) throw new Error('Fraction: inverso di zero');
    return new Fraction(this.den, this.num);
  }

  add(o) { return new Fraction(this.num * o.den + o.num * this.den, this.den * o.den); }
  sub(o) { return new Fraction(this.num * o.den - o.num * this.den, this.den * o.den); }
  mul(o) { return new Fraction(this.num * o.num, this.den * o.den); }
  div(o) { return new Fraction(this.num * o.den, this.den * o.num); }

  equals(o) { return this.num === o.num && this.den === o.den; }

  // Rendering LaTeX coerente con lo stile del sito: interi nudi, frazioni con \frac,
  // segno meno portato davanti alla frazione.
  toLatex() {
    if (this.den === 1n) return this.num.toString();
    const sign = this.num < 0n ? '-' : '';
    const n = this.num < 0n ? -this.num : this.num;
    return `${sign}\\frac{${n.toString()}}{${this.den.toString()}}`;
  }

  toString() {
    return this.den === 1n ? this.num.toString() : `${this.num.toString()}/${this.den.toString()}`;
  }
}

// --- polynomial ---
// polynomial.mjs — Polinomio MULTIVARIATO a coefficienti razionali esatti (Fraction).
// Rappresentazione: mappa da monomio canonico -> coefficiente Fraction (non nullo).
// Un monomio è un oggetto { var: esponente, ... } con esponenti interi > 0.
// Invariante: nessun termine con coefficiente nullo (potatura automatica).
//
// Il punto cruciale per il rigore: isZero() è ESATTO. Un polinomio è nullo
// se e solo se, in forma canonica, non ha alcun termine. Questo rende ogni
// decisione di pivot (e quindi rango e dim Ker) decidibile senza ambiguità.


// chiave canonica di un monomio: variabili ordinate, "a^2|b^1"; costante -> ""
function monoKey(exps) {
  const keys = Object.keys(exps).filter((v) => exps[v] !== 0).sort();
  return keys.map((v) => `${v}^${exps[v]}`).join('|');
}
function keyToExps(key) {
  const exps = {};
  if (key === '') return exps;
  for (const part of key.split('|')) {
    const [v, e] = part.split('^');
    exps[v] = parseInt(e, 10);
  }
  return exps;
}

class Polynomial {
  // terms: Map<string, Fraction>
  constructor(terms = new Map()) {
    this.terms = new Map();
    for (const [k, c] of terms) if (!c.isZero()) this.terms.set(k, c);
  }

  static constant(fr) {
    const t = new Map();
    if (!fr.isZero()) t.set('', fr.clone());
    return new Polynomial(t);
  }
  static fromInt(n) { return Polynomial.constant(new Fraction(BigInt(n), 1n)); }
  static get ZERO() { return new Polynomial(); }
  static get ONE() { return Polynomial.constant(Fraction.ONE); }
  static variable(name) {
    const t = new Map();
    t.set(`${name}^1`, Fraction.ONE);
    return new Polynomial(t);
  }

  clone() {
    const t = new Map();
    for (const [k, c] of this.terms) t.set(k, c.clone());
    return new Polynomial(t);
  }

  isZero() { return this.terms.size === 0; }
  isConstant() { return this.terms.size === 0 || (this.terms.size === 1 && this.terms.has('')); }
  isOne() { return this.terms.size === 1 && this.terms.has('') && this.terms.get('').isOne(); }

  // Se è costante, ritorna la Fraction (utile per chiudere a numero).
  asConstant() {
    if (this.terms.size === 0) return Fraction.ZERO;
    if (this.terms.size === 1 && this.terms.has('')) return this.terms.get('').clone();
    return null;
  }

  vars() {
    const s = new Set();
    for (const k of this.terms.keys())
      for (const v of Object.keys(keyToExps(k))) s.add(v);
    return [...s].sort();
  }

  neg() {
    const t = new Map();
    for (const [k, c] of this.terms) t.set(k, c.neg());
    return new Polynomial(t);
  }

  add(o) {
    const t = new Map(this.terms);
    for (const [k, c] of o.terms) {
      const cur = t.get(k);
      if (cur) { const s = cur.add(c); if (s.isZero()) t.delete(k); else t.set(k, s); }
      else t.set(k, c.clone());
    }
    return new Polynomial(t);
  }
  sub(o) { return this.add(o.neg()); }

  scale(fr) {
    if (fr.isZero()) return Polynomial.ZERO;
    const t = new Map();
    for (const [k, c] of this.terms) t.set(k, c.mul(fr));
    return new Polynomial(t);
  }

  mul(o) {
    const t = new Map();
    for (const [k1, c1] of this.terms) {
      const e1 = keyToExps(k1);
      for (const [k2, c2] of o.terms) {
        const e2 = keyToExps(k2);
        const e = { ...e1 };
        for (const v of Object.keys(e2)) e[v] = (e[v] || 0) + e2[v];
        const k = monoKey(e);
        const prod = c1.mul(c2);
        const cur = t.get(k);
        if (cur) { const s = cur.add(prod); if (s.isZero()) t.delete(k); else t.set(k, s); }
        else t.set(k, prod);
      }
    }
    return new Polynomial(t);
  }

  equals(o) { return this.sub(o).isZero(); }

  degreeIn(name) {
    let d = 0;
    for (const k of this.terms.keys()) {
      const e = keyToExps(k)[name] || 0;
      if (e > d) d = e;
    }
    return d;
  }
  totalDegree() {
    let d = 0;
    for (const k of this.terms.keys()) {
      const e = keyToExps(k);
      const s = Object.values(e).reduce((a, b) => a + b, 0);
      if (s > d) d = s;
    }
    return d;
  }

  // Sostituisce una variabile con una Fraction; ritorna un nuovo Polynomial.
  substitute(name, fr) {
    let acc = Polynomial.ZERO;
    for (const [k, c] of this.terms) {
      const e = keyToExps(k);
      const p = e[name] || 0;
      let coeff = c;
      if (p > 0) { coeff = coeff.mul(fr.pow ? fr.pow(p) : fracPow(fr, p)); delete e[name]; }
      const nk = monoKey(e);
      const term = new Map(); term.set(nk, coeff);
      acc = acc.add(new Polynomial(term));
    }
    return acc;
  }

  // Valuta con tutte le variabili assegnate -> Fraction (errore se ne mancano).
  evalAll(assign) {
    let acc = Fraction.ZERO;
    for (const [k, c] of this.terms) {
      const e = keyToExps(k);
      let val = c.clone();
      for (const v of Object.keys(e)) {
        if (!(v in assign)) throw new Error(`evalAll: variabile ${v} non assegnata`);
        val = val.mul(fracPow(assign[v], e[v]));
      }
      acc = acc.add(val);
    }
    return acc;
  }

  // contenuto numerico: la Fraction g tale che p = g * (polinomio a coeff interi, contenuto 1)
  // Qui ci basta normalizzare il segno e il contenuto razionale per output puliti.
  // Ritorna { content: Fraction, prim: Polynomial } con prim a coefficienti interi e leading positivo.
  primitivePart() {
    if (this.isZero()) return { content: Fraction.ONE, prim: Polynomial.ZERO };
    // mcm dei denominatori, mcd dei numeratori
    let denLcm = 1n, numGcd = 0n;
    const g = (a, b) => { a = a < 0n ? -a : a; b = b < 0n ? -b : b; while (b) { [a, b] = [b, a % b]; } return a; };
    for (const c of this.terms.values()) {
      denLcm = denLcm / g(denLcm, c.den) * c.den;
    }
    for (const c of this.terms.values()) {
      const scaledNum = c.num * (denLcm / c.den);
      numGcd = g(numGcd, scaledNum);
    }
    if (numGcd === 0n) numGcd = 1n;
    // content = numGcd/denLcm, eventualmente segno dal termine guida
    let content = new Fraction(numGcd, denLcm);
    const t = new Map();
    for (const [k, c] of this.terms) {
      t.set(k, c.div(content));
    }
    let prim = new Polynomial(t);
    return { content, prim };
  }

  // Rendering LaTeX leggibile. Ordina per grado totale decrescente, poi per chiave.
  toLatex() {
    if (this.isZero()) return '0';
    const entries = [...this.terms.entries()].map(([k, c]) => ({ k, c, e: keyToExps(k) }));
    entries.sort((A, B) => {
      const dA = Object.values(A.e).reduce((a, b) => a + b, 0);
      const dB = Object.values(B.e).reduce((a, b) => a + b, 0);
      if (dB !== dA) return dB - dA;
      return A.k < B.k ? -1 : (A.k > B.k ? 1 : 0);
    });
    let out = '';
    entries.forEach((t, i) => {
      const isConst = t.k === '';
      const c = t.c;
      const neg = c.sign() < 0;
      const absC = neg ? c.neg() : c;
      // monomio in LaTeX
      let mono = '';
      const vars = Object.keys(t.e).sort();
      for (const v of vars) {
        mono += t.e[v] === 1 ? v : `${v}^{${t.e[v]}}`;
      }
      // coefficiente
      let coeffTex;
      if (isConst) coeffTex = absC.toLatex();
      else if (absC.isOne()) coeffTex = '';
      else if (absC.isInteger()) coeffTex = absC.toLatex();
      else coeffTex = absC.toLatex(); // frazione: \frac{}{} davanti al monomio
      const piece = coeffTex + mono || coeffTex || mono;
      if (i === 0) out += (neg ? '-' : '') + (piece === '' ? absC.toLatex() : piece);
      else out += (neg ? ' - ' : ' + ') + (piece === '' ? absC.toLatex() : piece);
    });
