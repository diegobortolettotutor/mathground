    pCaseTrivialAtVal: `<p>Tutti i pivot sono presenti: non ci sono variabili libere, quindi il nucleo resta banale, \\(\\operatorname{Ker} f=\\{\\mathbf{0}\\}\\).</p>`,
    pNonRational: (tex, approx, degree, realCount) => {
      let s = `<p>I restanti valori critici sono le radici dell'equazione \\(${tex}\\). Per questo polinomio sono <b>irrazionali</b>: non si possono scrivere come frazioni esatte, e chiuderle in forma esatta richiederebbe l'aritmetica sui numeri algebrici, fuori dalla portata di questo strumento, che lavora su numeri razionali. In ognuna di esse il rango cala di uno e il nucleo diventa di dimensione \\(1\\).</p>`;
      if (approx && approx.length) {
        const more = degree > realCount ? ` (le altre \\(${degree - realCount}\\) radici non sono reali)` : '';
        s += `<p>Per orientarti, ${realCount === 1 ? 'la radice reale vale' : 'le radici reali valgono'} circa \\(k \\approx ${approx.join(',\\quad ')}\\)${more}. Per ottenere la base del nucleo in uno di questi valori, sostituiscilo (anche in forma approssimata) e risolvi il sistema numerico, ad esempio con il risolutore di Gauss-Jordan.</p>`;
      } else {
        s += `<p>Questo polinomio non ha radici reali, quindi il caso non si presenta per valori reali del parametro: il nucleo resta banale per ogni \\(k\\) reale.</p>`;
      }
      return s;
    },
    pDeclared: (tex) => `<p>La condizione \\(${tex}\\) coinvolge più di un parametro: non la chiudo automaticamente, perché enumerarne tutti i sottocasi è un problema molto più ampio. Va analizzata a parte sostituendola nella matrice.</p>`,
    pRecursion: (param, val, resid) => `<p>Sostituendo \\(${param}=${val}\\), la matrice resta in funzione ${resid.length ? `del parametro \\(${resid.join(',')}\\)` : 'di nessun altro parametro'}; si richiude il ragionamento generico su ciò che rimane.</p>`,
    quickGenericLabel: `<p><b>Caso generico:</b></p>`,
    quickCaseLabel: (param, val) => `<p><b>Caso \\(${param}=${val}\\):</b></p>`,
  };

  const en = {
    title: 'Kernel of a linear map',
    m1: 'Rank and kernel dimension',
    m2: 'Searching for shortcuts',
    m3: 'Evaluating the shortcuts',
    m4: 'Solving the homogeneous system',
    m5: 'Comparison and conclusion',
    mCases: 'Case analysis',

    intro: (m, n) => `<p>The matrix \\(A\\) is \\(${m}\\times ${n}\\), so it represents a linear map \\(f:\\;K^{${n}}\\to K^{${m}}\\). We look for its <b>kernel</b>, the set of vectors \\(\\mathbf{x}\\) with \\(A \\cdot \\mathbf{x}=\\mathbf{0}\\).</p>`,
    m1body: (n, k) => `<p>The <b>image</b> of \\(f\\) is spanned by the columns of \\(A\\), and the <b>rank</b> is the dimension of the image: the number of pivots obtained by reducing the matrix. Here there are \\(${k}\\) pivots, so \\(\\dim(\\operatorname{Im} f)=${k}\\).</p>`,
    m1dim: (n, k, d) => `<p>By the <b>rank–nullity theorem</b> we have \\(\\dim(\\operatorname{Ker} f)+\\dim(\\operatorname{Im} f)=n\\), i.e.:</p>`,
    m1dimTex: (n, k, d) => `\\dim(\\operatorname{Ker} f)=n-\\operatorname{rank}(A)=${n}-${k}=${d}`,
    m1compass: (d) => d === 0
      ? `<p>So the kernel has dimension \\(0\\): its basis is empty and the kernel is just the zero vector. We will confirm this by solving the system.</p>`
      : `<p>This number is our compass: a basis of the kernel must contain exactly \\(${d}\\) independent ${d === 1 ? 'vector' : 'vectors'}.</p>`,

    m2intro: `<p>Solving \\(A \\cdot \\mathbf{x}=\\mathbf{0}\\) is the same as looking for linear relations among the columns:</p>`,
    m2introTex: (n) => `x_1\\,\\mathbf{c}_1+x_2\\,\\mathbf{c}_2+\\dots+x_{${n}}\\,\\mathbf{c}_{${n}}=\\mathbf{0}`,
    m2why: `<p>Every relation among columns yields a kernel vector: the relation's coefficients <i>are</i> the components of \\(\\mathbf{x}\\). We only look for relations a person would spot by eye — zero columns, multiples, or combinations of two or three previous columns — with "human" coefficients (small integers or simple fractions).</p>`,
    m2none: `<p>No simple relation among the columns is found: no useful shortcut. We proceed directly with the homogeneous system.</p>`,
    relNull: (j) => `<p>Column \\(\\mathbf{c}_{${j}}\\) is zero. Since \\(A\\,\\mathbf{e}_{${j}}=\\mathbf{c}_{${j}}=\\mathbf{0}\\), the vector \\(\\mathbf{e}_{${j}}\\) (with \\(1\\) in position \\(${j}\\), \\(0\\) elsewhere) belongs to the kernel.</p>`,
    relMult: (j, i, lam) => `<p>Column \\(\\mathbf{c}_{${j}}\\) is a multiple of the earlier \\(\\mathbf{c}_{${i}}\\): \\(\\mathbf{c}_{${j}}=\\left(${lam}\\right)\\mathbf{c}_{${i}}\\), i.e. \\(\\mathbf{c}_{${j}}-\\left(${lam}\\right)\\mathbf{c}_{${i}}=\\mathbf{0}\\). The kernel vector has \\(1\\) in position \\(${j}\\) and \\(${neg(lam)}\\) in position \\(${i}\\).</p>`,
    relCombo: (j, parts) => `<p>Column \\(\\mathbf{c}_{${j}}\\) is a linear combination of previous columns: \\(\\mathbf{c}_{${j}}=${parts.map((p) => `\\left(${p.coeff}\\right)\\mathbf{c}_{${p.col}}`).join('+')}\\). Rewriting it as \\(\\mathbf{c}_{${j}}-\\big(${parts.map((p) => `\\left(${p.coeff}\\right)\\mathbf{c}_{${p.col}}`).join('+')}\\big)=\\mathbf{0}\\) gives a kernel vector with \\(1\\) in position \\(${j}\\) and the opposite coefficients in the positions involved.</p>`,
    relVecLabel: `<p>The kernel vector found is:</p>`,
    m2found: (r) => `<p>In all, the shortcuts find \\(${r}\\) kernel ${r === 1 ? 'vector' : 'vectors'}.</p>`,

    m3eq: (r, d) => `<p>The shortcuts found \\(${r}\\) ${r === 1 ? 'vector' : 'vectors'}, and the kernel must have dimension \\(${d}\\). Since \\(${r}=${d}\\), these already form a complete <b>candidate basis</b>. We still solve the homogeneous system as a rigorous check.</p>`,
    m3part: (r, d) => `<p>The shortcuts found \\(${r}\\) ${r === 1 ? 'vector' : 'vectors'}, but the kernel has dimension \\(${d}\\): \\(${d - r}\\) ${d - r === 1 ? 'is' : 'are'} missing. We complete the basis with the homogeneous system.</p>`,
    m3none: (d) => `<p>No shortcut found: the kernel, of dimension \\(${d}\\), is determined by solving the homogeneous system.</p>`,
    m3indip: `<p>The shortcut vectors are independent by construction (each has its \\(1\\) in a different position); the rank check confirms it.</p>`,

    m4intro: `<p>We reduce \\(A\\) to reduced row echelon form (RREF) by Gauss-Jordan. Rank and pivots suffice for plain echelon form (REF); the <i>reduced</i> form (RREF) is handier here, since it lets us read the pivot variables directly in terms of the free ones. The detailed row operations are those of the Gauss-Jordan solver; here we use its result.</p>`,
    m4rref: `<p>The reduced row echelon form of \\(A\\) is:</p>`,
    m4noFree: `<p>There are no free variables: the only solution of \\(A \\cdot \\mathbf{x}=\\mathbf{0}\\) is \\(\\mathbf{x}=\\mathbf{0}\\). The kernel is trivial, \\(\\operatorname{Ker} f=\\{\\mathbf{0}\\}\\).</p>`,
    m4vars: (piv, free) => `<p>The <b>pivot</b> variables are \\(${piv}\\); the <b>free</b> variables are \\(${free}\\). Each non-zero row gives a pivot variable in terms of the free ones:</p>`,
    m4assign: (free) => `<p>Setting each free variable to \\(1\\) in turn and the others to \\(0\\) (\\(${free}\\)) yields one kernel vector each. Together they form the standard basis.</p>`,
    m4basis: `<p>The kernel basis from Gauss-Jordan is:</p>`,

    m5diff: `<p>The two bases (shortcuts and Gauss-Jordan) need not match vector by vector: they may differ by sign, scalar multiple, or linear combination. So we do not compare them entrywise; we check that they span the <b>same subspace</b> via ranks:</p>`,
    m5tex: (ra, rb, ru) => `\\operatorname{rank}(\\text{shortcuts})=${ra},\\quad \\operatorname{rank}(\\text{standard})=${rb},\\quad \\operatorname{rank}(\\text{union})=${ru}`,
    m5same: `<p>The three ranks agree: the shortcuts and the standard basis span exactly the same kernel. ✓</p>`,
    m5concl: (d) => d === 0
      ? `<p><b>Conclusion.</b> The kernel is trivial: \\(\\operatorname{Ker} f=\\{\\mathbf{0}\\}\\).</p>`
      : `<p><b>Conclusion.</b> The kernel has dimension \\(${d}\\) and a basis is:</p>`,

    pGeneric: (k, d) => `<p>The matrix contains a parameter. Reducing it with Gauss-Jordan divides by the pivots, implicitly assuming they are non-zero; under these assumptions the <b>generic</b> rank is \\(${k}\\) and \\(\\dim(\\operatorname{Ker} f)=${d}\\). The explicit pivots, and hence the genericity conditions, we will read shortly from the RREF.</p>`,
    pAssume: (list) => `<p>The genericity conditions are exactly the pivots we divided by, which you find as denominators in the RREF above. Explicitly: \\(${list.map((s) => s + '\\neq 0').join(',\\quad ')}\\). Parameter values violating them must be examined separately, since the rank may drop there.</p>`,
    pCaseDrop: (param, val, k, d) => `<p>For \\(${param}=${val}\\) the rank drops to \\(${k}\\), so \\(\\dim(\\operatorname{Ker} f)=${d}\\). We substitute the value into the matrix and recompute everything from scratch.</p>`,
    pCaseNoDrop: (param, val, k, d) => `<p>For \\(${param}=${val}\\) the rank does <b>not</b> drop: it stays \\(${k}\\), so \\(\\dim(\\operatorname{Ker} f)=${d}\\) as in the generic case (the value was only a candidate, since an intermediate pivot vanishes). We substitute to check it${d > 0 ? ', and because the generic basis is invalid here (a denominator vanishes)' : ''}.</p>`,
    pCaseSubst: (param, val) => `<p>We substitute \\(${param}=${val}\\) into the matrix formulas (boxed value) and carry out the computation:</p>`,
    pCaseRref: `<p>and its reduced row echelon form (RREF) is:</p>`,
    pCaseBasis: `<p>hence a kernel basis in this case:</p>`,
    pCaseTrivialAtVal: `<p>All pivots are present: there are no free variables, so the kernel stays trivial, \\(\\operatorname{Ker} f=\\{\\mathbf{0}\\}\\).</p>`,
    pNonRational: (tex, approx, degree, realCount) => {
      let s = `<p>The remaining critical values are the roots of \\(${tex}\\). For this polynomial they are <b>irrational</b>: they cannot be written as exact fractions, and closing them exactly would require algebraic-number arithmetic, beyond the reach of this tool, which works over the rationals. At each of them the rank drops by one and the kernel becomes one-dimensional.</p>`;
      if (approx && approx.length) {
        const more = degree > realCount ? ` (the other \\(${degree - realCount}\\) roots are not real)` : '';
        s += `<p>For orientation, ${realCount === 1 ? 'the real root is' : 'the real roots are'} about \\(k \\approx ${approx.join(',\\quad ')}\\)${more}. To get a kernel basis at one of these values, substitute it (even in approximate form) and solve the resulting numeric system, e.g. with the Gauss-Jordan solver.</p>`;
      } else {
        s += `<p>This polynomial has no real roots, so the case does not occur for real values of the parameter: the kernel stays trivial for every real \\(k\\).</p>`;
      }
      return s;
    },
    pDeclared: (tex) => `<p>The condition \\(${tex}\\) involves more than one parameter: it is not closed automatically, since enumerating all its sub-cases is a much larger problem. Analyze it separately by substituting it into the matrix.</p>`,
    pRecursion: (param, val, resid) => `<p>Substituting \\(${param}=${val}\\), the matrix still depends ${resid.length ? `on the parameter \\(${resid.join(',')}\\)` : 'on no further parameter'}; we re-close the generic reasoning on what remains.</p>`,
    quickGenericLabel: `<p><b>Generic case:</b></p>`,
    quickCaseLabel: (param, val) => `<p><b>Case \\(${param}=${val}\\):</b></p>`,
  };

  return lang === 'en' ? en : it;
}

function neg(texCoeff) {
  // opposto "testuale" di un coefficiente già in LaTeX (per la frase relMult)
  if (texCoeff.startsWith('-')) return texCoeff.slice(1);
  return '-' + texCoeff;
}

// ----------------------------------------------------------------- orchestratore
function buildNarration(cellStrings, lang = 'it') {
  const t = T(lang);
  const { matrix, field, vars } = buildMatrix(cellStrings);
  const m = matrix.length, n = m ? matrix[0].length : 0;
  const blocks = [];
  const push = (html, tex) => blocks.push(tex !== undefined ? { html, tex } : { html });

  push(`<h2>${t.title}</h2>` + t.intro(m, n), 'A = ' + matTex(matrix));

  if (vars.length > 0) return blocks.concat(narrateParametric(matrix, field, vars, n, m, t));
  return blocks.concat(narrateNumeric(matrix, field, n, t));
}

// versione sintetica: solo matrice + basi finali, senza la narrazione dei passaggi
function buildQuickResult(cellStrings, lang = 'it') {
  const t = T(lang);
  const { matrix, field, vars } = buildMatrix(cellStrings);
  const m = matrix.length, n = m ? matrix[0].length : 0;
  const blocks = [];
  const push = (html, tex) => blocks.push(tex !== undefined ? { html, tex } : { html });

  push(`<h2>${t.title}</h2>`, 'A = ' + matTex(matrix));

  if (vars.length === 0) {
    const { R, pivotCols, rank } = rref(matrix, field, { preferConstantPivot: true });
    const d = n - rank;
    if (d === 0) {
      push(t.m5concl(0));
    } else {
      const { basis } = kernelBasis(R, pivotCols, n, field);
      push(t.m5concl(d), basisTex(basis));
    }
    return blocks;
  }

  const a = analyzeParametric(matrix, field);
  push(t.quickGenericLabel);
  if (a.generic.nullity === 0) push(t.m5concl(0));
  else push(t.m5concl(a.generic.nullity), basisTex(a.generic.basis));
  if (a.generic.assumptions.length) push(t.pAssume(a.generic.assumptions.map((x) => condTex(x.num))));

  for (const br of a.branches) {
    push(t.quickCaseLabel(br.condition.param, br.condition.value.toLatex()));
    if (br.nullity === 0) push(t.m5concl(0));
    else push(t.m5concl(br.nullity), basisTex(br.basis));
  }
  for (const dc of a.declaredConditions) {
    const tex = condTex(dc.poly) + ' = 0';
    if (dc.kind === 'nonrational') push(t.pNonRational(tex, dc.approx, dc.degree, dc.realCount));
    else push(t.pDeclared(tex));
  }
  return blocks;
}

function narrateNumeric(matrix, field, n, t) {
  const blocks = [];
  const push = (html, tex) => blocks.push(tex !== undefined ? { html, tex } : { html });

  const { R, pivotCols, rank } = rref(matrix, field, { preferConstantPivot: true });
  const d = n - rank;

  // --- Momento 1
  push(`<h3>${t.m1}</h3>` + t.m1body(n, rank));
  push(t.m1dim(n, rank, d), t.m1dimTex(n, rank, d));
  push(t.m1compass(d));

  // --- Momento 2
  push(`<h3>${t.m2}</h3>` + t.m2intro, t.m2introTex(n));
  push(t.m2why);
  const sc = findShortcuts(matrix, field);
  if (sc.count === 0) {
    push(t.m2none);
  } else {
    for (const rel of sc.relations) {
      const j = rel.target + 1;
      if (rel.type === 'null') push(t.relNull(j));
      else if (rel.type === 'multiple') push(t.relMult(j, rel.parts[0].col + 1, rel.parts[0].coeff.toLatex()));
      else push(t.relCombo(j, rel.parts.map((p) => ({ col: p.col + 1, coeff: p.coeff.toLatex() }))));
    }
    push(t.relVecLabel, basisTex(sc.vectors));
    push(t.m2found(sc.count));
  }

  // --- Momento 3
  push(`<h3>${t.m3}</h3>`);
  if (sc.count === 0) push(t.m3none(d));
  else if (sc.count === d) { push(t.m3eq(sc.count, d)); push(t.m3indip); }
  else { push(t.m3part(sc.count, d)); push(t.m3indip); }

  // --- Momento 4
  push(`<h3>${t.m4}</h3>` + t.m4intro);
  push(t.m4rref, 'A_{\\text{RREF}} = ' + matTex(R));
  const { basis, freeCols } = kernelBasis(R, pivotCols, n, field);
  if (d === 0) {
    push(t.m4noFree);
  } else {
    const pivNames = pivotCols.map((c) => `x_{${c + 1}}`).join(',\\,');
    const freeNames = freeCols.map((c) => `x_{${c + 1}}`).join(',\\,');
    push(t.m4vars(pivNames, freeNames), readingTex(R, pivotCols, freeCols));
    push(t.m4assign(freeNames));
    push(t.m4basis, basisTex(basis));
  }

  // --- Momento 5
  push(`<h3>${t.m5}</h3>`);
  if (d === 0) {
    push(t.m5concl(d));
  } else if (sc.count > 0) {
    const ra = rankOfVectors(sc.vectors, field);
    const rb = rankOfVectors(basis, field);
    const ru = rankOfVectors([...sc.vectors, ...basis], field);
    push(t.m5diff, t.m5tex(ra, rb, ru));
    if (sameSpan(sc.vectors, basis, field)) push(t.m5same);
    push(t.m5concl(d), basisTex(basis));
  } else {
    push(t.m5concl(d), basisTex(basis));
  }
  return blocks;
}

// equazioni "x_pivot = - somma( R[riga][libera] x_libera )"
function readingTex(R, pivotCols, freeCols) {
  const lines = [];
  pivotCols.forEach((pc, idx) => {
    const terms = [];
    for (const f of freeCols) {
      const coeff = R[idx][f];
      if (coeff.isZero()) continue;
      const opp = coeff.neg();
      terms.push(`${opp.toLatex().startsWith('-') ? '' : '+'}${opp.toLatex()}\\,x_{${f + 1}}`);
    }
    const rhs = terms.length ? terms.join(' ').replace(/^\+/, '') : '0';
    lines.push(`x_{${pc + 1}} &= \\textstyle ${rhs}`);
  });
  return `\\begin{aligned} ${lines.join(' \\\\[3pt] ')} \\end{aligned}`;
}

function narrateParametric(matrix, field, vars, n, m, t) {
  const blocks = [];
  const push = (html, tex) => blocks.push(tex !== undefined ? { html, tex } : { html });
  const a = analyzeParametric(matrix, field);
  const k = a.generic.rank, d = a.generic.nullity;

  // Momento 1 (generico)
  push(`<h3>${t.m1}</h3>` + t.pGeneric(k, d), t.m1dimTex(n, k, d));
  push(t.m1compass(d));

  // Momento 2 — ricerca scorciatoie (relazioni costanti valide per OGNI valore del parametro)
  push(`<h3>${t.m2}</h3>` + t.m2intro, t.m2introTex(n));
  push(t.m2why);
  const sc = findShortcuts(matrix, field);
  if (sc.count === 0) {
    push(t.m2none);
  } else {
    for (const rel of sc.relations) {
      const j = rel.target + 1;
      if (rel.type === 'null') push(t.relNull(j));
      else if (rel.type === 'multiple') push(t.relMult(j, rel.parts[0].col + 1, rel.parts[0].coeff.toLatex()));
      else push(t.relCombo(j, rel.parts.map((p) => ({ col: p.col + 1, coeff: p.coeff.toLatex() }))));
    }
    push(t.relVecLabel, basisTex(sc.vectors));
    push(t.m2found(sc.count));
  }

  // Momento 3 — valutazione (mostrata SEMPRE, anche se infruttuosa)
  push(`<h3>${t.m3}</h3>`);
  if (sc.count === 0) push(t.m3none(d));
  else if (sc.count === d) { push(t.m3eq(sc.count, d)); push(t.m3indip); }
  else { push(t.m3part(sc.count, d)); push(t.m3indip); }

  // Momento 4 (RREF generica) — la mostriamo PRIMA di dichiarare le condizioni,
  // così si vede da dove escono (sono i pivot/denominatori).
  const { R, pivotCols } = rref(matrix, field, { preferConstantPivot: true });
  push(`<h3>${t.m4}</h3>` + t.m4intro);
  push(t.m4rref, 'A_{\\text{RREF}} = ' + matTex(R));
  if (a.generic.assumptions.length) push(t.pAssume(a.generic.assumptions.map((x) => condTex(x.num))));
  if (d === 0) push(t.m4noFree);
  else push(t.m4basis, basisTex(a.generic.basis));

  // Analisi per casi
  push(`<h3>${t.mCases}</h3>`);
  for (const br of a.branches) {
    const param = br.condition.param, val = br.condition.value.toLatex();
    if (br.rankDropped) push(t.pCaseDrop(param, val, br.rank, br.nullity));
    else push(t.pCaseNoDrop(param, val, br.rank, br.nullity));
    // matrice sostituita: A = (formule con valore incorniciato) = (matrice semplificata)
    push(t.pCaseSubst(param, val),
      'A = ' + matSubstTex(matrix, br.condition.param, val) + ' = ' + matTex(br.subMatrix));
    push(t.pCaseRref, 'A_{\\text{RREF}} = ' + matTex(br.R));
    // lettura pivot/libere + base, oppure nucleo banale
    if (br.nullity > 0) {
      const pivNames = br.pivotCols.map((c) => `x_{${c + 1}}`).join(',\\,');
      const freeNames = br.freeCols.map((c) => `x_{${c + 1}}`).join(',\\,');
      push(t.m4vars(pivNames, freeNames), readingTex(br.R, br.pivotCols, br.freeCols));
      push(t.pCaseBasis, basisTex(br.basis));
    } else {
      push(t.pCaseTrivialAtVal);
    }
    if (br.residualParams && br.residualParams.length) push(t.pRecursion(param, val, br.residualParams));
  }
  for (const dc of a.declaredConditions) {
    const tex = condTex(dc.poly) + ' = 0';
    if (dc.kind === 'nonrational') push(t.pNonRational(tex, dc.approx, dc.degree, dc.realCount));
    else push(t.pDeclared(tex));
  }
  return blocks;
}


// ====================================================================== WIRING
const __ksRoot = document.querySelector('.ks-root');
if (__ksRoot) initKernelSolver(__ksRoot);

function initKernelSolver(root) {
  const LANG = (root.dataset.lang || document.documentElement.lang || 'it')
    .toLowerCase().startsWith('en') ? 'en' : 'it';
  const S = {
    it: { parseErr: (msg) => 'Cella non valida: ' + msg, empty: 'Inserisci almeno un valore non nullo.' },
    en: { parseErr: (msg) => 'Invalid cell: ' + msg, empty: 'Enter at least one non-zero value.' },
  }[LANG];

  const inRows = root.querySelector('#ksRows');
  const inCols = root.querySelector('#ksCols');
  const gridHost = root.querySelector('#ksGrid');
  const parenL = root.querySelector('.ks-paren-l');
  const parenR = root.querySelector('.ks-paren-r');
  const xeq = root.querySelector('#ksXeq');
  const statusEl = root.querySelector('#ksStatus');
  const out = root.querySelector('#ksOut');

  let rows = 3, cols = 4;

  const KOPTS = { throwOnError: false, displayMode: true };
  const RMOPTS = {
    throwOnError: false,
    delimiters: [
      { left: '\\(', right: '\\)', display: false },
      { left: '\\[', right: '\\]', display: true },
    ],
  };
  function renderKatexBlock(tex) {
    const safe = tex.replace(/\\mspace/g, '\\mkern');
    try { return katex.renderToString(safe, KOPTS); }
    catch (e) { return '<span style="color:#e55">[KaTeX error]</span>'; }
  }
  function renderInline(el) { try { renderMathInElement(el, RMOPTS); } catch (e) {} }
  function tip(msg) { statusEl.textContent = msg; statusEl.className = 'ks-status ks-error'; }
  function unTip() { statusEl.textContent = ''; statusEl.className = 'ks-status'; }
  function reveal(el) { el.hidden = false; el.style.display = 'block'; requestAnimationFrame(() => el.classList.add('ks-visible')); }

  function buildGrid() {
    rows = Math.max(1, Math.min(8, parseInt(inRows.value, 10) || 1));
    cols = Math.max(1, Math.min(10, parseInt(inCols.value, 10) || 1));
    let table = '<table class="ks-grid"><tbody>';
    for (let r = 0; r < rows; r++) {
      table += '<tr>';
      for (let c = 0; c < cols; c++) {
        table += '<td><input class="ks-cell" type="text" inputmode="text" autocomplete="off" '
          + 'data-row="' + r + '" data-col="' + c + '" value="0"></td>';
      }
      table += '</tr>';
    }
    table += '</tbody></table>';
    gridHost.innerHTML = table;
    renderXeq();
    fitBrackets();
  }

  function renderXeq() {
    const xv = [];
    for (let c = 0; c < cols; c++) xv.push('x_{' + (c + 1) + '}');
    const zv = [];
    for (let r = 0; r < rows; r++) zv.push('0');
    const tex = '\\;\\cdot\\;\\begin{pmatrix}' + xv.join('\\\\') + '\\end{pmatrix}'
      + '\\;=\\;\\begin{pmatrix}' + zv.join('\\\\') + '\\end{pmatrix}';
    try { xeq.innerHTML = katex.renderToString(tex, { throwOnError: false, displayMode: false }); }
    catch (e) { xeq.innerHTML = ''; }
  }

  // ---- Parentesi SVG: path matematico reale di KaTeX (tallDelim) ----
    const PAREN_VBW = 875;
    const PAREN_CAP_HEIGHT = 3600;
    function gjLparenPath(midHeight) {
      return `M863,9c0,-2,-2,-5,-6,-9c0,0,-17,0,-17,0c-12.7,0,-19.3,0.3,-20,1
c-5.3,5.3,-10.3,11,-15,17c-242.7,294.7,-395.3,682,-458,1162c-21.3,163.3,-33.3,349,
-36,557 l0,${midHeight + 84}c0.2,6,0,26,0,60c2,159.3,10,310.7,24,454c53.3,528,210,
949.7,470,1265c4.7,6,9.7,11.7,15,17c0.7,0.7,7,1,19,1c0,0,18,0,18,0c4,-4,6,-7,6,-9
c0,-2.7,-3.3,-8.7,-10,-18c-135.3,-192.7,-235.5,-414.3,-300.5,-665c-65,-250.7,-102.5,
-544.7,-112.5,-882c-2,-104,-3,-167,-3,-189
l0,-${midHeight + 92}c0,-162.7,5.7,-314,17,-454c20.7,-272,63.7,-513,129,-723c65.3,
-210,155.3,-396.3,270,-559c6.7,-9.3,10,-15.3,10,-18z`;
    }
    function gjRparenPath(midHeight) {
      return `M76,0c-16.7,0,-25,3,-25,9c0,2,2,6.3,6,13c21.3,28.7,42.3,60.3,
63,95c96.7,156.7,172.8,332.5,228.5,527.5c55.7,195,92.8,416.5,111.5,664.5
c11.3,139.3,17,290.7,17,454c0,28,1.7,43,3.3,45l0,${midHeight + 9}
c-3,4,-3.3,16.7,-3.3,38c0,162,-5.7,313.7,-17,455c-18.7,248,-55.8,469.3,-111.5,664
c-55.7,194.7,-131.8,370.3,-228.5,527c-20.7,34.7,-41.7,66.3,-63,95c-2,3.3,-4,7,-6,11
c0,7.3,5.7,11,17,11c0,0,11,0,11,0c9.3,0,14.3,-0.3,15,-1c5.3,-5.3,10.3,-11,15,-17
c242.7,-294.7,395.3,-681.7,458,-1161c21.3,-164.7,33.3,-350.7,36,-558
l0,-${midHeight + 144}c-2,-159.3,-10,-310.7,-24,-454c-53.3,-528,-210,-949.7,
-470,-1265c-4.7,-6,-9.7,-11.7,-15,-17c-0.7,-0.7,-6.7,-1,-18,-1z`;
    }
    function gjParenSvg(side, heightPx, widthPx) {
      const k = widthPx / PAREN_VBW;
      let viewBoxHeight = Math.round(heightPx / k);
      let midHeight = viewBoxHeight - PAREN_CAP_HEIGHT;
      if (midHeight < 0) midHeight = 0;
      viewBoxHeight = PAREN_CAP_HEIGHT + midHeight;
      const renderedHeight = viewBoxHeight * k;
      const d = side === 'l' ? gjLparenPath(midHeight) : gjRparenPath(midHeight);
      const w = widthPx.toFixed(2), h = renderedHeight.toFixed(2);
      const style = `display:block !important;flex:0 0 auto;`
        + `width:${w}px !important;height:${h}px !important;`
        + `max-width:none !important;opacity:1 !important;visibility:visible !important`;
      return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${PAREN_VBW} ${viewBoxHeight}" width="${w}" height="${h}" preserveAspectRatio="none" style="${style}" aria-hidden="true"><path d="${d}" fill="currentColor"/></svg>`;
    }

    function fitBrackets(tries) {
      tries = tries || 0;
      requestAnimationFrame(() => {
        const grid = gridHost.querySelector('.ks-grid');
        if (!grid || grid.getBoundingClientRect().height <= 0) {
          if (tries < 12) fitBrackets(tries + 1);
          return;
        }
        const G = grid.getBoundingClientRect().height;
        const fontSizePx = parseFloat(getComputedStyle(parenL).fontSize) || 16;
        const widthPx = fontSizePx * 0.875;
        parenL.innerHTML = gjParenSvg('l', G, widthPx);
        parenR.innerHTML = gjParenSvg('r', G, widthPx);
      });
    }

  function gatherCells() {
    const data = [];
    for (let r = 0; r < rows; r++) {
      const row = [];
      for (let c = 0; c < cols; c++) {
        const inp = gridHost.querySelector('.ks-cell[data-row="' + r + '"][data-col="' + c + '"]');
        row.push(inp ? inp.value : '0');
      }
      data.push(row);
    }
    return data;
  }

  function clearOut() { out.innerHTML = ''; out.classList.remove('ks-visible'); out.hidden = true; out.style.display = 'none'; }

  function renderBlocks(blocks) {
    out.innerHTML = '';
    for (const b of blocks) {
      if (b.html) {
        const div = document.createElement('div');
        div.className = 'ks-text';
        div.innerHTML = b.html.replace(/\\mspace/g, '\\mkern');
        out.appendChild(div);
        renderInline(div);
      }
      if (b.tex !== undefined) {
        const wrap = document.createElement('div');
        wrap.className = 'ks-katex';
        wrap.innerHTML = renderKatexBlock(b.tex);
        out.appendChild(wrap);
      }
    }
    reveal(out);
  }

  let ksRandomUsed = false;

  function ksTrack(mode) {
    const paramsUsed = gatherCells().some((row) => row.some((v) => /[a-zA-Z]/.test(v)));
    if (window.umami) umami.track('kernel-solve', { mode, rows, cols, randomUsed: ksRandomUsed, paramsUsed });
  }

  function step() {
    unTip();
    const cells = gatherCells();
    let blocks;
    try { blocks = buildNarration(cells, LANG); }
    catch (e) { tip(S.parseErr(e.message || String(e))); return; }
    renderBlocks(blocks);
    ksTrack('steps');
  }

  function quick() {
    unTip();
    const cells = gatherCells();
    let blocks;
    try { blocks = buildQuickResult(cells, LANG); }
    catch (e) { tip(S.parseErr(e.message || String(e))); return; }
    renderBlocks(blocks);
    ksTrack('quick');
  }

  function reset() {
    gridHost.querySelectorAll('.ks-cell').forEach((inp) => { inp.value = '0'; });
    clearOut(); unTip();
    ksRandomUsed = false;
  }
  function randomize() {
    gridHost.querySelectorAll('.ks-cell').forEach((inp) => {
      inp.value = String(Math.floor(Math.random() * 7) - 3); // -3..3
    });
    clearOut(); unTip();
    ksRandomUsed = true;
  }

  // allargamento cella in focus (porting dal Gauss-Jordan)
  let blurTimer = null;
  function setFocus(cell) {
    gridHost.querySelectorAll('.ks-cell').forEach((el) => el.classList.toggle('ks-cell-wide', el === cell));
  }
  gridHost.addEventListener('focusin', (e) => {
    if (e.target.classList && e.target.classList.contains('ks-cell')) {
      if (blurTimer) { clearTimeout(blurTimer); blurTimer = null; }
      setFocus(e.target);
    }
  });
  gridHost.addEventListener('focusout', () => {
    if (blurTimer) clearTimeout(blurTimer);
    blurTimer = setTimeout(() => { setFocus(null); blurTimer = null; }, 0);
  });

  inRows.addEventListener('input', () => { buildGrid(); clearOut(); });
  inCols.addEventListener('input', () => { buildGrid(); clearOut(); });
  root.querySelector('#ksBtnReset').addEventListener('click', reset);
  root.querySelector('#ksBtnRandom').addEventListener('click', randomize);
  root.querySelector('#ksBtnQuick').addEventListener('click', quick);
  root.querySelector('#ksBtnStep').addEventListener('click', step);

  buildGrid();
  renderInline(root);
  fitBrackets();
  window.addEventListener('resize', fitBrackets);
}

</script>