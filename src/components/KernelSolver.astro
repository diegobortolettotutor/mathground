// Risolve, in modo esatto, il sistema  Σ_t x_t · c_{S[t]} = c_j  (tutte le m righe).
// Ritorna { ok, coeffs } solo se la soluzione è UNICA e CONSISTENTE su tutte le righe.
function solveCombination(matrix, S, j, field) {
  const k = S.length;
  const aug = matrix.map((row) => [...S.map((c) => row[c].clone()), row[j].clone()]);
  const { R, pivotCols } = rref(aug, field);
  // inconsistente se l'ultima colonna è di pivot
  if (pivotCols.includes(k)) return { ok: false };
  // unica solo se ciascuna delle prime k colonne è di pivot
  for (let t = 0; t < k; t++) if (!pivotCols.includes(t)) return { ok: false };
  const coeffs = new Array(k);
  pivotCols.forEach((pc, idx) => { if (pc < k) coeffs[pc] = R[idx][k].clone(); });
  return { ok: true, coeffs };
