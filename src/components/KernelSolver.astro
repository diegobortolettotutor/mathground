// Gauss-Jordan -> forma a scala ridotta per righe (RREF).
// Ritorna:
//   R           : matrice ridotta
//   pivotCols   : indici di colonna dei pivot (in ordine)
//   rank        : numero di pivot
//   ops         : log di operazioni elementari [{type, ...}] per la narrazione
//   assumptions : elementi-pivot NON costanti su cui abbiamo diviso (pivot ≠ 0 assunto).
//                 Per il campo numerico è sempre vuoto.
function rref(M, field, opts = {}) {
  const preferConst = !!opts.preferConstantPivot;
  const R = cloneMatrix(M);
  const m = R.length, n = m ? R[0].length : 0;
  const ops = [];
  const pivotCols = [];
  const assumptions = [];
  let pivRow = 0;

  for (let col = 0; col < n && pivRow < m; col++) {
    // cerca un pivot non nullo nella colonna, da pivRow in giù.
    // Se richiesto, PREFERISCE un pivot costante non nullo (evita di assumere ≠ 0
    // un'espressione simbolica quando esiste già un pivot numerico utilizzabile).
    let sel = -1;
    if (preferConst) {
      for (let r = pivRow; r < m; r++) {
        const e = R[r][col];
        if (!e.isZero() && e.isConstant && e.isConstant()) { sel = r; break; }
      }
    }
    if (sel === -1) {
      for (let r = pivRow; r < m; r++) { if (!R[r][col].isZero()) { sel = r; break; } }
    }
    if (sel === -1) continue; // colonna senza pivot (variabile libera)

    if (sel !== pivRow) {
      const tmp = R[sel]; R[sel] = R[pivRow]; R[pivRow] = tmp;
      ops.push({ type: 'swap', i: pivRow, j: sel });
    }

    const pivotEl = R[pivRow][col];
    if (!pivotEl.isConstant || (pivotEl.isConstant && !pivotEl.isConstant())) {
      // elemento simbolico non costante: dividerci significa assumerlo ≠ 0
      if (pivotEl.isConstant && !pivotEl.isConstant()) {
        assumptions.push({ col, element: pivotEl.clone() });
      }
    }
    // normalizza il pivot a 1 (se non lo è già)
    if (!R[pivRow][col].isOne()) {
      const inv = R[pivRow][col].inv();
      for (let c = col; c < n; c++) R[pivRow][c] = R[pivRow][c].mul(inv);
      ops.push({ type: 'scale', i: pivRow, factor: inv });
    }
    // azzera tutte le altre righe in questa colonna (sopra e sotto)
    for (let r = 0; r < m; r++) {
      if (r === pivRow) continue;
      const f = R[r][col];
      if (!f.isZero()) {
        const negf = f.neg();
        for (let c = col; c < n; c++) R[r][c] = R[r][c].add(negf.mul(R[pivRow][c]));
        ops.push({ type: 'addmul', target: r, source: pivRow, factor: negf });
      }
    }
    pivotCols.push(col);
    pivRow++;
  }
  return { R, pivotCols, rank: pivotCols.length, ops, assumptions };
}

// Base del nucleo a partire dalla RREF.
// Per ogni colonna libera f si costruisce un vettore con 1 in posizione f e, nelle
// posizioni dei pivot, l'opposto del coefficiente di f nella riga di quel pivot.
function kernelBasis(R, pivotCols, n, field) {
  const m = R.length;
  const isPivotCol = new Array(n).fill(false);
  pivotCols.forEach((c) => { isPivotCol[c] = true; });
  // riga del pivot per ciascuna colonna-pivot (in RREF il k-esimo pivot sta nella riga k)
  const pivotRowOfCol = {};
  pivotCols.forEach((c, k) => { pivotRowOfCol[c] = k; });

  const freeCols = [];
  for (let c = 0; c < n; c++) if (!isPivotCol[c]) freeCols.push(c);

  const basis = [];
  for (const fcol of freeCols) {
    const vec = new Array(n).fill(null).map(() => field.zero());
    vec[fcol] = field.one();
    for (const pcol of pivotCols) {
      const prow = pivotRowOfCol[pcol];
      // x_pcol = - R[prow][fcol]
      vec[pcol] = R[prow][fcol].neg();
    }
    basis.push(vec);
  }
  return { basis, freeCols };
}

// Rango di un insieme di vettori (colonne) sullo stesso campo: riduco la matrice
// che li ha come RIGHE e conto i pivot. Serve per il confronto fra sottospazi.
function rankOfVectors(vectors, field) {
  if (vectors.length === 0) return 0;
  const M = vectors.map((v) => v.map((e) => e.clone()));
  return rref(M, field).rank;
}

// Verifica che due insiemi di vettori generino lo STESSO sottospazio:
//   rank(A) == rank(B) == rank(A ∪ B).
function sameSpan(vecsA, vecsB, field) {
  const rA = rankOfVectors(vecsA, field);
  const rB = rankOfVectors(vecsB, field);
  const rU = rankOfVectors([...vecsA, ...vecsB], field);
  return rA === rB && rB === rU;
}

// --- shortcuts ---
// shortcuts.mjs — Ricerca didattica delle scorciatoie "umane".
// Ax = 0 equivale a cercare relazioni lineari tra le colonne. Scandendo le colonne
// da sinistra a destra, per ogni colonna-target j cerchiamo UNA relazione che la
// esprima come combinazione di colonne PRECEDENTI (indice < j), con coefficienti
// umani (interi piccoli o frazioni semplici). Ogni relazione produce un vettore del
// nucleo: 1 nella posizione target, gli opposti dei coefficienti nelle posizioni
// coinvolte, 0 altrove. Una relazione al massimo per target -> vettori indipendenti
// per costruzione (ognuno ha l'1 in una posizione diversa).
//
// Si cercano relazioni con al più 3 colonne precedenti (nessuno studente cercherebbe
// combinazioni di 4+ colonne come "scorciatoia"). Caso simbolico: si accettano solo
// coefficienti COSTANTI umani, cioè relazioni valide per OGNI valore del parametro.



// Insieme dei coefficienti "umani": interi piccoli o frazioni a denominatore piccolo.
// Tarato per accettare -3,-2,-1,-1/2,1/2,1,2,3,... e rifiutare cose tipo 17/43.
const HUMAN_DENS = [1n, 2n, 3n, 4n, 5n];
const HUMAN_MAX_ABS_NUM = 12n;

function asFrac(el) {
  // Fraction restituisce sé stessa; RationalFunction la sua Fraction costante o null.
  if (typeof el.asFraction === 'function') return el.asFraction();
  return el; // è già una Fraction
}
