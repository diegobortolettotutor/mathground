// --- rationalfunction ---
// rationalfunction.mjs — Funzione razionale ESATTA: rapporto di due Polynomial.
// È il backend simbolico vero e proprio. Stessa API di Fraction, così il motore
// di Gauss-Jordan è scritto UNA SOLA VOLTA contro un'interfaccia comune.
//
// Riduzione:
//  - se il denominatore è costante -> diventa un polinomio puro (den = 1);
//  - se num e den coinvolgono al più UNA variabile (il caso realistico a un
//    parametro) -> riduzione esatta tramite MCD di polinomi univariati;
//  - nel raro multivariato -> normalizzazione del contenuto/segno (correttezza
//    garantita comunque, perché isZero() guarda solo il numeratore).



// ----- utilità univariate (coefficienti Fraction, indice = grado) -----
function polyToUni(poly, v) {
  const d = poly.degreeIn(v);
  const arr = new Array(d + 1).fill(null).map(() => Fraction.ZERO);
  for (const [k, c] of poly.terms) {
    // un termine univariato ha chiave "" oppure "v^e"
    if (k === '') { arr[0] = arr[0].add(c); continue; }
    const [vv, e] = k.split('^');
    arr[parseInt(e, 10)] = arr[parseInt(e, 10)].add(c);
