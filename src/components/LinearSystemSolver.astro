---
/**
 * LinearSystemSolver.astro — Risolutore didattico di SISTEMI LINEARI (anche non omogenei).
 * Bilingue (it/en), aritmetica esatta (razionale su BigInt + funzioni razionali
 * multivariate per i parametri), spiegazione passo-passo in KaTeX.
 *
 * Impostazione sulla falsariga di KernelSolver.astro:
 *   - stesse classi/pattern grafici (prefisso ls- invece di ks-);
 *   - stesso motore aritmetico (Fraction / Polynomial / RationalFunction / rref);
 *   - scorciatoie "a occhio" adattate al caso non omogeneo (incompatibilità evidenti,
 *     soluzione particolare visibile, relazioni fra colonne per la parte omogenea);
 *   - via maestra SEMPRE mostrata: Rouché-Capelli, Gauss-Jordan sull'aumentata,
 *     forma parametrica della soluzione generale (parametri = variabili libere).
 *
 * Dipendenze (già nel progetto): npm install katex
 * Uso in una pagina .mdx:
 *   import LinearSystemSolver from '../../../components/LinearSystemSolver.astro';
 *   <LinearSystemSolver />
 *
 * Una sola istanza per pagina (come per GaussJordan.astro e KernelSolver.astro).
 */
import 'katex/dist/katex.min.css';

const lang = (Astro.currentLocale ?? 'it').toLowerCase().startsWith('en') ? 'en' : 'it';

const UI = {
  it: {
    title: 'Sistemi lineari',
    subtitle: 'Risoluzione di \\(A \\cdot \\mathbf{x}=\\mathbf{b}\\) con Rouché-Capelli, scorciatoie e Gauss-Jordan',
    step1: 'Step 1 \u2014 IMPOSTA LE DIMENSIONI DEL SISTEMA',
    rowsLabel: 'Equazioni \\((m)\\)',
    colsLabel: 'Incognite \\((n)\\)',
    step2: 'Step 2 \u2014 COMPILA LA MATRICE \\(A\\) E IL TERMINE NOTO \\(\\mathbf{b}\\)',
    note: 'Cerchiamo TUTTE le soluzioni del sistema \\(A \\cdot \\mathbf{x}=\\mathbf{b}\\): prima le scorciatoie, poi in ogni caso la via maestra con Gauss-Jordan e la forma parametrica del risultato.',
    btnReset: 'AZZERA VALORI',
    btnRandom: 'VALORI CASUALI',
    btnQuick: 'RISULTATO SINTETICO',
    btnStep: 'SVOLGIMENTO PASSO-PASSO',
  },
  en: {
    title: 'Linear systems',
    subtitle: 'Solving \\(A \\cdot \\mathbf{x}=\\mathbf{b}\\) via Rouché-Capelli, shortcuts and Gauss-Jordan',
    step1: 'Step 1 \u2014 SET THE SYSTEM DIMENSIONS',
    rowsLabel: 'Equations \\((m)\\)',
    colsLabel: 'Unknowns \\((n)\\)',
    step2: 'Step 2 \u2014 FILL IN THE MATRIX \\(A\\) AND THE RIGHT-HAND SIDE \\(\\mathbf{b}\\)',
    note: 'We look for ALL solutions of \\(A \\cdot \\mathbf{x}=\\mathbf{b}\\): shortcuts first, then in any case the standard route with Gauss-Jordan and the parametric form of the result.',
    btnReset: 'RESET VALUES',
    btnRandom: 'RANDOM VALUES',
    btnQuick: 'QUICK RESULT',
    btnStep: 'STEP-BY-STEP SOLUTION',
  },
}[lang];
---

<div class="ls-root" data-lang={lang}>
  <section class="ls-panel">
    <h4 class="ls-steplabel">{UI.step1}</h4>
    <div class="ls-dims" id="lsDims">
      <label for="lsRows" set:html={UI.rowsLabel}></label>
      <input id="lsRows" type="number" min="1" max="8" value="3" />
      <span class="ls-times">\(\large\times\)</span>
      <input id="lsCols" type="number" min="1" max="8" value="3" />
      <label for="lsCols" set:html={UI.colsLabel}></label>
    </div>
  </section>

  <section class="ls-panel">
    <h4 class="ls-steplabel">{UI.step2}</h4>
    <div class="ls-eqwrap" id="lsEqWrap">
      <div class="ls-eq">
        <span class="ls-paren ls-paren-al" aria-hidden="true"></span>
        <div id="lsGrid" class="ls-gridhost"></div>
        <span class="ls-paren ls-paren-ar" aria-hidden="true"></span>
        <span id="lsXeq" class="ls-xeq"></span>
        <span class="ls-paren ls-paren-bl" aria-hidden="true"></span>
        <div id="lsBGrid" class="ls-gridhost"></div>
        <span class="ls-paren ls-paren-br" aria-hidden="true"></span>
      </div>
    </div>
    <p class="ls-note" set:html={UI.note}></p>
    <div id="lsStatus" class="ls-status" role="alert" aria-live="polite"></div>
  </section>

  <div class="ls-actions">
    <button id="lsBtnReset" class="ls-btn ls-btn-ghost" type="button">{UI.btnReset}</button>
    <button id="lsBtnRandom" class="ls-btn ls-btn-ghost" type="button">{UI.btnRandom}</button>
    <button id="lsBtnQuick" class="ls-btn ls-btn-ghost" type="button">{UI.btnQuick}</button>
  </div>

  <div class="ls-secondary">
    <button id="lsBtnStep" class="ls-btn ls-btn-ghost ls-btn-wide" type="button">{UI.btnStep}</button>
  </div>

  <section id="lsOut" class="ls-result" hidden></section>
</div>

<style is:global>
  .ls-root {
    --ls-radius: 12px;
    --ls-surface: var(--sl-color-gray-6, #1a1a1a);
    --ls-border: var(--sl-color-gray-5, #383838);
    --ls-accent: var(--sl-color-accent, #4f7cff);
    --ls-red: #d11111;
    --ls-accent-hi: var(--sl-color-accent-high, #b8c8ff);
    font-size: 1rem; line-height: 1.5;
    min-width: 330px;
    color: var(--sl-color-text, inherit);
    width: 100%; margin: 1.5rem 0; text-align: center;
  }
  .ls-root *, .ls-root *::before, .ls-root *::after { box-sizing: border-box; }

  .ls-panel {
    background: var(--ls-surface); border: 1px solid var(--ls-border);
    border-radius: var(--ls-radius); padding: 1.25rem 1rem; margin: 1.25rem 0;
  }
  .ls-steplabel {
    margin: 0 0 1rem; font-size: clamp(0.8rem, 2.4vw, 1rem);
    letter-spacing: 0.02em; color: var(--sl-color-text-accent, var(--ls-accent-hi));
  }

  .ls-dims { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 1.2rem; }
  .ls-dims label { font-size: 1rem; }
  .ls-dims input, .ls-cell {
    background: var(--sl-color-bg, #000); color: var(--sl-color-text, #fff);
    border: 1.5px solid var(--ls-border); border-radius: 6px; text-align: center;
    padding: 0.35rem; font: inherit;
  }
  .ls-dims input { width: 4rem; }
  .ls-dims input:hover, .ls-cell:hover {
    border-color: var(--ls-accent);
    background: color-mix(in srgb, var(--ls-accent) 10%, var(--sl-color-bg, #000));
  }
  .ls-dims input:focus, .ls-cell:focus { border-color: var(--ls-accent); outline: none; }
  .ls-times { font-size: 1.3rem; }

  .ls-eqwrap { overflow-x: auto; padding: 0.5rem 0.25rem; }
  .ls-eq { display: inline-flex; align-items: center; justify-content: center; gap: 0.15rem; min-width: 100%; white-space: nowrap; }
  .ls-gridhost { display: inline-block; }
  .ls-paren { display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; line-height: 0; color: var(--sl-color-text, inherit); }
  .ls-paren svg { display: block; }
  .ls-xeq { display: inline-flex; align-items: center; padding: 0 0.5rem; white-space: nowrap; }

  .ls-root .ls-grid {
    display: table !important; width: auto !important; margin: 0; border: 0 !important;
    border-collapse: collapse; background: transparent !important; box-shadow: none !important;
  }
  .ls-root .ls-grid :is(thead, tbody, tr, th, td) {
    border: 0 !important; background: transparent !important; box-shadow: none !important;
  }
  .ls-root .ls-grid td { padding: 2px 3px; text-align: center; vertical-align: middle; }

  .ls-cell {
    width: 3.4rem; padding: 0.18rem 0.3rem; margin: 0;
    transition: width 0.35s ease-in-out, background-color 0.15s ease, border-color 0.15s ease;
  }
  .ls-cell:focus { background: color-mix(in srgb, var(--ls-accent) 16%, var(--sl-color-bg, #000)); }
  .ls-cell.ls-cell-wide { width: 7rem; }

  .ls-note { margin: 1rem auto 0; max-width: 36rem; opacity: 0.9; font-size: 0.9rem; }

  .ls-status { margin: 0.75rem 0 0; font-size: 0.95rem; }
  .ls-status.ls-error {
    padding: 0.6rem 0.8rem;
    border-left: 4px solid var(--ls-red);
    background: color-mix(in srgb, var(--ls-red) 8%, transparent);
    border-radius: 4px;
  }

  /* ----- bottoni -----
     Starlight inietta un margin-top automatico sugli elementi "fratelli" dentro
     il contenuto markdown: senza reset, il 2° e 3° bottone vengono spinti in
     basso e la riga appare sfalsata (il 1° sembra di altezza diversa).
     Fix collaudato sugli altri risolutori (Gauss-Jordan, Kernel): margin: 0
     esplicito sui bottoni + align-items: stretch sulla griglia + altezza fissa.
     Stile e comportamento (ghost, pillola, scale on active) allineati agli
     altri risolutori del sito. */
  .ls-actions {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem; align-items: stretch; margin: 1.25rem auto; max-width: 48rem;
  }
  .ls-actions .ls-btn { width: 100%; margin: 0; }
  .ls-btn {
    box-sizing: border-box; height: 3.6rem; padding: 0 1rem; line-height: 1.2;
    display: inline-flex; align-items: center; justify-content: center; text-align: center;
    font: inherit; font-weight: 600; cursor: pointer; border-radius: 999px;
    border: 1.5px solid transparent; transition: transform 0.1s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .ls-btn:active { transform: scale(0.96); }
  .ls-btn-accent { background: var(--ls-accent); color: var(--sl-color-white, #fff); }
  .ls-btn-accent:hover { background: var(--sl-color-accent-high, var(--ls-accent)); }
  .ls-btn-ghost { background: transparent; color: var(--sl-color-text, inherit); border-color: var(--ls-border); }
  .ls-btn-ghost:hover { border-color: var(--ls-accent); color: var(--ls-accent); }
  .ls-secondary { margin: 1.25rem auto 0; max-width: 48rem; }
  .ls-btn-wide { width: 100%; margin: 0 0 1rem; }

  .ls-result {
    background: var(--ls-surface); border: 1px solid var(--ls-border);
    border-radius: var(--ls-radius); margin-top: 1.5rem; padding: 1.5rem 1rem;
    opacity: 0; transition: opacity 0.3s ease; text-align: left;
  }
  .ls-result.ls-visible { opacity: 1; }
  .ls-result h2 { text-align: center; }
  .ls-result h3 {
    margin-top: 2.5rem; padding-top: 0.75rem; color: var(--ls-accent);
    border-top: 1px solid var(--ls-border);
  }
  .ls-result p { margin: 0.9rem 0; }
  .ls-katex { overflow-x: auto; overflow-y: hidden; padding: 0.75rem 0.25rem; margin: 1rem 0; }
  .ls-katex .katex-display { margin: 0; }

  @media (max-width: 600px) {
    .ls-root { font-size: 0.95rem; }
    .ls-actions { grid-template-columns: 1fr; }
    .ls-result { padding: 1rem 0.5rem; }

    /* Step 1 (input m e n) su due righe: input affiancati sopra, etichette sotto
       allineate al bordo interno del proprio input. Colonne 1 e 3 = 4rem (= larghezza
       input), così le etichette più larghe sporgono senza spostare l'allineamento. */
    .ls-dims {
      display: grid;
      grid-template-columns: 4rem auto 4rem;
      column-gap: 1.2rem;
      row-gap: 0.4rem;
      justify-content: center;
      align-items: center;
    }
    .ls-dims input { grid-row: 1; width: 100%; }
    #lsRows { grid-column: 1; }
    .ls-times { grid-row: 1; grid-column: 2; justify-self: center; }
    #lsCols { grid-column: 3; }
    .ls-dims label {
      grid-row: 2;
      width: max-content;
      white-space: nowrap;
    }
    label[for="lsRows"] { grid-column: 1; justify-self: center; }
    label[for="lsCols"] { grid-column: 3; justify-self: center; }
  }
</style>

<script>
import katex from 'katex';
import renderMathInElement from 'katex/contrib/auto-render';


// --- fraction ---
// Aritmetica razionale ESATTA su BigInt (identica a KernelSolver).
// Invariante: den > 0, gcd(|num|, den) == 1, lo zero è 0/1.

function gcdBig(a, b) {
  a = a < 0n ? -a : a;
  b = b < 0n ? -b : b;
  while (b) { [a, b] = [b, a % b]; }
  return a;
}

class Fraction {
  constructor(num, den = 1n) {
    num = BigInt(num);
    den = BigInt(den);
    if (den === 0n) throw new Error('Fraction: denominatore nullo');
    if (den < 0n) { num = -num; den = -den; }
    const g = gcdBig(num, den) || 1n;
    this.num = num / g;
    this.den = den / g;
  }

  static get ZERO() { return new Fraction(0n, 1n); }
  static get ONE() { return new Fraction(1n, 1n); }

  static tryParse(str) {
    const s = String(str).trim().replace(/\s+/g, '');
    if (s === '') return null;
    let m = s.match(/^([+-]?\d+)\/([+-]?\d+)$/);
    if (m) return new Fraction(BigInt(m[1]), BigInt(m[2]));
    m = s.match(/^([+-]?\d+)$/);
    if (m) return new Fraction(BigInt(m[1]), 1n);
    m = s.match(/^([+-]?)(\d*)\.(\d+)$/);
    if (m) {
      const sign = m[1] === '-' ? -1n : 1n;
      const intp = m[2] === '' ? 0n : BigInt(m[2]);
      const frac = m[3];
      const den = 10n ** BigInt(frac.length);
      const num = intp * den + BigInt(frac);
      return new Fraction(sign * num, den);
    }
    return null;
  }

  clone() { return new Fraction(this.num, this.den); }

  isZero() { return this.num === 0n; }
  isConstant() { return true; }
  isOne() { return this.num === 1n && this.den === 1n; }
  isMinusOne() { return this.num === -1n && this.den === 1n; }
  isInteger() { return this.den === 1n; }

  sign() { return this.num > 0n ? 1 : (this.num < 0n ? -1 : 0); }

  neg() { return new Fraction(-this.num, this.den); }
  inv() {
    if (this.num === 0n) throw new Error('Fraction: inverso di zero');
    return new Fraction(this.den, this.num);
  }

  add(o) { return new Fraction(this.num * o.den + o.num * this.den, this.den * o.den); }
  sub(o) { return new Fraction(this.num * o.den - o.num * this.den, this.den * o.den); }
  mul(o) { return new Fraction(this.num * o.num, this.den * o.den); }
  div(o) { return new Fraction(this.num * o.den, this.den * o.num); }

  equals(o) { return this.num === o.num && this.den === o.den; }

  toLatex() {
    if (this.den === 1n) return this.num.toString();
    const sign = this.num < 0n ? '-' : '';
    const n = this.num < 0n ? -this.num : this.num;
    return `${sign}\\frac{${n.toString()}}{${this.den.toString()}}`;
  }

  toString() {
    return this.den === 1n ? this.num.toString() : `${this.num.toString()}/${this.den.toString()}`;
  }
}

// --- polynomial ---
// Polinomio MULTIVARIATO a coefficienti razionali esatti (identico a KernelSolver).
// isZero() è ESATTO: ogni decisione di pivot (rango, compatibilità) è senza ambiguità.

function monoKey(exps) {
  const keys = Object.keys(exps).filter((v) => exps[v] !== 0).sort();
  return keys.map((v) => `${v}^${exps[v]}`).join('|');
}
function keyToExps(key) {
  const exps = {};
  if (key === '') return exps;
  for (const part of key.split('|')) {
    const [v, e] = part.split('^');
    exps[v] = parseInt(e, 10);
  }
  return exps;
}

class Polynomial {
  constructor(terms = new Map()) {
    this.terms = new Map();
    for (const [k, c] of terms) if (!c.isZero()) this.terms.set(k, c);
  }

  static constant(fr) {
    const t = new Map();
    if (!fr.isZero()) t.set('', fr.clone());
    return new Polynomial(t);
  }
  static fromInt(n) { return Polynomial.constant(new Fraction(BigInt(n), 1n)); }
  static get ZERO() { return new Polynomial(); }
  static get ONE() { return Polynomial.constant(Fraction.ONE); }
  static variable(name) {
    const t = new Map();
    t.set(`${name}^1`, Fraction.ONE);
    return new Polynomial(t);
  }

  clone() {
    const t = new Map();
    for (const [k, c] of this.terms) t.set(k, c.clone());
    return new Polynomial(t);
  }

  isZero() { return this.terms.size === 0; }
  isConstant() { return this.terms.size === 0 || (this.terms.size === 1 && this.terms.has('')); }
  isOne() { return this.terms.size === 1 && this.terms.has('') && this.terms.get('').isOne(); }

  asConstant() {
    if (this.terms.size === 0) return Fraction.ZERO;
    if (this.terms.size === 1 && this.terms.has('')) return this.terms.get('').clone();
    return null;
  }

  vars() {
    const s = new Set();
    for (const k of this.terms.keys())
      for (const v of Object.keys(keyToExps(k))) s.add(v);
    return [...s].sort();
  }

  neg() {
    const t = new Map();
    for (const [k, c] of this.terms) t.set(k, c.neg());
    return new Polynomial(t);
  }

  add(o) {
    const t = new Map(this.terms);
    for (const [k, c] of o.terms) {
      const cur = t.get(k);
      if (cur) { const s = cur.add(c); if (s.isZero()) t.delete(k); else t.set(k, s); }
      else t.set(k, c.clone());
    }
    return new Polynomial(t);
  }
  sub(o) { return this.add(o.neg()); }

  scale(fr) {
    if (fr.isZero()) return Polynomial.ZERO;
    const t = new Map();
    for (const [k, c] of this.terms) t.set(k, c.mul(fr));
    return new Polynomial(t);
  }

  mul(o) {
    const t = new Map();
    for (const [k1, c1] of this.terms) {
      const e1 = keyToExps(k1);
      for (const [k2, c2] of o.terms) {
        const e2 = keyToExps(k2);
        const e = { ...e1 };
        for (const v of Object.keys(e2)) e[v] = (e[v] || 0) + e2[v];
        const k = monoKey(e);
        const prod = c1.mul(c2);
        const cur = t.get(k);
        if (cur) { const s = cur.add(prod); if (s.isZero()) t.delete(k); else t.set(k, s); }
        else t.set(k, prod);
      }
    }
    return new Polynomial(t);
  }

  equals(o) { return this.sub(o).isZero(); }

  degreeIn(name) {
    let d = 0;
    for (const k of this.terms.keys()) {
      const e = keyToExps(k)[name] || 0;
      if (e > d) d = e;
    }
    return d;
  }
  totalDegree() {
    let d = 0;
    for (const k of this.terms.keys()) {
      const e = keyToExps(k);
      const s = Object.values(e).reduce((a, b) => a + b, 0);
      if (s > d) d = s;
    }
    return d;
  }

  substitute(name, fr) {
    let acc = Polynomial.ZERO;
    for (const [k, c] of this.terms) {
      const e = keyToExps(k);
      const p = e[name] || 0;
      let coeff = c;
      if (p > 0) { coeff = coeff.mul(fracPow(fr, p)); delete e[name]; }
      const nk = monoKey(e);
      const term = new Map(); term.set(nk, coeff);
      acc = acc.add(new Polynomial(term));
    }
    return acc;
  }

  primitivePart() {
    if (this.isZero()) return { content: Fraction.ONE, prim: Polynomial.ZERO };
    let denLcm = 1n, numGcd = 0n;
    const g = (a, b) => { a = a < 0n ? -a : a; b = b < 0n ? -b : b; while (b) { [a, b] = [b, a % b]; } return a; };
    for (const c of this.terms.values()) {
      denLcm = denLcm / g(denLcm, c.den) * c.den;
    }
    for (const c of this.terms.values()) {
      const scaledNum = c.num * (denLcm / c.den);
      numGcd = g(numGcd, scaledNum);
    }
    if (numGcd === 0n) numGcd = 1n;
    let content = new Fraction(numGcd, denLcm);
    const t = new Map();
    for (const [k, c] of this.terms) {
      t.set(k, c.div(content));
    }
    let prim = new Polynomial(t);
    return { content, prim };
  }

  toLatex() {
    if (this.isZero()) return '0';
    const entries = [...this.terms.entries()].map(([k, c]) => ({ k, c, e: keyToExps(k) }));
    entries.sort((A, B) => {
      const dA = Object.values(A.e).reduce((a, b) => a + b, 0);
      const dB = Object.values(B.e).reduce((a, b) => a + b, 0);
      if (dB !== dA) return dB - dA;
      return A.k < B.k ? -1 : (A.k > B.k ? 1 : 0);
    });
    let out = '';
    entries.forEach((t, i) => {
      const isConst = t.k === '';
      const c = t.c;
      const neg = c.sign() < 0;
      const absC = neg ? c.neg() : c;
      let mono = '';
      const vars = Object.keys(t.e).sort();
      for (const v of vars) {
        mono += t.e[v] === 1 ? v : `${v}^{${t.e[v]}}`;
      }
      let coeffTex;
      if (isConst) coeffTex = absC.toLatex();
      else if (absC.isOne()) coeffTex = '';
      else coeffTex = absC.toLatex();
      const piece = coeffTex + mono || coeffTex || mono;
      if (i === 0) out += (neg ? '-' : '') + (piece === '' ? absC.toLatex() : piece);
      else out += (neg ? ' - ' : ' + ') + (piece === '' ? absC.toLatex() : piece);
    });
    return out;
  }

  toString() { return this.toLatex(); }

  // Come toLatex, ma una variabile viene RESA come una stringa data (non valutata):
  // serve a mostrare la sostituzione del parametro col valore incorniciato.
  toLatexSubst(subst) {
    if (this.isZero()) return '0';
    const entries = [...this.terms.entries()].map(([k, c]) => ({ k, c, e: keyToExps(k) }));
    entries.sort((A, B) => {
      const dA = Object.values(A.e).reduce((a, b) => a + b, 0);
      const dB = Object.values(B.e).reduce((a, b) => a + b, 0);
      if (dB !== dA) return dB - dA;
      return A.k < B.k ? -1 : (A.k > B.k ? 1 : 0);
    });
    let out = '';
    entries.forEach((t, i) => {
      const isConst = t.k === '';
      const c = t.c;
      const neg = c.sign() < 0;
      const absC = neg ? c.neg() : c;
      let mono = '';
      for (const v of Object.keys(t.e).sort()) {
        const sym = subst[v] !== undefined ? subst[v] : v;
        mono += t.e[v] === 1 ? sym : `${sym}^{${t.e[v]}}`;
      }
      let coeffTex;
      if (isConst) coeffTex = absC.toLatex();
      else if (absC.isOne()) coeffTex = '';
      else coeffTex = absC.toLatex();
      const piece = (coeffTex + mono) || coeffTex || mono;
      if (i === 0) out += (neg ? '-' : '') + (piece === '' ? absC.toLatex() : piece);
      else out += (neg ? ' - ' : ' + ') + (piece === '' ? absC.toLatex() : piece);
    });
    return out;
  }
}

function fracPow(fr, n) {
  let r = Fraction.ONE;
  for (let i = 0; i < n; i++) r = r.mul(fr);
  return r;
}

// --- rationalfunction ---
// Funzione razionale ESATTA (identica a KernelSolver): stessa API di Fraction,
// così il motore di Gauss-Jordan è scritto UNA SOLA VOLTA contro un campo astratto.

function polyToUni(poly, v) {
  const d = poly.degreeIn(v);
  const arr = new Array(d + 1).fill(null).map(() => Fraction.ZERO);
  for (const [k, c] of poly.terms) {
    if (k === '') { arr[0] = arr[0].add(c); continue; }
    const [vv, e] = k.split('^');
    arr[parseInt(e, 10)] = arr[parseInt(e, 10)].add(c);
  }
  return arr;
}
function uniToPoly(arr, v) {
  let p = Polynomial.ZERO;
  for (let e = 0; e < arr.length; e++) {
    if (arr[e].isZero()) continue;
    const t = new Map();
    t.set(e === 0 ? '' : `${v}^${e}`, arr[e].clone());
    p = p.add(new Polynomial(t));
  }
  return p;
}
function uniTrim(a) { let n = a.length; while (n > 1 && a[n - 1].isZero()) n--; return a.slice(0, n); }
function uniIsZero(a) { return a.every((c) => c.isZero()); }
function uniDivmod(a, b) {
  a = uniTrim(a.map((x) => x.clone())); b = uniTrim(b);
  const q = new Array(Math.max(1, a.length - b.length + 1)).fill(null).map(() => Fraction.ZERO);
  const r = a.map((x) => x.clone());
  const bLead = b[b.length - 1];
  while (uniTrim(r).length >= b.length && !uniIsZero(r)) {
    const rt = uniTrim(r);
    const deg = rt.length - b.length;
    if (deg < 0) break;
    const coeff = rt[rt.length - 1].div(bLead);
    q[deg] = coeff;
    for (let i = 0; i < b.length; i++) r[deg + i] = r[deg + i].sub(coeff.mul(b[i]));
  }
  return { q: uniTrim(q), r: uniTrim(r) };
}
function uniGCD(a, b) {
  a = uniTrim(a); b = uniTrim(b);
  while (!uniIsZero(b)) { const { r } = uniDivmod(a, b); a = b; b = uniTrim(r); }
  const lead = a[a.length - 1];
  if (!lead.isZero() && !lead.isOne()) a = a.map((c) => c.div(lead));
  return a;
}

class RationalFunction {
  constructor(num, den = Polynomial.ONE) {
    if (den.isZero()) throw new Error('RationalFunction: denominatore nullo');
    this.num = num;
    this.den = den;
    this.reduce();
  }

  static get ZERO() { return new RationalFunction(Polynomial.ZERO); }
  static get ONE() { return new RationalFunction(Polynomial.ONE); }
  static fromFraction(fr) { return new RationalFunction(Polynomial.constant(fr)); }
  static fromInt(n) { return new RationalFunction(Polynomial.fromInt(n)); }
  static variable(name) { return new RationalFunction(Polynomial.variable(name)); }

  clone() { return new RationalFunction(this.num.clone(), this.den.clone()); }

  reduce() {
    if (this.num.isZero()) { this.den = Polynomial.ONE; return; }
    const dc = this.den.asConstant();
    if (dc !== null) { this.num = this.num.scale(dc.inv()); this.den = Polynomial.ONE; return; }
    const allVars = new Set([...this.num.vars(), ...this.den.vars()]);
    if (allVars.size <= 1) {
      const v = [...allVars][0];
      let na = polyToUni(this.num, v);
      let da = polyToUni(this.den, v);
      const g = uniGCD(na, da);
      if (!(g.length === 1 && g[0].isOne())) {
        na = uniDivmod(na, g).q;
        da = uniDivmod(da, g).q;
      }
      let nP = uniToPoly(na, v), dP = uniToPoly(da, v);
      const dPP = dP.primitivePart();
      nP = nP.scale(dPP.content.inv());
      dP = dPP.prim;
      const dArr = polyToUni(dP, v);
      if (dArr[dArr.length - 1].sign() < 0) { dP = dP.neg(); nP = nP.neg(); }
      this.num = nP; this.den = dP;
      return;
    }
    const dPP = this.den.primitivePart();
    this.num = this.num.scale(dPP.content.inv());
    this.den = dPP.prim;
  }

  isZero() { return this.num.isZero(); }
  isOne() { return this.den.isOne() && this.num.isOne(); }
  isConstant() { return this.den.isConstant() && this.num.isConstant(); }
  asFraction() {
    const n = this.num.asConstant(), d = this.den.asConstant();
    if (n !== null && d !== null) return n.div(d);
    return null;
  }
  vars() { return [...new Set([...this.num.vars(), ...this.den.vars()])].sort(); }

  neg() { return new RationalFunction(this.num.neg(), this.den.clone()); }
  inv() {
    if (this.num.isZero()) throw new Error('RationalFunction: inverso di zero');
    return new RationalFunction(this.den.clone(), this.num.clone());
  }
  add(o) { return new RationalFunction(this.num.mul(o.den).add(o.num.mul(this.den)), this.den.mul(o.den)); }
  sub(o) { return new RationalFunction(this.num.mul(o.den).sub(o.num.mul(this.den)), this.den.mul(o.den)); }
  mul(o) { return new RationalFunction(this.num.mul(o.num), this.den.mul(o.den)); }
  div(o) { return new RationalFunction(this.num.mul(o.den), this.den.mul(o.num)); }
  equals(o) { return this.sub(o).isZero(); }

  substitute(name, fr) {
    const n = this.num.substitute(name, fr);
    const d = this.den.substitute(name, fr);
    if (d.isZero()) return null;
    return new RationalFunction(n, d);
  }

  toLatex() {
    if (this.den.isOne()) return this.num.toLatex();
    const nTex = this.num.toLatex();
    const dTex = this.den.toLatex();
    return `\\frac{${nTex}}{${dTex}}`;
  }
  toString() { return this.den.isOne() ? this.num.toString() : `(${this.num})/(${this.den})`; }
}

// --- engine ---
// Motore di riduzione scritto UNA VOLTA contro un campo astratto (come KernelSolver).

function makeMatrix(data) { return data.map((row) => row.map((e) => e.clone())); }
function cloneMatrix(M) { return makeMatrix(M); }

// Gauss-Jordan -> forma a scala ridotta per righe (RREF).
// assumptions: elementi-pivot NON costanti su cui abbiamo diviso (pivot ≠ 0 assunto).
function rref(M, field, opts = {}) {
  const preferConst = !!opts.preferConstantPivot;
  const R = cloneMatrix(M);
  const m = R.length, n = m ? R[0].length : 0;
  const ops = [];
  const pivotCols = [];
  const assumptions = [];
  let pivRow = 0;

  for (let col = 0; col < n && pivRow < m; col++) {
    let sel = -1;
    if (preferConst) {
      for (let r = pivRow; r < m; r++) {
        const e = R[r][col];
        if (!e.isZero() && e.isConstant && e.isConstant()) { sel = r; break; }
      }
    }
    if (sel === -1) {
      for (let r = pivRow; r < m; r++) { if (!R[r][col].isZero()) { sel = r; break; } }
    }
    if (sel === -1) continue;

    if (sel !== pivRow) {
      const tmp = R[sel]; R[sel] = R[pivRow]; R[pivRow] = tmp;
      ops.push({ type: 'swap', i: pivRow, j: sel });
    }

    const pivotEl = R[pivRow][col];
    if (pivotEl.isConstant && !pivotEl.isConstant()) {
      assumptions.push({ col, element: pivotEl.clone() });
    }
    if (!R[pivRow][col].isOne()) {
      const inv = R[pivRow][col].inv();
      for (let c = col; c < n; c++) R[pivRow][c] = R[pivRow][c].mul(inv);
      ops.push({ type: 'scale', i: pivRow, factor: inv });
    }
    for (let r = 0; r < m; r++) {
      if (r === pivRow) continue;
      const f = R[r][col];
      if (!f.isZero()) {
        const negf = f.neg();
        for (let c = col; c < n; c++) R[r][c] = R[r][c].add(negf.mul(R[pivRow][c]));
        ops.push({ type: 'addmul', target: r, source: pivRow, factor: negf });
      }
    }
    pivotCols.push(col);
    pivRow++;
  }
  return { R, pivotCols, rank: pivotCols.length, ops, assumptions };
}

// Base del nucleo a partire dalla RREF (della sola A, prime n colonne).
function kernelBasis(R, pivotCols, n, field) {
  const isPivotCol = new Array(n).fill(false);
  pivotCols.forEach((c) => { isPivotCol[c] = true; });
  const pivotRowOfCol = {};
  pivotCols.forEach((c, k) => { pivotRowOfCol[c] = k; });

  const freeCols = [];
  for (let c = 0; c < n; c++) if (!isPivotCol[c]) freeCols.push(c);

  const basis = [];
  for (const fcol of freeCols) {
    const vec = new Array(n).fill(null).map(() => field.zero());
    vec[fcol] = field.one();
    for (const pcol of pivotCols) {
      const prow = pivotRowOfCol[pcol];
      vec[pcol] = R[prow][fcol].neg();
    }
    basis.push(vec);
  }
  return { basis, freeCols };
}

function rankOfVectors(vectors, field) {
  if (vectors.length === 0) return 0;
  const M = vectors.map((v) => v.map((e) => e.clone()));
  return rref(M, field).rank;
}

function sameSpan(vecsA, vecsB, field) {
  const rA = rankOfVectors(vecsA, field);
  const rB = rankOfVectors(vecsB, field);
  const rU = rankOfVectors([...vecsA, ...vecsB], field);
  return rA === rB && rB === rU;
}

// --- system core ---
// Chiusura di un sistema [A|b] (aumentata con n+1 colonne, incognite = prime n).
// Compatibile ⇔ l'ultima colonna NON è di pivot (Rouché-Capelli). Se compatibile:
//   - soluzione particolare: variabili libere = 0, pivot = colonna dei termini noti;
//   - base del nucleo dalla RREF ristretta alle prime n colonne.
function closeSystem(aug, field, n) {
  const { R, pivotCols, assumptions } = rref(aug, field, { preferConstantPivot: true });
  const incompatible = pivotCols.includes(n);
  const rankAug = pivotCols.length;
  const pivotColsA = pivotCols.filter((c) => c < n);
  const rankA = pivotColsA.length;
  const nullity = n - rankA;

  let xp = null, kbasis = [], freeCols = [];
  if (!incompatible) {
    xp = new Array(n).fill(null).map(() => field.zero());
    pivotColsA.forEach((pc, idx) => { xp[pc] = R[idx][n].clone(); });
    const Rn = R.map((row) => row.slice(0, n));
    const kb = kernelBasis(Rn, pivotColsA, n, field);
    kbasis = kb.basis; freeCols = kb.freeCols;
  } else {
    const Rn = R.map((row) => row.slice(0, n));
    const kb = kernelBasis(Rn, pivotColsA, n, field);
    freeCols = kb.freeCols;
  }
  return { R, pivotCols, pivotColsA, rankA, rankAug, incompatible, nullity, xp, kbasis, freeCols, assumptions };
}

// --- shortcuts ---
// Scorciatoie "umane" per il caso NON omogeneo, in tre famiglie:
//  (a) incompatibilità evidenti: riga di A nulla con b_i ≠ 0 (equazione 0 = c),
//      oppure due righe di A proporzionali con termini noti non proporzionali;
//  (b) soluzione particolare a occhio: b = 0, oppure b uguale a una colonna,
//      a un multiplo umano o a una combinazione umana di ≤ 3 colonne di A
//      (se Σ λ_j c_j = b, allora x con x_j = λ_j risolve il sistema);
//  (c) relazioni fra colonne di A (identiche al KernelSolver): danno la parte
//      omogenea, cioè i vettori del nucleo.
// Caso simbolico: si accettano solo coefficienti COSTANTI umani, cioè fatti
// validi per OGNI valore del parametro.

const HUMAN_DENS = [1n, 2n, 3n, 4n, 5n];
const HUMAN_MAX_ABS_NUM = 12n;

function asFrac(el) {
  if (typeof el.asFraction === 'function') return el.asFraction();
  return el;
}
function isHumanCoeff(el) {
  const fr = asFrac(el);
  if (!fr || fr.isZero()) return false;
  const absNum = fr.num < 0n ? -fr.num : fr.num;
  if (!HUMAN_DENS.includes(fr.den)) return false;
  return absNum <= HUMAN_MAX_ABS_NUM;
}
// vero se l'elemento è una costante razionale NON nulla (fatto valido per ogni parametro)
function isNonzeroConst(el) {
  const fr = asFrac(el);
  return !!fr && !fr.isZero();
}

function getColumn(matrix, j) { return matrix.map((row) => row[j]); }
function columnIsZero(matrix, j) { return matrix.every((row) => row[j].isZero()); }

// Risolve, in modo esatto, il sistema Σ_t x_t · c_{S[t]} = target (tutte le m righe),
// dove target è una colonna data. Ritorna { ok, coeffs } solo se UNICA e CONSISTENTE.
function solveCombination(matrix, S, targetCol, field) {
  const k = S.length;
  const aug = matrix.map((row, r) => [...S.map((c) => row[c].clone()), targetCol[r].clone()]);
  const { R, pivotCols } = rref(aug, field);
  if (pivotCols.includes(k)) return { ok: false };
  for (let t = 0; t < k; t++) if (!pivotCols.includes(t)) return { ok: false };
  const coeffs = new Array(k);
  pivotCols.forEach((pc, idx) => { if (pc < k) coeffs[pc] = R[idx][k].clone(); });
  return { ok: true, coeffs };
}

function* subsets(maxExclusive, size, start = 0, acc = []) {
  if (acc.length === size) { yield acc.slice(); return; }
  for (let i = start; i < maxExclusive; i++) {
    acc.push(i);
    yield* subsets(maxExclusive, size, i + 1, acc);
    acc.pop();
  }
}

function kernelVectorFromRelation(target, parts, n, field) {
  const v = new Array(n).fill(null).map(() => field.zero());
  v[target] = field.one();
  for (const { col, coeff } of parts) v[col] = coeff.neg();
  return v;
}

// (c) relazioni fra colonne di A — identico al KernelSolver.
function findColumnShortcuts(matrix, field) {
  const m = matrix.length, n = m ? matrix[0].length : 0;
  const relations = [];

  for (let j = 0; j < n; j++) {
    if (columnIsZero(matrix, j)) {
      relations.push({ target: j, type: 'null', parts: [] });
      continue;
    }
    if (j === 0) continue;

    let found = null;
    for (let size = 1; size <= 3 && !found; size++) {
      if (size > j) break;
      for (const S of subsets(j, size)) {
        const sol = solveCombination(matrix, S, getColumn(matrix, j), field);
        if (!sol.ok) continue;
        if (!sol.coeffs.every(isHumanCoeff)) continue;
        const parts = S.map((col, t) => ({ col, coeff: sol.coeffs[t] }));
        const type = size === 1 ? 'multiple' : (size === 2 ? 'combo2' : 'combo3');
        found = { target: j, type, parts };
        break;
      }
    }
    if (found) relations.push(found);
  }

  const vectors = relations.map((rel) => kernelVectorFromRelation(rel.target, rel.parts, n, field));
  const count = vectors.length;
  const independent = rankOfVectors(vectors, field) === count;
  return { relations, vectors, count, independent };
}

// (a) incompatibilità evidenti. Nel caso simbolico l'incompatibilità viene
// dichiarata SOLO se vale per ogni valore del parametro (scarti costanti non nulli).
function findEyeIncompatibilities(A, b, field) {
  const m = A.length;
  const out = [];
  for (let i = 0; i < m; i++) {
    if (A[i].every((e) => e.isZero())) {
      if (isNonzeroConst(b[i]) || (!b[i].isZero() && b[i].isConstant && b[i].isConstant())) {
        out.push({ kind: 'zeroRow', row: i, rhs: b[i].clone() });
      }
      continue;
    }
    for (let j = i + 1; j < m; j++) {
      if (A[j].every((e) => e.isZero())) continue;
      let lam = null, ok = true;
      for (let c = 0; c < A[i].length; c++) {
        const a = A[i][c], bb = A[j][c];
        if (a.isZero()) { if (!bb.isZero()) { ok = false; break; } continue; }
        const r = bb.div(a);
        if (lam === null) lam = r;
        else if (!lam.equals(r)) { ok = false; break; }
      }
      if (!ok || lam === null || lam.isZero()) continue;
      if (!isHumanCoeff(lam)) continue;
      const diff = b[j].sub(lam.mul(b[i]));
      if (isNonzeroConst(diff)) {
        out.push({ kind: 'propRows', i, j, lam: lam.clone(), bi: b[i].clone(), bj: b[j].clone() });
      }
    }
  }
  return out;
}

// (b) soluzione particolare a occhio.
function findEyeParticular(A, b, field) {
  const m = A.length, n = m ? A[0].length : 0;
  if (b.every((e) => e.isZero())) {
    const xp = new Array(n).fill(null).map(() => field.zero());
    return { kind: 'bzero', parts: [], xp };
  }
  for (let size = 1; size <= 3; size++) {
    if (size > n) break;
    for (const S of subsets(n, size)) {
      const sol = solveCombination(A, S, b, field);
      if (!sol.ok) continue;
      if (!sol.coeffs.every(isHumanCoeff)) continue;
      const parts = S.map((col, t) => ({ col, coeff: sol.coeffs[t] }));
      const xp = new Array(n).fill(null).map(() => field.zero());
      for (const { col, coeff } of parts) xp[col] = coeff.clone();
      const kind = size === 1 ? (parts[0].coeff.isOne() ? 'bcol' : 'bmult') : 'bcombo';
      return { kind, parts, xp };
    }
  }
  return null;
}

// --- fields / parser ---
const numericField = {
  name: 'Q',
  symbolic: false,
  zero: () => Fraction.ZERO,
  one: () => Fraction.ONE,
  fromFraction: (fr) => fr.clone(),
};

function symbolicField(varNames) {
  return {
    name: `Q(${varNames.join(',')})`,
    symbolic: true,
    vars: [...varNames],
    zero: () => RationalFunction.ZERO,
    one: () => RationalFunction.ONE,
    fromFraction: (fr) => RationalFunction.fromFraction(fr),
  };
}

function parseCellToPoly(str) {
  const s = String(str).trim();
  if (s === '') return Polynomial.ZERO;
  const asFr = Fraction.tryParse(s);
  if (asFr) return Polynomial.constant(asFr);
  return parseExpr(s);
}

function parseExpr(s) {
  let i = 0;
  const src = s.replace(/\s+/g, '');
  function peek() { return src[i]; }
  function eat(ch) { if (src[i] === ch) { i++; return true; } return false; }

  function parseSum() {
    let node = parseTerm();
    for (;;) {
      if (eat('+')) node = node.add(parseTerm());
      else if (eat('-')) node = node.sub(parseTerm());
      else break;
    }
    return node;
  }
  function parseTerm() {
    let node = parseFactor();
    for (;;) {
      if (eat('*')) node = node.mul(parseFactor());
      else if (eat('/')) {
        const d = parseFactor();
        const dc = d.asConstant();
        if (dc === null) throw new Error('divisione per un\'espressione non costante non supportata in una cella');
        if (dc.isZero()) throw new Error('divisione per zero');
        node = node.scale(dc.inv());
      }
      else if (isImplicitMul()) node = node.mul(parseFactor());
      else break;
    }
    return node;
  }
  function isImplicitMul() {
    const c = peek();
    if (c === undefined) return false;
    return /[A-Za-z0-9(]/.test(c);
  }
  function parseFactor() {
    let base = parseAtom();
    if (eat('^')) {
      const expNode = parseAtom();
      const ex = expNode.asConstant();
      if (!ex || !ex.isInteger() || ex.num < 0n) throw new Error('Esponente non valido');
      let r = Polynomial.ONE;
      for (let e = 0n; e < ex.num; e++) r = r.mul(base);
      base = r;
    }
    return base;
  }
  function parseAtom() {
    if (eat('(')) { const node = parseSum(); if (!eat(')')) throw new Error('Parentesi non chiusa'); return node; }
    if (eat('-')) return parseAtom().neg();
    if (eat('+')) return parseAtom();
    const c = peek();
    if (c === undefined) throw new Error('Espressione incompleta');
    if (/[0-9.]/.test(c)) {
      let num = '';
      while (i < src.length && /[0-9.]/.test(src[i])) num += src[i++];
      const fr = Fraction.tryParse(num);
      if (!fr) throw new Error('Numero non valido: ' + num);
      return Polynomial.constant(fr);
    }
    if (/[A-Za-z]/.test(c)) { i++; return Polynomial.variable(c); }
    throw new Error('Carattere inatteso: ' + c);
  }

  const result = parseSum();
  if (i !== src.length) throw new Error('Token residui in: ' + s);
  return result;
}

// Costruisce A, b e l'aumentata dal contenuto testuale delle celle.
// Decide il campo: se compare almeno una variabile (in A O in b) -> simbolico.
function buildSystem(aCells, bCells) {
  const aPolys = aCells.map((row) => row.map(parseCellToPoly));
  const bPolys = bCells.map(parseCellToPoly);
  const varSet = new Set();
  for (const row of aPolys) for (const p of row) for (const v of p.vars()) varSet.add(v);
  for (const p of bPolys) for (const v of p.vars()) varSet.add(v);
  const vars = [...varSet].sort();
  if (vars.length === 0) {
    const field = numericField;
    const A = aPolys.map((row) => row.map((p) => field.fromFraction(p.asConstant())));
    const b = bPolys.map((p) => field.fromFraction(p.asConstant()));
    const aug = A.map((row, r) => [...row.map((e) => e.clone()), b[r].clone()]);
    return { A, b, aug, field, vars: [] };
  }
  const field = symbolicField(vars);
  const A = aPolys.map((row) => row.map((p) => new RationalFunction(p)));
  const b = bPolys.map((p) => new RationalFunction(p));
  const aug = A.map((row, r) => [...row.map((e) => e.clone()), b[r].clone()]);
  return { A, b, aug, field, vars };
}

// --- cases ---
// Analisi per casi sui PARAMETRI (stessa idea del KernelSolver, ma sull'AUMENTATA):
// i valori critici candidati sono gli zeri dei pivot per cui abbiamo diviso.
// Se tutti i pivot restano ≠ 0 in k0, lo stesso cammino di eliminazione vale in k0
// e struttura di pivot, ranghi e compatibilità restano quelli generici: ogni cambiamento
// (rango di A, rango dell'aumentata, compatibilità) avviene NECESSARIAMENTE in uno
// zero di un pivot. Per ciascun candidato si SOSTITUISCE e si ricalcola in modo esatto.

function uniCoeffs(poly, v) {
  const d = poly.degreeIn(v);
  const arr = new Array(d + 1).fill(null).map(() => Fraction.ZERO);
  for (const [k, c] of poly.terms) {
    if (k === '') { arr[0] = arr[0].add(c); continue; }
    const e = parseInt(k.split('^')[1], 10);
    arr[e] = arr[e].add(c);
  }
  return arr;
}
function divisorsBig(nAbs) {
  const out = [];
  for (let i = 1n; i * i <= nAbs; i++) {
    if (nAbs % i === 0n) { out.push(i); if (i !== nAbs / i) out.push(nAbs / i); }
  }
  return out.sort((a, b) => (a < b ? -1 : 1));
}
function rationalRoots(poly, v) {
  let coeffs = uniCoeffs(poly, v);
  let lcm = 1n;
  const g = (a, b) => { a = a < 0n ? -a : a; b = b < 0n ? -b : b; while (b) { [a, b] = [b, a % b]; } return a; };
  for (const c of coeffs) lcm = lcm / g(lcm, c.den) * c.den;
  let ic = coeffs.map((c) => c.num * (lcm / c.den));
  while (ic.length > 1 && ic[ic.length - 1] === 0n) ic.pop();
  const roots = [];
  while (ic.length > 1 && ic[0] === 0n) { roots.push(new Fraction(0n, 1n)); ic = ic.slice(1); }
  if (ic.length <= 1) return { roots: dedupeFr(roots), residualDeg: 0 };
  const a0 = ic[0] < 0n ? -ic[0] : ic[0];
  const an = ic[ic.length - 1] < 0n ? -ic[ic.length - 1] : ic[ic.length - 1];
  const ps = divisorsBig(a0), qs = divisorsBig(an);
  const evalInt = (cands, x) => {
    let acc = Fraction.ZERO;
    let pw = Fraction.ONE;
    for (let i = 0; i < cands.length; i++) { acc = acc.add(new Fraction(cands[i], 1n).mul(pw)); pw = pw.mul(x); }
    return acc;
  };
  const tried = new Set();
  for (const p of ps) for (const q of qs) for (const s of [1n, -1n]) {
    const cand = new Fraction(s * p, q);
    const key = cand.toString();
    if (tried.has(key)) continue; tried.add(key);
    if (evalInt(ic, cand).isZero()) roots.push(cand);
  }
  const uniq = dedupeFr(roots);
  const residualDeg = Math.max(0, (poly.degreeIn(v)) - uniq.length);
  return { roots: uniq, residualDeg };
}
function dedupeFr(arr) {
  const seen = new Set(); const out = [];
  for (const f of arr) { const k = f.toString(); if (!seen.has(k)) { seen.add(k); out.push(f); } }
  return out;
}

function approxRealRoots(poly, v) {
  let coeffs = uniCoeffs(poly, v);
  let lcm = 1n;
  const g = (a, b) => { a = a < 0n ? -a : a; b = b < 0n ? -b : b; while (b) { [a, b] = [b, a % b]; } return a; };
  for (const c of coeffs) lcm = lcm / g(lcm, c.den) * c.den;
  let ic = coeffs.map((c) => Number(c.num * (lcm / c.den)));
  while (ic.length > 1 && ic[ic.length - 1] === 0) ic.pop();
  const degree = ic.length - 1;
  if (degree < 1) return { roots: [], degree: 0 };
  const f = (x) => { let s = 0; for (let i = ic.length - 1; i >= 0; i--) s = s * x + ic[i]; return s; };
  const an = Math.abs(ic[ic.length - 1]);
  let bound = 1;
  for (let i = 0; i < ic.length - 1; i++) bound = Math.max(bound, Math.abs(ic[i]) / an);
  bound = 1 + bound;
  const step = Math.min(0.01, (2 * bound) / 4000);
  const roots = [];
  let pk = -bound, pv = f(pk);
  for (let x = -bound + step; x <= bound; x += step) {
    const vv = f(x);
    if (pv === 0) roots.push(pk);
    else if (pv * vv < 0) {
      let a = pk, b = x, fa = pv;
      for (let i = 0; i < 100; i++) { const m = (a + b) / 2, fm = f(m); if (fa * fm <= 0) b = m; else { a = m; fa = fm; } }
      roots.push((a + b) / 2);
    }
    pk = x; pv = vv;
  }
  const uniq = [];
  for (const r of roots) if (!uniq.some((u) => Math.abs(u - r) < 1e-6)) uniq.push(r);
  return { roots: uniq, degree };
}

function substituteMatrix(symMatrix, param, fr) {
  return symMatrix.map((row) => row.map((rfEl) => rfEl.substitute(param, fr)));
}
function fieldOfSymMatrix(symMatrix) {
  const vars = new Set();
  for (const row of symMatrix) for (const e of row) for (const v of e.vars()) vars.add(v);
  const list = [...vars].sort();
  if (list.length === 0) {
    const field = numericField;
    const matrix = symMatrix.map((row) => row.map((e) => field.fromFraction(e.asFraction())));
    return { matrix, field, vars: [] };
  }
  return { matrix: symMatrix.map((row) => row.map((e) => e.clone())), field: symbolicField(list), vars: list };
}

function analyzeParametricSystem(aug, field, n) {
  const params = field.vars.slice();
  const generic = closeSystem(aug, field, n);

  const result = {
    parameters: params,
    multiParam: params.length > 1,
    generic,
    branches: [],
    declaredConditions: [],
  };

  if (params.length === 1) {
    const v = params[0];
    const candSet = new Map();
    for (const a of generic.assumptions) {
      const num = a.element.num;
      const { roots, residualDeg } = rationalRoots(num, v);
      for (const r of roots) candSet.set(r.toString(), r);
      if (residualDeg > 0) {
        const { roots: rr, degree } = approxRealRoots(num, v);
        result.declaredConditions.push({
          kind: 'nonrational',
          poly: num,
          approx: rr.map((r) => (Math.abs(r) < 1e-9 ? '0' : r.toFixed(4))),
          degree,
          realCount: rr.length,
        });
      }
    }
    for (const val of candSet.values()) {
      const subAug = substituteMatrix(aug, v, val);
      const { matrix: numAug, field: numF } = fieldOfSymMatrix(subAug);
      const closed = closeSystem(numAug, numF, n);
      result.branches.push({
        condition: { param: v, value: val },
        closed,
        subAug: numAug,
        rankDropped: closed.rankA < generic.rankA,
        compatChanged: closed.incompatible !== generic.incompatible,
      });
    }
  } else if (params.length > 1) {
    for (const a of generic.assumptions) {
      const num = a.element.num;
      const vs = num.vars();
      if (num.totalDegree() === 1 && vs.length === 1) {
        const v = vs[0];
        const co = uniCoeffs(num, v);
        const b0 = co[0], aCoef = co[1];
        const val = b0.neg().div(aCoef);
        const subAug = substituteMatrix(aug, v, val);
        const { matrix: subM, field: subF } = fieldOfSymMatrix(subAug);
        const closed = closeSystem(subM, subF, n);
        result.branches.push({
          condition: { param: v, value: val },
          closed,
          subAug: subM,
          rankDropped: closed.rankA < generic.rankA,
          compatChanged: closed.incompatible !== generic.incompatible,
          residualParams: subF.vars || [],
        });
      } else {
        result.declaredConditions.push({ kind: 'declared', poly: num });
      }
    }
  }
  return result;
}

