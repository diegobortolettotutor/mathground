// ----------------------------------------------------------------- helper LaTeX
function matTex(M) {
  if (!M.length) return '\\begin{pmatrix}\\end{pmatrix}';
  const body = M.map((row) => row.map((e) => e.toLatex()).join(' & ')).join(' \\\\[3pt] ');
  return `\\begin{pmatrix} ${body} \\end{pmatrix}`;
}
function colVecTex(v) {
  return `\\begin{pmatrix} ${v.map((e) => e.toLatex()).join(' \\\\[3pt] ')} \\end{pmatrix}`;
}
function xVecTex(n) {
  const xs = [];
  for (let c = 0; c < n; c++) xs.push(`x_{${c + 1}}`);
  return `\\begin{pmatrix} ${xs.join(' \\\\[3pt] ')} \\end{pmatrix}`;
}
// Matrice aumentata [A|b]: array con barra verticale prima dell'ultima colonna.
function augTex(aug, n) {
  if (!aug.length) return '\\left(\\begin{array}{c}\\end{array}\\right)';
  const spec = 'c'.repeat(n) + '|c';
  const body = aug.map((row) => row.map((e) => e.toLatex()).join(' & ')).join(' \\\\[3pt] ');
  return `\\left(\\begin{array}{${spec}} ${body} \\end{array}\\right)`;
}
// Aumentata con le formule ORIGINALI ma il parametro sostituito col valore incorniciato.
function augSubstTex(aug, n, param, valLatex) {
  const subst = {}; subst[param] = `\\boxed{${valLatex}}`;
  const spec = 'c'.repeat(n) + '|c';
  const body = aug.map((row) => row.map((e) => {
    const p = e.num ? e.num : e; // RationalFunction -> numeratore (den = 1 sugli input)
    return p.toLatexSubst ? p.toLatexSubst(subst) : p.toLatex();
  }).join(' & ')).join(' \\\\[3pt] ');
  return `\\left(\\begin{array}{${spec}} ${body} \\end{array}\\right)`;
}
function basisTex(basis) {
  if (!basis.length) return '\\{\\,\\mathbf{0}\\,\\}';
  return `\\left\\{\\; ${basis.map(colVecTex).join(',\\;\\; ')} \\;\\right\\}`;
}
function condTex(poly) {
  const { prim } = poly.primitivePart();
  let p = prim;
  if (p.toLatex().startsWith('-')) p = p.neg();
  return p.toLatex();
}
// equazioni "x_pivot = (termine noto) - somma( R[riga][libera] x_libera )"
function readingTexSys(R, pivotColsA, freeCols, n) {
  const lines = [];
  pivotColsA.forEach((pc, idx) => {
    const parts = [];
    const c0 = R[idx][n];
    if (!c0.isZero()) parts.push(c0.toLatex());
    for (const f of freeCols) {
      const coeff = R[idx][f];
      if (coeff.isZero()) continue;
      const opp = coeff.neg();
      const tex = opp.toLatex();
      parts.push((tex.startsWith('-') ? '' : '+') + tex + `\\,x_{${f + 1}}`);
    }
    let rhs = parts.length ? parts.join(' ') : '0';
    rhs = rhs.replace(/^\+/, '');
    lines.push(`x_{${pc + 1}} &= \\textstyle ${rhs}`);
  });
  return `\\begin{aligned} ${lines.join(' \\\\[3pt] ')} \\end{aligned}`;
}
// Forma parametrica: x = x_p + Σ x_f · v_f, con le VARIABILI LIBERE come parametri.
function paramFormTex(xp, kbasis, freeCols) {
  if (!kbasis.length) return `\\mathbf{x} \\;=\\; ${colVecTex(xp)}`;
  const terms = kbasis.map((v, i) => `\\;+\\; x_{${freeCols[i] + 1}}\\,${colVecTex(v)}`).join('');
  const frees = freeCols.map((f) => `x_{${f + 1}}`).join(',\\,');
  return `\\mathbf{x} \\;=\\; ${colVecTex(xp)}${terms},\\qquad ${frees}\\in K`;
}

function neg(texCoeff) {
  if (texCoeff.startsWith('-')) return texCoeff.slice(1);
  return '-' + texCoeff;
}
function fmtInf(d) { return d === 0 ? '1' : `\\infty^{${d}}`; }

