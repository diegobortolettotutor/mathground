---
// ============================================================================
//  SimulatoreCollatz.astro
//  Visualizzatore della congettura di Collatz (3n+1) con:
//   - Animazione di scaling dinamico degli assi (n e valori)
//   - Pop-up bounce dei punti, linee ancorate e colori didattici
//   - Slider di velocità in tempo reale
//   - Gestione del valore in sospeso: solo Calcola con modifica interrompe
// ============================================================================
const locale = Astro.currentLocale ?? "it";
const lang = locale.startsWith("en") ? "en" : "it";

const i18n = {
  it: {
    title: "Congettura di Collatz (3n+1)",
    calcButton: "Calcola",
    randomButton: "Numero casuale",
    inputPlaceholder: "Inserisci numero (1-100)",
    speedLabel: "Velocità animazione:",
    errorRange: "Inserisci un numero da 1 a 100",
    errorInvalid: "Inserisci un numero valido",
    statsLabel: "Elementi nella sequenza:",
    umamiEvent: "collatz_calculate",
  },
  en: {
    title: "Collatz Conjecture (3n+1)",
    calcButton: "Calculate",
    randomButton: "Random Number",
    inputPlaceholder: "Enter number (1-100)",
    speedLabel: "Animation speed:",
    errorRange: "Enter a number between 1 and 100",
    errorInvalid: "Enter a valid number",
    statsLabel: "Elements in the sequence:",
    umamiEvent: "collatz_calculate",
  },
};

const t = i18n[lang] || i18n.it;
const uid = "collatz-" + Math.random().toString(36).slice(2, 9);
---

<div
  class="collatz-root"
  data-locale={lang}
  data-error-range={t.errorRange}
  data-error-invalid={t.errorInvalid}
  data-stats-label={t.statsLabel}
  data-umami-event={t.umamiEvent}
>
  <canvas class="collatz-canvas" aria-label={t.title}></canvas>
  <div class="collatz-message" role="status"></div>

  <div class="collatz-controls">
    <button type="button" class="collatz-btn collatz-btn-primary collatz-calc">{t.calcButton}</button>
    <button type="button" class="collatz-btn collatz-btn-compact collatz-random">{t.randomButton}</button>
    <input
      type="number"
      class="collatz-input"
      placeholder={t.inputPlaceholder}
      min="1"
      max="100"
      inputmode="numeric"
    />
    <span class="collatz-speedcell">
      <label for={uid + "-speed"}>{t.speedLabel}</label>
      <input type="range" id={uid + "-speed"} class="collatz-speed-slider" min="0" max="19" step="1" value="0" />
      <span class="collatz-speed-value">0.5x</span>
    </span>
  </div>

  <div class="collatz-formula"></div>
</div>

<script>
  // Umami e' gia' caricato globalmente da Head.astro: nessun import, si usa
  // window.umami con un guard, come negli altri simulatori del sito
  // (es. SimulatoreUrti: `if (!window.umami) return;`).
  function trackEvent(name: string, data?: Record<string, unknown>) {
    if (typeof window !== "undefined" && (window as any).umami) {
      (window as any).umami.track(name, data);
    }
  }

  interface AnimationState {
    isRunning: boolean;
    currentValue: number;
    sequence: number[];
    runningMax: number[]; // massimo storico ad ogni passo (crescita progressiva)
    committedCount: number; // punti gia' completamente posizionati (0..sequence.length)
    stepStartTime: number; // performance.now() dall'inizio della fase/passo corrente
    visibleCount: number; // quanti numeri mostrare nella formula f(n)={...}
  }

  // ========================================================================
  // INIZIALIZZAZIONE
  // ========================================================================
  const root = document.querySelector(".collatz-root") as HTMLElement;
  const canvas = root.querySelector(".collatz-canvas") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;
  const msgBox = root.querySelector(".collatz-message") as HTMLElement;
  const formulaBox = root.querySelector(".collatz-formula") as HTMLElement;
  const calcBtn = root.querySelector(".collatz-calc") as HTMLButtonElement;

  // Le stringhe i18n del frontmatter Astro (server-side) NON esistono nello
  // script client: si leggono dai data-* impostati sul root (stesso pattern
  // di GramSchmidt3D: root.dataset.hintEdit ecc.).
  const STR = {
    errorRange: root.dataset.errorRange ?? "",
    errorInvalid: root.dataset.errorInvalid ?? "",
    statsLabel: root.dataset.statsLabel ?? "",
    umamiEvent: root.dataset.umamiEvent ?? "collatz_calculate",
  };
  const randomBtn = root.querySelector(".collatz-random") as HTMLButtonElement;
  const inputField = root.querySelector(".collatz-input") as HTMLInputElement;
  const speedSlider = root.querySelector(".collatz-speed-slider") as HTMLInputElement;
  const speedValue = root.querySelector(".collatz-speed-value") as HTMLElement;

  // Scala del canvas adattata al device pixel ratio: su schermi ad alta
  // densità (retina, 4K) usiamo una risoluzione più alta per nitidezza,
  // su schermi normali/telefoni usiamo una risoluzione più bassa per
  // performance. Rapporto base: 800x500 (fisso); scaling factor dal DPR.
  const dpr = window.devicePixelRatio ?? 1;
  const baseWidth = 800;
  const baseHeight = 500;
  let canvasWidth = baseWidth;
  let canvasHeight = baseHeight;
  let radiusScale = 1;
  let lineWidthScale = 1;

  // Su schermi ad alta densità (DPR >= 2), raddoppia la risoluzione
  // per mantenere nitidezza. Su schermi normali/telefono, mantieni base.
  if (dpr >= 2) {
    canvasWidth = baseWidth * 2;
    canvasHeight = baseHeight * 2;
    radiusScale = 2;
    lineWidthScale = 2;
  }

  canvas.width = canvasWidth;
  canvas.height = canvasHeight;

  // Scala non lineare dello slider: passi fini da 0.5x a 1.5x (0.1 alla
  // volta), poi si passa a passi interi da 2x in su. Lo slider stesso
  // resta un semplice indice 0..N-1 su questo elenco di valori.
  const SPEED_VALUES = [0.5, 0.6, 0.7, 0.8, 0.9, 1.0, 1.1, 1.2, 1.3, 1.4, 1.5,
    2, 3, 4, 5, 6, 7, 8, 9, 10];
  function getSpeedMultiplier(): number {
    const idx = parseInt(speedSlider.value, 10);
    return SPEED_VALUES[idx] ?? 1;
  }

  let pendingValue: number | null = null;
  let animState: AnimationState = {
    isRunning: false,
    currentValue: 0,
    sequence: [],
    runningMax: [],
    committedCount: 0,
    stepStartTime: 0,
    visibleCount: 0,
  };

  const S = 0.9; // frazione dell'asse usata per la distanza
  const BASE_RADIUS = 6 * radiusScale; // raggio a riposo dei pallini (scalato dal DPR)

  // Durata di un "passo" della sequenza a velocita' 1x, suddivisa in tre
  // fasi consecutive e non sovrapposte: zoom (riposiziona i punti
  // esistenti) -> linea (si allunga fino a dove comparira' il nuovo punto)
  // -> pop-up (il punto compare all'arrivo della linea). Le frazioni
  // sommano a 1.
  const STEP_DURATION_BASE = 600;
  const ZOOM_FRACTION = 0.45;
  const LINE_FRACTION = 0.20;
  const POP_FRACTION = 0.35;

  // ========================================================================
  // LOGICA DI COLLATZ
  // ========================================================================
  function computeSequence(n: number): number[] {
    if (n < 1 || n > 100 || !Number.isInteger(n)) return [];
    const seq: number[] = [n];
    let current = n;
    while (current !== 1 && seq.length < 10000) {
      current = current % 2 === 0 ? current / 2 : 3 * current + 1;
      seq.push(current);
    }
    return seq;
  }

  // massimo storico ad ogni indice: parte dal numero iniziale e cresce
  // solo quando compare un nuovo massimo (mai in discesa) — cosi' il primo
  // punto e' sempre a T e la scala verticale si allarga progressivamente.
  function computeRunningMax(seq: number[]): number[] {
    const out: number[] = [];
    let m = seq.length > 0 ? seq[0] : 0;
    for (let i = 0; i < seq.length; i++) {
      if (seq[i] > m) m = seq[i];
      out.push(m);
    }
    return out;
  }

  // ========================================================================
  // VALIDAZIONE INPUT
  // ========================================================================
  function validateInput(val: string): number | null {
    const n = parseInt(val, 10);
    if (isNaN(n) || n < 1 || n > 100) {
      msgBox.className = "collatz-message collatz-error";
      msgBox.textContent =
        n < 1 || n > 100 ? STR.errorRange : STR.errorInvalid;
      return null;
    }
    msgBox.className = "collatz-message";
    msgBox.textContent = "";
    return n;
  }

  // ========================================================================
  // EASING & ANIMAZIONE
  // ========================================================================
  function lerp(a: number, b: number, p: number): number {
    return a + (b - a) * p;
  }
  function easeInOutCubic(p: number): number {
    return p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
  }
  function easeOutCubic(p: number): number {
    return 1 - Math.pow(1 - p, 3);
  }

  // Rimbalzo del pop-up: il diametro parte da 0, si allarga fino al 200%
  // del diametro finale, poi si stringe fino al 100% (mai un cerchio
  // "statico" che appare di colpo).
  function popDiameterFraction(p: number): number {
    if (p <= 0.5) {
      return lerp(0, 2, easeOutCubic(p / 0.5));
    }
    return lerp(2, 1, easeInOutCubic((p - 0.5) / 0.5));
  }

  function pointColor(seq: number[], i: number): string {
    if (i === 0 || seq[i] === 1) return "#00AA00"; // verde: iniziale o finale
    return seq[i] % 2 === 0 ? "#DD0000" : "#0066FF"; // rosso pari, blu dispari
  }

  // ========================================================================
  // RENDERING CANVAS
  // ========================================================================
  // Disegna l'intera scena per un dato istante dell'animazione.
  // k = indice del punto in elaborazione (irrilevante per "idle"/"done").
  // phase distingue le fasi: idle (nulla ancora calcolato), initial-pop
  // (il primo punto, n=0, non ha nulla da riposizionare), zoom (i punti
  // 0..k-1 si riposizionano con continuita' sulla nuova scala), pop (il
  // punto k compare con il rimbalzo), line (la linea k-1 -> k si allunga),
  // done (stato finale, tutto fermo).
  type Phase = "idle" | "initial-pop" | "zoom" | "pop" | "line" | "done";

  function render(k: number, phase: Phase, progress: number) {
    const seq = animState.sequence;
    const runningMax = animState.runningMax;

    const w = canvas.width;
    const h = canvas.height;
    // Gli assi non stanno sul bordo del frame: entrano di 1/20 della
    // rispettiva misura, cosi' c'e' spazio per leggere le etichette.
    const marginX = w * 0.05;
    const marginY = h * 0.05;
    const axisWidth = w - 2 * marginX;
    const axisHeight = h - 2 * marginY;
    const x0 = marginX;
    const y0 = h - marginY;

    let existingCount = 0; // punti "fermi" gia' posizionati (0..existingCount-1)
    let nzoom = 1;
    let yzoom = 1;
    // Etichetta "n" mostrata sotto l'asse: 1-based (il primo elemento e'
    // "n=1"), cosi' l'ultimo valore visualizzato coincide col conteggio
    // totale degli elementi, non col conteggio-1.
    let labelN = 1;

    if (phase === "idle") {
      // niente da disegnare oltre agli assi
    } else if (phase === "done") {
      existingCount = seq.length;
      const finalNmax = seq.length - 1;
      const finalVmax = runningMax[runningMax.length - 1] ?? 0;
      nzoom = finalNmax > 0 ? 1 / finalNmax : 1;
      yzoom = finalVmax > 0 ? 1 / finalVmax : 1;
      labelN = finalNmax + 1;
    } else if (phase === "initial-pop") {
      existingCount = 0;
      nzoom = 1;
      yzoom = seq[0] > 0 ? 1 / seq[0] : 1;
      labelN = 1;
    } else {
      // zoom / pop / line: k >= 1, punti 0..k-1 esistono, si aggiunge il punto k
      existingCount = k;
      const oldNmax = k - 1;
      const newNmax = k;
      const nzoomOld = oldNmax > 0 ? 1 / oldNmax : 1;
      const nzoomNew = newNmax > 0 ? 1 / newNmax : 1;
      const oldVmax = runningMax[k - 1];
      const newVmax = runningMax[k];
      const yzoomOld = oldVmax > 0 ? 1 / oldVmax : 1;
      const yzoomNew = newVmax > 0 ? 1 / newVmax : 1;

      if (phase === "zoom") {
        const e = easeInOutCubic(progress);
        nzoom = lerp(nzoomOld, nzoomNew, e);
        yzoom = lerp(yzoomOld, yzoomNew, e); // no-op se non c'e' nuovo massimo
        // Durante zoom e line, mostra l'etichetta del numero precedente
        labelN = oldNmax + 1;
      } else if (phase === "line") {
        nzoom = nzoomNew;
        yzoom = yzoomNew;
        // Durante line, ancora non aggiornare: il pop-up non è ancora iniziato
        labelN = oldNmax + 1;
      } else {
        // pop: lo zoom e line sono gia' completati
        nzoom = nzoomNew;
        yzoom = yzoomNew;
        // Durante pop, mostra l'etichetta del numero corrente (il pallino sta comparendo)
        labelN = newNmax + 1;
      }
    }

    // ----- sfondo, assi, etichette -----
    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = "rgba(200, 200, 200, 0.2)";
    ctx.fillRect(x0, y0 - axisHeight, axisWidth, axisHeight);

    ctx.strokeStyle = "rgba(100, 100, 100, 0.5)";
    ctx.lineWidth = 2 * lineWidthScale;
    ctx.beginPath();
    ctx.moveTo(x0, y0);
    ctx.lineTo(x0 + axisWidth, y0);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(x0, y0);
    ctx.lineTo(x0, y0 - axisHeight);
    ctx.stroke();

    ctx.fillStyle = "rgba(90, 90, 90, 0.85)";
    ctx.font = "12px monospace";
    ctx.textAlign = "right";
    ctx.fillText(`n=${labelN}`, x0 + axisWidth, y0 + 16);

    if (seq.length === 0) return;

    const px = (i: number) => x0 + i * nzoom * axisWidth * S;
    const py = (value: number) => y0 - value * yzoom * axisHeight * S;

    // ----- linee gia' consolidate (sotto ai punti) -----
    for (let i = 0; i < existingCount - 1; i++) {
      const x1 = px(i);
      const y1 = py(seq[i]);
      const x2 = px(i + 1);
      const y2 = py(seq[i + 1]);
      ctx.strokeStyle = seq[i + 1] > seq[i] ? "#FFD700" : "#FF8C00";
      ctx.lineWidth = 2.5 * lineWidthScale;
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.lineTo(x2, y2);
      ctx.stroke();
    }

    // ----- linea verso il punto k-1 -> k: in crescita durante "line",
    // gia' completa (statica) durante "pop" (e' arrivata prima che il
    // punto cominci a comparire) -----
    if (phase === "line") {
      const xPrev = px(k - 1);
      const yPrev = py(seq[k - 1]);
      const xTarget = px(k);
      const yTarget = py(seq[k]);
      const e = easeOutCubic(progress);
      const xEnd = lerp(xPrev, xTarget, e);
      const yEnd = lerp(yPrev, yTarget, e);
      ctx.strokeStyle = seq[k] > seq[k - 1] ? "#FFD700" : "#FF8C00";
      ctx.lineWidth = 2.5 * lineWidthScale;
      ctx.beginPath();
      ctx.moveTo(xPrev, yPrev);
      ctx.lineTo(xEnd, yEnd);
      ctx.stroke();
    } else if (phase === "pop") {
      const x1 = px(k - 1);
      const y1 = py(seq[k - 1]);
      const x2 = px(k);
      const y2 = py(seq[k]);
      ctx.strokeStyle = seq[k] > seq[k - 1] ? "#FFD700" : "#FF8C00";
      ctx.lineWidth = 2.5 * lineWidthScale;
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.lineTo(x2, y2);
      ctx.stroke();
    }

    // ----- punti "fermi" -----
    ctx.lineWidth = 2 * lineWidthScale;
    for (let i = 0; i < existingCount; i++) {
      const x = px(i);
      const y = py(seq[i]);
      ctx.fillStyle = pointColor(seq, i);
      ctx.strokeStyle = "rgba(0, 0, 0, 0.3)";
      ctx.beginPath();
      ctx.arc(x, y, BASE_RADIUS, 0, 2 * Math.PI);
      ctx.fill();
      ctx.stroke();
    }

    // ----- punto attivo: compare SOLO quando la linea e' gia' arrivata
    // (fase "pop"), non mentre la linea sta ancora crescendo -----
    let activeIndex = -1;
    if (phase === "initial-pop") activeIndex = 0;
    else if (phase === "pop") activeIndex = k;

    if (activeIndex >= 0) {
      const x = px(activeIndex);
      const y = py(seq[activeIndex]);
      const radius = BASE_RADIUS * popDiameterFraction(progress);
      ctx.fillStyle = pointColor(seq, activeIndex);
      ctx.strokeStyle = "rgba(0, 0, 0, 0.3)";
      ctx.beginPath();
      ctx.arc(x, y, radius, 0, 2 * Math.PI);
      ctx.fill();
      ctx.stroke();
    }
  }

  function renderIdle() {
    render(0, "idle", 0);
  }

  function renderDone() {
    render(animState.sequence.length, "done", 1);
  }

  // ========================================================================
  // ANIMAZIONE
  // ========================================================================
  function startAnimation(startVal: number) {
    const seq = computeSequence(startVal);
    if (seq.length === 0) return;

    animState = {
      isRunning: true,
      currentValue: startVal,
      sequence: seq,
      runningMax: computeRunningMax(seq),
      committedCount: 0,
      stepStartTime: performance.now(),
      visibleCount: 0,
    };

    inputField.disabled = false; // Consenti editing anche durante animazione
    calcBtn.disabled = false; // Consenti click calc durante animazione
    randomBtn.disabled = false;
    pendingValue = null;
    updateFormula();

    trackEvent(STR.umamiEvent, { startValue: startVal, sequenceLength: seq.length });
    animate();
  }

  function animate() {
    if (!animState.isRunning) return;

    const seq = animState.sequence;
    const k = animState.committedCount;

    // Sequenza esaurita: fase finale, tutto fermo.
    if (k >= seq.length) {
      animState.isRunning = false;
      inputField.disabled = false;
      calcBtn.disabled = false;
      animState.visibleCount = seq.length;
      updateFormula();
      renderDone();
      return;
    }

    const speedMult = getSpeedMultiplier();
    const stepDuration = STEP_DURATION_BASE / speedMult;
    const elapsed = performance.now() - animState.stepStartTime;

    // Passo 0: solo pop-up del punto iniziale, niente da riposizionare.
    if (k === 0) {
      const popDur = stepDuration * POP_FRACTION;
      if (animState.visibleCount < 1) {
        animState.visibleCount = 1;
        updateFormula();
      }
      if (elapsed >= popDur) {
        animState.committedCount = 1;
        animState.stepStartTime = performance.now();
        requestAnimationFrame(animate);
        return;
      }
      render(0, "initial-pop", Math.min(elapsed / popDur, 1));
      requestAnimationFrame(animate);
      return;
    }

    // Passo k >= 1: zoom (riposiziona) -> linea (si allunga fino alla
    // posizione futura) -> pop (il punto compare all'arrivo della linea)
    const zoomDur = stepDuration * ZOOM_FRACTION;
    const lineDur = stepDuration * LINE_FRACTION;
    const popDur = stepDuration * POP_FRACTION;

    if (elapsed < zoomDur) {
      render(k, "zoom", elapsed / zoomDur);
    } else if (elapsed < zoomDur + lineDur) {
      render(k, "line", (elapsed - zoomDur) / lineDur);
    } else if (elapsed < zoomDur + lineDur + popDur) {
      if (animState.visibleCount < k + 1) {
        animState.visibleCount = k + 1;
        updateFormula();
      }
      render(k, "pop", (elapsed - zoomDur - lineDur) / popDur);
    } else {
      // Passo completato: il punto k e' ora "fermo", si passa al successivo.
      animState.committedCount = k + 1;
      animState.stepStartTime = performance.now();
      requestAnimationFrame(animate);
      return;
    }

    requestAnimationFrame(animate);
  }

  // ========================================================================
  // AGGIORNAMENTO FORMULA
  // ========================================================================
  function updateFormula() {
    if (animState.sequence.length === 0) {
      formulaBox.innerHTML = "";
      return;
    }

    const numToShow = animState.isRunning
      ? animState.visibleCount
      : animState.sequence.length;

    let html = `f(${animState.currentValue}) = {`;
    for (let i = 0; i < numToShow; i++) {
      if (i > 0) html += ", ";
      html += animState.sequence[i];
    }
    html += "}";

    // Conteggio nello stesso riquadro della sequenza, stesso font, con una
    // riga di respiro (margin-top). Mostra SOLO quando la simulazione e'
    // terminata, altrimenti distrae durante l'animazione.
    let statsHtml = "";
    if (!animState.isRunning && animState.sequence.length > 0) {
      statsHtml = `<div class="collatz-formula-stats">${STR.statsLabel} ${animState.sequence.length}</div>`;
    }

    formulaBox.innerHTML =
      `<div class="collatz-formula-text">${html}</div>` + statsHtml;
  }

  // ========================================================================
  // HANDLER BOTTONI
  // ========================================================================
  function handleCalc() {
    const val = validateInput(inputField.value);
    if (val === null) return;

    // Se non c'è animazione in corso, avvia sempre
    if (!animState.isRunning) {
      startAnimation(val);
      return;
    }

    // Se c'è animazione in corso:
    // - Se c'è un valore in sospeso (diverso da quello attuale), ferma e riparta
    // - Se non c'è cambio in sospeso, non fare nulla (l'animazione continua)
    if (pendingValue !== null && pendingValue !== animState.currentValue) {
      animState.isRunning = false;
      startAnimation(pendingValue);
    }
    // Altrimenti non fare nulla: l'animazione continua indisturbata
  }

  function handleRandom() {
    const val = 1 + Math.floor(Math.random() * 100);
    inputField.value = String(val);
    pendingValue = val;
    updateFormula();
    // Non interrompe l'animazione in corso
  }

  function handleInputChange() {
    const val = validateInput(inputField.value);
    if (val !== null) {
      pendingValue = val;
    }
  }

  function handleSpeedChange() {
    const val = getSpeedMultiplier();
    speedValue.textContent = val.toFixed(1) + "x";
    // La velocità si applica già in tempo reale tramite requestAnimationFrame
  }

  // ========================================================================
  // EVENT LISTENERS
  // ========================================================================
  calcBtn.addEventListener("click", handleCalc);
  randomBtn.addEventListener("click", handleRandom);
  inputField.addEventListener("input", handleInputChange);
  inputField.addEventListener("change", handleInputChange);
  speedSlider.addEventListener("input", handleSpeedChange);

  // Inizializzazione: disegna gli assi vuoti subito, cosi' il canvas non
  // resta bianco prima del primo calcolo.
  updateFormula();
  renderIdle();
</script>

<style>
  .collatz-root {
    --collatz-red: #dd0000;
    --collatz-blue: #0066ff;
    --collatz-green: #00aa00;
    --collatz-yellow: #ffd700;
    --collatz-orange: #ff8c00;
  }
  .collatz-root *,
  .collatz-root *::before,
  .collatz-root *::after { box-sizing: border-box; }

  .collatz-canvas {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-gray-5, #3a3a3a);
    border-radius: 8px;
    background: white;
    margin-bottom: 0.5rem;
  }

  .collatz-message {
    font-size: 0.85rem;
    margin: 0;
    min-height: 0;
  }

  .collatz-message.collatz-error {
    margin-top: 0.6rem;
    padding: 0.5rem 0.7rem;
    border-left: 4px solid var(--collatz-red);
