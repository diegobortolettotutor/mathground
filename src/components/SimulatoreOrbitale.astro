---
// src/components/SimulatoreOrbitale.astro
// STEP 1 + grafico energia. In arrivo (step 2): trascinamento perturbatore, zoom/pan.
const locale = (Astro.currentLocale ?? "it").toLowerCase();
const lang = locale.startsWith("en") ? "en" : "it";

const DICT = {
  it: {
    integr: "Integratore: ",
    ec: "Euler-Cromer", rk4: "Runge-Kutta 4 (RK4)",
    toRK4: "Passa a RK4", toEC: "Passa a Euler-Cromer",
    pertOn: "Attiva perturbatore", pertOff: "Disattiva perturbatore",
    eHide: "Nascondi grafico energia", eShow: "Mostra grafico energia",
    eTitle: "Energia totale  E = \u00bdv\u00b2 \u2212 GM/r",
    legV: "velocità", legA: "accelerazione gravitazionale",
    impact: "IMPATTO — muovi uno slider per ricominciare",
    sV: "velocità v₀", sR: "raggio R", sRho: "densità ρ",
    sR0: "distanza r₀", sH: "passo h", sM2: "massa M₂",
    dCirc: "v circ", dFuga: "v fuga", dM: "M", dV: "V",
  },
  en: {
    integr: "Integrator: ",
    ec: "Euler-Cromer", rk4: "Runge-Kutta 4 (RK4)",
    toRK4: "Switch to RK4", toEC: "Switch to Euler-Cromer",
    pertOn: "Enable perturber", pertOff: "Disable perturber",
    eHide: "Hide energy plot", eShow: "Show energy plot",
    eTitle: "Total energy  E = \u00bdv\u00b2 \u2212 GM/r",
    legV: "velocity", legA: "gravitational acceleration",
    impact: "IMPACT — move a slider to restart",
    sV: "velocity v₀", sR: "radius R", sRho: "density ρ",
    sR0: "distance r₀", sH: "step h", sM2: "mass M₂",
    dCirc: "v circ", dFuga: "v esc", dM: "M", dV: "V",
  },
};
const t = DICT[lang];
---

<div class="grav">
  <div class="grav-energy-wrap" id="grav-energy-wrap">
    <canvas id="grav-energy"></canvas>
  </div>

  <div class="grav-canvas-wrap">
    <canvas id="grav-cv"></canvas>
  </div>

  <p class="grav-legend">
    <span><span class="sw v"></span>{t.legV}</span>
    <span><span class="sw a"></span>{t.legA}</span>
    <span id="grav-status" class="status"></span>
  </p>

  <div class="grav-buttons">
    <button id="grav-int" class="int">{t.toRK4}</button>
    <button id="grav-pert">{t.pertOn}</button>
    <button id="grav-energy-btn">{t.eHide}</button>
  </div>

  <p class="grav-derived" id="grav-derived"></p>

  <div class="grav-sliders">
    <div class="cell"><label>{t.sV}</label><input type="range" id="g-v" min="0" max="3" value="0.5" step="0.01" /><span class="val" id="g-v-val"></span></div>
    <div class="cell"><label>{t.sR}</label><input type="range" id="g-R" min="0.02" max="0.4" value="0.1" step="0.01" /><span class="val" id="g-R-val"></span></div>
    <div class="cell"><label>{t.sRho}</label><input type="range" id="g-rho" min="0.5" max="5" value="1" step="0.1" /><span class="val" id="g-rho-val"></span></div>
    <div class="cell"><label>{t.sR0}</label><input type="range" id="g-r0" min="0.5" max="3" value="1" step="0.05" /><span class="val" id="g-r0-val"></span></div>
    <div class="cell"><label>{t.sH}</label><input type="range" id="g-h" min="0.01" max="1" value="0.05" step="0.01" /><span class="val" id="g-h-val"></span></div>
    <div class="cell"><label>{t.sM2}</label><input type="range" id="g-M2" min="0.01" max="5" value="0.5" step="0.01" /><span class="val" id="g-M2-val"></span></div>
  </div>
</div>

<style>
  .grav {
    position: relative;        /* riferimento per l'overlay del grafico energia */
    --ink: var(--sl-color-text, #26252a);
    --muted: var(--sl-color-gray-3, #6c6b66);
    --surface: var(--sl-color-gray-6, #f3f3f1);
    --line: var(--sl-color-hairline, #d9d7cf);
    --track: var(--sl-color-gray-5, #c8c6be);
    --btn-bg: var(--sl-color-gray-6, #f0eeea);
    --accent: #ffcc44;
    color: var(--ink);
    max-width: 820px;
    margin-inline: auto;
    line-height: 1.5;
  }
  .grav-canvas-wrap {
    position: relative;
    width: 100%;
    height: min(72vh, 640px);
    border-radius: 10px;
    overflow: hidden;
    background: #0f0f1e;
  }
  .grav-canvas-wrap canvas { display: block; width: 100%; height: 100%; touch-action: none; cursor: default; }

  /* Grafico energia: DESKTOP = sovrapposto in alto a destra nel canvas */
  .grav-energy-wrap {
    position: absolute;
    top: 8px; right: 8px;
    width: min(38%, 300px);
    height: 150px;
    border-radius: 6px;
    overflow: hidden;
    z-index: 2;
    background: #14142a;
  }
  .grav-energy-wrap canvas { display: block; width: 100%; height: 100%; }

  .grav-legend { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; font-size: 13px; color: var(--muted); margin: 10px 0 4px; }
  .grav-legend .sw { display: inline-block; width: 12px; height: 12px; border-radius: 50%; vertical-align: -1px; margin-right: 5px; }
  .grav-legend .sw.v { background: #32e664; }
  .grav-legend .sw.a { background: #e63c3c; }
  .grav-legend .status { color: #e65050; font-weight: 600; }

  .grav-buttons { display: flex; flex-wrap: wrap; align-items: stretch; gap: 8px; margin: 8px 0; }
  .grav-buttons button {
  font: inherit; font-size: 13px; padding: 6px 12px; border-radius: 6px;
  border: 1px solid var(--line); background: var(--btn-bg); color: var(--ink);
  cursor: pointer; margin: 0;
  }
  .grav-buttons button:hover { border-color: var(--muted); }
  .grav-buttons button.int { font-weight: 600; }

  .grav-derived { font-size: 12px; color: var(--muted); margin: 4px 0 10px; font-variant-numeric: tabular-nums; }

  .grav-sliders {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px 12px;
    align-items: end;
  }
  .grav-sliders .cell { display: flex; flex-direction: column; justify-content: flex-end; }
  .grav-sliders label { font-size: 12px; color: var(--muted); line-height: 1.3; margin-bottom: 10px; }
  .grav-sliders .val { font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; margin-top: 8px; }
  .grav-sliders input[type="range"] {
    -webkit-appearance: none; appearance: none;
    width: 100%; height: 4px;
    background: var(--track); border-radius: 2px;
    outline: none; cursor: pointer;
  }
  .grav-sliders input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none; width: 16px; height: 16px; border-radius: 50%;
    background: var(--accent); border: 2px solid var(--sl-color-bg, #fff); cursor: pointer;
  }
  .grav-sliders input[type="range"]::-moz-range-thumb {
    width: 16px; height: 16px; border-radius: 50%;
    background: var(--accent); border: 2px solid var(--sl-color-bg, #fff); cursor: pointer;
  }

  /* Responsive */
  @media (max-width: 900px) { .grav-sliders { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 600px) {
    .grav-sliders { grid-template-columns: 1fr; }
    /* MOBILE = grafico energia come blocco sopra il canvas */
    .grav-energy-wrap {
      position: static;
      width: 100%;
      height: 140px;
      margin-bottom: 10px;
    }
  }
</style>

<script define:vars={{ t, G_const: 1 }}>
  (function () {
    var canvas = document.getElementById("grav-cv");
    if (!canvas) return;
    var ctx = canvas.getContext("2d");
    var wrap = canvas.parentElement;

    var energyCv = document.getElementById("grav-energy");
    var energyWrap = document.getElementById("grav-energy-wrap");
    var ectx = energyCv.getContext("2d");

    // ---- stato ----
    var G = G_const;
    var x, y, vx, vy, h, R, rho, r0, v0;
    var trail = [];
    var landed = false;
    var useRK4 = false;
    var perturbatore = false;
    var dragging = false;
    var panning = null;
    var showEnergy = true;
    var px2 = 2, py2 = 0;
    var offsetX = 0, offsetY = 0; // pan (step 2)
    var sc = 100, cx = 0, cy = 0, W = 0, H = 0;
    var W2 = 0, H2 = 0;
    var E0 = 0, E_current = 0;
    var energyHistory = [];
    var MAX_ENERGY = 400, MAX_TRAIL = 4000;
    var BALL_D = 12, MIN_ARROW = 12;

    var els = {
      v: document.getElementById("g-v"), R: document.getElementById("g-R"),
      rho: document.getElementById("g-rho"), r0: document.getElementById("g-r0"),
      h: document.getElementById("g-h"), M2: document.getElementById("g-M2"),
    };
    var vals = {
      v: document.getElementById("g-v-val"), R: document.getElementById("g-R-val"),
      rho: document.getElementById("g-rho-val"), r0: document.getElementById("g-r0-val"),
      h: document.getElementById("g-h-val"), M2: document.getElementById("g-M2-val"),
    };
    var btnInt = document.getElementById("grav-int");
    var btnPert = document.getElementById("grav-pert");
    var btnEnergy = document.getElementById("grav-energy-btn");
    var statusEl = document.getElementById("grav-status");
    var derivedEl = document.getElementById("grav-derived");

    function map(v, a, b, c, d) { return c + (d - c) * (v - a) / (b - a); }

    // ---- fisica ----
    function getMass() { return rho * (4 / 3) * Math.PI * Math.pow(R, 3); }
    function getVc() { return Math.sqrt(G * getMass() / r0); }
    function getEnergy(ex, ey, evx, evy) {
      var M = getMass();
      var r = Math.sqrt(ex * ex + ey * ey);
      var v2 = evx * evx + evy * evy;
      return 0.5 * v2 - G * M / r;
    }
    function accel(ax_, ay_) {
      var M = getMass();
      var M2 = +els.M2.value;
      var r2 = ax_ * ax_ + ay_ * ay_;
      var r3 = Math.pow(r2, 1.5);
      var ax = -G * M * ax_ / r3;
      var ay = -G * M * ay_ / r3;
      if (perturbatore) {
        var dx2 = ax_ - px2, dy2 = ay_ - py2;
        var rd3 = Math.pow(dx2 * dx2 + dy2 * dy2, 1.5);
        ax -= G * M2 * dx2 / rd3;
        ay -= G * M2 * dy2 / rd3;
      }
      return { ax: ax, ay: ay };
    }
    function stepEulerCromer() {
      var a = accel(x, y);
      vx += a.ax * h; vy += a.ay * h;
      x += vx * h; y += vy * h;
    }
    function stepRK4() {
      var k1v = accel(x, y);
      var k1x = { vx: vx, vy: vy };
      var k2v = accel(x + k1x.vx * h / 2, y + k1x.vy * h / 2);
      var k2x = { vx: vx + k1v.ax * h / 2, vy: vy + k1v.ay * h / 2 };
      var k3v = accel(x + k2x.vx * h / 2, y + k2x.vy * h / 2);
      var k3x = { vx: vx + k2v.ax * h / 2, vy: vy + k2v.ay * h / 2 };
      var k4v = accel(x + k3x.vx * h, y + k3x.vy * h);
      var k4x = { vx: vx + k3v.ax * h, vy: vy + k3v.ay * h };
      x += (h / 6) * (k1x.vx + 2 * k2x.vx + 2 * k3x.vx + k4x.vx);
      y += (h / 6) * (k1x.vy + 2 * k2x.vy + 2 * k3x.vy + k4x.vy);
      vx += (h / 6) * (k1v.ax + 2 * k2v.ax + 2 * k3v.ax + k4v.ax);
      vy += (h / 6) * (k1v.ay + 2 * k2v.ay + 2 * k3v.ay + k4v.ay);
    }

    // ---- coordinate ----
    function toScreen(wx, wy) { return { x: cx + offsetX + wx * sc, y: cy + offsetY - wy * sc }; }
    function toWorld(sx, sy) { return { x: (sx - cx - offsetX) / sc, y: -(sy - cy - offsetY) / sc }; }
    function pointerPos(e) { var r = canvas.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; }
    function perturberHit(p) {
      var ps = toScreen(px2, py2);
      var raggio2 = Math.max(8, (+els.M2.value) * 10);
      return Math.hypot(p.x - ps.x, p.y - ps.y) <= raggio2 + 10;
    }

    // ---- layout / DPI ----
    function resize() {
      var dpr = window.devicePixelRatio || 1;
      var r = wrap.getBoundingClientRect();
      W = r.width; H = r.height;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      sc = Math.min(W, H) / 6;
      cx = W / 2; cy = H / 2;

      // grafico energia (solo se visibile)
      if (energyWrap.offsetParent !== null) {
        var r2 = energyWrap.getBoundingClientRect();
        W2 = r2.width; H2 = r2.height;
        energyCv.width = Math.round(W2 * dpr);
        energyCv.height = Math.round(H2 * dpr);
        ectx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
    }

    function reset() {
      R = +els.R.value; rho = +els.rho.value; r0 = +els.r0.value;
      h = +els.h.value; v0 = +els.v.value;
      x = r0; y = 0; vx = 0; vy = v0;
      trail = []; energyHistory = []; landed = false;
      offsetX = 0; offsetY = 0;
      E0 = getEnergy(x, y, vx, vy); E_current = E0;
    }

    function drawArrow(x1, y1, dx, dy, col) {
      var len = Math.hypot(dx, dy);
      var ux = len > 0 ? dx / len : 0, uy = len > 0 ? dy / len : 0;
      var drawLen = Math.max(len, MIN_ARROW), as = 10;
      var sX = x1 + ux * (BALL_D / 2), sY = y1 + uy * (BALL_D / 2);
      var eX = sX + ux * drawLen, eY = sY + uy * drawLen;
      ctx.strokeStyle = col; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(sX, sY); ctx.lineTo(eX, eY); ctx.stroke();
      ctx.fillStyle = col;
      ctx.save(); ctx.translate(eX, eY); ctx.rotate(Math.atan2(eY - sY, eX - sX));
      ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(-as, as / 2); ctx.lineTo(-as, -as / 2); ctx.closePath(); ctx.fill();
      ctx.restore();
    }

    function drawEnergy() {
      if (!showEnergy || energyWrap.offsetParent === null) return;
      ectx.clearRect(0, 0, W2, H2);
      ectx.fillStyle = "#14142a";
      ectx.fillRect(0, 0, W2, H2);

      var fs = Math.max(10, Math.min(13, W2 / 22));
      ectx.font = fs + "px sans-serif"; ectx.textAlign = "left";
      ectx.fillStyle = "#c8c8d0";
      ectx.fillText(t.eTitle, 8, fs + 5);

      if (energyHistory.length < 2) return;

      var emin = Infinity, emax = -Infinity;
      for (var j = 0; j < energyHistory.length; j++) {
        if (energyHistory[j] < emin) emin = energyHistory[j];
        if (energyHistory[j] > emax) emax = energyHistory[j];
      }
      var margin = Math.max(Math.abs(emax - emin) * 0.15, Math.abs(E0) * 0.05, 0.001);
      emin -= margin; emax += margin;

      var plotX = 8, plotY = fs + 12, plotW = W2 - 16, plotH = H2 - fs - 34;

      // linea E0
      var y0 = map(E0, emin, emax, plotY + plotH, plotY);
      ectx.strokeStyle = "rgba(255,255,100,0.5)"; ectx.lineWidth = 1;
      ectx.setLineDash([4, 4]);
      ectx.beginPath(); ectx.moveTo(plotX, y0); ectx.lineTo(plotX + plotW, y0); ectx.stroke();
      ectx.setLineDash([]);
      ectx.fillStyle = "rgba(255,255,100,0.85)"; ectx.font = (fs - 1) + "px sans-serif";
      ectx.fillText("E\u2080 = " + E0.toFixed(4), plotX + 2, y0 - 3);

      // curva
      ectx.strokeStyle = "#64dcff"; ectx.lineWidth = 1.5; ectx.beginPath();
      for (var i = 0; i < energyHistory.length; i++) {
        var ex = map(i, 0, MAX_ENERGY - 1, plotX, plotX + plotW);
        var ey = map(energyHistory[i], emin, emax, plotY + plotH, plotY);
        if (i === 0) ectx.moveTo(ex, ey); else ectx.lineTo(ex, ey);
      }
      ectx.stroke();

      // ΔE
      var dE = E_current - E0;
      var dEpct = E0 !== 0 ? (dE / Math.abs(E0)) * 100 : 0;
      var sgn = dEpct >= 0 ? "+" : "";
      ectx.fillStyle = "#64dcff"; ectx.font = fs + "px sans-serif";
      ectx.fillText("\u0394E = " + sgn + dEpct.toFixed(2) + "%", plotX, H2 - 6);
    }

    function frame() {
      ctx.fillStyle = "#0f0f1e";
      ctx.fillRect(0, 0, W, H);

      var M = getMass();
      var M2 = +els.M2.value;
      var vc = getVc();
      var vf = Math.SQRT2 * vc;
      var Vrat = vc > 0 ? v0 / vc : 0;

      var c = toScreen(0, 0);
      ctx.fillStyle = "#50a0ff";
      ctx.beginPath(); ctx.arc(c.x, c.y, R * sc, 0, Math.PI * 2); ctx.fill();

      if (perturbatore) {
        var ps = toScreen(px2, py2);
        var raggio2 = Math.max(8, M2 * 10);
        ctx.fillStyle = "#ff8c1e";
        ctx.beginPath(); ctx.arc(ps.x, ps.y, raggio2, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = "#ffb450"; ctx.font = "12px sans-serif"; ctx.textAlign = "left";
        ctx.fillText("M\u2082=" + M2.toFixed(2), ps.x + raggio2 + 4, ps.y - 2);
      }

      if (trail.length > 1) {
        ctx.strokeStyle = "rgba(255,200,50,0.7)"; ctx.lineWidth = 1.5;
        ctx.beginPath();
        for (var i = 0; i < trail.length; i++) {
          var p = toScreen(trail[i].x, trail[i].y);
          if (i === 0) ctx.moveTo(p.x, p.y); else ctx.lineTo(p.x, p.y);
        }
        ctx.stroke();
      }

      if (!landed) {
        if (useRK4) stepRK4(); else stepEulerCromer();
        trail.push({ x: x, y: y });
        if (trail.length > MAX_TRAIL) trail.shift();
        E_current = getEnergy(x, y, vx, vy);
        energyHistory.push(E_current);
        if (energyHistory.length > MAX_ENERGY) energyHistory.shift();
        if (Math.sqrt(x * x + y * y) <= R) landed = true;
      }

      var bp = toScreen(x, y);
      var a = accel(x, y);
      var vscale = sc * 1.2, ascale = sc * 0.6;
      drawArrow(bp.x, bp.y, vx * vscale, -vy * vscale, "#32e664");
      drawArrow(bp.x, bp.y, a.ax * ascale, -a.ay * ascale, "#e63c3c");
      ctx.fillStyle = landed ? "#ff5050" : "#ffdc50";
      ctx.beginPath(); ctx.arc(bp.x, bp.y, BALL_D / 2, 0, Math.PI * 2); ctx.fill();

      var nome = useRK4 ? t.rk4 : t.ec;
      var fsTitle = Math.max(14, Math.min(20, W / 40));
      ctx.font = fsTitle + "px sans-serif"; ctx.textAlign = "left";
      ctx.fillStyle = useRK4 ? "#ffc832" : "#96c8ff";
      ctx.fillText(t.integr + nome, 12, fsTitle + 8);

      drawEnergy();

      vals.v.textContent = v0.toFixed(2);
      vals.R.textContent = R.toFixed(2);
      vals.rho.textContent = rho.toFixed(1);
      vals.r0.textContent = r0.toFixed(2);
      vals.h.textContent = h.toFixed(2);
      vals.M2.textContent = M2.toFixed(2);
      derivedEl.textContent =
        t.dM + " = " + M.toFixed(3) + "   " +
        t.dCirc + " = " + vc.toFixed(2) + "   " +
        t.dFuga + " = " + vf.toFixed(2) + "   " +
        t.dV + " = " + Vrat.toFixed(2);
      statusEl.textContent = landed ? t.impact : "";

      requestAnimationFrame(frame);
    }

    // ---- eventi ----
    Object.keys(els).forEach(function (k) { els[k].addEventListener("input", reset); });
    btnInt.addEventListener("click", function () {
      useRK4 = !useRK4;
      btnInt.textContent = useRK4 ? t.toEC : t.toRK4;
      trail = []; energyHistory = []; E0 = getEnergy(x, y, vx, vy);
    });
    btnPert.addEventListener("click", function () {
      perturbatore = !perturbatore;
      btnPert.textContent = perturbatore ? t.pertOff : t.pertOn;
      energyHistory = []; E0 = getEnergy(x, y, vx, vy);
    });
    btnEnergy.addEventListener("click", function () {
      showEnergy = !showEnergy;
      btnEnergy.textContent = showEnergy ? t.eHide : t.eShow;
      energyWrap.style.display = showEnergy ? "" : "none";
      if (showEnergy) resize();
    });
    // ---- interazione: mouse (drag/pan/zoom) + touch (drag/scroll/pan+pinch) ----
    var activePointers = new Map();
    var gesture = null;     // {dist, midX, midY} per pan+pinch a due dita
    var scrollLast = null;  // scroll manuale della pagina (un dito a vuoto)

    function touchList() {
      var pts = [];
      activePointers.forEach(function (v) { if (v.type !== "mouse") pts.push(v); });
      return pts;
    }
    function gestureState(pts) {
      var a = pts[0], b = pts[1];
      return { dist: Math.hypot(a.x - b.x, a.y - b.y), midX: (a.x + b.x) / 2, midY: (a.y + b.y) / 2 };
    }
    function zoomAt(mx, my, factor) {
      var wx = (mx - cx - offsetX) / sc;
      var wy = -(my - cy - offsetY) / sc;
      sc *= factor;
      offsetX = mx - cx - wx * sc;
      offsetY = my - cy + wy * sc;
    }

    function onPointerDown(e) {
      var p = pointerPos(e);
      activePointers.set(e.pointerId, { x: p.x, y: p.y, type: e.pointerType });
      if (e.pointerType === "mouse") {
        if (perturbatore && perturberHit(p)) {
          dragging = true; canvas.style.cursor = "grabbing";
          if (canvas.setPointerCapture) canvas.setPointerCapture(e.pointerId);
          e.preventDefault();
        } else {
          panning = { x: p.x, y: p.y, ox: offsetX, oy: offsetY };
          canvas.style.cursor = "grabbing";
          if (canvas.setPointerCapture) canvas.setPointerCapture(e.pointerId);
        }
        return;
      }
      // tocco
      var pts = touchList();
      if (pts.length >= 2) {
        dragging = false; scrollLast = null;
        gesture = gestureState(pts);
        e.preventDefault();
      } else if (perturbatore && perturberHit(p)) {
        dragging = true; e.preventDefault();
      } else {
        scrollLast = { y: e.clientY };
      }
    }

    function onPointerMove(e) {
      var p = pointerPos(e);
      if (activePointers.has(e.pointerId)) { var rec = activePointers.get(e.pointerId); rec.x = p.x; rec.y = p.y; }
      if (e.pointerType === "mouse") {
        if (dragging && perturbatore) {
          var wm = toWorld(p.x, p.y); px2 = wm.x; py2 = wm.y;
          energyHistory = []; E0 = getEnergy(x, y, vx, vy); e.preventDefault(); return;
        }
        if (panning) { offsetX = panning.ox + (p.x - panning.x); offsetY = panning.oy + (p.y - panning.y); return; }
        canvas.style.cursor = (perturbatore && perturberHit(p)) ? "grab" : "default";
        return;
      }
      // tocco
      var pts = touchList();
      if (gesture && pts.length >= 2) {
        var g = gestureState(pts);
        offsetX += g.midX - gesture.midX;
        offsetY += g.midY - gesture.midY;
        if (gesture.dist > 0) zoomAt(g.midX, g.midY, g.dist / gesture.dist);
        gesture = g; e.preventDefault(); return;
      }
      if (dragging && perturbatore) {
        var wt = toWorld(p.x, p.y); px2 = wt.x; py2 = wt.y;
        energyHistory = []; E0 = getEnergy(x, y, vx, vy); e.preventDefault(); return;
      }
      if (scrollLast) {
        var dy = e.clientY - scrollLast.y;
        window.scrollBy(0, -dy);
        scrollLast.y = e.clientY;
      }
    }

    function onPointerUp(e) {
      activePointers.delete(e.pointerId);
      if (e.pointerType === "mouse") {
        dragging = false; panning = null; canvas.style.cursor = "default";
        if (canvas.hasPointerCapture && canvas.hasPointerCapture(e.pointerId)) canvas.releasePointerCapture(e.pointerId);
        return;
      }
      var pts = touchList();
      if (pts.length < 2) gesture = null;
      if (pts.length <= 1) { dragging = false; scrollLast = null; } // evita salti passando da 2 a 1 dito
    }

    function onWheel(e) {
      e.preventDefault();
      var p = pointerPos(e);
      zoomAt(p.x, p.y, e.deltaY > 0 ? 0.92 : 1.08);
    }

    canvas.addEventListener("pointerdown", onPointerDown);
    canvas.addEventListener("pointermove", onPointerMove);
    canvas.addEventListener("pointerup", onPointerUp);
    canvas.addEventListener("pointercancel", onPointerUp);
    canvas.addEventListener("wheel", onWheel, { passive: false });

    window.addEventListener("resize", resize);
    if (window.ResizeObserver) {
      new ResizeObserver(resize).observe(wrap);
      new ResizeObserver(resize).observe(energyWrap);
    }

    // ---- avvio ----
    resize();
    R = +els.R.value; rho = +els.rho.value; r0 = +els.r0.value;
    els.v.value = getVc().toFixed(2);
    reset();
    requestAnimationFrame(frame);
  })();
</script>