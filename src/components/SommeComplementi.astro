    }[LANG];
    const L = D;

    // ── riferimenti DOM ──────────────────────────────────────────────
    const widthSel = root.querySelector('#scWidth');
    const decBox = root.querySelector('#scDec');
    const binBox = root.querySelector('#scBin');
    const decA = root.querySelector('#scDecA');
    const decB = root.querySelector('#scDecB');
    const rangeEl = root.querySelector('#scRange');
    const cellsA = root.querySelector('#scCellsA');
    const cellsB = root.querySelector('#scCellsB');
