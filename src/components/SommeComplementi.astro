    const quickEl = root.querySelector('#scQuick');
    const fullEl = root.querySelector('#scFull');

    // ── helper rendering ─────────────────────────────────────────────
    const RMOPTS = {
      throwOnError: false,
      delimiters: [
        { left: '\\(', right: '\\)', display: false },
        { left: '\\[', right: '\\]', display: true },
      ],
    };
    function kx(tex, display) {
      try { return katex.renderToString(tex, { throwOnError: false, displayMode: display !== false }); }
      catch (e) { return '<span style="color:#e55">[KaTeX error]</span>'; }
    }
    function renderInline(el) { try { renderMathInElement(el, RMOPTS); } catch (e) {} }
    function reveal(el) { el.hidden = false; el.style.display = 'block'; requestAnimationFrame(() => el.classList.add('sc-visible')); }
    function hide(el) { el.classList.remove('sc-visible'); el.style.display = 'none'; el.hidden = true; }
    function emit(target, html, tex) {
      if (html) { const d = document.createElement('div'); d.className = 'sc-text'; d.innerHTML = html; target.appendChild(d); renderInline(d); }
      if (tex) { const w = document.createElement('div'); w.className = 'sc-katex'; w.innerHTML = kx(tex); target.appendChild(w); }
    }
    function emitTip(target, html, warn) {
      const d = document.createElement('div'); d.className = 'sc-tip' + (warn ? ' sc-warn' : ''); d.innerHTML = html; target.appendChild(d); renderInline(d);
    }
    function heading(target, text, level) { const h = document.createElement(level || 'h5'); h.textContent = text; target.appendChild(h); }
    function block(target) { const b = document.createElement('div'); b.className = 'sc-octblock'; target.appendChild(b); return b; }
    function tip(msg) { statusEl.textContent = msg; statusEl.className = 'sc-status sc-error'; }
    function unTip() { statusEl.textContent = ''; statusEl.className = 'sc-status'; decA.classList.remove('sc-invalid'); decB.classList.remove('sc-invalid'); }
    function clearResults() { quickEl.innerHTML = ''; fullEl.innerHTML = ''; hide(quickEl); hide(fullEl); }
    const minus = (v) => String(v).replace('-', '−');

    // ============================================================= aritmetica sui bit
    // stringhe di '0'/'1', indice 0 = bit piu' a sinistra (bit di segno)
    const invert = (b) => b.split('').map((c) => (c === '0' ? '1' : '0')).join('');
    const uval = (b) => parseInt(b, 2);
    function addBits(a, b) {
      const n = a.length, sum = new Array(n), cin = new Array(n).fill(0);
      let c = 0;
      for (let j = n - 1; j >= 0; j--) {
        cin[j] = c;
        const s = +a[j] + +b[j] + c;
        sum[j] = String(s % 2);
        c = s >> 1;
      }
      return { sum: sum.join(''), cin, out: c };
    }
    const c2val = (b) => uval(b) - (b[0] === '1' ? 2 ** b.length : 0);
    const c1val = (b) => uval(b) - (b[0] === '1' ? 2 ** b.length - 1 : 0);
    const valOf = (sys, b) => (sys === 'c2' ? c2val(b) : c1val(b));
    const isNegZero = (sys, b) => sys === 'c1' && !b.includes('0');
    const absBits = (v, n) => Math.abs(v).toString(2).padStart(n, '0');

    // calcolo completo in un sistema; A, B: { bits, v, dec } (dec = valore decimale inserito o null)
    function computeSys(sys, n, A, B, sub) {
      const m = 2 ** (n - 1) - 1;
      const lo = sys === 'c2' ? -(m + 1) : -m;
      const one = '0'.repeat(n - 1) + '1';
      let Bp = B.bits, oppStep = null, special = false;
      if (sub) {
        const inv = invert(B.bits);
        if (sys === 'c2') { oppStep = addBits(inv, one); Bp = oppStep.sum; special = B.v === -(m + 1); }
        else Bp = inv;
      }
      const first = addBits(A.bits, Bp);
      let endStep = null, R = first.sum;
      if (sys === 'c1' && first.out) { endStep = addBits(first.sum, one); R = endStep.sum; }
      const t = sub ? A.v - B.v : A.v + B.v;
      const ov = t < lo || t > m;
      return {
        sys, n, m, lo, one, A, B, sub, Bp, inv: sub ? invert(B.bits) : null, oppStep, special,
        first, endStep, R, r: valOf(sys, R), t, ov,
      };
    }

    // ── LaTeX ────────────────────────────────────────────────────────
    const nibbles = (b) => b.match(/.{1,4}/g);
