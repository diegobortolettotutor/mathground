---
/**
 * SommeComplementi.astro — Risolutore di somma e sottrazione in complemento
 * a 2 e in complemento a 1, su 4, 8, 12 o 16 bit. Nativo, responsive,
 * bilingue (it/en).
 *
 * Dipendenze:  npm install katex
 *
 * Uso in una pagina .mdx di Starlight:
 *   import SommeComplementi from '@components/SommeComplementi.astro';
 *   <SommeComplementi />
 *
 * ── Inserimento ────────────────────────────────────────────────────────
 *   Due pulsanti a scelta esclusiva (grigio spento, giallo acceso, come in
 *   SimulatoreUrti) scelgono l'operazione (A + B, A - B) e altri due il modo
 *   di inserimento:
 *   - decimale: una casella per numero; i caratteri non ammessi vengono
 *     tolti mentre si scrive (solo cifre, con un eventuale + o - davanti);
 *   - binario: n caselle per numero, tutte a 0, come in Complementi.astro.
 *   I due modi conservano ciascuno i propri valori. Cambiando n, in binario
 *   si estende il segno (allargando) o si tengono i bit di destra (stringendo).
 *
 * ── Svolgimento: tutti e due i sistemi, uno dopo l'altro ───────────────
 *   1) dati e intervalli rappresentabili
 *   2) solo in decimale: |A| e |B| in binario con le divisioni successive
 *   3) complemento a 2 / 4) complemento a 1, ciascuno con:
 *      rappresentazione di A e B (in decimale: i negativi si complementano;
 *      in binario: lettura con segno dei bit), eventuale opposto di B,
 *      somma in colonna con i riporti, riporto in uscita scartato (C2) o
 *      risommato in coda (C1), controllo del traboccamento (regola dei segni;
 *      in C2 anche regola dei riporti), lettura del risultato e confronto col
 *      valore vero. Il traboccamento non blocca il calcolo: si mostra il
 *      risultato sbagliato e perche'.
 *   5) confronto fra i due sistemi in tabella
 *
 * ── Casi particolari (verificati in modo esaustivo su 4 e 8 bit) ───────
 *   - in C2, A - B con B = -2^(n-1): C2(B) = B e le regole dei segni e dei
 *     riporti applicate ad A + C2(B) sbagliano; il traboccamento si stabilisce
 *     dal valore vero (c'e' se e solo se A >= 0)
 *   - in C1 il riporto risommato in coda non genera mai un secondo riporto
 *   - in decimale, -2^(n-1) non e' rappresentabile in C1: quel sistema si salta
 */

import 'katex/dist/katex.min.css';

const lang = (Astro.currentLocale ?? 'it').toLowerCase().startsWith('en') ? 'en' : 'it';

const UI = {
  it: {
    step1: 'Step 1 — IMPOSTA L\'OPERAZIONE',
    bitsLabel: 'Numero di bit',
    opSum: 'A + B',
    opSub: 'A − B',
    step2: 'Step 2 — INSERISCI I NUMERI',
    modeDec: 'INSERISCI IN DECIMALE',
    modeBin: 'INSERISCI IN BINARIO',
    helpDec: 'Numeri interi, eventualmente con il segno + o − davanti: i caratteri non ammessi vengono tolti mentre si scrive.',
    helpBin: 'Toccare una casella per passare da 0 a 1 e viceversa; da tastiera si possono anche scrivere 0 e 1 e spostarsi con le frecce. Sopra ogni casella c\'è la posizione del bit.',
    btnReset: 'AZZERA VALORI',
    btnRandom: 'VALORI CASUALI',
    btnQuick: 'RISULTATO SINTETICO',
    btnStep: 'SVOLGIMENTO PASSO-PASSO',
  },
  en: {
    step1: 'Step 1 — SET THE OPERATION',
    bitsLabel: 'Number of bits',
    opSum: 'A + B',
    opSub: 'A − B',
    step2: 'Step 2 — ENTER THE NUMBERS',
    modeDec: 'ENTER IN DECIMAL',
    modeBin: 'ENTER IN BINARY',
    helpDec: 'Integers, optionally preceded by a + or − sign: characters that are not allowed are removed while typing.',
    helpBin: 'Tap a box to switch between 0 and 1; with a keyboard you can also type 0 and 1 and move with the arrow keys. The bit position is shown above each box.',
    btnReset: 'RESET VALUES',
    btnRandom: 'RANDOM VALUES',
    btnQuick: 'QUICK RESULT',
    btnStep: 'STEP-BY-STEP SOLUTION',
  },
}[lang];
---

<div class="sc-root" data-lang={lang}>
  <!-- Step 1: numero di bit e operazione -->
  <section class="sc-panel">
    <h3 class="sc-steplabel">{UI.step1}</h3>
    <div class="sc-widthrow">
      <label for="scWidth" class="sc-label">{UI.bitsLabel}</label>
      <select id="scWidth" class="sc-select">
        <option value="4">4</option>
        <option value="8" selected>8</option>
        <option value="12">12</option>
        <option value="16">16</option>
      </select>
    </div>
    <div class="sc-modes sc-ops" role="group">
      <button type="button" class="sc-mode-btn is-on" data-op="sum" aria-pressed="true">{UI.opSum}</button>
      <button type="button" class="sc-mode-btn" data-op="sub" aria-pressed="false">{UI.opSub}</button>
    </div>
  </section>

  <!-- Step 2: numeri -->
  <section class="sc-panel">
    <h3 class="sc-steplabel">{UI.step2}</h3>
    <div class="sc-modes sc-inmodes" role="group">
      <button type="button" class="sc-mode-btn is-on" data-mode="dec" aria-pressed="true">{UI.modeDec}</button>
      <button type="button" class="sc-mode-btn" data-mode="bin" aria-pressed="false">{UI.modeBin}</button>
    </div>

    <div id="scDec" class="sc-decbox">
      <div class="sc-decfields">
        <div class="sc-decfield">
          <label for="scDecA" class="sc-label">A</label>
          <input id="scDecA" class="sc-input" type="text" inputmode="numeric" autocomplete="off" spellcheck="false" placeholder="45" />
        </div>
        <div class="sc-decfield">
          <label for="scDecB" class="sc-label">B</label>
          <input id="scDecB" class="sc-input" type="text" inputmode="numeric" autocomplete="off" spellcheck="false" placeholder="-23" />
        </div>
      </div>
      <div class="sc-help"><p>{UI.helpDec}</p><p id="scRange"></p></div>
    </div>

    <div id="scBin" class="sc-binbox" hidden>
      <div class="sc-numrow"><span class="sc-rowname">A</span><div id="scCellsA" class="sc-cells"></div></div>
      <div class="sc-numrow"><span class="sc-rowname">B</span><div id="scCellsB" class="sc-cells"></div></div>
      <div class="sc-help"><p>{UI.helpBin}</p></div>
    </div>

    <div id="scStatus" class="sc-status" role="alert" aria-live="polite"></div>
  </section>

  <!-- Azioni -->
  <div class="sc-actions">
    <button id="scBtnReset" class="sc-btn sc-btn-ghost" type="button">{UI.btnReset}</button>
    <button id="scBtnRandom" class="sc-btn sc-btn-ghost" type="button">{UI.btnRandom}</button>
    <button id="scBtnQuick" class="sc-btn sc-btn-ghost" type="button">{UI.btnQuick}</button>
  </div>
  <div class="sc-secondary">
    <button id="scBtnStep" class="sc-btn sc-btn-ghost sc-btn-wide" type="button">{UI.btnStep}</button>
  </div>

  <!-- Output -->
  <section id="scQuick" class="sc-result" hidden></section>
  <section id="scFull" class="sc-result" hidden></section>
</div>
<style is:global>
  .sc-root {
    --sc-radius: 12px;
    --sc-surface: var(--sl-color-gray-6, #1a1a1a);
    --sc-border: var(--sl-color-gray-5, #383838);
    --sc-accent: var(--sl-color-accent, #4f7cff);
    --sc-red: #d11111;
    --sc-green: #1f9d55;
    --sc-yellow: #ffcc44;
    --sc-accent-hi: var(--sl-color-accent-high, #b8c8ff);
    --sc-faint: var(--sl-color-gray-3, #888);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--sl-color-text, inherit);
    width: 100%;
    min-width: 330px;
    margin: 1.5rem 0;
    text-align: center;
  }
  .sc-root *,
  .sc-root *::before,
  .sc-root *::after { box-sizing: border-box; }

  /* reset difensivo contro il margin-top che Starlight inietta sugli elementi
     "fratelli" dentro il contenuto markdown (stesso fix degli altri risolutori) */
  .sc-root[data-lang] .sc-widthrow,
  .sc-root[data-lang] .sc-label,
  .sc-root[data-lang] .sc-select,
  .sc-root[data-lang] .sc-mode-btn,
  .sc-root[data-lang] .sc-decfields,
  .sc-root[data-lang] .sc-decfield,
  .sc-root[data-lang] .sc-input,
  .sc-root[data-lang] .sc-numrow,
  .sc-root[data-lang] .sc-rowname,
  .sc-root[data-lang] .sc-cells,
  .sc-root[data-lang] .sc-nibble,
  .sc-root[data-lang] .sc-cellwrap,
  .sc-root[data-lang] .sc-pos,
  .sc-root[data-lang] .sc-bit,
  .sc-root[data-lang] .sc-help,
  .sc-root[data-lang] .sc-booktable,
  .sc-root[data-lang] .sc-booktable th,
  .sc-root[data-lang] .sc-booktable td,
  .sc-root[data-lang] .sc-remainder-box,
  .sc-root[data-lang] .sc-readarrow,
  .sc-root[data-lang] .sc-readarrow-head,
  .sc-root[data-lang] .sc-fig {
    margin: 0 !important;
  }

  .sc-panel {
    background: var(--sc-surface);
    border: 1px solid var(--sc-border);
    border-radius: var(--sc-radius);
    padding: 1.25rem 1rem;
    margin: 1.25rem 0;
  }
  .sc-steplabel {
    margin: 0 0 1rem;
    font-size: clamp(0.85rem, 2.4vw, 1rem);
    letter-spacing: 0.02em;
    color: var(--sl-color-text-accent, var(--sc-accent-hi));
  }

  .sc-widthrow { display: flex; align-items: center; justify-content: center; gap: 0.9rem; flex-wrap: wrap; }
  .sc-label { font-size: 0.95rem; color: var(--sl-color-text-accent, var(--sc-accent-hi)); }
  .sc-select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background-color: var(--sl-color-bg, #000);
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path d='M1 1l4 4 4-4' stroke='%23888' stroke-width='1.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-repeat: no-repeat;
    background-position: right 0.75rem center;
    background-size: 10px 6px;
    color: var(--sl-color-text, #fff);
    border: 1.5px solid var(--sc-border);
    border-radius: 6px;
    padding: 0.5rem 2rem 0.5rem 0.9rem;
    font: inherit;
    line-height: 1.5rem;
    cursor: pointer;
  }
  .sc-select:hover, .sc-select:focus { border-color: var(--sc-accent); outline: none; }

  /* pulsanti a scelta esclusiva: grigi spenti, gialli accesi (come SimulatoreUrti) */
  .sc-modes { display: flex; gap: 0.6rem; max-width: 32rem; margin: 1rem auto 0 !important; }
  .sc-inmodes { margin: 0 auto 1.1rem !important; }
  .sc-mode-btn {
    flex: 1 1 0;
    font: inherit; font-size: 0.9rem; font-weight: 600;
    padding: 0.6rem 0.7rem;
    border-radius: 8px;
    border: 1px solid var(--sc-border);
    background: var(--sl-color-bg, #fff);
    color: var(--sc-faint);
    cursor: pointer; text-align: center;
    transition: background 0.12s, border-color 0.12s, color 0.12s;
  }
  .sc-mode-btn:hover { border-color: var(--sc-faint); color: var(--sl-color-text, inherit); }
  .sc-mode-btn.is-on {
    background: var(--sc-yellow);
    border-color: var(--sc-yellow);
    color: #3a2f00;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
  }
  .sc-mode-btn.is-on:hover { border-color: var(--sc-yellow); color: #3a2f00; }

  /* inserimento in decimale */
  .sc-decfields { display: flex; justify-content: center; gap: 1rem 2rem; flex-wrap: wrap; }
  .sc-decfield { display: flex; align-items: center; gap: 0.6rem; }
  .sc-input {
    background: var(--sl-color-bg, #000);
    color: var(--sl-color-text, #fff);
    border: 1.5px solid var(--sc-border);
    border-radius: 6px;
    text-align: center;
    padding: 0.45rem 0.6rem;
    font: inherit;
    line-height: 1.5rem;
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
    width: 9rem;
  }
  .sc-input:hover, .sc-input:focus { border-color: var(--sc-accent); outline: none; }
  .sc-input.sc-invalid { border-color: var(--sc-red); }

  /* inserimento in binario */
  .sc-numrow { display: flex; align-items: flex-end; justify-content: center; gap: 0.7rem; }
  .sc-root[data-lang] .sc-numrow + .sc-numrow { margin-top: 1.1rem !important; }
  .sc-rowname { font-weight: 700; color: var(--sl-color-text-accent, var(--sc-accent-hi)); width: 1.2rem; padding-bottom: 0.55rem; }
  .sc-cells { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 0.9rem; }
  .sc-nibble { display: flex; gap: 0.25rem; }
  .sc-cellwrap { display: flex; flex-direction: column; align-items: center; gap: 0.15rem; }
  .sc-pos { font-size: 0.7rem; line-height: 1; color: var(--sc-faint); font-family: var(--__sl-font-mono, ui-monospace, monospace); }
  .sc-bit {
    width: 2.2rem; height: 2.4rem; padding: 0;
    border: 1.5px solid var(--sc-border); border-radius: 6px;
    background: var(--sl-color-bg, #000); color: var(--sl-color-text, #fff);
    font-family: var(--__sl-font-mono, ui-monospace, monospace); font-size: 1.2rem; font-weight: 700;
    cursor: pointer;
  }
  .sc-bit[data-v="1"] { border-color: var(--sc-accent); background: color-mix(in srgb, var(--sc-accent) 18%, var(--sl-color-bg, #000)); }
  .sc-bit:hover, .sc-bit:focus-visible { border-color: var(--sc-accent); outline: none; }

  .sc-help { font-size: 0.82rem; color: var(--sc-faint); }
  .sc-root[data-lang] .sc-help { margin-top: 1rem !important; }
  .sc-help p { margin: 0.25rem 0; }
  .sc-status { margin: 0.6rem 0 0; font-size: 0.95rem; }
  .sc-status.sc-error {
    padding: 0.6rem 0.8rem; text-align: left;
    border-left: 4px solid var(--sc-red);
    background: color-mix(in srgb, var(--sc-red) 8%, transparent);
    border-radius: 4px;
  }

  /* pulsanti: riga da tre e pulsante largo con la stessa larghezza massima */
  .sc-actions {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem; align-items: stretch; margin: 1.25rem auto; max-width: 48rem;
  }
  .sc-actions .sc-btn {
    box-sizing: border-box; width: 100%; margin: 0;
    height: 3.6rem; padding: 0 1rem; line-height: 1.2;
    display: inline-flex; align-items: center; justify-content: center; text-align: center;
  }
  .sc-secondary { max-width: 48rem; margin: 1.25rem auto 0; }
  .sc-btn {
    font: inherit; font-weight: 600; cursor: pointer;
    border-radius: 999px; padding: 0.7rem 1.4rem; border: 1.5px solid transparent;
    transition: transform 0.1s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .sc-btn:active { transform: scale(0.96); }
  .sc-btn-ghost { background: transparent; color: var(--sl-color-text, inherit); border-color: var(--sc-border); }
  .sc-btn-ghost:hover { border-color: var(--sc-accent); color: var(--sc-accent); }
  .sc-btn-wide { padding: 0.9rem 1.4rem; width: 100%; margin: 0 0 1rem; }

  /* output */
  .sc-result {
    background: var(--sc-surface); border: 1px solid var(--sc-border);
    border-radius: var(--sc-radius); margin-top: 1.5rem; padding: 1.5rem 1rem;
    opacity: 0; transition: opacity 0.3s ease; text-align: left;
  }
  .sc-result.sc-visible { opacity: 1; }
  .sc-result h2 { text-align: center; }
  .sc-result h4 {
    margin: 2.75rem 0 0.5rem; padding-top: 1rem;
    border-top: 2px solid var(--sc-border);
    font-size: 1.05rem; color: var(--sl-color-text-accent, var(--sc-accent-hi));
  }
  .sc-result h5 {
    margin: 2rem 0 0.8rem; padding-top: 0.5rem;
    font-size: 0.95rem; letter-spacing: 0.03em; color: var(--sl-color-text-accent, var(--sc-accent-hi));
  }
  .sc-result h5:first-child { margin-top: 0; padding-top: 0; }
  .sc-text p { margin: 0.7rem 0; }
  .sc-tip {
    background: var(--sl-color-gray-6, rgba(255,255,255,0.04));
    border-left: 4px solid var(--sc-accent);
    border-radius: 6px; padding: 0.9rem 1rem; margin: 1.25rem 0;
  }
  .sc-warn { border-left-color: var(--sc-red); }
  .sc-katex { overflow-x: auto; overflow-y: hidden; padding: 0.75rem 0.25rem; margin: 1.25rem 0; }
  .sc-katex .katex-display { margin: 0; }
  .sc-red-strong { color: var(--sc-red); }
  .sc-octblock { border-top: 1px dashed var(--sc-border); margin-top: 1.25rem; padding-top: 0.5rem; }

  /* ----- figure con le righe di bit (SVG), come in Complementi ----- */
  .sc-figwrap { overflow-x: auto; margin: 1.5rem 0; padding: 0.25rem 0; }
  .sc-fig { display: block; height: auto; margin: 0 auto !important; max-width: none; }
  .sc-fig .sc-c { fill: var(--sl-color-bg, #fff); stroke: var(--sl-color-gray-4, #888); stroke-width: 0.8; }
  .sc-fig .sc-cfill { fill: color-mix(in srgb, var(--sl-color-gray-5, #888) 45%, var(--sl-color-bg, #fff)); stroke: var(--sl-color-gray-4, #888); stroke-width: 0.8; stroke-dasharray: 2 2; }
  .sc-fig text { fill: var(--sl-color-text, #222); font-family: var(--__sl-font-mono, ui-monospace, monospace); }
  .sc-fig .sc-bit-t { font-size: 15px; font-weight: 700; }
  .sc-fig .sc-red-t { fill: var(--sc-red); }
  .sc-fig .sc-faint-t { fill: var(--sc-faint); }
  .sc-fig .sc-carry-t { font-size: 11px; font-weight: 700; fill: var(--sc-red); }
  .sc-fig .sc-rowlabel { font-family: var(--sl-font, sans-serif); font-size: 13px; font-weight: 600; }
  .sc-fig .sc-small { font-family: var(--sl-font, sans-serif); font-size: 11px; fill: var(--sc-faint); }
  .sc-fig .sc-rule { stroke: var(--sl-color-text, #222); stroke-width: 1.5; }
  .sc-fig .sc-arrow { stroke: var(--sc-faint); stroke-width: 1.2; fill: none; }
  .sc-fig .sc-cross { fill: none; stroke: var(--sl-color-gray-3, #888); stroke-width: 1.4; stroke-linecap: round; }

  /* ----- tabelle in stile "libro" ----- */
  .sc-tablewrap { display: flex; justify-content: safe center; overflow-x: auto; margin: 1.5rem 0 !important; padding: 0.25rem; }
  .sc-booktable { border-collapse: collapse; margin: 0 auto; font-size: 0.92rem; }
  .sc-tablewrap > .sc-booktable { flex: none; }
  .sc-booktable th, .sc-booktable td { border: none; padding: 0.3rem 0.5rem; text-align: center; white-space: nowrap; }
  .sc-booktable td { font-family: var(--__sl-font-mono, ui-monospace, monospace); }
  .sc-booktable thead tr { border-top: 1.5px solid var(--sl-color-text, currentColor); border-bottom: 1.5px solid var(--sl-color-text, currentColor); }
  .sc-booktable th { font-weight: 700; line-height: 1.25; color: var(--sl-color-text-accent, var(--sc-accent-hi)); padding-top: 0.45rem; padding-bottom: 0.45rem; }
  .sc-booktable tbody tr:last-child { border-bottom: 1.5px solid var(--sl-color-text, currentColor); }
  .sc-booktable tbody tr:nth-child(even) { background: color-mix(in srgb, var(--sl-color-gray-5, #888) 32%, transparent); }
  .sc-booktable td.sc-rowhead { font-family: var(--sl-font, system-ui, sans-serif); font-weight: 600; text-align: left; }
  .sc-booktable td.sc-bad { color: var(--sc-red); font-weight: 700; }
  .sc-booktable .sc-octets { display: inline-block; text-align: left; line-height: 1.35; }
  /* tabella delle divisioni successive con freccia di lettura (da BaseConverter) */
  .sc-divtable td.sc-remainder { font-weight: 700; }
  .sc-remainder-box { display: inline-flex; align-items: center; justify-content: center; min-width: 1.5rem; height: 1.5rem; padding: 0 0.25rem; border: 2px solid var(--sl-color-text, #111); border-radius: 4px; }
  .sc-divtable td.sc-readarrow-cell { border: none; padding: 0 0.6rem; vertical-align: middle; position: relative; }
  .sc-readarrow { position: relative; width: 3px; margin: 0 auto; background: var(--sc-red); }
  .sc-readarrow-head { position: absolute; top: -4px; left: 50%; width: 0; height: 0; }
  .sc-readarrow-head::before, .sc-readarrow-head::after {
    content: ''; position: absolute; left: 0; top: 0; width: 3px; height: 10px;
    background: var(--sc-red); border-radius: 1.5px; transform-origin: top center;
  }
  .sc-readarrow-head::before { transform: translateX(-50%) rotate(-24deg); }
  .sc-readarrow-head::after { transform: translateX(-50%) rotate(24deg); }

  @media (max-width: 600px) {
    .sc-root { font-size: 0.95rem; }
    .sc-actions { grid-template-columns: 1fr; }
    .sc-actions .sc-btn, .sc-btn-wide { width: 100%; }
    .sc-result { padding: 1rem 0.5rem; }
    .sc-bit { width: 1.8rem; height: 2.15rem; font-size: 1.05rem; }
    .sc-nibble { gap: 0.2rem; }
    .sc-cells { gap: 0.5rem 0.7rem; }
    .sc-numrow { gap: 0.4rem; }
    .sc-mode-btn { font-size: 0.85rem; }
  }
</style>
<script>
  import katex from 'katex';
  import renderMathInElement from 'katex/contrib/auto-render';

  document.querySelectorAll('.sc-root').forEach((root) => initSomme(root));

  function initSomme(root) {
    const LANG = (root.dataset.lang || document.documentElement.lang || 'it')
      .toLowerCase().startsWith('en') ? 'en' : 'it';

    const RED = '#d11111';

    // ============================================================= i18n
    const D = {
      it: {
        titleQuick: 'Risultato sintetico',
        titleStep: 'Svolgimento passo-passo',
        sysName: { c2: 'complemento a 2', c1: 'complemento a 1' },
        sysTitle: { c2: 'Complemento a 2', c1: 'Complemento a 1' },
        sysRow: { c2: 'Complemento a 2', c1: 'Complemento a 1' },
