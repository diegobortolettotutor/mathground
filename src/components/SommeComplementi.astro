        else { sym.push(`-(2^{${n - 1}}-1)`); num.push(`-${2 ** (n - 1) - 1}`); }
      }
      for (let j = 1; j < n; j++) if (b[j] === '1') { sym.push(`2^{${n - 1 - j}}`); num.push(String(2 ** (n - 1 - j))); }
      if (!sym.length) return `${name} = ${texBits(b)} = 0`;
      const join = (arr) => arr.map((t, i) => (i === 0 ? t : (t.startsWith('-') ? ` ${t}` : ` + ${t}`))).join('');
      const head = `${name} = ${texBits(b)} = ${join(sym)} = ${join(num)}`;
      return sym.length === 1 ? head : `${head} = ${valOf(sys, b)}`;
    }

    // ============================================================= figure SVG (come in Complementi)
    const FG = { cell: 24, gap: 10, label: 104, pad: 12 };
    const fx = (j) => FG.label + (j + 1) * FG.cell + (j >= 0 ? (Math.floor(j / 4) + 1) * FG.gap : 0);
    const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    function labelSvg(t) {
      return esc(t).replace(/C([12])/g, 'C<tspan dy="4" font-size="9.5">$1</tspan><tspan dy="-4">\u200A</tspan>');
    }
    function txt(x, y, s, cls, anchor) {
      return `<text x="${x}" y="${y}" class="${cls}" text-anchor="${anchor || 'middle'}" dominant-baseline="central">${s}</text>`;
    }
    // items: { type:'bits', label, bits, red?:bool, out?:'1', outMode?:'discard'|'back' }
    //        { type:'carries', cin, out }  { type:'arrows' }  { type:'rule' }
    function buildFigure(n, items, aria) {
      const C = FG.cell;
      const out = [], ys = [];
      let y = 6;
      items.forEach((it) => {
        ys.push(y);
        y += it.type === 'bits' ? C + 8 : it.type === 'carries' ? 16 : it.type === 'arrows' ? 18 : 10;
      });
      const hasNote = items.some((it) => it.type === 'bits' && it.out !== undefined);
      const H = y + (hasNote ? 14 : 0);
      const W = fx(n - 1) + C + FG.pad;
      items.forEach((it, i) => {
        const y0 = ys[i];
        if (it.type === 'bits') {
          out.push(`<text x="${FG.label - 10}" y="${y0 + C / 2}" class="sc-rowlabel" text-anchor="end" dominant-baseline="central">${labelSvg(it.label)}</text>`);
          for (let j = 0; j < n; j++) {
            out.push(`<rect x="${fx(j)}" y="${y0}" width="${C}" height="${C}" class="sc-c"/>`);
            out.push(txt(fx(j) + C / 2, y0 + C / 2 + 0.5, it.bits[j], it.red ? 'sc-bit-t sc-red-t' : 'sc-bit-t'));
          }
          if (it.out !== undefined) {
            out.push(`<rect x="${fx(-1)}" y="${y0}" width="${C}" height="${C}" class="sc-cfill"/>`);
            out.push(txt(fx(-1) + C / 2, y0 + C / 2 + 0.5, it.out, it.outMode === 'back' ? 'sc-bit-t sc-red-t' : 'sc-bit-t sc-faint-t'));
            if (it.outMode === 'discard') {
              const x0 = fx(-1) + 3, yy = y0 + 3, s = C - 6;
              out.push(`<path d="M ${x0} ${yy} L ${x0 + s} ${yy + s} M ${x0} ${yy + s} L ${x0 + s} ${yy}" class="sc-cross"/>`);
            }
            out.push(txt(fx(-1) + C / 2, y0 + C + 9, it.outMode === 'discard' ? L.figDiscard : L.figBack, 'sc-small'));
          }
        } else if (it.type === 'carries') {
          if (it.out || it.cin.some((c) => c)) out.push(`<text x="${FG.label - 10}" y="${y0 + 7}" class="sc-small" text-anchor="end" dominant-baseline="central">${esc(L.figCarry)}</text>`);
          for (let j = 0; j < n; j++) if (it.cin[j]) out.push(txt(fx(j) + C / 2, y0 + 7, '1', 'sc-carry-t'));
          if (it.out) out.push(txt(fx(-1) + C / 2, y0 + 7, '1', 'sc-carry-t'));
        } else if (it.type === 'arrows') {
          for (let j = 0; j < n; j++) {
            const cx = fx(j) + C / 2;
            out.push(`<path d="M ${cx} ${y0 - 4} V ${y0 + 12} M ${cx - 3.5} ${y0 + 8} L ${cx} ${y0 + 12} L ${cx + 3.5} ${y0 + 8}" class="sc-arrow"/>`);
          }
        } else if (it.type === 'rule') {
          out.push(`<line x1="${fx(-1)}" y1="${y0 + 1}" x2="${fx(n - 1) + C}" y2="${y0 + 1}" class="sc-rule"/>`);
        }
      });
      const wrap = document.createElement('div');
      wrap.className = 'sc-figwrap';
      wrap.innerHTML = `<svg class="sc-fig" viewBox="0 0 ${W} ${H}" width="${W}" role="img" aria-label="${esc(aria)}" xmlns="http://www.w3.org/2000/svg">${out.join('')}</svg>`;
      return wrap;
    }
    // inversione (e, in C2, somma di 1): da "src" a "dst"
    function complementFigure(sys, n, srcLabel, srcBits, midLabel, dstLabel, step) {
      if (sys === 'c1') {
        return buildFigure(n, [
          { type: 'bits', label: srcLabel, bits: srcBits },
          { type: 'arrows' },
          { type: 'bits', label: dstLabel, bits: invert(srcBits), red: true },
        ], `${srcLabel} → ${dstLabel}`);
      }
      return buildFigure(n, [
        { type: 'bits', label: srcLabel, bits: srcBits },
        { type: 'arrows' },
        { type: 'carries', cin: step.cin, out: step.out },
        { type: 'bits', label: midLabel, bits: invert(srcBits), red: true },
        { type: 'bits', label: '+ 1', bits: '0'.repeat(n - 1) + '1' },
        { type: 'rule' },
        step.out ? { type: 'bits', label: dstLabel, bits: step.sum, out: '1', outMode: 'discard' } : { type: 'bits', label: dstLabel, bits: step.sum },
      ], `${srcLabel} → ${dstLabel}`);
    }

    // ── divisioni successive (da IPNetmask / BaseConverter) ──────────
    function buildDivisionTable(rows) {
      const wrap = document.createElement('div');
      wrap.className = 'sc-tablewrap';
      const table = document.createElement('table');
      table.className = 'sc-booktable sc-divtable';
      table.innerHTML = `<thead><tr><th>${L.bTableHead.div}</th><th></th><th>${L.bTableHead.quo}</th><th>${L.bTableHead.rem}</th><th></th></tr></thead>`;
      const tbody = document.createElement('tbody');
      rows.forEach((r, idx) => {
        const tr = document.createElement('tr');
        tr.innerHTML = `<td>${r.dividend}</td><td>${kx('\\div 2 \\;=\\;', false)}</td><td>${r.quotient}</td><td class="sc-remainder"><span class="sc-remainder-box">${r.remainder}</span></td>`;
        if (idx === 0) {
          const td = document.createElement('td');
          td.className = 'sc-readarrow-cell';
          td.rowSpan = rows.length;
          td.innerHTML = '<div class="sc-readarrow"><div class="sc-readarrow-head"></div></div>';
          tr.appendChild(td);
        }
        tbody.appendChild(tr);
      });
      table.appendChild(tbody);
      wrap.appendChild(table);
      return wrap;
    }
    function renderDivisions(target, v, n) {
      const rows = [];
      let q = v;
      while (q > 0) { rows.push({ dividend: q, quotient: Math.floor(q / 2), remainder: q % 2 }); q = Math.floor(q / 2); }
      const raw = rows.map((r) => r.remainder).reverse().join('');
      target.appendChild(buildDivisionTable(rows));
      const pad = n - raw.length;
      const padTex = pad > 0 ? `\\textcolor{#8a8a8a}{\\texttt{${'0'.repeat(pad)}}}` : '';
      emit(target, pad > 0 ? L.bRead : L.bReadFull,
        `${v}_{10} \\;\\Longrightarrow\\; \\texttt{${raw}}_{2}` + (pad > 0 ? ` \\;\\Longrightarrow\\; {${padTex}\\texttt{${raw}}}_{2}` : ''));
    }
    const READARROW_INSET = 18;
    function fitReadArrows(tries) {
      tries = tries || 0;
      requestAnimationFrame(() => {
        const cells = root.querySelectorAll('.sc-readarrow-cell');
        if (!cells.length) return;
        let pending = false;
        cells.forEach((cell) => {
          const line = cell.querySelector('.sc-readarrow');
          const h = cell.getBoundingClientRect().height;
          if (h <= 0) { pending = true; return; }
          line.style.height = Math.max(0, h - READARROW_INSET) + 'px';
          const rowsCount = parseInt(cell.getAttribute('rowspan'), 10) || 1;
          const rowH = h / rowsCount;
          const table = cell.closest('table');
          const evenRow = table ? table.querySelector('tbody tr:nth-child(2)') : null;
          const tint = evenRow ? getComputedStyle(evenRow).backgroundColor : 'transparent';
          cell.style.backgroundImage = `repeating-linear-gradient(to bottom, transparent 0px, transparent ${rowH}px, ${tint} ${rowH}px, ${tint} ${2 * rowH}px)`;
        });
        if (pending && tries < 12) fitReadArrows(tries + 1);
      });
    }

    // ============================================================= svolgimento di un sistema
    function renderSystem(t, S, mode) {
      const { sys, n, m, A, B, sub } = S;
      const sysN = L.sysName[sys];
      const Cs = sys === 'c2' ? 'C2' : 'C1';
      heading(t, L.sysTitle[sys], 'h4');

      // rappresentazione
      heading(t, L.repr);
      if (mode === 'dec') {
        [['A', A], ['B', B]].forEach(([w, X]) => {
          const blk = block(t);
          if (X.v >= 0) { emit(blk, L.reprPos(w, X.v, texBits(X.bits), sysN)); return; }
          const abs = absBits(X.v, n);
          if (sys === 'c2') {
            emit(blk, X.v === -(m + 1) ? L.reprMinC2(w, X.v) : L.reprNegC2(w, X.v));
            blk.appendChild(complementFigure('c2', n, `|${w}|`, abs, `C1(|${w}|)`, w, addBits(invert(abs), S.one)));
          } else {
            emit(blk, L.reprNegC1(w, X.v));
            blk.appendChild(complementFigure('c1', n, `|${w}|`, abs, null, w));
          }
          emit(blk, '', `${w} = ${texBits(X.bits)}`);
        });
      } else {
        emit(t, L.readBin(sysN), `\\begin{aligned} ${signedTex('A', A.bits, sys).replace(' = ', ' &= ')} \\\\ ${signedTex('B', B.bits, sys).replace(' = ', ' &= ')} \\end{aligned}`);
      }

      // opposto di B
      if (sub) {
        heading(t, L.opp);
        emit(t, sys === 'c2' ? L.oppC2 : L.oppC1);
        t.appendChild(complementFigure(sys, n, 'B', B.bits, 'C1(B)', '−B', S.oppStep));
        emit(t, '', `-B = ${texBits(S.Bp)}`);
        if (S.special) emitTip(t, L.oppMin(B.v), true);
      }

      // somma in colonna
      heading(t, L.sum);
      emit(t, sys === 'c2' ? L.sumC2 : L.sumC1);
      const secondLabel = sub ? '+ (−B)' : '+ B';
      const resLabel = sub ? 'A − B' : 'A + B';
      const f = S.first;
      const lastRow = { type: 'bits', label: S.endStep ? L.figPartial : resLabel, bits: f.sum };
      if (f.out) { lastRow.out = '1'; lastRow.outMode = sys === 'c2' ? 'discard' : 'back'; }
      t.appendChild(buildFigure(n, [
        { type: 'carries', cin: f.cin, out: f.out },
        { type: 'bits', label: 'A', bits: A.bits },
        { type: 'bits', label: secondLabel, bits: S.Bp },
        { type: 'rule' },
        lastRow,
      ], `A ${sub ? '−' : '+'} B`));
      if (!f.out) emit(t, L.noCarryOut);
      else if (sys === 'c2') emit(t, L.discarded);
      else {
        emit(t, L.endAround);
        t.appendChild(buildFigure(n, [
          { type: 'carries', cin: S.endStep.cin, out: S.endStep.out },
          { type: 'bits', label: L.figPartial, bits: f.sum },
          { type: 'bits', label: L.figPlusCarry, bits: S.one },
          { type: 'rule' },
          { type: 'bits', label: resLabel, bits: S.R },
        ], resLabel));
      }

      // traboccamento
      heading(t, L.ovf);
      const second = sub ? '\\( -B \\)' : '\\( B \\)';
      if (S.special) emit(t, L.specialOvf(A.v >= 0, m));
      else {
        emit(t, L.signRule(A.bits[0], S.Bp[0], S.R[0], second));
        if (sys === 'c2') emit(t, L.carryRule(f.cin[0], f.out));
      }

      // risultato
      heading(t, L.res);
      const name = sub ? 'A - B' : 'A + B';
      emit(t, L.resRead(sysN), signedTex(name, S.R, sys));
      const bT = B.v < 0 ? `(${B.v})` : `${B.v}`;
      const tTex = `${A.v} ${sub ? '-' : '+'} ${bT} = ${S.t}`;
      if (S.ov) emitTip(t, L.resBad(tTex, S.r, S.lo, m, n), true);
      else {
        if (isNegZero(sys, S.R)) emit(t, L.resNegZero);
        emit(t, L.resOk(tTex));
      }
    }

    // tabella di confronto; con 12 e 16 bit i bit vanno su righe da 8, cosi' la tabella resta larga come a 8 bit
    const cellBits = (b) => `<span class="sc-octets">${b.match(/.{1,8}/g).map(plainBits).join('<br>')}</span>`;
    function buildComparison(systems) {
      const wrap = document.createElement('div');
      wrap.className = 'sc-tablewrap';
      const table = document.createElement('table');
      table.className = 'sc-booktable';
      table.innerHTML = `<thead><tr>${L.cmpHead.map((h) => `<th>${h}</th>`).join('')}</tr></thead>`;
      const tbody = document.createElement('tbody');
      systems.forEach((S) => {
        const tr = document.createElement('tr');
        if (S.skip) {
          tr.innerHTML = `<td class="sc-rowhead">${L.sysRow[S.sys]}</td><td colspan="6">${L.na}</td>`;
        } else {
          const read = isNegZero(S.sys, S.R) ? '−0' : minus(S.r);
          tr.innerHTML = `<td class="sc-rowhead">${L.sysRow[S.sys]}</td><td>${cellBits(S.A.bits)}</td><td>${cellBits(S.Bp)}</td>`
            + `<td>${cellBits(S.R)}</td><td class="${S.ov ? 'sc-bad' : ''}">${read}</td><td>${minus(S.t)}</td>`
            + `<td class="${S.ov ? 'sc-bad' : ''}">${S.ov ? L.yes : L.no}</td>`;
        }
        tbody.appendChild(tr);
      });
      table.appendChild(tbody);
      wrap.appendChild(table);
      return wrap;
    }

    // ============================================================= stato e interazioni
    let width = parseInt(widthSel.value, 10);
    let op = 'sum';
    let mode = 'dec';
    let bitsA = '0'.repeat(width), bitsB = '0'.repeat(width);
    let scRandomUsed = false;

    function updateRangeHelp() { rangeEl.textContent = L.rangeHelp(width, 2 ** (width - 1) - 1); }

    function setExclusive(group, attr, value) {
      group.querySelectorAll('.sc-mode-btn').forEach((b) => {
        const on = b.dataset[attr] === value;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    }
    root.querySelector('.sc-ops').addEventListener('click', (e) => {
      const b = e.target.closest('.sc-mode-btn'); if (!b) return;
      op = b.dataset.op; setExclusive(root.querySelector('.sc-ops'), 'op', op); clearResults(); unTip();
    });
    root.querySelector('.sc-inmodes').addEventListener('click', (e) => {
      const b = e.target.closest('.sc-mode-btn'); if (!b) return;
      mode = b.dataset.mode; setExclusive(root.querySelector('.sc-inmodes'), 'mode', mode);
      decBox.hidden = mode !== 'dec'; binBox.hidden = mode !== 'bin';
      clearResults(); unTip();
    });

    // celle binarie
    function drawCells(el, which) {
      el.innerHTML = '';
      for (let g = 0; g < width / 4; g++) {
        const nib = document.createElement('div');
        nib.className = 'sc-nibble';
        for (let k = 0; k < 4; k++) {
          const j = 4 * g + k;
          const wrap = document.createElement('div');
          wrap.className = 'sc-cellwrap';
          wrap.innerHTML = `<span class="sc-pos">${width - 1 - j}</span><button type="button" class="sc-bit" data-w="${which}" data-j="${j}"></button>`;
          nib.appendChild(wrap);
        }
        el.appendChild(nib);
      }
    }
    function refreshCells() {
      root.querySelectorAll('.sc-bit').forEach((b) => {
        const bits = b.dataset.w === 'A' ? bitsA : bitsB;
        const j = +b.dataset.j;
        b.textContent = bits[j]; b.dataset.v = bits[j];
        b.setAttribute('aria-label', `${b.dataset.w}, bit ${width - 1 - j}: ${bits[j]}`);
      });
    }
    function drawAllCells() { drawCells(cellsA, 'A'); drawCells(cellsB, 'B'); refreshCells(); }
    function setBit(w, j, v) {
      if (w === 'A') bitsA = bitsA.slice(0, j) + v + bitsA.slice(j + 1);
      else bitsB = bitsB.slice(0, j) + v + bitsB.slice(j + 1);
      refreshCells(); clearResults(); unTip(); scRandomUsed = false;
    }
    const cellAt = (w, j) => root.querySelector(`.sc-bit[data-w="${w}"][data-j="${j}"]`);
    binBox.addEventListener('click', (e) => {
      const b = e.target.closest('.sc-bit'); if (!b) return;
      const w = b.dataset.w, j = +b.dataset.j, cur = (w === 'A' ? bitsA : bitsB)[j];
      setBit(w, j, cur === '0' ? '1' : '0');
    });
    binBox.addEventListener('keydown', (e) => {
      const b = e.target.closest('.sc-bit'); if (!b) return;
      const w = b.dataset.w, j = +b.dataset.j;
      const next = () => (j < width - 1 ? cellAt(w, j + 1) : (w === 'A' ? cellAt('B', 0) : null));
      if (e.key === '0' || e.key === '1') { e.preventDefault(); setBit(w, j, e.key); const nx = next(); if (nx) nx.focus(); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); const nx = next(); if (nx) nx.focus(); }
      else if (e.key === 'ArrowLeft' && j > 0) { e.preventDefault(); cellAt(w, j - 1).focus(); }
      else if (e.key === 'Backspace') { e.preventDefault(); setBit(w, j, '0'); if (j > 0) cellAt(w, j - 1).focus(); }
    });

    // bonifica dell'inserimento decimale: solo cifre, con un eventuale segno davanti
    function sanitize(s) {
      s = s.replace(/[\u2212\u2013]/g, '-');
      const sign = /^[+-]/.test(s) ? s[0] : '';
      const digits = s.slice(sign.length).replace(/[^0-9]/g, '');
      return (sign + digits).slice(0, 6);
    }
    [decA, decB].forEach((inp) => inp.addEventListener('input', () => {
      const pos = inp.selectionStart, before = inp.value, clean = sanitize(before);
      if (clean !== before) { inp.value = clean; const p = Math.max(0, pos - (before.length - clean.length)); inp.setSelectionRange(p, p); }
      clearResults(); unTip(); scRandomUsed = false;
    }));

    widthSel.addEventListener('change', () => {
      const w = parseInt(widthSel.value, 10);
      // allargando si estende il bit di segno (il valore resta lo stesso in C2 e in C1);
      // stringendo si tengono i bit di destra
      const fit = (b) => (w >= width ? b[0].repeat(w - width) + b : b.slice(width - w));
      bitsA = fit(bitsA); bitsB = fit(bitsB);
      width = w;
      drawAllCells(); updateRangeHelp(); clearResults(); unTip(); scRandomUsed = false;
    });
    root.querySelector('#scBtnReset').addEventListener('click', () => {
      if (mode === 'dec') { decA.value = ''; decB.value = ''; }
      else { bitsA = '0'.repeat(width); bitsB = '0'.repeat(width); refreshCells(); }
      clearResults(); unTip(); scRandomUsed = false;
    });
    root.querySelector('#scBtnRandom').addEventListener('click', () => {
      const m = 2 ** (width - 1) - 1;
      const rnd = () => Math.floor(Math.random() * (2 * m + 1)) - m;   // intervallo comune ai due sistemi
      if (mode === 'dec') { decA.value = String(rnd()); decB.value = String(rnd()); }
      else {
        const rb = () => Array.from({ length: width }, () => (Math.random() < 0.5 ? '0' : '1')).join('');
        bitsA = rb(); bitsB = rb(); refreshCells();
      }
      clearResults(); unTip(); scRandomUsed = true;
    });

    // lettura degli ingressi
    function readDec(inp, w) {
      const s = inp.value.trim();
      if (!s) return { error: L.errEmpty(w) };
      if (/^[+-]$/.test(s)) return { error: L.errSignOnly(w) };
      const v = parseInt(s, 10);
      const m = 2 ** (width - 1) - 1;
      if (v < -(m + 1) || v > m) return { error: L.errRange(w, minus(v), width, m) };
      return { v };
    }
    function bitsFor(sys, v) {
      const abs = absBits(v, width);
      if (v >= 0) return abs;
      return sys === 'c2' ? addBits(invert(abs), '0'.repeat(width - 1) + '1').sum : invert(abs);
    }

    function prepare() {
      const sub = op === 'sub';
      const m = 2 ** (width - 1) - 1;
      if (mode === 'dec') {
        const a = readDec(decA, 'A');
        if (a.error) { tip(a.error); decA.classList.add('sc-invalid'); return null; }
        const b = readDec(decB, 'B');
        if (b.error) { tip(b.error); decB.classList.add('sc-invalid'); return null; }
        const systems = ['c2', 'c1'].map((sys) => {
          if (sys === 'c1' && (a.v === -(m + 1) || b.v === -(m + 1))) {
            return { sys, skip: true, who: a.v === -(m + 1) ? 'A' : 'B', val: a.v === -(m + 1) ? a.v : b.v };
          }
          return computeSys(sys, width, { bits: bitsFor(sys, a.v), v: a.v }, { bits: bitsFor(sys, b.v), v: b.v }, sub);
        });
        return { mode, sub, a: a.v, b: b.v, systems };
      }
      const systems = ['c2', 'c1'].map((sys) =>
        computeSys(sys, width, { bits: bitsA, v: valOf(sys, bitsA) }, { bits: bitsB, v: valOf(sys, bitsB) }, sub));
      return { mode, sub, systems };
    }

    function renderFull(t, P) {
      const n = width, m = 2 ** (n - 1) - 1;
      heading(t, L.s1);
      if (P.mode === 'dec') {
        const bT = P.b < 0 ? `(${P.b})` : `${P.b}`;
        const opTex = P.sub ? `A - B = ${P.a} - ${bT}` : `A + B = ${P.a} + ${bT}`;
        emit(t, L.dataDec(n, opTex));
      } else {
        emit(t, L.dataBin(n, P.sub ? 'A - B' : 'A + B'), `A = ${texBits(bitsA)} \\qquad B = ${texBits(bitsB)}`);
      }
      emit(t, L.ranges(n, m));

      if (P.mode === 'dec') {
        heading(t, L.s2);
        emit(t, L.s2Intro);
        const seen = new Map();
        [['A', P.a], ['B', P.b]].forEach(([w, v]) => {
          const blk = block(t);
          const av = Math.abs(v);
          if (av === 0) { emit(blk, L.absZero(w, n)); return; }
          if (seen.has(av)) { emit(blk, L.absSame(w, av, texBits(seen.get(av)))); return; }
          emit(blk, L.absHead(w, av));
          renderDivisions(blk, av, n);
          seen.set(av, absBits(av, n));
        });
      }

      P.systems.forEach((S, i) => {
        if (S.skip) {
          heading(t, L.sysTitle[S.sys], 'h4');
          emitTip(t, L.c1Skip(S.who, S.val, m), true);
          return;
        }
        renderSystem(t, S, P.mode);
      });

      heading(t, L.s5, 'h4');
      t.appendChild(buildComparison(P.systems));
    }

    function elabora(quick) {
      const target = quick ? quickEl : fullEl;
      const other = quick ? fullEl : quickEl;
      quickEl.innerHTML = ''; fullEl.innerHTML = '';
      unTip();
      const P = prepare();
      if (!P) { hide(quickEl); hide(fullEl); return; }
      emit(target, `<h2>${quick ? L.titleQuick : L.titleStep}</h2>`);
      if (quick) {
        target.appendChild(buildComparison(P.systems));
        P.systems.forEach((S) => { if (S.skip) emitTip(target, L.c1Skip(S.who, S.val, 2 ** (width - 1) - 1), true); });
      } else {
        renderFull(target, P);
      }
      hide(other);
      reveal(target);
      fitReadArrows();
      if (window.umami) umami.track('sommecomplementi-solve', { mode: quick ? 'quick' : 'steps', input: P.mode, op, bits: width, randomUsed: scRandomUsed });
    }
    root.querySelector('#scBtnQuick').addEventListener('click', () => elabora(true));
    root.querySelector('#scBtnStep').addEventListener('click', () => elabora(false));
    window.addEventListener('resize', () => fitReadArrows());

